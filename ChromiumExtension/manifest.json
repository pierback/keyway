{
  "manifest_version": 3,
  "name": "Keyway Chromium Media Bridge",
  "version": "0.1.0",
  "key": "",
  "description": "Reports Chromium tab media targets to Keyway and executes supported tab-local media commands.",
  "permissions": [
    "alarms",
    "nativeMessaging",
    "scripting",
    "storage",
    "tabs"
  ],
  "host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "background": {
    "service_worker": "service_worker.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "content_script.js"
      ],
      "run_at": "document_idle",
      "all_frames": true
    }
  ]
}
