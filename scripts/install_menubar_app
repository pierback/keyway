#!/usr/bin/env bash
set -euo pipefail

ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
DERIVED_DATA_DIR="$ROOT_DIR/.build/xcode-derived-data"
BUILT_APP="$DERIVED_DATA_DIR/Build/Products/Debug/Keyway.app"
STAGING_DIR="$HOME/Applications/.Keyway-install"
STAGED_APP="$STAGING_DIR/Keyway.app"
INSTALL_LOCK="$HOME/Applications/.Keyway-install.lock"
APP_DIR="$HOME/Applications/Keyway.app"
APP_PROCESS_NAME="Keyway"
APP_EXECUTABLE="$APP_DIR/Contents/MacOS/$APP_PROCESS_NAME"
NATIVE_HOST_PROCESS_NAME="keyway-chromium-native-host"
NATIVE_HOST_EXECUTABLE="$APP_DIR/Contents/Helpers/$NATIVE_HOST_PROCESS_NAME"
EXPECTED_TEAM_ID='7Q44SDV7BM'

stop_exact_executable() {
  local process_name="$1"
  local executable="$2"
  local label="$3"
  local process_pids=()
  local running_pids=()
  local pid

  while IFS= read -r pid; do
    if lsof -a -p "$pid" -d txt -Fn \
      | awk -v executable="n$executable" '$0 == executable { found = 1 } END { exit !found }'; then
      process_pids+=("$pid")
    fi
  done < <(pgrep -x "$process_name" || true)

  if (( ${#process_pids[@]} == 0 )); then
    return
  fi

  kill "${process_pids[@]}"
  for _ in {1..50}; do
    running_pids=()
    for pid in "${process_pids[@]}"; do
      if lsof -a -p "$pid" -d txt -Fn \
        | awk -v executable="n$executable" '$0 == executable { found = 1 } END { exit !found }'; then
        running_pids+=("$pid")
      fi
    done
    if (( ${#running_pids[@]} == 0 )); then
      return
    fi
    sleep 0.1
  done

  echo "error: $label did not stop: ${running_pids[*]}" >&2
  exit 1
}

mkdir -p "$HOME/Applications"
mkdir "$INSTALL_LOCK"
trap 'rm -rf "$STAGING_DIR"; rmdir "$INSTALL_LOCK"' EXIT

xcodebuild \
  -quiet \
  -workspace "$ROOT_DIR/Keyway.xcworkspace" \
  -scheme Keyway \
  -configuration Debug \
  -destination 'platform=macOS' \
  -derivedDataPath "$DERIVED_DATA_DIR" \
  -allowProvisioningUpdates \
  build

rm -rf "$STAGED_APP"
mkdir -p "$STAGING_DIR"
ditto "$BUILT_APP" "$STAGED_APP"
codesign --verify --deep --strict "$STAGED_APP"
staged_signing_info="$(codesign -dvv "$STAGED_APP" 2>&1)"
if [[ "$staged_signing_info" != *"TeamIdentifier=$EXPECTED_TEAM_ID"* ]]; then
  echo "error: Keyway must be signed by Apple development team $EXPECTED_TEAM_ID" >&2
  exit 1
fi

if [[ -d "$APP_DIR" ]]; then
  installed_requirement="$(codesign -d -r- "$APP_DIR" 2>&1 | sed -n 's/^designated => //p')"
  staged_requirement="$(codesign -d -r- "$STAGED_APP" 2>&1 | sed -n 's/^designated => //p')"
  if [[ -z "$installed_requirement" || -z "$staged_requirement" ]] \
    || ! codesign --verify --deep --strict -R="$installed_requirement" "$STAGED_APP" >/dev/null 2>&1 \
    || ! codesign --verify --deep --strict -R="$staged_requirement" "$APP_DIR" >/dev/null 2>&1; then
    echo "error: refusing to replace Keyway because the update has a different designated requirement" >&2
    echo "Installing it would make macOS request Accessibility and Input Monitoring again." >&2
    exit 1
  fi
fi

stop_exact_executable "$APP_PROCESS_NAME" "$APP_EXECUTABLE" "Keyway"

rm -rf "$APP_DIR"
mv "$STAGED_APP" "$APP_DIR"
stop_exact_executable "$NATIVE_HOST_PROCESS_NAME" "$NATIVE_HOST_EXECUTABLE" "Keyway Chromium native host"
open -n "$APP_DIR"

echo "$APP_DIR"
