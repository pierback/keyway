#!/usr/bin/env bash
set -euo pipefail

ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
DERIVED_DATA_DIR="$ROOT_DIR/.build/xcode-derived-data"
BUILT_APP="$DERIVED_DATA_DIR/Build/Products/Debug/Keyway.app"
APP_ENTITLEMENTS="$DERIVED_DATA_DIR/Build/Intermediates.noindex/SonosHandoffMenuBar.build/Debug/Keyway.build/Keyway.app.xcent"
APP_DIR="$HOME/Applications/Keyway.app"
APP_PROCESS_NAME="Keyway"
APP_PROCESS_PATTERN="$APP_DIR/Contents/MacOS/$APP_PROCESS_NAME"
SIGNING_IDENTITY="${KEYWAY_CODESIGN_IDENTITY:-}"

if [[ -z "$SIGNING_IDENTITY" ]]; then
  SIGNING_IDENTITY="$(
    security find-identity -v -p codesigning 2>/dev/null \
      | sed -n 's/.*"\(Apple Development:[^"]*\)".*/\1/p' \
      | head -n 1
  )"
fi

if [[ -z "$SIGNING_IDENTITY" ]]; then
  SIGNING_IDENTITY="-"
  echo "warning: no Apple Development signing identity found; falling back to ad-hoc signing" >&2
fi

xcodebuild \
  -workspace "$ROOT_DIR/Keyway.xcworkspace" \
  -scheme Keyway \
  -configuration Debug \
  -destination 'platform=macOS' \
  -derivedDataPath "$DERIVED_DATA_DIR" \
  build

if pgrep -f "$APP_PROCESS_PATTERN" >/dev/null; then
  pkill -f "$APP_PROCESS_PATTERN"
  for _ in {1..50}; do
    if ! pgrep -f "$APP_PROCESS_PATTERN" >/dev/null; then
      break
    fi
    sleep 0.1
  done
fi

rm -rf "$APP_DIR"
ditto "$BUILT_APP" "$APP_DIR"
if [[ -f "$APP_ENTITLEMENTS" ]]; then
  codesign --force --deep --sign "$SIGNING_IDENTITY" --entitlements "$APP_ENTITLEMENTS" "$APP_DIR"
else
  codesign --force --deep --sign "$SIGNING_IDENTITY" "$APP_DIR"
fi
codesign --verify --deep --strict "$APP_DIR"
open "$APP_DIR"

echo "$APP_DIR"
