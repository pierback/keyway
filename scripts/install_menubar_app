#!/usr/bin/env bash
set -euo pipefail

ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
DERIVED_DATA_DIR="$ROOT_DIR/.build/xcode-derived-data"
BUILT_APP="$DERIVED_DATA_DIR/Build/Products/Debug/SonosHandoffMenuBar.app"
APP_DIR="$HOME/Applications/Sonos Handoff.app"
SIGNING_IDENTITY="${SONOS_HANDOFF_CODESIGN_IDENTITY:-}"

if [[ -z "$SIGNING_IDENTITY" ]]; then
  SIGNING_IDENTITY="$(
    security find-identity -v -p codesigning 2>/dev/null \
      | sed -n 's/.*"\(Apple Development:[^"]*\)".*/\1/p' \
      | head -n 1
  )"
fi

if [[ -z "$SIGNING_IDENTITY" ]]; then
  SIGNING_IDENTITY="-"
  echo "warning: no Apple Development signing identity found; falling back to ad-hoc signing" >&2
fi

xcodebuild \
  -workspace "$ROOT_DIR/SonosHandoff.xcworkspace" \
  -scheme SonosHandoffMenuBar \
  -configuration Debug \
  -destination 'platform=macOS' \
  -derivedDataPath "$DERIVED_DATA_DIR" \
  build

rm -rf "$APP_DIR"
ditto "$BUILT_APP" "$APP_DIR"
codesign --force --deep --sign "$SIGNING_IDENTITY" "$APP_DIR"

echo "$APP_DIR"
