    raise SystemExit("verify_playback_routing_invariants: visible chooser row refresh must reject ambiguous same-process matches")
    if "targets.isEmpty" not in update or "self.targets = []" not in update:
        raise SystemExit("verify_playback_routing_invariants: empty target refresh must clear visible chooser rows")
