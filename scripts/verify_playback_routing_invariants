python3 - "$transport" <<'PY'
import pathlib
import re
import sys

text = pathlib.Path(sys.argv[1]).read_text()
for name, value in re.findall(r'private static let (\w*(?:Callback|Echo|Rebound|Shadow|Suppression)\w*(?:Interval|Window)): TimeInterval = ([0-9.]+)', text):
    if name == "programmaticCommandCenterEchoWindow":
        low, high = 0.0, 0.25
    elif name == "programmaticGeneratedMediaKeyCallbackWindow":
        low, high = 0.0, 0.25
    elif name == "physicalMediaKeyReboundWindow":
        low, high = 0.0, 0.25
    elif name == "chooserTargetedMediaKeyEchoWindow":
        low, high = 0.0, 1.25
    elif name == "commandCenterMediaKeyShadowInterval":
        low, high = 0.0, 0.30
    else:
        low, high = 0.0, 0.15
    parsed = float(value)
    if parsed < low or parsed > high:
        raise SystemExit(
            f"verify_playback_routing_invariants: {name} must stay between {low}s and {high}s; got {value}s"
        )
fallback_delay = re.search(r'programmaticDispatchFallbackDelayNanoseconds: UInt64 = ([0-9_]+)', text)
if not fallback_delay:
    raise SystemExit("verify_playback_routing_invariants: programmatic dispatch fallback delay must be explicit")
fallback_nanoseconds = int(fallback_delay.group(1).replace("_", ""))
if fallback_nanoseconds <= 0 or fallback_nanoseconds > 250_000_000:
    raise SystemExit("verify_playback_routing_invariants: programmatic dispatch fallback must stay below visible cooldown territory")
PY

