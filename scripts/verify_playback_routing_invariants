    raise SystemExit("verify_playback_routing_invariants: generated event-tap media-key callbacks must be traceable before routing")
if "mediaTransportActions.noteGeneratedMediaKeyIgnored(command: command, metadata: metadata)" not in input_body:
    raise SystemExit("verify_playback_routing_invariants: generated event-tap media-key callbacks must arm central transport shadow state before returning")
if "return false" not in input_body:
    raise SystemExit("verify_playback_routing_invariants: generated event-tap media-key callbacks must not reach routeFromMediaKey")
handle_start = hotkeys.index("case .transportKeyDown")
handle_end = hotkeys.index("case .transportKeyUp", handle_start)
handle_body = hotkeys[handle_start:handle_end]
if handle_body.index('acceptTransportInput(command: command, source: source, metadata: metadata, phase: "down")') > handle_body.index("mediaTransportActions.routeFromMediaKey(command: command, metadata: metadata)"):
    raise SystemExit("verify_playback_routing_invariants: event-tap input boundary must run before routeFromMediaKey")
accept_start = hotkeys.index("private func acceptTransportKeyDown")
accept_end = hotkeys.index("    private func commandsMatch", accept_start)
accept_body = hotkeys[accept_start:accept_end]
if "matchesSameGeneratedMediaKey(as: metadata)" not in accept_body:
    raise SystemExit("verify_playback_routing_invariants: transport key duplicate detection must key off the current CGEvent metadata")
if "Task.sleep" in accept_body or "CFAbsoluteTimeGetCurrent" in accept_body:
    raise SystemExit("verify_playback_routing_invariants: transport key duplicate detection must not add wall-clock delay")
if "lastTransportKeyDown = (command, metadata)" not in accept_body:
    raise SystemExit("verify_playback_routing_invariants: transport key duplicate detection must store exactly the accepted event marker")
if "activeTransportKeyDown = command" not in accept_body:
    raise SystemExit("verify_playback_routing_invariants: transport key duplicate detection must latch a held media key until key-up")
if "armTransportKeyDownReset(command: command)" not in accept_body:
    raise SystemExit("verify_playback_routing_invariants: transport key duplicate detection must arm a bounded reset in case key-up is missed")
