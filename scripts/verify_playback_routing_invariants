    raise SystemExit("verify_playback_routing_invariants: visible chooser selection must survive metadata-derived id churn")
if "preservedSelectedTargetID" not in update:
    raise SystemExit("verify_playback_routing_invariants: visible chooser selection must track refreshed row identity explicitly")
