if not transport_reset:
    raise SystemExit("verify_playback_routing_invariants: transport key-down reset interval must be explicit")
transport_reset_value = float(transport_reset.group(1))
if transport_reset_value < 0.35 or transport_reset_value > 0.45:
    raise SystemExit("verify_playback_routing_invariants: missed key-up reset must cover a normal physical press without becoming a routing cooldown")
if "private func finishTransportKeyDown" not in hotkeys:
    raise SystemExit("verify_playback_routing_invariants: transport key duplicate detection must release the held media-key latch on key-up")
if "activeTransportKeyDownResetTimer?.cancel()" not in hotkeys:
    raise SystemExit("verify_playback_routing_invariants: transport key reset timer must be cancelled when the latch is released")
if "resetInputStateAfterTapInterruption" not in hotkeys:
    raise SystemExit("verify_playback_routing_invariants: event-tap interruptions must clear held input state")
if "onInterrupted:" not in hotkeys:
    raise SystemExit("verify_playback_routing_invariants: ShortcutEventTap must report timeout/user-input interruptions to the controller")
duplicate_interval = re.search(r'duplicateCallbackInterval: TimeInterval = ([0-9.]+)', command_center)
if not duplicate_interval:
    raise SystemExit("verify_playback_routing_invariants: command-center duplicate callback interval must be explicit")
if float(duplicate_interval.group(1)) > 0.15:
    raise SystemExit("verify_playback_routing_invariants: command-center duplicate callback interval must stay below 150ms")
