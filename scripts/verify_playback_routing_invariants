#!/usr/bin/env bash
set -euo pipefail

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
transport="$repo_root/SonosHandoffMenuBar/SonosHandoffMenuBar/App/MediaTransportActionController.swift"
overlay="$repo_root/SonosHandoffMenuBar/SonosHandoffMenuBar/App/MediaTargetOverlayController.swift"
overlay_model="$repo_root/SonosHandoffMenuBar/SonosHandoffMenuBar/App/MediaTargetOverlayModel.swift"
helper="$repo_root/MediaRemoteHelper/KeywayMediaRemoteShim.m"
command_center="$repo_root/SonosHandoffMenuBar/SonosHandoffMenuBar/App/MediaCommandCenterInterceptor.swift"
hotkeys="$repo_root/SonosHandoffMenuBar/SonosHandoffMenuBar/App/VolumeHotkeyController.swift"
parser="$repo_root/SonosHandoffMenuBar/SonosHandoffMenuBar/App/ShortcutEventParser.swift"
event_tap="$repo_root/SonosHandoffMenuBar/SonosHandoffMenuBar/App/ShortcutEventTap.swift"
command_filter="$repo_root/SonosHandoffMenuBar/SonosHandoffMenuBar/App/MediaTransportCommandCenterFilter.swift"
chooser_guard="$repo_root/SonosHandoffMenuBar/SonosHandoffMenuBar/App/MediaChooserSessionGuard.swift"
command_rules="$repo_root/SonosHandoffMenuBar/SonosHandoffMenuBar/App/MediaTransportCommandRules.swift"
refresh_gate="$repo_root/SonosHandoffMenuBar/SonosHandoffMenuBar/App/MediaRemoteSnapshotRefreshGate.swift"
remote_controller="$repo_root/SonosHandoffMenuBar/SonosHandoffMenuBar/App/MediaRemoteController.swift"
remote_helper_process="$repo_root/SonosHandoffMenuBar/SonosHandoffMenuBar/App/MediaRemoteHelperProcess.swift"
status_item="$repo_root/SonosHandoffMenuBar/SonosHandoffMenuBar/App/KeywayStatusItemController.swift"
app_environment="$repo_root/SonosHandoffMenuBar/SonosHandoffMenuBar/Support/AppEnvironment.swift"
info_plist="$repo_root/SonosHandoffMenuBar/SonosHandoffMenuBar/Resources/Info.plist"
runtime_status="$repo_root/SonosHandoffMenuBar/SonosHandoffMenuBar/App/ShortcutRuntimeStatus.swift"
runtime_reporter="$repo_root/SonosHandoffMenuBar/SonosHandoffMenuBar/App/ShortcutRuntimeReporter.swift"

fail() {
  printf 'verify_playback_routing_invariants: %s\n' "$1" >&2
  exit 1
}

grep -q 'commandCenterMetadata: commandCenterMetadata' "$transport" \
  || fail "Play/Pause routing must show the cached chooser immediately with input metadata"

if grep -q 'cgSessionEventTap\|case session' "$event_tap"; then
  fail "Play/Pause interception must fail closed instead of falling back to a non-cghid event tap"
fi

grep -q 'struct MediaRemoteSnapshotRefreshGate' "$refresh_gate" \
  || fail "MediaRemote snapshot refresh coalescing must be isolated in a testable value type"

grep -q 'private var refreshGate = MediaRemoteSnapshotRefreshGate()' "$remote_controller" \
  || fail "MediaRemoteController must use the snapshot refresh gate"

grep -q 'MediaRemoteHelperProcess(role: .snapshot' "$remote_controller" \
  || fail "MediaRemoteController must run snapshot work in its own helper process"

grep -q 'MediaRemoteHelperProcess(role: .command' "$remote_controller" \
  || fail "MediaRemoteController must run command dispatch in a separate helper process"

grep -q 'commandHelper.send' "$remote_controller" \
  || fail "MediaRemoteController must submit selected-row commands through the command helper"

grep -q 'snapshotHelper.send' "$remote_controller" \
  || fail "MediaRemoteController must submit refreshes through the snapshot helper"

grep -q 'KEYWAY_MEDIAREMOTE_DISABLE_NOTIFICATIONS' "$remote_helper_process" \
  || fail "command helper must disable notification registration to avoid duplicate refresh streams"

grep -q 'KEYWAY_MEDIAREMOTE_ROLE' "$repo_root/MediaRemoteHelper/keyway-mediaremote-helper.pl" \
  || fail "Perl helper must expose its role for split helper diagnostics"

grep -q 'KEYWAY_MEDIAREMOTE_DISABLE_NOTIFICATIONS' "$repo_root/MediaRemoteHelper/keyway-mediaremote-helper.pl" \
  || fail "Perl helper must support command helpers without notification registration"

grep -q 'KeywayStableHash' "$helper" \
  || fail "MediaRemote target IDs must use a deterministic content hash, not process-local NSString hash"

grep -q 'KeywayRefreshRowIdentifier(row);' "$helper" \
  || fail "MediaRemote target IDs must be refreshed from stable client identity before rows are exposed"

grep -q 'targetEntries\[index\]' "$helper" \
  || fail "MediaRemote duplicate target suffixes must be assigned in client enumeration order, not async callback order"

grep -q 'KeywayReserveTargetRow(targets, clientsByTargetID, row, client, visible)' "$helper" \
  || fail "MediaRemote snapshots must reserve hidden duplicate client ids before exposing visible rows"

grep -q '@"visible": @(KeywayRowHasMediaState(row))' "$helper" \
  || fail "MediaRemote snapshots must keep media-state visibility separate from duplicate id reservation"

grep -q 'row\[@"artworkBase64"\]' "$helper" \
  || fail "MediaRemote snapshots must keep artwork-only sessions visible as routable media targets"

grep -q 'if (visible && activeTargetID.length == 0' "$helper" \
  || fail "MediaRemote snapshots must not mark hidden duplicate clients as the active visible target"

grep -q 'keyway_mediaremote_refresh_client_cache' "$helper" \
  || fail "command helper must expose a fast client-cache refresh entry point"

grep -q 'refreshClientCache' "$repo_root/MediaRemoteHelper/keyway-mediaremote-helper.pl" \
  || fail "Perl helper must support fast command-cache refresh requests"

grep -q 'KeywayRefreshFastClientCache' "$helper" \
  || fail "command helper must resolve selected target IDs through the fast client cache"

grep -q 'guard let requestID = refreshGate.begin()' "$remote_controller" \
  || fail "MediaRemote snapshot refreshes must be single-flight so refresh bursts cannot queue ahead of row dispatch"

grep -q 'refresh_coalesced reason=in_flight' "$remote_controller" \
  || fail "coalesced snapshot refreshes must be visible in logs"

grep -q 'pendingRefreshRequested = true' "$remote_controller" \
  || fail "coalesced snapshot refreshes must request one follow-up snapshot"

grep -q 'drainPendingRefreshIfNeeded()' "$remote_controller" \
  || fail "completed snapshot refreshes must drain one coalesced follow-up refresh"

grep -q 'refresh_followup reason=coalesced' "$remote_controller" \
  || fail "coalesced follow-up refreshes must be visible in logs"

grep -q 'refreshGate.finish(requestID: snapshot.requestID)' "$remote_controller" \
  || fail "MediaRemote snapshots must close the exact in-flight refresh request"

grep -q 'snapshotRefreshTimeoutNanoseconds' "$remote_controller" \
  || fail "MediaRemote snapshot refreshes must have a bounded timeout"

python3 - "$remote_controller" <<'PY'
import pathlib
import re
import sys

text = pathlib.Path(sys.argv[1]).read_text()
command_timeout = re.search(r'commandResultTimeoutNanoseconds: UInt64 = ([0-9_]+)', text)
if not command_timeout:
    raise SystemExit("verify_playback_routing_invariants: MediaRemote command result timeout must be explicit")
if int(command_timeout.group(1).replace("_", "")) > 350_000_000:
    raise SystemExit("verify_playback_routing_invariants: MediaRemote command result timeout must fail fast and stay below hidden-delay territory")
poll_interval = re.search(r'snapshotPollInterval: TimeInterval = ([0-9.]+)', text)
if not poll_interval:
    raise SystemExit("verify_playback_routing_invariants: MediaRemote snapshot poll interval must be explicit")
if float(poll_interval.group(1)) > 1:
    raise SystemExit("verify_playback_routing_invariants: MediaRemote snapshot polling must keep chooser cache staleness below one second")
restart_delay = re.search(r'immediateRestartDelayNanoseconds: UInt64 = ([0-9_]+)', text)
if not restart_delay:
    raise SystemExit("verify_playback_routing_invariants: MediaRemote helper immediate restart delay must be explicit")
if int(restart_delay.group(1).replace("_", "")) > 250_000_000:
    raise SystemExit("verify_playback_routing_invariants: MediaRemote helper immediate restart delay must stay below hidden-delay territory")
PY

grep -q 'armSnapshotRefreshTimeout(requestID: requestID)' "$remote_controller" \
  || fail "accepted MediaRemote snapshot refreshes must arm the bounded timeout"

grep -q 'refresh_timeout requestID=' "$remote_controller" \
  || fail "timed-out MediaRemote snapshot refreshes must be visible in logs"

grep -q 'self.refreshGate.finish(requestID: requestID)' "$remote_controller" \
  || fail "MediaRemote snapshot refresh timeout must release only the matching in-flight request"

grep -q 'stale_snapshot_ignored' "$remote_controller" \
  || fail "stale MediaRemote snapshots must not overwrite the current target cache"

grep -q 'refreshGate.reset()' "$remote_controller" \
  || fail "MediaRemote helper failures and stops must clear refresh gate state"

grep -q 'resolved MediaRemote player path from fresh command cache' "$helper" \
  || fail "command helper fresh target resolution must be visible in command results"

grep -q 'warmCommandClientCacheIfNeeded(targets: visibleTargets, reason: "snapshot_targets")' "$remote_controller" \
  || fail "snapshot updates must keep the command helper client cache warm for instant row dispatch"

grep -q 'ShortcutRuntimeStatus.shared.updateMediaTargets' "$remote_controller" \
  || fail "MediaRemote snapshots must persist the filtered target cache for physical routing diagnosis"

grep -q 'mediaTargets' "$runtime_status" \
  || fail "runtime status must expose the app-visible MediaRemote target cache"

grep -q 'warmCommandClientCache(reason: "command_ready")' "$remote_controller" \
  || fail "command helper must warm its client cache as soon as it is ready"

grep -q 'commandCacheRefreshRequestIDs' "$remote_controller" \
  || fail "command helper client-cache refreshes must be bounded and tracked"

python3 - "$helper" <<'PY'
import pathlib
import sys

text = pathlib.Path(sys.argv[1]).read_text()
start = text.index("static NSUInteger KeywayRefreshFastClientCache(")
end = text.index("\nstatic NSNumber *KeywayCommandNumber", start)
resolver = text[start:end]
if "requestNowPlayingInfoOnQueue" in resolver:
    raise SystemExit("verify_playback_routing_invariants: command helper fast cache must not wait for now-playing metadata")
if "5 * NSEC_PER_SEC" in resolver or "1500 * NSEC_PER_MSEC" in resolver or "1_500_000_000" in resolver:
    raise SystemExit("verify_playback_routing_invariants: command helper fast cache must not contain a visible dispatch delay")
if "150 * NSEC_PER_MSEC" not in resolver:
    raise SystemExit("verify_playback_routing_invariants: command helper fast cache must use a short client-list timeout")
if "KeywayReplaceClientCache(clientsByTargetID)" not in resolver:
    raise SystemExit("verify_playback_routing_invariants: command helper fast cache must populate its process-local cache")
send_start = text.index("void keyway_mediaremote_send_command(void)")
send_end = text.index("\nstatic void KeywayNotificationThreadMain", send_start)
send_command = text[send_start:send_end]
if "KeywayResolveClientForTargetID" in send_command:
    raise SystemExit("verify_playback_routing_invariants: selected-row command dispatch must not use slow now-playing target reconstruction")
if "requestNowPlayingInfoOnQueue" in send_command:
    raise SystemExit("verify_playback_routing_invariants: selected-row command dispatch must not request now-playing metadata before sending")
submit_start = text.index("static BOOL KeywaySubmitCommandToPlayerPath(")
submit_end = text.index("\nvoid keyway_mediaremote_snapshot", submit_start)
submit_command = text[submit_start:submit_end]
if "dispatch_semaphore_wait" in submit_command:
    raise SystemExit("verify_playback_routing_invariants: selected-row command dispatch must not wait for MediaRemote completion before returning")
if "commandCompletionTimeoutNanoseconds" in submit_command:
    raise SystemExit("verify_playback_routing_invariants: selected-row command dispatch must not keep a hidden completion timeout")
PY

grep -q 'isPlayFamily(command)' "$transport" "$command_rules" \
  || fail "play, pause, and play/pause commands must share chooser-first routing"

grep -q 'MediaTransportCommandRules.rowScopedCommand(command, for: target)' "$transport" \
  || fail "chooser Play/Pause must resolve normal targets from the selected row state, not a post-key refreshed target state"

grep -q 'usesSpotifyDesktopTransport(target: target) || usesHeliumDesktopTransport(target: target)' "$transport" \
  || fail "desktop chooser Play/Pause must use app-owned transports because MediaRemote playbackRate can be stale"

grep -q 'net.imput.helium' "$transport" \
  || fail "Helium must have a selected-row desktop transport when MediaRemote player-path commands do not affect it"

grep -q 'targetsIncludingHeliumDesktop' "$remote_controller" \
  || fail "Helium must remain visible as a chooser target when MediaRemote omits its browser media row"

grep -q 'sendAppleEvent' "$transport" \
  || fail "Spotify desktop dispatch must use in-process Apple Events instead of spawning osascript"

grep -q 'runHeliumJavaScriptToggle' "$transport" \
  || fail "Helium desktop dispatch must execute tab JavaScript instead of using MediaRemote or keypress guesses"

grep -q 'execute active tab of front window javascript' "$transport" \
  || fail "Helium desktop dispatch must target browser media through Chromium scripting"

grep -q 'shadowRoot' "$transport" \
  || fail "Helium desktop dispatch must inspect open shadow DOM media elements"

grep -q 'contentDocument' "$transport" \
  || fail "Helium desktop dispatch must inspect same-origin iframe media elements"

grep -q 'const directPlaying = direct.filter(isPlaying)' "$transport" \
  || fail "Helium desktop dispatch must keep the direct playing-media path fast before deep DOM traversal"

grep -q 'const deepPlaying = deep.filter(isPlaying)' "$transport" \
  || fail "Helium desktop dispatch must pause playing media found in shadow DOM or same-origin frames"

if grep -q '/usr/bin/osascript' "$transport"; then
  fail "selected-row desktop dispatch must not spawn osascript from the app hot path"
fi

if grep -q 'key code 49\|virtualKey: 49' "$transport"; then
  fail "Helium selected-row dispatch must not simulate Space; focus-dependent browser keypresses are not target control"
fi

grep -q 'NSAppleEventsUsageDescription' "$info_plist" \
  || fail "in-process Spotify Apple Events must declare Automation usage"

grep -q 'transportBackendName(command: command, target: target)' "$transport" \
  || fail "chooser dispatch traces must expose the selected transport backend"

grep -q 'transportBackend: result.backend' "$transport" \
  || fail "desktop helper results must preserve their selected transport backend"

grep -q 'output == "paused" || output == "playing" || output == "play_requested"' "$transport" \
  || fail "Helium JavaScript dispatch must fail closed for no_media/no_windows states"

grep -q 'selected_row_dispatch_route_shield_kept' "$transport" \
  || fail "desktop selected-row dispatch must keep the route shield armed"

grep -q 'return target.isCurrentlyPlaying ? .pause : .play' "$command_rules" \
  || fail "normal chooser Play/Pause must not send a global toggle when the selected row already tells us play state"

if grep -q 'func currentTarget(matching selectedTarget: MediaRemoteTarget)' "$transport"; then
  fail "chooser dispatch must not rewrite the selected row id before dispatch"
fi

grep -q 'MediaChooserSessionGuard' "$transport" \
  || fail "active chooser state must be owned by the testable session guard"

grep -q 'guard !self.chooserSession.isActive else { return }' "$transport" \
  || fail "pending chooser rows must not be mutated by snapshot refreshes before the user chooses"

grep -q 'let id = UUID()' "$repo_root/SonosHandoffMenuBar/SonosHandoffMenuBar/App/MediaChooserSessionGuard.swift" \
  || fail "each chooser presentation must create a unique session id"

grep -q 'active == nil ? "inactive" : "visible"' "$repo_root/SonosHandoffMenuBar/SonosHandoffMenuBar/App/MediaChooserSessionGuard.swift" \
  || fail "chooser session guard must model only visible chooser state"

python3 - "$repo_root/SonosHandoffMenuBar/SonosHandoffMenuBar/App/MediaChooserSessionGuard.swift" <<'PY'
import pathlib
import sys

text = pathlib.Path(sys.argv[1]).read_text()
for forbidden in (
    "selectedEcho",
    "selectedEchoInterval",
    "ignoreReasonForChooserRequest",
    "post_selection_echo",
    "matchesSameGeneratedMediaKey",
):
    if forbidden in text:
        raise SystemExit(f"verify_playback_routing_invariants: chooser session guard must not keep post-selection routing memory: {forbidden}")
if "let command: MediaRemoteTransportCommand" not in text or "let id: UUID" not in text:
    raise SystemExit("verify_playback_routing_invariants: chooser session guard must model only visible chooser id plus pending command")
PY

if grep -Eq 'finishScheduledRelease|releaseDecision|isDispatching|dispatchingID|markDispatching|selectedEcho|post_selection_echo|ignoreReasonForChooserRequest' "$repo_root/SonosHandoffMenuBar/SonosHandoffMenuBar/App/MediaChooserSessionGuard.swift"; then
  fail "chooser session guard must not keep delayed post-selection routing state"
fi

python3 - "$transport" <<'PY'
import pathlib
import re
import sys

text = pathlib.Path(sys.argv[1]).read_text()
chooser_from_cache = text[
    text.index("private func showChooserImmediately("):
    text.index("    private func routeFromCache", text.index("private func showChooserImmediately("))
]
if "refreshSnapshotAndWait(" in chooser_from_cache or "chooserSnapshotWaitNanoseconds" in text:
    raise SystemExit("verify_playback_routing_invariants: chooser path must not wait for MediaRemote snapshots before presenting")
if "let refreshQueued = mediaRemoteController.refreshSnapshot()" not in chooser_from_cache:
    raise SystemExit("verify_playback_routing_invariants: chooser path must refresh MediaRemote snapshots in the background after taking the cached target list")
if "showChooserOverlay(" not in chooser_from_cache or "commandCenterMetadata: commandCenterMetadata" not in chooser_from_cache:
    raise SystemExit("verify_playback_routing_invariants: chooser path must present cached targets immediately with input metadata")
after_overlay = chooser_from_cache[chooser_from_cache.index("showChooserOverlay("):]
if "refreshSnapshot()" in after_overlay:
    raise SystemExit("verify_playback_routing_invariants: chooser open must not queue a MediaRemote refresh that can block selected-row dispatch")
on_choose = text.index("onChoose: {")
on_dismiss = text.index("onDismiss:", on_choose)
choose_body = text[on_choose:on_dismiss]
if "self.currentTarget(matching: target)" in choose_body:
    raise SystemExit("verify_playback_routing_invariants: chooser clicks must not rewrite the selected row id before dispatch")
if "to: target" not in choose_body:
    raise SystemExit("verify_playback_routing_invariants: chooser clicks must dispatch exactly the selected row target")
finish_marker = "self.finishChooser("
if finish_marker not in choose_body or "selected: true" not in choose_body:
    raise SystemExit("verify_playback_routing_invariants: chooser row selection must clear visible chooser state immediately")
if "selectedTargetExpectation" in choose_body or "selectedTargetReachedExpectedState" in text:
    raise SystemExit("verify_playback_routing_invariants: chooser row selection must not depend on stale selected-target expectation state")
if '"chooser_closed_for_dispatch"' not in choose_body:
    raise SystemExit("verify_playback_routing_invariants: chooser row selection must trace the overlay close before selected-row dispatch")
if "dispatchFromChooser(" not in choose_body:
    raise SystemExit("verify_playback_routing_invariants: chooser row selection must dispatch after releasing the route shield")
if "relaxRouteShield?(\"selected_row_dispatch\")" not in choose_body:
    raise SystemExit("verify_playback_routing_invariants: chooser row selection must stop the Command Center route shield before selected-target dispatch")
if "selectedRowDispatchRouteShieldReleaseDelayNanoseconds" not in choose_body:
    raise SystemExit("verify_playback_routing_invariants: selected-target dispatch must wait only for the explicit route-shield release delay")
if choose_body.index(finish_marker) > choose_body.index("dispatchFromChooser("):
    raise SystemExit("verify_playback_routing_invariants: chooser visible guard must clear before selected-row dispatch")
if choose_body.index('"chooser_closed_for_dispatch"') > choose_body.index("dispatchFromChooser("):
    raise SystemExit("verify_playback_routing_invariants: chooser close trace must happen before selected-row dispatch")
route_shield_delay = re.search(r'selectedRowDispatchRouteShieldReleaseDelayNanoseconds: UInt64 = ([0-9_]+)', text)
if not route_shield_delay:
    raise SystemExit("verify_playback_routing_invariants: selected-row dispatch route-shield release delay must be explicit")
route_shield_delay_value = int(route_shield_delay.group(1).replace("_", ""))
if route_shield_delay_value <= 0 or route_shield_delay_value > 250_000_000:
    raise SystemExit("verify_playback_routing_invariants: selected-row dispatch route-shield release delay must stay below visible cooldown territory")
dispatch_from_chooser = text[text.index("private func dispatchFromChooser"):text.index("private func finishChooser")]
if "sendFromChooser(command: command, to: target, dispatchID: dispatchID)" not in dispatch_from_chooser:
    raise SystemExit("verify_playback_routing_invariants: chooser dispatch must send the selected command without waiting for guard release")
if "targetUnixProcessID: Int64(target.pid)" not in dispatch_from_chooser:
    raise SystemExit("verify_playback_routing_invariants: chooser dispatch must bind targeted HID echo suppression to the selected row process")
if "applicationUnixProcessID: Int64(ProcessInfo.processInfo.processIdentifier)" not in dispatch_from_chooser:
    raise SystemExit("verify_playback_routing_invariants: chooser dispatch must also bind targeted HID echo suppression to Keyway for macOS-retargeted row echoes")
if "chooserID" in dispatch_from_chooser:
    raise SystemExit("verify_playback_routing_invariants: chooser dispatch must not carry delayed session state after row selection")
send_from_chooser = text[text.index("private func sendFromChooser"):text.index("private func chooserScopedCommand")]
if "releaseChooserAfterDispatchEchoWindow" in send_from_chooser:
    raise SystemExit("verify_playback_routing_invariants: chooser dispatch must not wait on a post-send release window")
if "commandCenterFilter.finishProgrammaticDispatch(command: command)" in send_from_chooser:
    raise SystemExit("verify_playback_routing_invariants: chooser dispatch must not tie echo cleanup to helper completion")
if "defer" in send_from_chooser:
    raise SystemExit("verify_playback_routing_invariants: chooser dispatch must not defer routing-state cleanup around helper latency")
release_delay = re.search(r'chooserDispatchReleaseDelayNanoseconds: UInt64 = ([0-9_]+)', text)
if release_delay:
    raise SystemExit("verify_playback_routing_invariants: chooser dispatch must not keep a post-selection release delay")
quiet_delay = re.search(r'chooserDispatchEchoQuietDelayNanoseconds: UInt64 = ([0-9_]+)', text)
if quiet_delay:
    raise SystemExit("verify_playback_routing_invariants: chooser dispatch must not extend a hidden quiet-window delay")
if "chooserCommandCenterEchoSuppressionInterval" in text or "chooserMediaKeyEchoSuppressionInterval" in text:
    raise SystemExit("verify_playback_routing_invariants: chooser dispatch must not keep 1.5s echo suppression windows")
stuck_delay = re.search(r'chooserDispatchStuckReleaseDelayNanoseconds: UInt64 = ([0-9_]+)', text)
if stuck_delay:
    raise SystemExit("verify_playback_routing_invariants: chooser dispatch must not use a stuck-helper release delay to recover routing state")
hard_release = re.search(r'chooserDispatchHardReleaseInterval: TimeInterval = ([0-9.]+)', text)
if hard_release:
    raise SystemExit("verify_playback_routing_invariants: chooser dispatch must not use a hard-release delay")
if "scheduleChooserDispatchRelease" in text:
    raise SystemExit("verify_playback_routing_invariants: chooser dispatch must not schedule delayed routing-state release")
if "chooserDispatchReentryBlockInterval" in text or "blockChooserReentryAfterDispatch" in text or "chooser_dispatch_reentry_block" in text:
    raise SystemExit("verify_playback_routing_invariants: chooser row dispatch must not install a route-boundary cooldown that can swallow a fresh physical key press")
if "private func beginBoundedChooserDispatch" not in text or "private func scheduleProgrammaticDispatchFallback" not in text:
    raise SystemExit("verify_playback_routing_invariants: chooser dispatch must have a bounded local fallback if helper completion is missing")
if "commandCenterMetadata: commandCenterMetadata" not in text:
    raise SystemExit("verify_playback_routing_invariants: chooser dispatch must use bounded chooser echo handling")
if "commandCenterFilter.finishChooserDispatch(" in text or "commandCenterFilter.finishProgrammaticDispatch(" in text:
    raise SystemExit("verify_playback_routing_invariants: helper completion must not close time-bounded echo suppression before late rebound callbacks arrive")
if "enum MediaTransportDispatchEchoKind" not in pathlib.Path(sys.argv[1]).with_name("MediaRouteStatus.swift").read_text() or "struct MediaTransportPendingDispatchEcho" not in pathlib.Path(sys.argv[1]).with_name("MediaRouteStatus.swift").read_text():
    raise SystemExit("verify_playback_routing_invariants: pending dispatch fallback must remember whether the command came from chooser or automatic routing")
if "programmaticDispatches[id] = MediaTransportPendingDispatchEcho(command: command, kind: .chooser)" not in text:
    raise SystemExit("verify_playback_routing_invariants: chooser dispatch fallback must be tagged as chooser-specific")
fallback_body = text[
    text.index("private func scheduleProgrammaticDispatchFallback"):
    text.index("    private func trace(", text.index("private func scheduleProgrammaticDispatchFallback"))
]
if "pending.kind.rawValue" not in fallback_body:
    raise SystemExit("verify_playback_routing_invariants: dispatch fallback must preserve the dispatch echo kind in logs")
if "commandCenterFilter.finish" in fallback_body:
    raise SystemExit("verify_playback_routing_invariants: dispatch fallback must not close the time-bounded echo guard")
if "await mediaRemoteController.send" in text:
    raise SystemExit("verify_playback_routing_invariants: UI routing must not await helper command acknowledgement")
if "mediaRemoteController.submit(command: command, targetID: target.id)" not in text:
    raise SystemExit("verify_playback_routing_invariants: automatic routing must submit commands without request/response latency")
if "mediaRemoteController.submit(command: command, targetID: target.id)" not in send_from_chooser:
    raise SystemExit("verify_playback_routing_invariants: chooser routing must submit commands without request/response latency")
if "Routed by chooser" in send_from_chooser:
    raise SystemExit("verify_playback_routing_invariants: chooser success must not leave a 1.35s HUD after row selection")
send_body = text[text.index("private func send(command:"):text.index("private func dispatchFromChooser")]
if "Routed by " in send_body:
    raise SystemExit("verify_playback_routing_invariants: automatic playback success must not leave a 1.35s HUD")
if "defer" in send_body or "commandCenterFilter.finishProgrammaticDispatch(command: command)" in send_body:
    raise SystemExit("verify_playback_routing_invariants: automatic dispatch must not tie echo cleanup to helper completion")
if "beginBoundedProgrammaticDispatch(command: command)" not in send_body:
    raise SystemExit("verify_playback_routing_invariants: automatic dispatch must use bounded programmatic echo handling")
route_body = text[text.index("private func route("):text.index("    func showChooser(command:")]
if "chooserSession.isDispatching" in route_body or "chooser_dispatch_input_ignored" in route_body:
    raise SystemExit("verify_playback_routing_invariants: route boundary must not block a real next key press during chooser dispatch")
programmatic_command_center = re.search(r'programmaticCommandCenterEchoWindow: TimeInterval = ([0-9.]+)', text)
if not programmatic_command_center:
    raise SystemExit("verify_playback_routing_invariants: programmatic Command Center echoes must have an explicit bounded window")
