    raise SystemExit("verify_playback_routing_invariants: missing keyway_mediaremote_send_command")
body = match.group("body")
if "KeywayCachedClientForTargetID(targetID)" in body:
    raise SystemExit("verify_playback_routing_invariants: selected playback commands must not submit through a stale process-local client cache")
if "KeywayRefreshFastClientCache(targetID, &symbols, queue, &resolvedClient)" not in body:
    raise SystemExit("verify_playback_routing_invariants: selected playback commands must resolve the selected target from a fresh fast client cache")
if body.index("KeywayRefreshFastClientCache(targetID, &symbols, queue, &resolvedClient)") > body.index("KeywaySubmitCommandToPlayerPath"):
    raise SystemExit("verify_playback_routing_invariants: selected playback commands must refresh target resolution before MRPlayerPath submission")
if "fresh MediaRemote client cache unavailable" not in body or "target not found in fresh MediaRemote client cache" not in body:
    raise SystemExit("verify_playback_routing_invariants: failed fresh target resolution must be explicit in command results")
if "KeywaySubmitCommandToPlayerPath" not in body:
    raise SystemExit("verify_playback_routing_invariants: selected playback commands must submit through MRPlayerPath")
submit = text[text.index("static BOOL KeywaySubmitCommandToPlayerPath"):text.index("void keyway_mediaremote_snapshot")]
if "appOptions:(unsigned int)appOptions" not in text or "appOptions:0" not in submit:
    raise SystemExit("verify_playback_routing_invariants: MRNowPlayingRequest appOptions must use the runtime unsigned-int ABI, not an object")
if "appOptions:@{}" in submit:
    raise SystemExit("verify_playback_routing_invariants: MRNowPlayingRequest appOptions object corrupts selected-row command dispatch")
if "dispatch_semaphore_wait" in submit:
    raise SystemExit("verify_playback_routing_invariants: helper command results must not wait on the MediaRemote completion callback")
if "commandCompletionTimeoutNanoseconds" in submit:
    raise SystemExit("verify_playback_routing_invariants: helper command submission must not keep a hidden completion timeout")
PY

if grep -Eq 'MRMediaRemoteSendCommandToClient|sendCommandToClient|enqueueCommand|sendQueuedCommands' "$helper"; then
  fail "MediaRemote helper must not use global/client queued command fallbacks"
fi

printf 'verify_playback_routing_invariants=ok\n'
