import pathlib
import re
import sys

hotkeys = pathlib.Path(sys.argv[1]).read_text()
command_center = pathlib.Path(sys.argv[2]).read_text()
for stale_name in (
    "transportKeyPressAutoClearInterval",
    "transportKeyPressAutoClearNanoseconds",
    "scheduleTransportKeyPressAutoClear",
    "transport_press_auto_cleared",
    "activeTransportKeyPress",
):
    if stale_name in hotkeys:
        raise SystemExit(f"verify_playback_routing_invariants: transport key routing must not keep timed latch state: {stale_name}")
if "acceptTransportKeyDown(command: command, metadata: metadata)" not in hotkeys:
    raise SystemExit("verify_playback_routing_invariants: transport key duplicate detection must use CGEvent metadata")
input_start = hotkeys.index("private func acceptTransportInput")
