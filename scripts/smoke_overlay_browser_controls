#!/usr/bin/env bash
set -euo pipefail

APP_DIR="${KEYWAY_APP:-$HOME/Applications/Keyway.app}"
HELPER_SCRIPT="$APP_DIR/Contents/Resources/MediaRemoteHelper/keyway-mediaremote-helper.pl"
HELPER_DYLIB="$APP_DIR/Contents/Resources/MediaRemoteHelper/libkeyway_mediaremote.dylib"
RUNTIME_STATUS_FILE="$HOME/Library/Application Support/keyway/shortcut-runtime-status.json"
PHYSICAL_MEDIA_KEYS="${KEYWAY_PHYSICAL_MEDIA_KEYS:-0}"
BROWSER_TARGET_MATCH="${KEYWAY_BROWSER_TARGET_MATCH:-}"
TARGET_INFO_FILE="$(mktemp -t keyway-overlay-targets.XXXXXX)"
VISIBLE_STATE_FILE="$(mktemp -t keyway-overlay-visible-apps.XXXXXX)"

if [[ ! -d "$APP_DIR" ]]; then
  echo "smoke_overlay_browser_controls: missing app bundle: $APP_DIR" >&2
  echo "Run scripts/install_menubar_app first." >&2
  exit 1
fi

if [[ "$PHYSICAL_MEDIA_KEYS" == "1" && ! -r /dev/tty ]]; then
  echo "smoke_overlay_browser_controls: physical media-key mode requires an interactive terminal" >&2
  exit 1
fi

if [[ -x "$HELPER_SCRIPT" && -f "$HELPER_DYLIB" ]]; then
  helper_snapshot="$(printf '%s\n' '{"type":"refresh","requestID":"overlay-browser-smoke"}' | /usr/bin/perl "$HELPER_SCRIPT" "$HELPER_DYLIB")"
else
  echo "smoke_overlay_browser_controls: bundled MediaRemote helper files are missing" >&2
  exit 1
fi

printf '%s\n' "$helper_snapshot" | /usr/bin/swift -e '
import Foundation

struct Envelope: Decodable {
    let type: String
}

struct Snapshot: Decodable {
    let type: String
    let targets: [Target]
}

struct Target: Decodable {
    let displayName: String
    let bundleIdentifier: String
    let parentBundleIdentifier: String

    var bundleIdentities: [String] {
        [bundleIdentifier, parentBundleIdentifier]
            .map { $0.trimmingCharacters(in: .whitespacesAndNewlines) }
            .filter { !$0.isEmpty }
    }

    var isBrowserLike: Bool {
        bundleIdentities
            .map { $0.lowercased() }
            .contains { identity in
                identity.contains("safari")
                    || identity.contains("chrome")
                    || identity.contains("firefox")
                    || identity.contains("brave")
                    || identity.contains("arc")
                    || identity.contains("helium")
                    || identity.contains("browser")
            }
    }
}

let input = String(data: FileHandle.standardInput.readDataToEndOfFile(), encoding: .utf8) ?? ""
let decoder = JSONDecoder()
let snapshot = input
    .split(separator: "\n")
    .compactMap { line -> Snapshot? in
        guard let data = line.data(using: .utf8),
              (try? decoder.decode(Envelope.self, from: data).type) == "snapshot"
        else {
            return nil
        }
        return try? decoder.decode(Snapshot.self, from: data)
    }
    .last

guard let snapshot else {
    fputs("helper snapshot was missing\n", stderr)
    exit(2)
}

print("target_count=\(snapshot.targets.count)")
print("browser_count=\(snapshot.targets.filter(\.isBrowserLike).count)")
var seenBundles = Set<String>()
for target in snapshot.targets {
    for bundleID in target.bundleIdentities where seenBundles.insert(bundleID).inserted {
        print("target_bundle\t\(bundleID)")
    }
}
' >"$TARGET_INFO_FILE"

target_count="$(awk -F= '/^target_count=/{ print $2; exit }' "$TARGET_INFO_FILE")"
browser_count="$(awk -F= '/^browser_count=/{ print $2; exit }' "$TARGET_INFO_FILE")"
if [[ -z "$target_count" || "$target_count" -lt 2 ]]; then
  echo "$helper_snapshot"
  echo "smoke_overlay_browser_controls: chooser requires at least two Now Playing targets; found ${target_count:-0}" >&2
  echo "Start Spotify or QuickTime plus a browser/browser-wrapper media session before running this check." >&2
  exit 1
fi
if [[ -z "$browser_count" || "$browser_count" -lt 1 ]]; then
  echo "$helper_snapshot"
  echo "smoke_overlay_browser_controls: no browser-like Now Playing target found" >&2
  echo "Start a browser or browser-wrapper media session before running this check." >&2
  exit 1
fi

close_overlay() {
  osascript >/dev/null 2>&1 <<'APPLESCRIPT' || true
tell application "System Events"
  if exists process "Keyway" then
    tell process "Keyway" to set frontmost to true
    key code 53
  end if
end tell
APPLESCRIPT
}

restore_visible_apps() {
  while IFS=$'\t' read -r bundle_id was_visible; do
    [[ -n "$bundle_id" ]] || continue
    osascript - "$bundle_id" "$was_visible" >/dev/null 2>&1 <<'APPLESCRIPT' || true
on run argv
  set bundleID to item 1 of argv
  set wasVisible to item 2 of argv
  tell application "System Events"
    repeat with appProcess in application processes
      try
        if bundle identifier of appProcess is bundleID then set visible of appProcess to (wasVisible is "true")
      end try
    end repeat
  end tell
end run
APPLESCRIPT
  done <"$VISIBLE_STATE_FILE"
}

cleanup() {
  close_overlay
  restore_visible_apps
  rm -f "$TARGET_INFO_FILE"
  rm -f "$VISIBLE_STATE_FILE"
}
trap cleanup EXIT

hide_media_windows_for_chooser() {
  : >"$VISIBLE_STATE_FILE"
  while IFS=$'\t' read -r kind bundle_id; do
    [[ "$kind" == "target_bundle" && -n "$bundle_id" ]] || continue
    osascript - "$bundle_id" >>"$VISIBLE_STATE_FILE" <<'APPLESCRIPT'
on run argv
  set bundleID to item 1 of argv
  tell application "System Events"
    repeat with appProcess in application processes
      try
        if bundle identifier of appProcess is bundleID then
          return bundleID & tab & ((visible of appProcess) as text)
        end if
      end try
    end repeat
  end tell
  return ""
end run
APPLESCRIPT
    osascript - "$bundle_id" >/dev/null 2>&1 <<'APPLESCRIPT' || true
on run argv
  set bundleID to item 1 of argv
  tell application "System Events"
    repeat with appProcess in application processes
      try
        if bundle identifier of appProcess is bundleID then set visible of appProcess to false
      end try
    end repeat
  end tell
end run
APPLESCRIPT
  done <"$TARGET_INFO_FILE"
}

open_menu_chooser() {
  osascript <<'APPLESCRIPT'
tell application "System Events"
  tell process "Keyway"
    set frontmost to true
    key code 53
    click menu bar item 1 of menu bar 2
    delay 0.4
    set popoverRef to first UI element of menu bar 2 whose role is "AXPopover"
    set scrollRef to UI element 1 of UI element 1 of popoverRef
    click first button of scrollRef
  end tell
end tell
APPLESCRIPT
}

trigger_overlay() {
  if [[ "$PHYSICAL_MEDIA_KEYS" == "1" ]]; then
    printf '\nPress the physical Play/Pause media key now. Waiting for the Keyway chooser...\n' >/dev/tty
  else
    open_menu_chooser
  fi
}

keyway_window_text() {
  osascript <<'APPLESCRIPT'
tell application "System Events"
  tell process "Keyway"
    set frontmost to true
    if (count of windows) is 0 then return ""
    set textValues to value of every static text of UI element 1 of window 1
    set AppleScript's text item delimiters to linefeed
    return textValues as text
  end tell
end tell
APPLESCRIPT
}

send_overlay_key() {
  local key_code="$1"
  osascript <<APPLESCRIPT
tell application "System Events"
  tell process "Keyway" to set frontmost to true
  key code $key_code
end tell
APPLESCRIPT
}

overlay_button() {
  local action_name="$1"
  local identifier="$2"
  osascript - "$action_name" "$identifier" <<'APPLESCRIPT'
on actByIdentifier(e, wanted, actionName, depth)
  if depth > 8 then return "missing"
  tell application "System Events"
    try
      if role of e is "AXButton" and value of attribute "AXIdentifier" of e is wanted then
        if actionName is "click" then
          perform action "AXPress" of e
          return "clicked"
        end if
        return (enabled of e as text)
      end if
    end try
    try
      repeat with childElement in UI elements of e
        set result to my actByIdentifier(childElement, wanted, actionName, depth + 1)
        if result is not "missing" then return result
      end repeat
    end try
  end tell
  return "missing"
end actByIdentifier

on run argv
  set actionName to item 1 of argv
  set wanted to item 2 of argv
  tell application "System Events"
    tell process "Keyway"
      set frontmost to true
      if (count of windows) is 0 then
        if actionName is "click" then return "missing-window"
        return "missing"
      end if
      set actionResult to my actByIdentifier(UI element 1 of window 1, wanted, actionName, 0)
      if actionResult is "missing" and actionName is "click" then return "missing-button"
      return actionResult
    end tell
  end tell
end run
APPLESCRIPT
}

wait_for_overlay_button_enabled() {
  local identifier="$1"
  local enabled="missing"
  for _ in {1..8}; do
    sleep 0.15
    enabled="$(overlay_button enabled "$identifier")"
    [[ "$enabled" == "true" ]] && break
  done
  printf '%s\n' "$enabled"
}

open "$APP_DIR"
sleep 1.0
close_overlay
expected_header="Media Targets"
if [[ "$PHYSICAL_MEDIA_KEYS" == "1" ]]; then
  hide_media_windows_for_chooser
  open -a Finder
  sleep 0.6
  expected_header="Play/Pause"
else
  : >"$VISIBLE_STATE_FILE"
fi
trace_sequence_before="$(python3 - "$RUNTIME_STATUS_FILE" <<'PY'
import json
import pathlib
import sys

path = pathlib.Path(sys.argv[1])
print((json.loads(path.read_text()).get("mediaTransportTraceSequence") or 0) if path.is_file() else 0)
PY
)"
trigger_overlay

overlay_text=""
for _ in {1..30}; do
  sleep 0.2
  overlay_text="$(keyway_window_text || true)"
  if grep -qx "$expected_header" <<<"$overlay_text"; then
    break
  fi
done

if ! grep -qx "$expected_header" <<<"$overlay_text"; then
  echo "$overlay_text"
  echo "smoke_overlay_browser_controls: media target overlay did not expose $expected_header" >&2
  exit 1
fi

send_overlay_key 48
for _ in {1..20}; do
  sleep 0.2
  overlay_text="$(keyway_window_text || true)"
  if grep -q '^Volume$' <<<"$overlay_text"; then
    break
  fi
done

if ! grep -q '^Volume$' <<<"$overlay_text"; then
  echo "$overlay_text"
  echo "smoke_overlay_browser_controls: expanded controls did not open with Tab" >&2
  exit 1
fi

browser_reduced_state_pattern='^(Select a Chromium extension target|Target not available|Browser not responding|Extension disconnected)$'
browser_mute_enabled="missing"
runtime_target_info="$(python3 - "$RUNTIME_STATUS_FILE" "$APP_DIR" "$BROWSER_TARGET_MATCH" "$trace_sequence_before" <<'PY'
import json
import pathlib
import sys

status_path = pathlib.Path(sys.argv[1])
app_path = sys.argv[2]
target_match = sys.argv[3].casefold()
trace_sequence_before = int(sys.argv[4])
if not status_path.is_file():
    raise SystemExit

status = json.loads(status_path.read_text())
if status.get("appPath") != app_path:
    raise SystemExit

chooser_shows = [
    event
    for event in status.get("mediaTransportTrace") or []
    if event.get("event") == "chooser_show"
    and int(event.get("sequence") or 0) > trace_sequence_before
]
targets = chooser_shows[-1].get("targets") if chooser_shows else status.get("mediaTargets")
targets = targets or []
print(f"target_count\t{len(targets)}")
browser_targets = [
    target
    for target in targets
    if str(target.get("id", "")).startswith("chromium-tab:")
]
if target_match:
    browser_targets = [
        target
        for target in browser_targets
        if target_match in " ".join(
            str(target.get(key, "")) for key in ("app", "title", "artist")
        ).casefold()
    ]
else:
    non_youtube_targets = [
        target
        for target in browser_targets
        if "youtube" not in " ".join(
            str(target.get(key, "")) for key in ("app", "title", "artist")
        ).casefold()
    ]
    browser_targets = non_youtube_targets or browser_targets

if browser_targets:
    print(f"browser_target_id\t{browser_targets[0]['id']}")
PY
)"
runtime_target_count="$(awk -F '\t' '$1 == "target_count" { print $2; exit }' <<<"$runtime_target_info")"
browser_target_id="$(awk -F '\t' '$1 == "browser_target_id" { print $2; exit }' <<<"$runtime_target_info")"
selection_attempts="$target_count"
if [[ "$runtime_target_count" =~ ^[0-9]+$ && "$runtime_target_count" -gt "$selection_attempts" ]]; then
  selection_attempts="$runtime_target_count"
fi

if [[ -n "$BROWSER_TARGET_MATCH" && -z "$browser_target_id" ]]; then
  echo "smoke_overlay_browser_controls: no live Chromium target matched '$BROWSER_TARGET_MATCH'" >&2
  exit 1
fi

if [[ -n "$browser_target_id" ]]; then
  click_result="$(overlay_button click "mediaTargetOverlay.target.$browser_target_id")"
  if [[ "$click_result" != "clicked" ]]; then
    echo "smoke_overlay_browser_controls: browser target row was not selectable ($click_result)" >&2
    exit 1
  fi
  sleep 0.5
else
  for ((step = 0; step < selection_attempts; step += 1)); do
    overlay_text="$(keyway_window_text || true)"
    browser_mute_enabled="$(overlay_button enabled "mediaTargetOverlay.browserMute")"
    if [[ "$browser_mute_enabled" == "true" ]] || grep -Eq "$browser_reduced_state_pattern" <<<"$overlay_text"; then
      break
    fi
    send_overlay_key 125
    sleep 0.5
  done
fi

for _ in {1..10}; do
  overlay_text="$(keyway_window_text || true)"
  browser_mute_enabled="$(overlay_button enabled "mediaTargetOverlay.browserMute")"
  if grep -q '^Browser$' <<<"$overlay_text" \
    && { [[ "$browser_mute_enabled" == "true" ]] || grep -Eq "$browser_reduced_state_pattern" <<<"$overlay_text"; }; then
    break
  fi
  sleep 0.2
done

printf '%s\n' "$overlay_text"

if ! grep -q '^Browser$' <<<"$overlay_text"; then
  echo "smoke_overlay_browser_controls: browser control row is missing" >&2
  exit 1
fi

if [[ -n "$BROWSER_TARGET_MATCH" && "$browser_mute_enabled" != "true" ]]; then
  echo "smoke_overlay_browser_controls: matched Chromium target did not expose live extension controls" >&2
  exit 1
fi

if [[ "$browser_mute_enabled" == "true" ]]; then
  click_result="$(overlay_button click "mediaTargetOverlay.browserMute")"
  if [[ "$click_result" != "clicked" ]]; then
    echo "$overlay_text"
    echo "smoke_overlay_browser_controls: browser mute button was not clickable ($click_result)" >&2
    exit 1
  fi
  browser_mute_enabled="$(wait_for_overlay_button_enabled "mediaTargetOverlay.browserMute")"
  if [[ "$browser_mute_enabled" != "true" ]]; then
    echo "smoke_overlay_browser_controls: browser mute state was not reflected before the confirmation timeout" >&2
    exit 1
  fi

  click_result="$(overlay_button click "mediaTargetOverlay.browserMute")"
  if [[ "$click_result" != "clicked" ]]; then
    echo "smoke_overlay_browser_controls: browser mute restore was not clickable ($click_result)" >&2
    exit 1
  fi
  browser_mute_enabled="$(wait_for_overlay_button_enabled "mediaTargetOverlay.browserMute")"
  if [[ "$browser_mute_enabled" != "true" ]]; then
    echo "smoke_overlay_browser_controls: browser mute restore was not reflected before the confirmation timeout" >&2
    exit 1
  fi

  overlay_text="$(keyway_window_text || true)"
  if ! grep -q '^Browser$' <<<"$overlay_text"; then
    echo "$overlay_text"
    echo "smoke_overlay_browser_controls: overlay disappeared after browser mute toggle" >&2
    exit 1
  fi
elif ! grep -Eq "$browser_reduced_state_pattern" <<<"$overlay_text"; then
  echo "$overlay_text"
  echo "smoke_overlay_browser_controls: no extension-backed browser controls or explicit reduced-capability state found" >&2
  exit 1
fi

echo "smoke_overlay_browser_controls=ok"
