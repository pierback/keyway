#!/usr/bin/env bash
set -euo pipefail

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
helper="$repo_root/SonosHandoffMenuBar/SonosHandoffMenuBar/App/MediaRemoteHelperProcess.swift"
controller="$repo_root/SonosHandoffMenuBar/SonosHandoffMenuBar/App/MediaRemoteController.swift"

fail() {
  printf 'verify_media_remote_helper_process_semantics: %s\n' "$*" >&2
  exit 1
}

python3 - "$helper" <<'PY'
import pathlib
import sys

text = pathlib.Path(sys.argv[1]).read_text()

for required in (
    "private var activeRunID: UUID?",
    "private var outputPipe: Pipe?",
    "private var errorPipe: Pipe?",
    "process?.isRunning == true && inputPipe != nil",
    "process != nil || !stoppedProcesses.isEmpty",
    "self.activeRunID = runID",
    "self.activeRunID == runID || self.ownsStopped(terminatedProcess)",
    "guard let self, self.activeRunID == runID else {",
):
    if required not in text:
        raise SystemExit(f"verify_media_remote_helper_process_semantics: missing helper run-ownership guard: {required}")

start = text.index("        do {")
end = text.index("\n    }\n\n    func stop()", start)
body = text[start:end]
for required in (
    "try process.run()",
    "outputPipe.fileHandleForReading.readabilityHandler = nil",
    "errorPipe.fileHandleForReading.readabilityHandler = nil",
    "activeRunID = nil",
    "self.process = nil",
    "self.inputPipe = nil",
    "self.outputPipe = nil",
    "self.errorPipe = nil",
    "outputBuffer.removeAll()",
    "throw error",
):
    if required not in body:
        raise SystemExit(f"verify_media_remote_helper_process_semantics: start() must clean up failed launches before rethrowing: {required}")

start = text.index("    func stop() {")
end = text.index("\n    @discardableResult", start)
body = text[start:end]
for required in (
    "outputPipe?.fileHandleForReading.readabilityHandler = nil",
    "errorPipe?.fileHandleForReading.readabilityHandler = nil",
    "activeRunID = nil",
    "outputPipe = nil",
    "errorPipe = nil",
):
    if required not in body:
        raise SystemExit(f"verify_media_remote_helper_process_semantics: stop() must clear helper IO ownership: {required}")

start = text.index("    func retire(_ candidate: Process) {")
end = text.index("\n    private func environment()", start)
body = text[start:end]
for required in (
    "outputPipe?.fileHandleForReading.readabilityHandler = nil",
    "errorPipe?.fileHandleForReading.readabilityHandler = nil",
    "activeRunID = nil",
    "outputPipe = nil",
    "errorPipe = nil",
    "outputBuffer.removeAll()",
):
    if required not in body:
        raise SystemExit(f"verify_media_remote_helper_process_semantics: retire() must detach old helper pipes before a restart: {required}")

for required in (
    "func forceTerminateStoppedProcesses()",
    "let result = Darwin.kill(process.processIdentifier, SIGKILL)",
    "result == 0 || errno == ESRCH",
):
    if required not in text:
        raise SystemExit(f"verify_media_remote_helper_process_semantics: stopped helper generations need a bounded shutdown: {required}")

start = text.index("    func send(_ request: [String: Any]) -> Bool {")
end = text.index("\n    func owns(_ candidate: Process) -> Bool {", start)
body = text[start:end]
for required in (
    "guard let inputPipe, process?.isRunning == true else {",
    "try inputPipe.fileHandleForWriting.write(contentsOf: data + Data([0x0A]))",
    "stop()",
):
    if required not in body:
        raise SystemExit(f"verify_media_remote_helper_process_semantics: send() must guard dead helpers and tear down broken pipes: {required}")
PY

python3 - "$controller" <<'PY'
import pathlib
import re
import sys

text = pathlib.Path(sys.argv[1]).read_text()
for required in (
    "private static let pingInterval: TimeInterval = 1",
    "private static let pongFreshnessInterval: TimeInterval = 2.5",
    "static let helperRecoveryGraceInterval: TimeInterval = 5",
    '"type": "ping"',
    '"requestID": requestID',
    "private var pendingPingRolesByRequestID: [String: (role: MediaRemoteHelperRole, sentAt: Date)] = [:]",
    "pendingPingRolesByRequestID[requestID] = (role: role, sentAt: Date())",
    "let pending = pendingPingRolesByRequestID.removeValue(forKey: requestID)",
    "pending.role == role",
    "case \"pong\":",
    "handlePong(pong, role: role)",
    "func probeHelperLiveness() -> Bool",
    "private var supervisorState = MediaRemoteHelperSupervisorState()",
    "private static let terminationDeadlineNanoseconds: UInt64 = 2_000_000_000",
):
    if required not in text:
        raise SystemExit(f"verify_media_remote_helper_process_semantics: missing ping liveness policy: {required}")

if "periodicRecoveryInterval" in text or "Keyway will retry the helper every" in text:
    raise SystemExit("verify_media_remote_helper_process_semantics: 60s periodic helper recovery must not return")

ping_sweep_start = text.index("    private func sendPingSweep()")
ping_sweep_end = text.index("\n    @discardableResult\n    private func ping", ping_sweep_start)
ping_sweep_body = text[ping_sweep_start:ping_sweep_end]
for required in (
    "let now = Date()",
    "pendingPingRolesByRequestID = pendingPingRolesByRequestID.filter {",
    "now.timeIntervalSince($0.value.sentAt) <= Self.pingInterval * 3",
):
    if required not in ping_sweep_body:
        raise SystemExit(f"verify_media_remote_helper_process_semantics: pending pings must be pruned by age before each sweep: {required}")
if ping_sweep_body.index("pendingPingRolesByRequestID = pendingPingRolesByRequestID.filter {") > ping_sweep_body.index("ping(role: .snapshot)"):
    raise SystemExit("verify_media_remote_helper_process_semantics: pending ping pruning must happen before sending the next sweep")

update_start = text.index("    private func updatePingLiveness(now: Date = Date())")
update_end = text.index("\n    private func scheduleHelperRecoveryGrace", update_start)
update_body = text[update_start:update_end]
ping_live_start = update_body.index("        if pingLive {")
ping_live_end = update_body.index("\n        }\n\n        guard helperDegradedSince == nil else", ping_live_start)
ping_live_body = update_body[ping_live_start:ping_live_end]
for required in (
    "if helperDegradedSince != nil {",
    "clearHelperDegraded()",
    "return",
):
    if required not in ping_live_body:
        raise SystemExit(f"verify_media_remote_helper_process_semantics: pong recovery must clear ping-caused degradation: {required}")

schedule = re.search(r'relaunchDelayNanoseconds: \[UInt64\] = \[(.*?)\]', text, re.S)
if not schedule:
    raise SystemExit("verify_media_remote_helper_process_semantics: capped relaunch schedule must be explicit")
delays = [int(value.replace("_", "")) for value in re.findall(r'[0-9][0-9_]+', schedule.group(1))]
if delays != [250_000_000, 500_000_000, 1_000_000_000, 2_000_000_000, 5_000_000_000]:
    raise SystemExit(f"verify_media_remote_helper_process_semantics: unexpected relaunch schedule {delays}")

if text.count("snapshotHelper.stop()") != 1 or text.count("commandHelper.stop()") != 1:
    raise SystemExit("verify_media_remote_helper_process_semantics: every pair shutdown must use the generation barrier")

schedule_start = text.index("    private func scheduleRelaunch() {")
schedule_end = text.index("\n    private func cancelRecoveryTask()", schedule_start)
schedule_body = text[schedule_start:schedule_end]
for required in (
    "min(restartAttempts, Self.relaunchDelayNanoseconds.count - 1)",
    "restartAttempts += 1",
    "Task { @MainActor [weak self] in",
    "self.supervisorState.requestRelaunch()",
    "self.launchPendingHelperPair()",
):
    if required not in schedule_body:
        raise SystemExit(f"verify_media_remote_helper_process_semantics: relaunch scheduler missing {required}")

ready_start = text.index('            case "ready":')
ready_end = text.index('            case "pong":', ready_start)
ready_body = text[ready_start:ready_end]
for required in (
    "helperPairState.markReady(role)",
    "guard snapshotHelper.isRunning, commandHelper.isRunning else {",
    "restartAttempts = 0",
    "cancelRecoveryTask()",
    "clearHelperDegraded()",
    "helperGeneration += 1",
):
    if required not in ready_body:
        raise SystemExit(f"verify_media_remote_helper_process_semantics: both helpers must be ready before startup succeeds: {required}")
if ready_body.index("helperGeneration += 1") > ready_body.index("health = MediaRemoteHelperHealth("):
    raise SystemExit("verify_media_remote_helper_process_semantics: a new generation must be published before running health")

recovery_start = text.index("    private func recoverHelperPair(message: String) {")
recovery_end = text.index("\n    private func markFailed", recovery_start)
recovery_body = text[recovery_start:recovery_end]
for required in (
    "stopHelperPair()",
    "helperPairState.reset()",
    "beginHelperRecovery(message: message)",
    "scheduleRelaunch()",
):
    if required not in recovery_body:
        raise SystemExit(f"verify_media_remote_helper_process_semantics: helper failures must restart the atomic pair: {required}")

if "ignored_unowned_termination" in text:
    raise SystemExit("verify_media_remote_helper_process_semantics: an owned unexpected termination must always schedule recovery")

launch_start = text.index("    private func launchPendingHelperPair() {")
launch_end = text.index("\n    func stop()", launch_start)
launch_body = text[launch_start:launch_end]
for required in (
    "snapshotHelper.hasOwnedProcesses || commandHelper.hasOwnedProcesses",
    "supervisorState.canLaunch(hasOwnedProcesses: hasOwnedProcesses)",
    "supervisorState.didLaunch()",
):
    if required not in launch_body:
        raise SystemExit(f"verify_media_remote_helper_process_semantics: a new pair must wait for full prior-generation retirement: {required}")

timeout_start = text.index("    private func armSnapshotRefreshTimeout(requestID: String) {")
timeout_end = text.index("\n    private func handleTermination", timeout_start)
timeout_body = text[timeout_start:timeout_end]
if 'recoverHelperPair(message: "MediaRemote snapshot helper timed out.")' not in timeout_body:
    raise SystemExit("verify_media_remote_helper_process_semantics: snapshot timeout must invalidate and recover the helper pair")

if "chromiumBrowserExtensionController" in text:
    raise SystemExit("verify_media_remote_helper_process_semantics: MediaRemote command readiness must not borrow Chromium readiness")

failure_probe = pathlib.Path(sys.argv[1]).with_name("MediaTransportActionController.swift").read_text()
if failure_probe.count("self.mediaRemoteController.probeHelperLiveness()") < 2:
    raise SystemExit("verify_media_remote_helper_process_semantics: MediaRemote command failures must trigger an out-of-cycle liveness probe")
for required in (
    "private var canRouteAnyCommands: Bool",
    "mediaRemoteController.isHelperPairReady",
    "chromiumBrowserExtensionController.hasRoutableTargets",
):
    if required not in failure_probe:
        raise SystemExit(f"verify_media_remote_helper_process_semantics: aggregate routing readiness belongs to the routing layer: {required}")

volume_hotkeys = pathlib.Path(sys.argv[1]).with_name("VolumeHotkeyController.swift").read_text()
for required in (
    "Publishers.CombineLatest(",
    "mediaRemoteController.$health",
    "mediaRemoteController.$helperGeneration",
    "private func mediaRemoteHealthChanged(_ health: MediaRemoteHelperHealth, generation: UInt)",
    "guard health.state == .running else {",
    "activeMediaRemoteGeneration = nil",
    "guard activeMediaRemoteGeneration != generation else {",
    "activeMediaRemoteGeneration = generation",
    'stopCommandCenterRoute(reason: "mediaremote_generation_ended")',
    "guard mediaRemoteController.isHelperPairReady else {",
):
    if required not in volume_hotkeys:
        raise SystemExit(f"verify_media_remote_helper_process_semantics: media-key readiness must follow each helper generation: {required}")

interceptor = pathlib.Path(sys.argv[1]).with_name("MediaCommandCenterInterceptor.swift").read_text()
failure_start = interceptor.index("    private func routeShieldFailed(reason: String) {")
failure_end = interceptor.index("\n    private func setReady", failure_start)
failure_body = interceptor[failure_start:failure_end]
for required in (
    "let stopWillNotify = isReady",
    "if !stopWillNotify {",
    "readinessChanged(false)",
):
    if required not in failure_body:
        raise SystemExit(f"verify_media_remote_helper_process_semantics: asynchronous route-shield failure must always reach the input owner: {required}")

status_item = pathlib.Path(sys.argv[1]).with_name("KeywayStatusItemController.swift").read_text()
if "chromiumBrowserExtensionController.hasRoutableTargets" not in status_item:
    raise SystemExit("verify_media_remote_helper_process_semantics: browser-only UI health must read the Chromium adapter directly")

start = text.index("    private func handleLine(_ line: Data, role: MediaRemoteHelperRole) {")
end = text.index("\n    private func drainPendingRefreshIfNeeded()", start)
body = text[start:end]
if 'logger.error("MediaRemoteHelper role=\\(role.rawValue, privacy: .public) parse_error=' not in body:
    raise SystemExit("verify_media_remote_helper_process_semantics: parse errors must log the helper role before restart")
if 'recoverHelperPair(message: "MediaRemote \\(role.rawValue) helper emitted invalid JSON.")' not in body:
    raise SystemExit("verify_media_remote_helper_process_semantics: malformed helper frames must restart both helper sessions")
PY

printf 'verify_media_remote_helper_process_semantics=ok\n'
