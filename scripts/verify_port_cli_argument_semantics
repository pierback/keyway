#!/usr/bin/env bash
set -euo pipefail

ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
PACKAGE_DIR="$ROOT_DIR/packages/SonosHandoffCore"
SOURCE="$PACKAGE_DIR/Sources/SonosHandoffPortCLI/main.swift"
workdir="$(mktemp -d)"
trap 'rm -rf "$workdir"' EXIT

cp "$SOURCE" "$workdir/main.swift"
sed -i '' '/^import SonosHandoffCore$/d' "$workdir/main.swift"
sed -i '' 's/fatalError(/testFailure(/g' "$workdir/main.swift"

cat >"$workdir/Stubs.swift" <<'SWIFT'
import Foundation

func testFailure(_ message: String) -> Never {
    FileHandle.standardError.write(Data("\(message)\n".utf8))
    exit(2)
}

enum SpotifyPlaybackCommand: String {
    case play
    case pause
    case playPause
    case next
    case previous
}

enum HandoffVerification {
    case full
}

enum HandoffResult {
    case success
    case failure(code: Int?, message: String)
}

struct VolumeStatus {
    let volume: Int
    let outputFixed: Bool
    let muted: Bool
}

struct ActivePlaybackStatus {
    let deviceName: String
    let type: String
    let isRestricted: Bool
    let volumePercent: Int?
    let isPlaying: Bool
    let itemName: String?
    let itemURI: String?
}

struct PlaybackDevice {
    let name: String
    let type: String
    let isActive: Bool
    let isRestricted: Bool
}

struct SonosTransportStatus {
    let currentURI: String
    let transportState: String
}

struct SpotifyConnectHandoffService {
    init(loginID: String?) {}

    func transfer(toRoomName: String, verification: HandoffVerification) async -> HandoffResult {
        .failure(code: nil, message: "test stub")
    }

    func volumeUp(roomName: String, step: Int) async throws -> Int { 0 }
    func volumeDown(roomName: String, step: Int) async throws -> Int { 0 }
    func setVolume(roomName: String, volume: Int) async throws -> Int { volume }
    func volumeStatus(roomName: String) async throws -> VolumeStatus {
        VolumeStatus(volume: 0, outputFixed: false, muted: false)
    }
    func toggleMute(roomName: String) async throws -> Bool { false }
    func setMute(roomName: String, muted: Bool) async throws -> Bool { muted }
    func activePlaybackDeviceStatus() async throws -> ActivePlaybackStatus? { nil }
    func availablePlaybackDevices() async throws -> [PlaybackDevice] { [] }
    func startActivePlayback(spotifyURI: String?, deviceName: String?, deviceType: String?) async throws {}
    func sendActivePlaybackCommand(_ command: SpotifyPlaybackCommand) async throws {}
    func sonosTransportStatus(roomName: String) async throws -> SonosTransportStatus {
        SonosTransportStatus(currentURI: "", transportState: "STOPPED")
    }
}
SWIFT

swiftc \
  -module-cache-path "$workdir/module-cache" \
  "$workdir/Stubs.swift" \
  "$workdir/main.swift" \
  -o "$workdir/sonos-handoff-port"
CLI="$workdir/sonos-handoff-port"

python3 - "$SOURCE" "$CLI" <<'PY'
import subprocess
import sys

source_path, cli = sys.argv[1:]
source = open(source_path, encoding="utf-8").read()
service_creation = source.index("let service = SpotifyConnectHandoffService")

for validation in [
    'fatalError("Duplicate option:',
    'fatalError("\\(invalidOption) is not valid for',
    'fatalError("volume-set requires --volume 0...100")',
    'fatalError("\\(command) expects \\(expectedPositionalCount) positional argument(s)',
]:
    if source.index(validation) > service_creation:
        raise SystemExit(f"verify_port_cli_argument_semantics: {validation} must run before service creation")

cases = [
    (["handoff", "Kitchen", "--login-id", "one", "--login-id=two"], "Duplicate option: --login-id"),
    (["playback-status", "--step", "5"], "--step is not valid for playback-status"),
    (["playback-status", "unexpected"], "playback-status expects 0 positional argument(s); got 1"),
    (["volume-up"], "volume-up expects 1 positional argument(s); got 0"),
    (["volume-set", "Kitchen"], "volume-set requires --volume 0...100"),
    (["volume-set", "Kitchen", "--volume", "50", "75"], "volume-set expects 1 positional argument(s); got 2"),
    (["playback-command", "play", "pause"], "playback-command expects 1 positional argument(s); got 2"),
]

for arguments, expected in cases:
    result = subprocess.run([cli, *arguments], capture_output=True, text=True, timeout=5)
    output = result.stdout + result.stderr
    if result.returncode != 2:
        raise SystemExit(
            "verify_port_cli_argument_semantics: "
            f"expected deterministic harness exit 2 for {arguments}, got {result.returncode}"
        )
    if expected not in output:
        raise SystemExit(
            f"verify_port_cli_argument_semantics: expected {expected!r} for {arguments}, got {output!r}"
        )

print("verify_port_cli_argument_semantics=ok")
PY
