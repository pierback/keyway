#!/usr/bin/env bash
set -euo pipefail

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
workdir="$(mktemp -d)"
trap 'rm -rf "$workdir"' EXIT

cat >"$workdir/MediaRemoteTransportCommand.swift" <<'SWIFT'
enum MediaRemoteTransportCommand: String, Equatable {
    case play
    case playPause
    case next
    case previous
    case pause
}
SWIFT

cat >"$workdir/FilterSemantics.swift" <<'SWIFT'
import Foundation

@main
struct FilterSemantics {
    @MainActor
    static func main() {
        var currentDate = Date(timeIntervalSince1970: 1_000)
        let filter = MediaTransportCommandCenterFilter(
            mediaKeyShadowInterval: 0.15,
            commandCenterInputShadowInterval: 0.15,
            programmaticCommandCenterEchoWindow: 0.15,
            programmaticGeneratedMediaKeyCallbackWindow: 0.15,
            physicalMediaKeyReboundWindow: 0.15,
            chooserTargetedMediaKeyEchoWindow: 0.45,
            now: { currentDate }
        )

        expectNil(
            filter.ignoreReasonForCommandCenter(command: .playPause),
            "fresh accessory command-center input must route without an event-tap pair"
        )
        expectNil(
            filter.ignoreReasonForMediaKey(command: .playPause),
            "fresh media-key event must pass through"
        )
        filter.noteCommandCenterInput(command: .playPause)
        expectEqual(
            filter.ignoreReasonForCommandCenter(command: .playPause),
            .commandCenterInputShadow,
            "command-center duplicate callbacks from one press must be ignored"
        )
        expectEqual(
            filter.ignoreReasonForMediaKey(command: .playPause),
            .commandCenterShadow,
            "media-key duplicate after a command-center event must be ignored"
        )

        filter.noteMediaKey(command: .playPause)
        for index in 1 ... 3 {
            expectEqual(
                filter.ignoreReasonForCommandCenter(command: .playPause),
                .mediaKeyShadow,
                "media-key shadow must suppress matching command-center callback \(index)"
            )
        }
        expectNil(
            filter.ignoreReasonForCommandCenter(command: .playPause),
            "fresh accessory input must route after the media-key shadow match budget is exhausted"
        )
        expectNil(
            filter.ignoreReasonForCommandCenter(command: .next),
            "an unrelated accessory command must not be hidden by a media-key shadow"
        )
        currentDate.addTimeInterval(0.4)
        expectNil(
            filter.ignoreReasonForCommandCenter(command: .playPause),
            "fresh accessory input must route after the media-key shadow expires"
        )

        filter.beginProgrammaticDispatch(command: .playPause)
        expectEqual(
            filter.ignoreReasonForCommandCenter(command: .playPause),
            .programmaticEcho,
            "programmatic dispatch must suppress immediate Command Center rebounds even when macOS gives them fresh metadata"
        )
        let overlappingDispatchFilter = MediaTransportCommandCenterFilter(
            mediaKeyShadowInterval: 0.15,
            commandCenterInputShadowInterval: 0.15,
            programmaticCommandCenterEchoWindow: 0.25,
            programmaticGeneratedMediaKeyCallbackWindow: 0.25,
            physicalMediaKeyReboundWindow: 0.15,
            chooserTargetedMediaKeyEchoWindow: 0.75
        )
        overlappingDispatchFilter.beginProgrammaticDispatch(command: .next)
        overlappingDispatchFilter.beginProgrammaticDispatch(command: .previous)
        expectEqual(
            overlappingDispatchFilter.ignoreReasonForCommandCenter(command: .next),
            .programmaticEcho,
            "overlapping dispatches must preserve the first Command Center echo window"
        )
        expectEqual(
            overlappingDispatchFilter.ignoreReasonForCommandCenter(command: .previous),
            .programmaticEcho,
            "overlapping dispatches must preserve the second Command Center echo window"
        )
        let overlappingMediaKeyEchoFilter = MediaTransportCommandCenterFilter(
            mediaKeyShadowInterval: 0.15,
            commandCenterInputShadowInterval: 0.15,
            programmaticCommandCenterEchoWindow: 0.25,
            programmaticGeneratedMediaKeyCallbackWindow: 0.25,
            physicalMediaKeyReboundWindow: 0.15,
            chooserTargetedMediaKeyEchoWindow: 0.75
        )
        overlappingMediaKeyEchoFilter.beginProgrammaticDispatch(command: .next)
        overlappingMediaKeyEchoFilter.beginProgrammaticDispatch(command: .previous)
        expectEqual(
            overlappingMediaKeyEchoFilter.ignoreReasonForMediaKey(
                command: .next,
                metadata: MediaTransportInputMetadata(
                    sourceUnixProcessID: 123,
                    sourceStateID: 0,
                    sourceUserData: 0,
                    targetUnixProcessID: 456,
                    eventTimestamp: 200
                )
            ),
            .programmaticMediaKeyEcho,
            "overlapping dispatches must preserve the first generated media-key echo window"
        )
        expectEqual(
            overlappingMediaKeyEchoFilter.ignoreReasonForMediaKey(
                command: .previous,
                metadata: MediaTransportInputMetadata(
                    sourceUnixProcessID: 123,
                    sourceStateID: 0,
                    sourceUserData: 0,
                    targetUnixProcessID: 456,
                    eventTimestamp: 201
                )
            ),
            .programmaticMediaKeyEcho,
            "overlapping dispatches must preserve the second generated media-key echo window"
        )
        filter.beginProgrammaticDispatch(command: .playPause)
        expectNil(
            filter.ignoreReasonForMediaKey(command: .playPause),
            "programmatic dispatch without media-key metadata must not suppress metadata-less media-key input"
        )
        expectNil(
            filter.ignoreReasonForMediaKey(
                command: .playPause,
                metadata: MediaTransportInputMetadata(
                    sourceUnixProcessID: 0,
                    sourceStateID: 1,
                    sourceUserData: 0,
                    eventTimestamp: 250
                )
            ),
            "programmatic dispatch must not suppress a fresh physical HID media-key press"
        )
        expectEqual(
            filter.ignoreReasonForMediaKey(
                command: .playPause,
                metadata: MediaTransportInputMetadata(
                    sourceUnixProcessID: 123,
                    sourceStateID: 0,
                    sourceUserData: 0,
                    targetUnixProcessID: 456,
                    eventTimestamp: 200
                )
            ),
            .programmaticMediaKeyEcho,
            "programmatic dispatch must suppress generated non-HID media-key echoes"
        )
        filter.beginProgrammaticDispatch(command: .playPause)
        expectNil(
            filter.ignoreReasonForMediaKey(
                command: .playPause,
                metadata: MediaTransportInputMetadata(
                    sourceUnixProcessID: 0,
                    sourceStateID: 1,
                    sourceUserData: 0,
                    targetUnixProcessID: 456,
                    eventTimestamp: 300
                )
            ),
            "programmatic dispatch must not suppress HID-shaped input with a fresh event identity"
        )

        let lateEchoFilter = MediaTransportCommandCenterFilter(
            mediaKeyShadowInterval: 0.15,
            commandCenterInputShadowInterval: 0.15,
            programmaticCommandCenterEchoWindow: 1.25,
            programmaticGeneratedMediaKeyCallbackWindow: 0.25,
            physicalMediaKeyReboundWindow: 0.15,
            chooserTargetedMediaKeyEchoWindow: 0.75,
            now: { currentDate }
        )
        lateEchoFilter.beginProgrammaticDispatch(command: .pause)
        currentDate.addTimeInterval(0.8)
        expectEqual(
            lateEchoFilter.ignoreReasonForCommandCenter(command: .playPause),
            .programmaticEcho,
            "programmatic Command Center echo suppression must cover late macOS rebounds"
        )
        expectNil(
            lateEchoFilter.ignoreReasonForMediaKey(
                command: .playPause,
                metadata: MediaTransportInputMetadata(
                    sourceUnixProcessID: 0,
                    sourceStateID: 1,
                    sourceUserData: 0,
                    targetUnixProcessID: 456,
                    eventTimestamp: 300
                )
            ),
            "programmatic Command Center echo suppression must not swallow a fresh physical media key"
        )
        currentDate.addTimeInterval(0.6)
        expectNil(
            lateEchoFilter.ignoreReasonForCommandCenter(command: .playPause),
            "fresh accessory input must route after programmatic echo suppression expires"
        )
        let delayedOSEchoFilter = MediaTransportCommandCenterFilter(
            mediaKeyShadowInterval: 0.15,
            commandCenterInputShadowInterval: 0.15,
            programmaticCommandCenterEchoWindow: 1.25,
            programmaticGeneratedMediaKeyCallbackWindow: 0.25,
            physicalMediaKeyReboundWindow: 0.15,
            chooserTargetedMediaKeyEchoWindow: 1.25,
            now: { currentDate }
        )
        delayedOSEchoFilter.beginProgrammaticDispatch(command: .pause)
        currentDate.addTimeInterval(0.8)
        expectEqual(
            delayedOSEchoFilter.ignoreReasonForCommandCenter(command: .playPause),
            .programmaticEcho,
            "programmatic dispatch must hide delayed Command Center rebounds"
        )
        let delayedChooserCommandCenterEchoFilter = MediaTransportCommandCenterFilter(
            mediaKeyShadowInterval: 0.15,
            commandCenterInputShadowInterval: 0.15,
            programmaticCommandCenterEchoWindow: 0.25,
            programmaticGeneratedMediaKeyCallbackWindow: 0.25,
            physicalMediaKeyReboundWindow: 0.15,
            chooserTargetedMediaKeyEchoWindow: 1.25,
            now: { currentDate }
        )
        delayedChooserCommandCenterEchoFilter.beginChooserDispatch(command: .pause)
        currentDate.addTimeInterval(0.3)
        expectNil(
            delayedChooserCommandCenterEchoFilter.ignoreReasonForCommandCenter(
                command: .playPause,
                metadata: MediaCommandCenterInputMetadata(eventTimestamp: 901)
            ),
            "chooser dispatch must allow fresh accessory input after the echo boundary"
        )
        delayedOSEchoFilter.beginProgrammaticDispatch(command: .pause)
        currentDate.addTimeInterval(0.1)
        expectEqual(
            delayedOSEchoFilter.ignoreReasonForMediaKey(
                command: .playPause,
                metadata: MediaTransportInputMetadata(
                    sourceUnixProcessID: 123,
                    sourceStateID: 0,
                    sourceUserData: 0,
                    targetUnixProcessID: 456,
                    eventTimestamp: 100_000_000
                )
            ),
            .programmaticMediaKeyEcho,
            "programmatic dispatch must suppress generated media-key echoes without hiding fresh HID input"
        )

        let repeatedCommandCenter = MediaCommandCenterInputMetadata(eventTimestamp: 20)
        let freshCommandCenter = MediaCommandCenterInputMetadata(eventTimestamp: 21)
        filter.beginChooserDispatch(command: .pause)
        expectEqual(
            filter.ignoreReasonForCommandCenter(command: .playPause, metadata: repeatedCommandCenter),
            .programmaticEcho,
            "chooser command-center dispatch must suppress the same Command Center event"
        )
        expectEqual(
            filter.ignoreReasonForCommandCenter(command: .playPause, metadata: freshCommandCenter),
            .programmaticEcho,
            "chooser command-center dispatch must suppress immediate fresh-timestamp Command Center rebounds"
        )
        let delayedGeneratedChooserEchoFilter = MediaTransportCommandCenterFilter(
            mediaKeyShadowInterval: 0.15,
            commandCenterInputShadowInterval: 0.15,
            programmaticCommandCenterEchoWindow: 0.25,
            programmaticGeneratedMediaKeyCallbackWindow: 0.25,
            physicalMediaKeyReboundWindow: 0.15,
            chooserTargetedMediaKeyEchoWindow: 0.75,
            now: { currentDate }
        )
        delayedGeneratedChooserEchoFilter.beginChooserDispatch(command: .pause)
        currentDate.addTimeInterval(0.3)
        expectNil(
            delayedGeneratedChooserEchoFilter.ignoreReasonForMediaKey(
                command: .playPause,
                metadata: MediaTransportInputMetadata(
                    sourceUnixProcessID: 123,
                    sourceStateID: 0,
                    sourceUserData: 0,
                    targetUnixProcessID: 456,
                    eventTimestamp: 1_000_000_000
                )
            ),
            "chooser dispatch must not keep a delayed generated media-key echo window after the instant boundary"
        )
        expectNil(
            delayedGeneratedChooserEchoFilter.ignoreReasonForMediaKey(
                command: .playPause,
                metadata: MediaTransportInputMetadata(
                    sourceUnixProcessID: 0,
                    sourceStateID: 1,
                    sourceUserData: 0,
                    targetUnixProcessID: 456,
                    eventTimestamp: 1_000_000_100
                )
            ),
            "chooser dispatch without source metadata must not suppress delayed targeted HID-shaped input"
        )
        expectNil(
            delayedGeneratedChooserEchoFilter.ignoreReasonForCommandCenter(command: .playPause),
            "chooser dispatch must allow fresh accessory input after the instant boundary"
        )
        let targetedEchoCommandCenterShadowFilter = MediaTransportCommandCenterFilter(
            mediaKeyShadowInterval: 0.15,
            commandCenterInputShadowInterval: 0.15,
            programmaticCommandCenterEchoWindow: 0.25,
            programmaticGeneratedMediaKeyCallbackWindow: 0.25,
            physicalMediaKeyReboundWindow: 0.15,
            chooserTargetedMediaKeyEchoWindow: 0.45,
            now: { currentDate }
        )
        targetedEchoCommandCenterShadowFilter.beginChooserDispatch(
            command: .pause,
            metadata: MediaTransportInputMetadata(
                sourceUnixProcessID: 0,
                sourceStateID: 1,
                sourceUserData: 0,
                eventTimestamp: 100
            ),
            targetUnixProcessID: 456
        )
        currentDate.addTimeInterval(0.3)
        expectEqual(
            targetedEchoCommandCenterShadowFilter.ignoreReasonForMediaKey(
                command: .playPause,
                metadata: MediaTransportInputMetadata(
                    sourceUnixProcessID: 0,
                    sourceStateID: 1,
                    sourceUserData: 0,
                    targetUnixProcessID: 456,
                    eventTimestamp: 100
                )
            ),
            .chooserTargetedMediaKeyEcho,
            "same-event targeted selected-row echoes must remain suppressed by exact selected-row process matching"
        )
        expectEqual(
            targetedEchoCommandCenterShadowFilter.ignoreReasonForCommandCenter(command: .playPause),
            .commandCenterInputShadow,
            "targeted HID-shaped selected-row echoes must shadow the following Command Center callback"
        )

        let originalHID = MediaTransportInputMetadata(
            sourceUnixProcessID: 0,
            sourceStateID: 1,
            sourceUserData: 0,
            eventTimestamp: 100
        )
        let repeatedHID = MediaTransportInputMetadata(
            sourceUnixProcessID: 0,
            sourceStateID: 1,
            sourceUserData: 0,
            eventTimestamp: 100
        )
        let delayedReboundHID = MediaTransportInputMetadata(
            sourceUnixProcessID: 0,
            sourceStateID: 1,
            sourceUserData: 0,
            eventTimestamp: 900_000_100
        )
        let freshHID = MediaTransportInputMetadata(
            sourceUnixProcessID: 0,
            sourceStateID: 1,
            sourceUserData: 0,
            eventTimestamp: 2_000_000_100
        )
        let regeneratedHID = MediaTransportInputMetadata(
            sourceUnixProcessID: 0,
            sourceStateID: 1,
            sourceUserData: 0,
            targetUnixProcessID: 456,
            eventTimestamp: 100
        )
        let lateTargetedHID = MediaTransportInputMetadata(
            sourceUnixProcessID: 0,
            sourceStateID: 1,
            sourceUserData: 0,
            targetUnixProcessID: 456,
            eventTimestamp: 650_000_100
        )
        let applicationTargetedHID = MediaTransportInputMetadata(
            sourceUnixProcessID: 0,
            sourceStateID: 1,
            sourceUserData: 0,
            targetUnixProcessID: 999,
            eventTimestamp: 650_000_200
        )
        let applicationTargetedSameEventHID = MediaTransportInputMetadata(
            sourceUnixProcessID: 0,
            sourceStateID: 1,
            sourceUserData: 0,
            targetUnixProcessID: 999,
            eventTimestamp: 100
        )
        let regeneratedHIDFromDifferentSource = MediaTransportInputMetadata(
            sourceUnixProcessID: 999,
            sourceStateID: 1,
            sourceUserData: 0,
            targetUnixProcessID: 456,
            eventTimestamp: 900_000_100
        )
        filter.beginChooserDispatch(command: .pause, metadata: originalHID, targetUnixProcessID: 456)
        expectEqual(
            filter.ignoreReasonForMediaKey(command: .playPause, metadata: repeatedHID),
            .mediaKeyRebound,
            "chooser dispatch must suppress exact media-key rebound before reopening the chooser"
        )
        expectEqual(
            filter.ignoreReasonForMediaKey(command: .playPause, metadata: regeneratedHID),
            .mediaKeyRebound,
            "chooser dispatch must suppress same-event targeted callbacks before reopening the chooser"
        )
        let differentTargetFilter = MediaTransportCommandCenterFilter(
            mediaKeyShadowInterval: 0.15,
            commandCenterInputShadowInterval: 0.15,
            programmaticCommandCenterEchoWindow: 0.25,
            programmaticGeneratedMediaKeyCallbackWindow: 0.25,
            physicalMediaKeyReboundWindow: 0.15,
            chooserTargetedMediaKeyEchoWindow: 0.45
        )
        differentTargetFilter.beginChooserDispatch(command: .pause, metadata: originalHID, targetUnixProcessID: 789)
        expectNil(
            differentTargetFilter.ignoreReasonForMediaKey(command: .playPause, metadata: lateTargetedHID),
            "chooser dispatch must not suppress a fresh targeted physical key for a different process"
        )
        let commandCenterChooserFilter = MediaTransportCommandCenterFilter(
            mediaKeyShadowInterval: 0.15,
            commandCenterInputShadowInterval: 0.15,
            programmaticCommandCenterEchoWindow: 0.25,
            programmaticGeneratedMediaKeyCallbackWindow: 0.25,
            physicalMediaKeyReboundWindow: 0.15,
            chooserTargetedMediaKeyEchoWindow: 0.45
        )
        commandCenterChooserFilter.beginChooserDispatch(command: .pause)
        expectNil(
            commandCenterChooserFilter.ignoreReasonForMediaKey(command: .playPause, metadata: regeneratedHID),
            "chooser dispatch without source metadata must not suppress HID-shaped targeted callbacks"
        )
        expectNil(
            filter.ignoreReasonForMediaKey(command: .playPause, metadata: regeneratedHIDFromDifferentSource),
            "chooser dispatch must consume one targeted HID-shaped selected-row echo, then route a fresh physical key immediately"
        )
        let delayedTargetedEchoFilter = MediaTransportCommandCenterFilter(
            mediaKeyShadowInterval: 0.15,
            commandCenterInputShadowInterval: 0.15,
            programmaticCommandCenterEchoWindow: 0.25,
            programmaticGeneratedMediaKeyCallbackWindow: 0.25,
            physicalMediaKeyReboundWindow: 0.15,
            chooserTargetedMediaKeyEchoWindow: 1.25
        )
        delayedTargetedEchoFilter.beginChooserDispatch(command: .pause, metadata: originalHID, targetUnixProcessID: 456)
        expectNil(
            delayedTargetedEchoFilter.ignoreReasonForMediaKey(command: .playPause, metadata: lateTargetedHID),
            "chooser dispatch must route fresh delayed HID-shaped targeted callbacks instead of treating them as a cooldown"
        )
        expectNil(
            delayedTargetedEchoFilter.ignoreReasonForMediaKey(command: .playPause, metadata: regeneratedHIDFromDifferentSource),
            "chooser dispatch must route the next targeted HID-shaped physical callback immediately after one selected-row echo is consumed"
        )
        let applicationTargetedEchoFilter = MediaTransportCommandCenterFilter(
            mediaKeyShadowInterval: 0.15,
            commandCenterInputShadowInterval: 0.15,
            programmaticCommandCenterEchoWindow: 0.25,
            programmaticGeneratedMediaKeyCallbackWindow: 0.25,
            physicalMediaKeyReboundWindow: 0.15,
            chooserTargetedMediaKeyEchoWindow: 1.25,
            now: { currentDate }
        )
        applicationTargetedEchoFilter.beginChooserDispatch(
            command: .pause,
            metadata: originalHID,
            targetUnixProcessID: 456,
            applicationUnixProcessID: 999
        )
        expectNil(
            applicationTargetedEchoFilter.ignoreReasonForMediaKey(command: .playPause, metadata: applicationTargetedHID),
            "chooser dispatch must not suppress an immediate fresh press just because macOS targets it at Keyway"
        )
        currentDate.addTimeInterval(0.4)
        expectEqual(
            applicationTargetedEchoFilter.ignoreReasonForMediaKey(command: .playPause, metadata: applicationTargetedSameEventHID),
            .chooserTargetedMediaKeyEcho,
            "chooser dispatch must suppress a delayed same-event selected-row rebound that macOS retargets at Keyway"
        )
        expectNil(
            applicationTargetedEchoFilter.ignoreReasonForMediaKey(command: .playPause, metadata: applicationTargetedHID),
            "Keyway-targeted selected-row rebound suppression must be one-shot"
        )
        expectNil(
            filter.ignoreReasonForMediaKey(command: .playPause, metadata: delayedReboundHID),
            "delayed untargeted HID input must be routeable immediately after the selected row dispatches"
        )
        expectNil(
            filter.ignoreReasonForMediaKey(command: .playPause, metadata: freshHID),
            "fresh HID input after the chooser rebound window must be routeable"
        )

        let mediaKeySequenceFilter = MediaTransportCommandCenterFilter(
            mediaKeyDownResetInterval: 0.45,
            mediaKeyShadowInterval: 0.15,
            commandCenterInputShadowInterval: 0.15,
            programmaticCommandCenterEchoWindow: 0.25,
            programmaticGeneratedMediaKeyCallbackWindow: 0.25,
            physicalMediaKeyReboundWindow: 0.15,
            chooserTargetedMediaKeyEchoWindow: 0.45,
            now: { currentDate }
        )
        let firstPress = MediaTransportInputMetadata(
            sourceUnixProcessID: 0,
            sourceStateID: 1,
            sourceUserData: 0,
            eventTimestamp: 10
        )
        expectNil(
            mediaKeySequenceFilter.ignoreReasonForMediaKeyDown(command: .playPause, metadata: firstPress),
            "the first physical key-down in a sequence must route"
        )
        expectEqual(
            mediaKeySequenceFilter.ignoreReasonForMediaKeyDown(command: .pause, metadata: firstPress),
            .duplicateMediaKey,
            "the policy must suppress duplicate callbacks across the play/pause command family"
        )
        mediaKeySequenceFilter.noteMediaKeyUp(command: .playPause)
        let betterTouchToolSessionCopy = MediaTransportInputMetadata(
            sourceUnixProcessID: 7_6671,
            sourceStateID: 0,
            sourceUserData: 0,
            targetUnixProcessID: 0,
            eventTimestamp: 1_000_000
        )
        expectNil(
            mediaKeySequenceFilter.ignoreReasonForMediaKeyDown(
                command: .playPause,
                metadata: betterTouchToolSessionCopy
            ),
            "the first downstream automation callback must route"
        )
        mediaKeySequenceFilter.noteMediaKeyUp(command: .playPause)
        expectEqual(
            mediaKeySequenceFilter.ignoreReasonForMediaKeyDown(
                command: .pause,
                metadata: MediaTransportInputMetadata(
                    sourceUnixProcessID: 7_6671,
                    sourceStateID: 0,
                    sourceUserData: 0,
                    targetUnixProcessID: 456,
                    eventTimestamp: 1_000_000
                )
            ),
            .duplicateMediaKey,
            "the same automation event observed at HID and session taps must route only once, even after key-up"
        )
        mediaKeySequenceFilter.noteMediaKeyUp(command: .pause)
        expectNil(
            mediaKeySequenceFilter.ignoreReasonForMediaKeyDown(
                command: .playPause,
                metadata: MediaTransportInputMetadata(
                    sourceUnixProcessID: 0,
                    sourceStateID: 1,
                    sourceUserData: 0,
                    eventTimestamp: 2_000_010
                )
            ),
            "a new event identity after key-up must route immediately"
        )
        currentDate.addTimeInterval(0.46)
        expectNil(
            mediaKeySequenceFilter.ignoreReasonForMediaKeyDown(
                command: .playPause,
                metadata: MediaTransportInputMetadata(
                    sourceUnixProcessID: 0,
                    sourceStateID: 1,
                    sourceUserData: 0,
                    eventTimestamp: 4_000_020
                )
            ),
            "a missing key-up must not leave the policy stuck after its deterministic reset interval"
        )

        print("verify_playback_filter_semantics=ok")
    }

    private static func expectEqual(
        _ actual: MediaTransportCommandCenterFilter.IgnoreReason?,
        _ expected: MediaTransportCommandCenterFilter.IgnoreReason,
        _ message: String
    ) {
        guard actual == expected else {
            fail("\(message): expected \(expected.rawValue), got \(actual?.rawValue ?? "nil")")
        }
    }

    private static func expectNil(
        _ actual: MediaTransportCommandCenterFilter.IgnoreReason?,
        _ message: String
    ) {
        guard actual == nil else {
            fail("\(message): got \(actual?.rawValue ?? "nil")")
        }
    }

    private static func fail(_ message: String) -> Never {
        FileHandle.standardError.write(Data("verify_playback_filter_semantics: \(message)\n".utf8))
        exit(1)
    }
}
SWIFT

swiftc \
  -module-cache-path "$workdir/module-cache" \
  "$workdir/MediaRemoteTransportCommand.swift" \
  "$repo_root/SonosHandoffMenuBar/SonosHandoffMenuBar/App/MediaTransportRouteSource.swift" \
  "$repo_root/SonosHandoffMenuBar/SonosHandoffMenuBar/App/MediaTransportCommandCenterFilter.swift" \
  "$workdir/FilterSemantics.swift" \
  -o "$workdir/verify_playback_filter_semantics"

"$workdir/verify_playback_filter_semantics"
