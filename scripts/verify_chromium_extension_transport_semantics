#!/usr/bin/env bash
set -euo pipefail

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
workdir="$(mktemp -d)"
trap 'rm -rf "$workdir"' EXIT

cp \
  "$repo_root/SonosHandoffMenuBar/SonosHandoffMenuBar/App/ChromiumBrowserExtensionTransport.swift" \
  "$workdir/ChromiumBrowserExtensionTransport.swift"

cat >"$workdir/Stubs.swift" <<'SWIFT'
import Foundation

enum AppIdentity {
    static let loggerSubsystem = "com.fpieringer.Keyway.tests"
}

enum MediaRemoteTransportCommand: String, Equatable {
    case play
    case pause
    case playPause
    case next
    case previous

    var displayName: String {
        switch self {
        case .play:
            return "Play"
        case .pause:
            return "Pause"
        case .playPause:
            return "Play/Pause"
        case .next:
            return "Next"
        case .previous:
            return "Previous"
        }
    }
}

struct MediaRemoteTarget: Equatable, Identifiable {
    let id: String
    let bundleIdentifier: String
    let parentBundleIdentifier: String
    let displayName: String
    let pid: Int
    let title: String
    let artist: String
    let album: String
    let playbackRate: String
    let mediaType: String?
    let artworkBase64: String?
    let duration: Double?
    let elapsedTime: Double?
    let elapsedTimestamp: Double?
    let supportedCommands: [MediaRemoteTransportCommand]?
    let browserFamily: String?
    let browserDisplayName: String?
    let browserBundleIdentifier: String?

    var isChromiumBrowserLike: Bool {
        let identities = [bundleIdentifier, parentBundleIdentifier, displayName].map { $0.lowercased() }
        return identities.contains { identity in
            identity.contains("chrome")
                || identity.contains("chromium")
                || identity.contains("brave")
                || identity.contains("edge")
                || identity.contains("arc")
                || identity.contains("helium")
                || identity.contains("opera")
                || identity.contains("vivaldi")
        }
    }
}

struct MediaRemoteCommandResultEvent: Decodable {
    let type: String
    let requestID: String?
    let targetID: String
    let command: String
    let ok: Bool
    let message: String
    let backend: String?
    var unsupported: Bool = false
}

enum SourceFocusFailureReason: String, Codable {
    case missingApplication = "missing_application"
    case applicationActivationRejected = "application_activation_rejected"
    case chromiumExtensionDisconnected = "chromium_extension_disconnected"
    case chromiumExtensionProtocolMismatch = "chromium_extension_protocol_mismatch"
    case chromiumExtensionTimedOut = "chromium_extension_timed_out"
    case browserActivationFailed = "browser_activation_failed"
    case browserTargetUnavailable = "browser_target_unavailable"
}

struct SourceFocusResult: Codable, Equatable {
    let type: String
    let requestID: String?
    let targetID: String
    let ok: Bool
    let message: String
    let backend: String?
    let failureReason: SourceFocusFailureReason?

    init(
        type: String = "focusResult",
        requestID: String?,
        targetID: String,
        ok: Bool,
        message: String,
        backend: String?,
        failureReason: SourceFocusFailureReason? = nil
    ) {
        self.type = type
        self.requestID = requestID
        self.targetID = targetID
        self.ok = ok
        self.message = message
        self.backend = backend
        self.failureReason = failureReason
    }
}
SWIFT

cat >"$workdir/Semantics.swift" <<'SWIFT'
import Foundation

@main
struct Semantics {
    @MainActor
    static func main() {
        let target = chromiumTarget(
            id: "chromium-extension:chrome:chromium-extension:runtime:22",
            title: "Video A"
        )
        let second = chromiumTarget(
            id: "chromium-extension:chrome:chromium-extension:runtime:23",
            title: "Video B"
        )
        let unsupportedTrackTarget = chromiumTarget(
            id: "chromium-extension:chrome:chromium-extension:runtime:24",
            title: "Video C",
            supportedCommands: [.play, .pause, .playPause]
        )

        expectTrue(
            ChromiumBrowserExtensionTransport.isTarget(target),
            "Chromium extension targets must be recognized by exact target identity"
        )
        expectEqual(
            ChromiumBrowserExtensionTransport.targetDisplayName(browser: "Chromium", pageTitle: "Video A"),
            "Chromium - Video A",
            "Chromium targets must visibly include browser and tab title"
        )
        expectEqual(
            ChromiumBrowserExtensionTransport.protocolVersion,
            2,
            "Chromium extension transport must use protocol v2"
        )
        expectEqual(
            ChromiumBrowserExtensionTransport.extensionID,
            "gmdpkggbaohimgacbclndlfjghgcbael",
            "Chromium native host manifests must use the stable extension ID"
        )
        expectEqual(
            ChromiumBrowserExtensionTransport.focusResultNotificationName.rawValue,
            "com.fpieringer.keyway.chromium.focusResult",
            "Chromium focus results must use a separate notification channel from media command results"
        )
        expectEqual(
            ChromiumBrowserExtensionTransport.browserFamily(target: target),
            "chromium",
            "Chromium extension targets must expose the browser family from typed metadata"
        )
        expectEqual(
            ChromiumBrowserExtensionTransport.targetDisplayName(browser: "Chromium", pageTitle: ""),
            "Chromium",
            "Chromium targets without a tab title must keep the browser label"
        )
        expectTrue(
            ChromiumBrowserExtensionTransport.supports(command: .playPause, target: target),
            "Chromium extension targets must support Play/Pause"
        )
        expectTrue(
            ChromiumBrowserExtensionTransport.supports(command: .next, target: target),
            "Chromium extension targets must support Next when the page advertises it"
        )
        expectTrue(
            ChromiumBrowserExtensionTransport.supports(command: .previous, target: target),
            "Chromium extension targets must support Previous when the page advertises it"
        )
        expectFalse(
            ChromiumBrowserExtensionTransport.supports(command: .next, target: unsupportedTrackTarget),
            "Chromium extension targets must not support Next when the page does not advertise it"
        )
        expectFalse(
            ChromiumBrowserExtensionTransport.supports(command: .previous, target: unsupportedTrackTarget),
            "Chromium extension targets must not support Previous when the page does not advertise it"
        )

        let unsupported = ChromiumBrowserExtensionTransport.unsupportedResult(command: .next, target: unsupportedTrackTarget)
        expectFalse(unsupported.ok, "Unsupported commands must not report success")
        expectTrue(unsupported.unsupported, "Unsupported commands must be marked unsupported")
        expectEqual(unsupported.backend, ChromiumBrowserExtensionTransport.backendName, "Unsupported result must name the Chromium backend")

        let controller = ChromiumBrowserExtensionController()
        controller.markConnected(targets: [target, second])
        let chromiumLegacy = legacyTarget(
            bundleIdentifier: "org.chromium.Chromium",
            displayName: "Chromium"
        )
        let heliumLegacy = legacyTarget(
            bundleIdentifier: "net.imput.helium",
            displayName: "Helium",
            title: "Unrelated Helium Video"
        )
        let duplicateHeliumLegacy = legacyTarget(
            bundleIdentifier: "net.imput.helium",
            displayName: "Helium",
            title: "Video A"
        )
        let merged = controller.targetsIncludingBrowserExtensionTargets([target, chromiumLegacy, heliumLegacy, duplicateHeliumLegacy])
        expectEqual(
            merged.map(\.id),
            [target.id, heliumLegacy.id, second.id],
            "Merging browser extension targets must hide same-family and same-media legacy rows while preserving unrelated browser fallbacks"
        )
        expectEqual(
            ChromiumBrowserExtensionTransport.legacyBrowserFamily(target: heliumLegacy),
            "helium",
            "Legacy Chromium browser family detection must identify Helium rows"
        )

        var unsupportedCallbackResult: MediaRemoteCommandResultEvent?
        let unsupportedHandled = controller.submit(command: .next, target: unsupportedTrackTarget) { result in
            unsupportedCallbackResult = result
        }
        expectEqual(unsupportedHandled, true, "Unsupported Chromium commands must be handled by the Chromium backend")
        expectEqual(unsupportedCallbackResult?.unsupported, true, "Unsupported Chromium commands must report through the command-result callback")
        expectEqual(unsupportedCallbackResult?.ok, false, "Unsupported Chromium commands must not report callback success")

        expectEqual(ChromiumBrowserAudioCommand.mute.rawValue, "mute", "Chromium mute must use the extension mute command")
        expectEqual(ChromiumBrowserAudioCommand.mute.volumeDelta, nil, "Chromium mute must not send a volume delta")
        expectEqual(ChromiumBrowserAudioCommand.volumeDelta(0.05).rawValue, "volumeDelta", "Chromium volume must use the extension volumeDelta command")
        expectEqual(ChromiumBrowserAudioCommand.volumeDelta(0.05).volumeDelta, 0.05, "Chromium volume must preserve the requested delta")

        let disconnectedController = ChromiumBrowserExtensionController()
        var disconnectedAudioResult: MediaRemoteCommandResultEvent?
        let disconnectedAudioHandled = disconnectedController.submit(audioCommand: .mute, target: target) { result in
            disconnectedAudioResult = result
        }
        expectEqual(disconnectedAudioHandled, true, "Disconnected Chromium audio commands must be handled by the Chromium backend")
        expectEqual(disconnectedAudioResult?.ok, false, "Disconnected Chromium audio commands must not report success")
        expectEqual(disconnectedAudioResult?.command, "mute", "Disconnected Chromium audio commands must preserve the command name")

        let connectedAudioHandled = controller.submit(audioCommand: .volumeDelta(0.05), target: target) { _ in }
        expectEqual(connectedAudioHandled, true, "Connected Chromium audio commands must route through the Chromium backend")

        var disconnectedFocusResult: SourceFocusResult?
        let disconnectedFocusHandled = disconnectedController.focus(target: target) { result in
            disconnectedFocusResult = result
        }
        expectEqual(disconnectedFocusHandled, true, "Disconnected Chromium focus must be handled by the Chromium backend")
        expectEqual(disconnectedFocusResult?.ok, false, "Disconnected Chromium focus must not report success")
        expectEqual(disconnectedFocusResult?.backend, ChromiumBrowserExtensionTransport.backendName, "Disconnected Chromium focus must name the Chromium backend")
        expectEqual(disconnectedFocusResult?.failureReason, .chromiumExtensionDisconnected, "Disconnected Chromium focus must report a focus-specific failure reason")

        let connectedFocusHandled = controller.focus(target: second) { _ in }
        expectEqual(connectedFocusHandled, true, "Connected Chromium focus must route through the Chromium backend")

        print("verify_chromium_extension_transport_semantics=ok")
    }

    private static func chromiumTarget(
        id: String,
        title: String,
        supportedCommands: [MediaRemoteTransportCommand]? = [.play, .pause, .playPause, .next, .previous]
    ) -> MediaRemoteTarget {
        MediaRemoteTarget(
            id: id,
            bundleIdentifier: ChromiumBrowserExtensionTransport.nativeMessagingHostName,
            parentBundleIdentifier: "",
            displayName: ChromiumBrowserExtensionTransport.targetDisplayName(
                browser: "Chromium",
                pageTitle: title
            ),
            pid: 0,
            title: title,
            artist: "",
            album: "",
            playbackRate: "1",
            mediaType: ChromiumBrowserExtensionTransport.mediaType,
            artworkBase64: nil,
            duration: 100,
            elapsedTime: 10,
            elapsedTimestamp: 0,
            supportedCommands: supportedCommands,
            browserFamily: "chromium",
            browserDisplayName: "Chromium",
            browserBundleIdentifier: "org.chromium.Chromium"
        )
    }

    private static func legacyTarget(
        bundleIdentifier: String,
        displayName: String,
        title: String = "Browser media"
    ) -> MediaRemoteTarget {
        MediaRemoteTarget(
            id: "\(bundleIdentifier):\(title):legacy",
            bundleIdentifier: bundleIdentifier,
            parentBundleIdentifier: "",
            displayName: displayName,
            pid: 123,
            title: title,
            artist: "",
            album: "",
            playbackRate: "1",
            mediaType: nil,
            artworkBase64: nil,
            duration: nil,
            elapsedTime: nil,
            elapsedTimestamp: nil,
            supportedCommands: nil,
            browserFamily: nil,
            browserDisplayName: nil,
            browserBundleIdentifier: nil
        )
    }

    private static func expectTrue(_ actual: Bool, _ message: String) {
        guard actual else {
            fail(message)
        }
    }

    private static func expectFalse(_ actual: Bool, _ message: String) {
        guard !actual else {
            fail(message)
        }
    }

    private static func expectEqual<T: Equatable>(_ actual: T, _ expected: T, _ message: String) {
        guard actual == expected else {
            fail("\(message): expected \(expected), got \(actual)")
        }
    }

    private static func fail(_ message: String) -> Never {
        FileHandle.standardError.write(Data("verify_chromium_extension_transport_semantics: \(message)\n".utf8))
        exit(1)
    }
}
SWIFT

swiftc \
  "$workdir/Stubs.swift" \
  "$workdir/ChromiumBrowserExtensionTransport.swift" \
  "$workdir/Semantics.swift" \
  -o "$workdir/verify_chromium_extension_transport_semantics"

"$workdir/verify_chromium_extension_transport_semantics"
