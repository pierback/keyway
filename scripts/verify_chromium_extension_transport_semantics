#!/usr/bin/env bash
set -euo pipefail

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
workdir="$(mktemp -d)"
trap 'rm -rf "$workdir"' EXIT

cp \
  "$repo_root/SonosHandoffMenuBar/SonosHandoffMenuBar/App/ChromiumBrowserExtensionTransport.swift" \
  "$workdir/ChromiumBrowserExtensionTransport.swift"

perl -0pi -e 's/private var pendingCommands:/var pendingCommands:/g; s/private var commandResultTimeouts:/var commandResultTimeouts:/g; s/private var pendingFocusRequests:/var pendingFocusRequests:/g; s/private var focusResultTimeouts:/var focusResultTimeouts:/g; s/private func handleSnapshotPayload/func handleSnapshotPayload/g; s/private func handleCommandResultPayload/func handleCommandResultPayload/g; s/private func handleFocusResultPayload/func handleFocusResultPayload/g; s/private struct ChromiumBrowserExtensionPendingCommand/struct ChromiumBrowserExtensionPendingCommand/g; s/private struct ChromiumBrowserExtensionPendingFocus/struct ChromiumBrowserExtensionPendingFocus/g' \
  "$workdir/ChromiumBrowserExtensionTransport.swift"

cat >"$workdir/Stubs.swift" <<'SWIFT'
import Foundation

enum AppIdentity {
    static let loggerSubsystem = "com.fpieringer.Keyway.tests"
}

enum MediaRemoteTransportCommand: String, Equatable {
    case play
    case pause
    case playPause
    case next
    case previous

    var displayName: String {
        switch self {
        case .play:
            return "Play"
        case .pause:
            return "Pause"
        case .playPause:
            return "Play/Pause"
        case .next:
            return "Next"
        case .previous:
            return "Previous"
        }
    }
}

struct MediaRemoteTarget: Equatable, Identifiable {
    let id: String
    let bundleIdentifier: String
    let parentBundleIdentifier: String
    let displayName: String
    let pid: Int
    let title: String
    let artist: String
    let album: String
    let playbackRate: String
    let mediaType: String?
    let artworkBase64: String?
    let duration: Double?
    let elapsedTime: Double?
    let elapsedTimestamp: Double?
    let supportedCommands: [MediaRemoteTransportCommand]?
    let browserFamily: String?
    let browserDisplayName: String?
    let browserBundleIdentifier: String?
    let browserInstanceID: String?

    var isChromiumBrowserLike: Bool {
        let identities = [bundleIdentifier, parentBundleIdentifier, displayName].map { $0.lowercased() }
        return identities.contains { identity in
            identity.contains("chrome")
                || identity.contains("chromium")
                || identity.contains("brave")
                || identity.contains("edge")
                || identity.contains("arc")
                || identity.contains("helium")
                || identity.contains("opera")
                || identity.contains("vivaldi")
        }
    }
}

struct MediaRemoteCommandResultEvent: Decodable {
    let type: String
    let requestID: String?
    let targetID: String
    let command: String
    let ok: Bool
    let message: String
    let backend: String?
    var unsupported: Bool = false
}

enum SourceFocusFailureReason: String, Codable {
    case missingApplication = "missing_application"
    case applicationActivationRejected = "application_activation_rejected"
    case chromiumExtensionDisconnected = "chromium_extension_disconnected"
    case chromiumExtensionProtocolMismatch = "chromium_extension_protocol_mismatch"
    case chromiumExtensionTimedOut = "chromium_extension_timed_out"
    case browserActivationFailed = "browser_activation_failed"
    case browserTargetUnavailable = "browser_target_unavailable"
}

struct SourceFocusResult: Codable, Equatable {
    let type: String
    let requestID: String?
    let targetID: String
    let ok: Bool
    let message: String
    let backend: String?
    let failureReason: SourceFocusFailureReason?

    init(
        type: String = "focusResult",
        requestID: String?,
        targetID: String,
        ok: Bool,
        message: String,
        backend: String?,
        failureReason: SourceFocusFailureReason? = nil
    ) {
        self.type = type
        self.requestID = requestID
        self.targetID = targetID
        self.ok = ok
        self.message = message
        self.backend = backend
        self.failureReason = failureReason
    }
}
SWIFT

cat >"$workdir/Semantics.swift" <<'SWIFT'
import Foundation

@main
struct Semantics {
    @MainActor
    static func main() {
        let target = chromiumTarget(
            id: "chromium-extension:chrome:chromium-extension:runtime:22",
            title: "Video A"
        )
        let second = chromiumTarget(
            id: "chromium-extension:chrome:chromium-extension:runtime:23",
            title: "Video B"
        )
        let unsupportedTrackTarget = chromiumTarget(
            id: "chromium-extension:chrome:chromium-extension:runtime:24",
            title: "Video C",
            supportedCommands: [.play, .pause, .playPause]
        )

        expectTrue(
            ChromiumBrowserExtensionTransport.isTarget(target),
            "Chromium extension targets must be recognized by exact target identity"
        )
        expectEqual(
            ChromiumBrowserExtensionTransport.targetDisplayName(browser: "Chromium", pageTitle: "Video A"),
            "Chromium - Video A",
            "Chromium targets must visibly include browser and tab title"
        )
        expectEqual(
            ChromiumBrowserExtensionTransport.protocolVersion,
            2,
            "Chromium extension transport must use protocol v2"
        )
        expectEqual(
            ChromiumBrowserExtensionTransport.extensionID,
            "gmdpkggbaohimgacbclndlfjghgcbael",
            "Chromium native host manifests must use the stable extension ID"
        )
        expectEqual(
            ChromiumBrowserExtensionTransport.focusResultNotificationName.rawValue,
            "com.fpieringer.keyway.chromium.focusResult",
            "Chromium focus results must use a separate notification channel from media command results"
        )
        expectEqual(
            ChromiumBrowserExtensionTransport.browserFamily(target: target),
            "chromium",
            "Chromium extension targets must expose the browser family from typed metadata"
        )
        expectEqual(
            target.browserInstanceID,
            "chromium-profile-a",
            "Chromium extension targets must preserve the browser host instance identity"
        )
        expectEqual(
            ChromiumBrowserExtensionTransport.targetDisplayName(browser: "Chromium", pageTitle: ""),
            "Chromium",
            "Chromium targets without a tab title must keep the browser label"
        )
        expectTrue(
            ChromiumBrowserExtensionTransport.supports(command: .playPause, target: target),
            "Chromium extension targets must support Play/Pause"
        )
        expectTrue(
            ChromiumBrowserExtensionTransport.supports(command: .next, target: target),
            "Chromium extension targets must support Next when the page advertises it"
        )
        expectTrue(
            ChromiumBrowserExtensionTransport.supports(command: .previous, target: target),
            "Chromium extension targets must support Previous when the page advertises it"
        )
        expectFalse(
            ChromiumBrowserExtensionTransport.supports(command: .next, target: unsupportedTrackTarget),
            "Chromium extension targets must not support Next when the page does not advertise it"
        )
        expectFalse(
            ChromiumBrowserExtensionTransport.supports(command: .previous, target: unsupportedTrackTarget),
            "Chromium extension targets must not support Previous when the page does not advertise it"
        )

        let unsupported = ChromiumBrowserExtensionTransport.unsupportedResult(command: .next, target: unsupportedTrackTarget)
        expectFalse(unsupported.ok, "Unsupported commands must not report success")
        expectTrue(unsupported.unsupported, "Unsupported commands must be marked unsupported")
        expectEqual(unsupported.backend, ChromiumBrowserExtensionTransport.backendName, "Unsupported result must name the Chromium backend")

        let controller = ChromiumBrowserExtensionController()
        controller.markConnected(targets: [target, second])
        let chromiumLegacy = legacyTarget(
            bundleIdentifier: "org.chromium.Chromium",
            displayName: "Chromium"
        )
        let heliumLegacy = legacyTarget(
            bundleIdentifier: "net.imput.helium",
            displayName: "Helium",
            title: "Unrelated Helium Video"
        )
        let duplicateHeliumLegacy = legacyTarget(
            bundleIdentifier: "net.imput.helium",
            displayName: "Helium",
            title: "Video A"
        )
        let merged = controller.targetsIncludingBrowserExtensionTargets([target, chromiumLegacy, heliumLegacy, duplicateHeliumLegacy])
        expectEqual(
            merged.map(\.id),
            [target.id, heliumLegacy.id, duplicateHeliumLegacy.id, second.id],
            "Merging browser extension targets must hide same-family legacy rows while preserving different-browser targets even when titles match"
        )
        let braveTarget = chromiumTarget(
            id: "chromium-extension:brave:chromium-extension:runtime:44",
            title: "Brave Video",
            browserFamily: "brave",
            browserDisplayName: "Brave",
            browserBundleIdentifier: "com.brave.Browser",
            browserInstanceID: "brave-profile-b"
        )
        let multiBrowserController = ChromiumBrowserExtensionController()
        multiBrowserController.markConnected(
            browserInstanceID: "chromium-profile-a",
            targets: [target, second]
        )
        multiBrowserController.markConnected(
            browserInstanceID: "brave-profile-b",
            targets: [braveTarget]
        )
        expectEqual(
            multiBrowserController.targets.map(\.id),
            [braveTarget.id, target.id, second.id],
            "Chromium extension snapshots must merge targets across browser instances instead of replacing the previous browser snapshot"
        )
        multiBrowserController.markConnected(
            browserInstanceID: "chromium-profile-a",
            targets: []
        )
        expectEqual(
            multiBrowserController.targets.map(\.id),
            [braveTarget.id],
            "An empty snapshot must clear only the browser instance that reported it"
        )
        let staleSourceController = ChromiumBrowserExtensionController()
        staleSourceController.markConnected(
            browserInstanceID: "stale-browser",
            targets: [target],
            now: Date(timeIntervalSinceNow: -5)
        )
        staleSourceController.markConnected(
            browserInstanceID: "live-browser",
            targets: [braveTarget]
        )
        expectEqual(
            staleSourceController.targets.map(\.id),
            [braveTarget.id],
            "Stale Chromium browser snapshots must expire independently when another browser stays connected"
        )
        expectEqual(
            ChromiumBrowserExtensionTransport.legacyBrowserFamily(target: heliumLegacy),
            "helium",
            "Legacy Chromium browser family detection must identify Helium rows"
        )

        var unsupportedCallbackResult: MediaRemoteCommandResultEvent?
        let unsupportedHandled = controller.submit(command: .next, target: unsupportedTrackTarget) { result in
            unsupportedCallbackResult = result
        }
        expectEqual(unsupportedHandled, true, "Unsupported Chromium commands must be handled by the Chromium backend")
        expectEqual(unsupportedCallbackResult?.unsupported, true, "Unsupported Chromium commands must report through the command-result callback")
        expectEqual(unsupportedCallbackResult?.ok, false, "Unsupported Chromium commands must not report callback success")

        expectEqual(ChromiumBrowserAudioCommand.mute.rawValue, "mute", "Chromium mute must use the extension mute command")
        expectEqual(ChromiumBrowserAudioCommand.mute.volumeDelta, nil, "Chromium mute must not send a volume delta")
        expectEqual(ChromiumBrowserAudioCommand.volumeDelta(0.05).rawValue, "volumeDelta", "Chromium volume must use the extension volumeDelta command")
        expectEqual(ChromiumBrowserAudioCommand.volumeDelta(0.05).volumeDelta, 0.05, "Chromium volume must preserve the requested delta")

        let disconnectedController = ChromiumBrowserExtensionController()
        var disconnectedAudioResult: MediaRemoteCommandResultEvent?
        let disconnectedAudioHandled = disconnectedController.submit(audioCommand: .mute, target: target) { result in
            disconnectedAudioResult = result
        }
        expectEqual(disconnectedAudioHandled, true, "Disconnected Chromium audio commands must be handled by the Chromium backend")
        expectEqual(disconnectedAudioResult?.ok, false, "Disconnected Chromium audio commands must not report success")
        expectEqual(disconnectedAudioResult?.command, "mute", "Disconnected Chromium audio commands must preserve the command name")

        let connectedAudioHandled = controller.submit(audioCommand: .volumeDelta(0.05), target: target) { _ in }
        expectEqual(connectedAudioHandled, true, "Connected Chromium audio commands must route through the Chromium backend")

        var disconnectedFocusResult: SourceFocusResult?
        let disconnectedFocusHandled = disconnectedController.focus(target: target) { result in
            disconnectedFocusResult = result
        }
        expectEqual(disconnectedFocusHandled, true, "Disconnected Chromium focus must be handled by the Chromium backend")
        expectEqual(disconnectedFocusResult?.ok, false, "Disconnected Chromium focus must not report success")
        expectEqual(disconnectedFocusResult?.backend, ChromiumBrowserExtensionTransport.backendName, "Disconnected Chromium focus must name the Chromium backend")
        expectEqual(disconnectedFocusResult?.failureReason, .chromiumExtensionDisconnected, "Disconnected Chromium focus must report a focus-specific failure reason")

        let connectedFocusHandled = controller.focus(target: second) { _ in }
        expectEqual(connectedFocusHandled, true, "Connected Chromium focus must route through the Chromium backend")

        let snapshotTrustBoundaryController = ChromiumBrowserExtensionController()
        snapshotTrustBoundaryController.markConnected(
            browserInstanceID: "chromium-profile-a",
            targets: [target]
        )
        snapshotTrustBoundaryController.markConnected(
            browserInstanceID: "brave-profile-b",
            targets: [braveTarget]
        )
        snapshotTrustBoundaryController.handleSnapshotPayload("not-json")
        expectEqual(
            snapshotTrustBoundaryController.targets.map(\.id),
            [braveTarget.id, target.id],
            "Malformed Chromium snapshots must be ignored without dropping existing browser state"
        )
        snapshotTrustBoundaryController.handleSnapshotPayload("""
        {"protocolVersion":999,"browserInstanceID":"chromium-profile-a","targets":[]}
        """)
        expectEqual(
            snapshotTrustBoundaryController.targets.map(\.id),
            [braveTarget.id],
            "Protocol-mismatched Chromium snapshots must clear only the reporting browser instance"
        )

        let commandResultController = ChromiumBrowserExtensionController()
        commandResultController.markConnected(targets: [target])
        var commandResult: MediaRemoteCommandResultEvent?
        let commandHandled = commandResultController.submit(command: .play, target: target) { result in
            commandResult = result
        }
        expectEqual(commandHandled, true, "Connected Chromium commands must queue a pending command result")
        guard let commandRequestID = commandResultController.pendingCommands.keys.first else {
            fail("Connected Chromium commands must record the pending request ID")
        }
        commandResultController.handleCommandResultPayload("""
        {"type":"commandResult","protocolVersion":2,"requestID":"\(commandRequestID)","targetID":"\(target.id)","command":"play","ok":true,"message":"played","backend":"chromium_extension","unsupported":false}
        """)
        expectEqual(commandResult?.requestID, commandRequestID, "Valid Chromium command results must be routed back to the matching pending command")
        expectEqual(commandResult?.command, "play", "Valid Chromium command results must preserve the requested command")
        expectEqual(commandResult?.ok, true, "Valid Chromium command results must preserve success")
        expectTrue(commandResultController.pendingCommands.isEmpty, "Valid Chromium command results must clear the pending command slot")
        expectTrue(commandResultController.commandResultTimeouts.isEmpty, "Valid Chromium command results must cancel the command timeout")

        let malformedCommandResultController = ChromiumBrowserExtensionController()
        malformedCommandResultController.markConnected(targets: [target])
        var protocolMismatchCommandResult: MediaRemoteCommandResultEvent?
        let protocolMismatchCommandHandled = malformedCommandResultController.submit(command: .pause, target: target) { result in
            protocolMismatchCommandResult = result
        }
        expectEqual(protocolMismatchCommandHandled, true, "Connected Chromium commands must arm a pending request before result validation")
        guard let protocolMismatchCommandRequestID = malformedCommandResultController.pendingCommands.keys.first else {
            fail("Malformed Chromium command result test must have a pending request ID")
        }
        malformedCommandResultController.handleCommandResultPayload("not-json")
        expectEqual(
            malformedCommandResultController.pendingCommands.keys.sorted(),
            [protocolMismatchCommandRequestID],
            "Malformed Chromium command results must leave the pending request armed for a later valid reply"
        )
        expectEqual(
            protocolMismatchCommandResult?.requestID,
            nil,
            "Malformed Chromium command results must not spuriously complete the pending request"
        )
        malformedCommandResultController.handleCommandResultPayload("""
        {"type":"commandResult","protocolVersion":999,"requestID":"\(protocolMismatchCommandRequestID)","targetID":"\(target.id)","command":"pause","ok":false,"message":"Chromium extension protocol mismatch.","backend":"chromium_extension","unsupported":true}
        """)
        expectEqual(
            protocolMismatchCommandResult?.requestID,
            protocolMismatchCommandRequestID,
            "Protocol-mismatched Chromium command results must complete the matching pending request"
        )
        expectEqual(protocolMismatchCommandResult?.command, "pause", "Protocol-mismatched Chromium command results must preserve the queued command name")
        expectEqual(protocolMismatchCommandResult?.ok, false, "Protocol-mismatched Chromium command results must fail the command")
        expectEqual(protocolMismatchCommandResult?.unsupported, true, "Protocol-mismatched Chromium command results must be marked unsupported")
        expectEqual(protocolMismatchCommandResult?.message, "Chromium extension protocol mismatch.", "Protocol-mismatched Chromium command results must explain the protocol failure")
        expectTrue(malformedCommandResultController.pendingCommands.isEmpty, "Protocol-mismatched Chromium command results must clear the pending command slot")
        expectTrue(malformedCommandResultController.commandResultTimeouts.isEmpty, "Protocol-mismatched Chromium command results must cancel the command timeout")

        let focusResultController = ChromiumBrowserExtensionController()
        focusResultController.markConnected(targets: [target])
        var focusResult: SourceFocusResult?
        let focusHandled = focusResultController.focus(target: target) { result in
            focusResult = result
        }
        expectEqual(focusHandled, true, "Connected Chromium focus must queue a pending focus result")
        guard let focusRequestID = focusResultController.pendingFocusRequests.keys.first else {
            fail("Connected Chromium focus must record the pending focus request ID")
        }
        focusResultController.handleFocusResultPayload("""
        {"type":"focusResult","protocolVersion":2,"requestID":"\(focusRequestID)","targetID":"\(target.id)","ok":true,"message":"focused","backend":"chromium_extension"}
        """)
        expectEqual(focusResult?.requestID, focusRequestID, "Valid Chromium focus results must be routed back to the matching pending focus request")
        expectEqual(focusResult?.ok, true, "Valid Chromium focus results must preserve success")
        expectEqual(focusResult?.message, "focused", "Valid Chromium focus results must preserve the extension message")
        expectTrue(focusResultController.pendingFocusRequests.isEmpty, "Valid Chromium focus results must clear the pending focus slot")
        expectTrue(focusResultController.focusResultTimeouts.isEmpty, "Valid Chromium focus results must cancel the focus timeout")

        let malformedFocusResultController = ChromiumBrowserExtensionController()
        malformedFocusResultController.markConnected(targets: [target])
        var protocolMismatchFocusResult: SourceFocusResult?
        let protocolMismatchFocusHandled = malformedFocusResultController.focus(target: target) { result in
            protocolMismatchFocusResult = result
        }
        expectEqual(protocolMismatchFocusHandled, true, "Connected Chromium focus must arm a pending request before result validation")
        guard let protocolMismatchFocusRequestID = malformedFocusResultController.pendingFocusRequests.keys.first else {
            fail("Malformed Chromium focus result test must have a pending request ID")
        }
        malformedFocusResultController.handleFocusResultPayload("not-json")
        expectEqual(
            malformedFocusResultController.pendingFocusRequests.keys.sorted(),
            [protocolMismatchFocusRequestID],
            "Malformed Chromium focus results must leave the pending request armed for a later valid reply"
        )
        expectEqual(
            protocolMismatchFocusResult?.requestID,
            nil,
            "Malformed Chromium focus results must not spuriously complete the pending request"
        )
        malformedFocusResultController.handleFocusResultPayload("""
        {"type":"focusResult","protocolVersion":999,"requestID":"\(protocolMismatchFocusRequestID)","targetID":"\(target.id)","ok":false,"message":"Chromium extension protocol mismatch.","backend":"chromium_extension","failureReason":"chromium_extension_protocol_mismatch"}
        """)
        expectEqual(
            protocolMismatchFocusResult?.requestID,
            protocolMismatchFocusRequestID,
            "Protocol-mismatched Chromium focus results must complete the matching pending request"
        )
        expectEqual(protocolMismatchFocusResult?.ok, false, "Protocol-mismatched Chromium focus results must fail the focus request")
        expectEqual(protocolMismatchFocusResult?.message, "Chromium extension protocol mismatch.", "Protocol-mismatched Chromium focus results must explain the protocol failure")
        expectEqual(protocolMismatchFocusResult?.failureReason, .chromiumExtensionProtocolMismatch, "Protocol-mismatched Chromium focus results must report the protocol-mismatch failure reason")
        expectTrue(malformedFocusResultController.pendingFocusRequests.isEmpty, "Protocol-mismatched Chromium focus results must clear the pending focus slot")
        expectTrue(malformedFocusResultController.focusResultTimeouts.isEmpty, "Protocol-mismatched Chromium focus results must cancel the focus timeout")

        print("verify_chromium_extension_transport_semantics=ok")
    }

    private static func chromiumTarget(
        id: String,
        title: String,
        supportedCommands: [MediaRemoteTransportCommand]? = [.play, .pause, .playPause, .next, .previous],
        browserFamily: String = "chromium",
        browserDisplayName: String = "Chromium",
        browserBundleIdentifier: String = "org.chromium.Chromium",
        browserInstanceID: String = "chromium-profile-a"
    ) -> MediaRemoteTarget {
        MediaRemoteTarget(
            id: id,
            bundleIdentifier: ChromiumBrowserExtensionTransport.nativeMessagingHostName,
            parentBundleIdentifier: "",
            displayName: ChromiumBrowserExtensionTransport.targetDisplayName(
                browser: browserDisplayName,
                pageTitle: title
            ),
            pid: 0,
            title: title,
            artist: "",
            album: "",
            playbackRate: "1",
            mediaType: ChromiumBrowserExtensionTransport.mediaType,
            artworkBase64: nil,
            duration: 100,
            elapsedTime: 10,
            elapsedTimestamp: 0,
            supportedCommands: supportedCommands,
            browserFamily: browserFamily,
            browserDisplayName: browserDisplayName,
            browserBundleIdentifier: browserBundleIdentifier,
            browserInstanceID: browserInstanceID
        )
    }

    private static func legacyTarget(
        bundleIdentifier: String,
        displayName: String,
        title: String = "Browser media"
    ) -> MediaRemoteTarget {
        MediaRemoteTarget(
            id: "\(bundleIdentifier):\(title):legacy",
            bundleIdentifier: bundleIdentifier,
            parentBundleIdentifier: "",
            displayName: displayName,
            pid: 123,
            title: title,
            artist: "",
            album: "",
            playbackRate: "1",
            mediaType: nil,
            artworkBase64: nil,
            duration: nil,
            elapsedTime: nil,
            elapsedTimestamp: nil,
            supportedCommands: nil,
            browserFamily: nil,
            browserDisplayName: nil,
            browserBundleIdentifier: nil,
            browserInstanceID: nil
        )
    }

    private static func expectTrue(_ actual: Bool, _ message: String) {
        guard actual else {
            fail(message)
        }
    }

    private static func expectFalse(_ actual: Bool, _ message: String) {
        guard !actual else {
            fail(message)
        }
    }

    private static func expectEqual<T: Equatable>(_ actual: T, _ expected: T, _ message: String) {
        guard actual == expected else {
            fail("\(message): expected \(expected), got \(actual)")
        }
    }

    private static func fail(_ message: String) -> Never {
        FileHandle.standardError.write(Data("verify_chromium_extension_transport_semantics: \(message)\n".utf8))
        exit(1)
    }
}
SWIFT

swiftc \
  "$workdir/Stubs.swift" \
  "$workdir/ChromiumBrowserExtensionTransport.swift" \
  "$workdir/Semantics.swift" \
  -o "$workdir/verify_chromium_extension_transport_semantics"

"$workdir/verify_chromium_extension_transport_semantics"

rg -n 'root\["browserInstanceID"\] = hostBrowserIdentity.instanceID' \
  "$repo_root/packages/SonosHandoffCore/Sources/KeywayChromiumNativeHost/main.swift" >/dev/null \
  || {
    echo "verify_chromium_extension_transport_semantics: native host snapshots must carry browserInstanceID at the payload root" >&2
    exit 1
  }

rg -n 'markConnected\(browserInstanceID: (snapshotEnvelope|snapshot)\.browserInstanceID' \
  "$repo_root/SonosHandoffMenuBar/SonosHandoffMenuBar/App/ChromiumBrowserExtensionTransport.swift" >/dev/null \
  || {
    echo "verify_chromium_extension_transport_semantics: snapshot handling must key extension state by browserInstanceID" >&2
    exit 1
  }

if rg -n 'preconditionFailure\("Chromium native host (snapshot|command-result|focus-result) notifications must include' \
  "$repo_root/SonosHandoffMenuBar/SonosHandoffMenuBar/App/ChromiumBrowserExtensionTransport.swift" >/dev/null; then
  echo "verify_chromium_extension_transport_semantics: external Chromium notifications must not crash the app on missing or invalid payloads" >&2
  exit 1
fi

if rg -n 'try! decoder.decode\((ChromiumBrowserExtensionSnapshotPayload|MediaRemoteCommandResultEvent|SourceFocusResult)\.self' \
  "$repo_root/SonosHandoffMenuBar/SonosHandoffMenuBar/App/ChromiumBrowserExtensionTransport.swift" >/dev/null; then
  echo "verify_chromium_extension_transport_semantics: external Chromium notifications must not force-decode untrusted payloads" >&2
  exit 1
fi
