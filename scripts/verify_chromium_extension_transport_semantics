#!/usr/bin/env bash
set -euo pipefail

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
workdir="$(mktemp -d)"
trap 'rm -rf "$workdir"' EXIT

cp \
  "$repo_root/SonosHandoffMenuBar/SonosHandoffMenuBar/App/ChromiumBrowserExtensionTransport.swift" \
  "$workdir/ChromiumBrowserExtensionTransport.swift"

perl -0pi -e 's/private struct SnapshotSource/struct SnapshotSource/g; s/private var snapshotSourcesByProfileGuid:/var snapshotSourcesByProfileGuid:/g; s/private var connectionIDByProfileGuid:/var connectionIDByProfileGuid:/g; s/private var highestAcceptedEpochByProfileGuid:/var highestAcceptedEpochByProfileGuid:/g; s/private var pendingCommands:/var pendingCommands:/g; s/private var commandResultTimeouts:/var commandResultTimeouts:/g; s/private var pendingFocusRequests:/var pendingFocusRequests:/g; s/private var focusResultTimeouts:/var focusResultTimeouts:/g; s/private func handleSnapshotPayload/func handleSnapshotPayload/g; s/private func handleCommandResultPayload/func handleCommandResultPayload/g; s/private func handleFocusResultPayload/func handleFocusResultPayload/g; s/private func hideSilentProfiles/func hideSilentProfiles/g; s/private func handleBrowserTermination/func handleBrowserTermination/g; s/private struct ChromiumBrowserExtensionPendingCommand/struct ChromiumBrowserExtensionPendingCommand/g; s/private struct ChromiumBrowserExtensionPendingFocus/struct ChromiumBrowserExtensionPendingFocus/g' \
  "$workdir/ChromiumBrowserExtensionTransport.swift"

cat >"$workdir/Stubs.swift" <<'SWIFT'
import Foundation

enum AppIdentity {
    static let loggerSubsystem = "com.fpieringer.Keyway.tests"
}

enum MediaRemoteTransportCommand: String, Equatable {
    case play
    case pause
    case playPause
    case next
    case previous

    var displayName: String {
        switch self {
        case .play:
            return "Play"
        case .pause:
            return "Pause"
        case .playPause:
            return "Play/Pause"
        case .next:
            return "Next"
        case .previous:
            return "Previous"
        }
    }
}

struct MediaRemoteTarget: Equatable, Identifiable {
    let id: String
    let bundleIdentifier: String
    let parentBundleIdentifier: String
    let displayName: String
    let pid: Int
    let title: String
    let artist: String
    let album: String
    let playbackRate: String
    let mediaType: String?
    let artworkBase64: String?
    let duration: Double?
    let elapsedTime: Double?
    let elapsedTimestamp: Double?
    let supportedCommands: [MediaRemoteTransportCommand]?
    let browserFamily: String?
    let browserDisplayName: String?
    let browserBundleIdentifier: String?

    var isChromiumBrowserLike: Bool {
        let identities = [bundleIdentifier, parentBundleIdentifier, displayName].map { $0.lowercased() }
        return identities.contains { identity in
            identity.contains("chrome")
                || identity.contains("chromium")
                || identity.contains("brave")
                || identity.contains("edge")
                || identity.contains("arc")
                || identity.contains("helium")
                || identity.contains("opera")
                || identity.contains("vivaldi")
        }
    }
}

struct MediaRemoteCommandResultEvent: Decodable {
    let type: String
    let requestID: String?
    let targetID: String
    let command: String
    let ok: Bool
    let message: String
    let backend: String?
    let unsupported: Bool

    init(
        type: String,
        requestID: String?,
        targetID: String,
        command: String,
        ok: Bool,
        message: String,
        backend: String?,
        unsupported: Bool = false
    ) {
        self.type = type
        self.requestID = requestID
        self.targetID = targetID
        self.command = command
        self.ok = ok
        self.message = message
        self.backend = backend
        self.unsupported = unsupported
    }
}

enum SourceFocusFailureReason: String, Codable {
    case missingApplication = "missing_application"
    case applicationActivationRejected = "application_activation_rejected"
    case chromiumExtensionDisconnected = "chromium_extension_disconnected"
    case chromiumExtensionProtocolMismatch = "chromium_extension_protocol_mismatch"
    case chromiumExtensionPayloadEncodingFailed = "chromium_extension_payload_encoding_failed"
    case chromiumExtensionTimedOut = "chromium_extension_timed_out"
    case browserActivationFailed = "browser_activation_failed"
    case browserTargetUnavailable = "browser_target_unavailable"
}

struct SourceFocusResult: Codable, Equatable {
    let type: String
    let requestID: String?
    let targetID: String
    let ok: Bool
    let message: String
    let backend: String?
    let failureReason: SourceFocusFailureReason?

    init(
        type: String = "focusResult",
        requestID: String?,
        targetID: String,
        ok: Bool,
        message: String,
        backend: String?,
        failureReason: SourceFocusFailureReason? = nil
    ) {
        self.type = type
        self.requestID = requestID
        self.targetID = targetID
        self.ok = ok
        self.message = message
        self.backend = backend
        self.failureReason = failureReason
    }
}
SWIFT

cat >"$workdir/Semantics.swift" <<'SWIFT'
import Foundation

@main
struct Semantics {
    @MainActor
    static func main() {
        let target = chromiumTarget(
            id: "chromium-tab:chromium-profile-a:22",
            title: "Video A"
        )
        let replacement = chromiumTarget(
            id: "chromium-tab:chromium-profile-a:23",
            title: "Video B"
        )
        let braveTarget = chromiumTarget(
            id: "chromium-tab:brave-profile-b:44",
            title: "Brave Video",
            browserFamily: "brave",
            browserDisplayName: "Brave",
            browserBundleIdentifier: "com.brave.Browser"
        )
        let unsupportedTrackTarget = chromiumTarget(
            id: "chromium-tab:chromium-profile-a:24",
            title: "Video C",
            supportedCommands: [.play, .pause, .playPause]
        )

        expectEqual(
            ChromiumBrowserExtensionTransport.protocolVersion,
            3,
            "Chromium extension transport must use protocol v3"
        )
        expectEqual(
            ChromiumBrowserExtensionTransport.targetIDPrefix,
            "chromium-tab:",
            "Chromium extension target IDs must use the stable tab prefix"
        )
        expectTrue(
            ChromiumBrowserExtensionTransport.isTarget(target),
            "Chromium tab targets must be recognized by exact target identity"
        )
        expectEqual(
            ChromiumBrowserExtensionTransport.profileGuid(targetID: target.id),
            "chromium-profile-a",
            "Chromium tab target IDs must expose the profile GUID for route lookup"
        )
        expectEqual(
            ChromiumBrowserExtensionTransport.profileGuid(targetID: "legacy-prefix:old:shape"),
            nil,
            "Old Chromium extension IDs must not parse as routable profile targets"
        )
        expectEqual(
            ChromiumBrowserExtensionTransport.targetDisplayName(browser: "Chromium", pageTitle: "Video A"),
            "Chromium - Video A",
            "Chromium targets must visibly include browser and tab title"
        )
        expectEqual(
            ChromiumBrowserExtensionTransport.browserFamily(target: target),
            "chromium",
            "Chromium extension targets must expose the browser family from typed metadata"
        )
        expectTrue(
            ChromiumBrowserExtensionTransport.supports(command: .playPause, target: target),
            "Chromium extension targets must support Play/Pause"
        )
        expectTrue(
            ChromiumBrowserExtensionTransport.supports(command: .next, target: target),
            "Chromium extension targets must support Next when the page advertises it"
        )
        expectFalse(
            ChromiumBrowserExtensionTransport.supports(command: .next, target: unsupportedTrackTarget),
            "Chromium extension targets must not support Next when the page does not advertise it"
        )

        let unsupported = ChromiumBrowserExtensionTransport.unsupportedResult(command: .next, target: unsupportedTrackTarget)
        expectFalse(unsupported.ok, "Unsupported commands must not report success")
        expectTrue(unsupported.unsupported, "Unsupported commands must be marked unsupported")
        expectEqual(unsupported.backend, ChromiumBrowserExtensionTransport.backendName, "Unsupported result must name the Chromium backend")

        let controller = ChromiumBrowserExtensionController()
        controller.markConnected(
            profileGuid: "chromium-profile-a",
            connectionID: "connection-a",
            targets: [target]
        )
        let chromiumLegacy = legacyTarget(
            bundleIdentifier: "org.chromium.Chromium",
            displayName: "Chromium"
        )
        let heliumLegacy = legacyTarget(
            bundleIdentifier: "net.imput.helium",
            displayName: "Helium",
            title: "Unrelated Helium Video"
        )
        let merged = controller.targetsIncludingBrowserExtensionTargets([target, chromiumLegacy, heliumLegacy])
        expectEqual(
            merged.map(\.id),
            [target.id, heliumLegacy.id],
            "Merging browser extension targets must hide same-family legacy rows while preserving different-browser targets"
        )

        let multiProfileController = ChromiumBrowserExtensionController()
        multiProfileController.markConnected(
            profileGuid: "chromium-profile-a",
            connectionID: "connection-a",
            targets: [target]
        )
        multiProfileController.markConnected(
            profileGuid: "brave-profile-b",
            connectionID: "connection-b",
            targets: [braveTarget]
        )
        expectEqual(
            multiProfileController.targets.map(\.id),
            [braveTarget.id, target.id],
            "Chromium extension snapshots must merge targets across profiles"
        )
        multiProfileController.markConnected(
            profileGuid: "chromium-profile-a",
            connectionID: "connection-a2",
            targets: [replacement],
            epoch: 1,
            resumed: true
        )
        expectEqual(
            multiProfileController.targets.map(\.id),
            [braveTarget.id, replacement.id],
            "A new snapshot for the same profile must atomically replace the prior profile snapshot"
        )
        multiProfileController.markConnected(
            profileGuid: "chromium-profile-a",
            connectionID: "connection-a3",
            targets: [],
            epoch: 2,
            resumed: true
        )
        expectEqual(
            multiProfileController.targets.map(\.id),
            [braveTarget.id],
            "An empty snapshot must clear only the reporting profile"
        )

        var unsupportedCallbackResult: MediaRemoteCommandResultEvent?
        let unsupportedHandled = controller.submit(command: .next, target: unsupportedTrackTarget) { result in
            unsupportedCallbackResult = result
        }
        expectEqual(unsupportedHandled, true, "Unsupported Chromium commands must be handled by the Chromium backend")
        expectEqual(unsupportedCallbackResult?.unsupported, true, "Unsupported Chromium commands must report through the command-result callback")
        expectEqual(unsupportedCallbackResult?.ok, false, "Unsupported Chromium commands must not report callback success")

        let disconnectedController = ChromiumBrowserExtensionController()
        var disconnectedAudioResult: MediaRemoteCommandResultEvent?
        let disconnectedAudioHandled = disconnectedController.submit(audioCommand: .mute, target: target) { result in
            disconnectedAudioResult = result
        }
        expectEqual(disconnectedAudioHandled, true, "Disconnected Chromium audio commands must be handled by the Chromium backend")
        expectEqual(disconnectedAudioResult?.ok, false, "Disconnected Chromium audio commands must not report success")
        expectEqual(disconnectedAudioResult?.command, "mute", "Disconnected Chromium audio commands must preserve the command name")

        var missingRouteResult: MediaRemoteCommandResultEvent?
        let missingRouteHandled = controller.submit(command: .play, target: braveTarget) { result in
            missingRouteResult = result
        }
        expectEqual(missingRouteHandled, true, "Missing Chromium routes must still be owned by the Chromium backend")
        expectEqual(missingRouteResult?.ok, false, "Missing Chromium routes must fail locally")
        expectEqual(missingRouteResult?.message, "Chromium extension is disconnected.", "Missing Chromium routes must not broadcast without a connection ID")

        var disconnectedFocusResult: SourceFocusResult?
        let disconnectedFocusHandled = disconnectedController.focus(target: target) { result in
            disconnectedFocusResult = result
        }
        expectEqual(disconnectedFocusHandled, true, "Disconnected Chromium focus must be handled by the Chromium backend")
        expectEqual(disconnectedFocusResult?.ok, false, "Disconnected Chromium focus must not report success")
        expectEqual(disconnectedFocusResult?.failureReason, .chromiumExtensionDisconnected, "Disconnected Chromium focus must report a focus-specific failure reason")

        let snapshotController = ChromiumBrowserExtensionController()
        snapshotController.handleSnapshotPayload("""
        {"protocolVersion":3,"profileGuid":"chromium-profile-a","connectionID":"connection-a","epoch":10,"resumed":false,"browserBundleIdentifier":"com.google.Chrome","targets":[{"id":"chromium-tab:chromium-profile-a:22","browser":"Chrome","browserFamily":"chrome","browserDisplayName":"Chrome","browserBundleIdentifier":"com.google.Chrome","url":"https://example.test","pageTitle":"Example","title":"Song","artist":"Artist","album":"Album","playing":true,"duration":100,"elapsedTime":10,"supportedCommands":["play","pause","playPause"]}]}
        """)
        expectEqual(snapshotController.targets.map(\.id), ["chromium-tab:chromium-profile-a:22"], "Valid Chromium snapshots must decode stable tab IDs")
        snapshotController.handleSnapshotPayload("""
        {"protocolVersion":3,"profileGuid":"chromium-profile-a","connectionID":"connection-a","epoch":11,"browserBundleIdentifier":"com.google.Chrome","targets":[{"id":"chromium-tab:chromium-profile-a:23","browser":"Chrome","browserFamily":"chrome","browserDisplayName":"Chrome","browserBundleIdentifier":"com.google.Chrome","url":"https://example.test/2","pageTitle":"Second","title":"Second","artist":"Artist","album":"Album","playing":true,"duration":100,"elapsedTime":10,"supportedCommands":["play","pause","playPause"]}]}
        """)
        expectEqual(snapshotController.targets.map(\.id), ["chromium-tab:chromium-profile-a:23"], "Decoded snapshots must atomically replace by profile GUID")
        snapshotController.handleSnapshotPayload("""
        {"protocolVersion":999,"profileGuid":"chromium-profile-a","connectionID":"connection-a3","epoch":12,"targets":[]}
        """)
        expectEqual(snapshotController.targets.map(\.id), ["chromium-tab:chromium-profile-a:23"], "Protocol-mismatched Chromium snapshots must be ignored")

        let oldProtocolV3Controller = ChromiumBrowserExtensionController()
        oldProtocolV3Controller.handleSnapshotPayload("""
        {"protocolVersion":3,"profileGuid":"chromium-profile-old","connectionID":"connection-old","browserBundleIdentifier":"com.google.Chrome","targets":[{"id":"chromium-tab:chromium-profile-old:22","browser":"Chrome","browserFamily":"chrome","browserDisplayName":"Chrome","browserBundleIdentifier":"com.google.Chrome","url":"https://example.test","pageTitle":"Example","title":"Song","artist":"Artist","album":"Album","playing":true,"duration":100,"elapsedTime":10,"supportedCommands":["play","pause","playPause"]}]}
        """)
        expectEqual(
            oldProtocolV3Controller.targets.map(\.id),
            ["chromium-tab:chromium-profile-old:22"],
            "Protocol v3 snapshots without additive resume fields must still decode"
        )

        let epochController = ChromiumBrowserExtensionController()
        epochController.markConnected(profileGuid: "chromium-profile-a", connectionID: "connection-a", targets: [target], epoch: 10, resumed: false)
        epochController.markConnected(profileGuid: "chromium-profile-a", connectionID: "connection-a", targets: [replacement], epoch: 9)
        expectEqual(
            epochController.targets.map(\.id),
            [target.id],
            "A lower-epoch snapshot in the same profile session must be ignored"
        )
        epochController.markConnected(profileGuid: "chromium-profile-a", connectionID: "connection-a", targets: [replacement], epoch: 11)
        expectEqual(
            epochController.targets.map(\.id),
            [replacement.id],
            "A higher-epoch snapshot in the same profile session must be accepted"
        )
        epochController.markConnected(profileGuid: "chromium-profile-a", connectionID: "connection-b", targets: [target], epoch: 1, resumed: false)
        expectEqual(
            epochController.targets.map(\.id),
            [target.id],
            "A resumed=false snapshot must reset and win even when its epoch is lower"
        )
        epochController.markConnected(profileGuid: "chromium-profile-a", connectionID: "connection-a", targets: [replacement], epoch: 99)
        expectEqual(
            epochController.targets.map(\.id),
            [target.id],
            "Snapshots from the superseded connection must not overwrite a fresh resumed=false session"
        )

        // Phase 2 review finding: a resumed=true hello whose persisted epoch lagged
        // behind what Swift already accepted (extension crashed between sendNative
        // and its chrome.storage.session.set() landing) must still be accepted and
        // adopt the new connection -- rejecting it would leave connectionIDByProfileGuid
        // pointed at the dead connection forever, wedging the profile until quit.
        let resumeWedgeController = ChromiumBrowserExtensionController()
        resumeWedgeController.markConnected(profileGuid: "chromium-profile-a", connectionID: "connection-a", targets: [target], epoch: 10, resumed: false)
        resumeWedgeController.markConnected(profileGuid: "chromium-profile-a", connectionID: "connection-b", targets: [replacement], epoch: 6, resumed: true)
        expectEqual(
            resumeWedgeController.targets.map(\.id),
            [replacement.id],
            "A resumed=true hello with a stale persisted epoch must still be accepted and adopt the new connection"
        )
        expectEqual(
            resumeWedgeController.connectionIDByProfileGuid["chromium-profile-a"],
            "connection-b",
            "Accepting a stale resumed=true hello must adopt its connection ID so the live worker's next ordinary snapshot is not rejected as a connection mismatch"
        )
        resumeWedgeController.markConnected(profileGuid: "chromium-profile-a", connectionID: "connection-b", targets: [target], epoch: 7)
        expectEqual(
            resumeWedgeController.targets.map(\.id),
            [target.id],
            "The live worker's follow-up ordinary snapshot on the adopted connection must be accepted, proving the profile is not permanently wedged"
        )

        let retentionController = ChromiumBrowserExtensionController()
        retentionController.markConnected(
            profileGuid: "chromium-profile-a",
            connectionID: "connection-a",
            targets: [target],
            epoch: 1,
            resumed: false,
            now: Date(timeIntervalSince1970: 100)
        )
        retentionController.hideSilentProfiles(now: Date(timeIntervalSince1970: 109))
        expectEqual(
            retentionController.targets.map(\.id),
            [target.id],
            "Chromium profile targets must stay published during the 10s reconnect grace"
        )
        retentionController.hideSilentProfiles(now: Date(timeIntervalSince1970: 111))
        expectEqual(
            retentionController.targets.map(\.id),
            [],
            "Chromium profile targets must hide after 10s of snapshot silence"
        )
        expectTrue(
            retentionController.snapshotSourcesByProfileGuid.keys.contains("chromium-profile-a"),
            "Hidden Chromium profile snapshots must be retained after the grace window"
        )
        expectEqual(
            retentionController.connectionIDByProfileGuid["chromium-profile-a"],
            "connection-a",
            "Hidden Chromium profile route tables must be retained after the grace window"
        )

        let quitController = ChromiumBrowserExtensionController()
        quitController.markConnected(
            profileGuid: "chromium-profile-a",
            connectionID: "connection-a",
            targets: [target],
            epoch: 1,
            resumed: false,
            browserBundleIdentifier: "org.chromium.Chromium"
        )
        quitController.markConnected(
            profileGuid: "brave-profile-b",
            connectionID: "connection-b",
            targets: [braveTarget],
            epoch: 1,
            resumed: false,
            browserBundleIdentifier: "com.brave.Browser"
        )
        quitController.handleBrowserTermination(bundleIdentifier: "org.chromium.Chromium")
        expectEqual(
            quitController.targets.map(\.id),
            [braveTarget.id],
            "Browser termination must clear only profiles owned by the terminated bundle"
        )
        expectFalse(
            quitController.snapshotSourcesByProfileGuid.keys.contains("chromium-profile-a"),
            "Browser termination must fully clear retained snapshots for the terminated profile"
        )
        expectEqual(
            quitController.connectionIDByProfileGuid["chromium-profile-a"],
            nil,
            "Browser termination must fully clear route tables for the terminated profile"
        )
        expectEqual(
            quitController.highestAcceptedEpochByProfileGuid["chromium-profile-a"],
            nil,
            "Browser termination must clear tracked epochs for the terminated profile"
        )
        expectTrue(
            quitController.snapshotSourcesByProfileGuid.keys.contains("brave-profile-b"),
            "Browser termination must leave other browser profiles retained"
        )

        let commandResultController = ChromiumBrowserExtensionController()
        commandResultController.markConnected(profileGuid: "chromium-profile-a", connectionID: "connection-a", targets: [target])
        var commandResult: MediaRemoteCommandResultEvent?
        let commandRequestID = "command-result-a"
        commandResultController.pendingCommands[commandRequestID] = ChromiumBrowserExtensionPendingCommand(
            startedAt: ProcessInfo.processInfo.systemUptime,
            commandName: "play",
            targetID: target.id
        ) { result in
            commandResult = result
        }
        commandResultController.handleCommandResultPayload("""
        {"type":"commandResult","protocolVersion":3,"requestID":"\(commandRequestID)","targetID":"\(target.id)","command":"play","ok":true,"message":"played","backend":"chromium_extension","unsupported":false}
        """)
        expectEqual(commandResult?.requestID, commandRequestID, "Valid Chromium command results must route back to the matching pending command")
        expectEqual(commandResult?.ok, true, "Valid Chromium command results must preserve success")
        expectTrue(commandResultController.pendingCommands.isEmpty, "Valid Chromium command results must clear the pending command slot")

        let focusResultController = ChromiumBrowserExtensionController()
        focusResultController.markConnected(profileGuid: "chromium-profile-a", connectionID: "connection-a", targets: [target])
        var focusResult: SourceFocusResult?
        let focusRequestID = "focus-result-a"
        focusResultController.pendingFocusRequests[focusRequestID] = ChromiumBrowserExtensionPendingFocus(
            startedAt: ProcessInfo.processInfo.systemUptime,
            targetID: target.id
        ) { result in
            focusResult = result
        }
        focusResultController.handleFocusResultPayload("""
        {"type":"focusResult","protocolVersion":3,"requestID":"\(focusRequestID)","targetID":"\(target.id)","ok":true,"message":"focused","backend":"chromium_extension"}
        """)
        expectEqual(focusResult?.requestID, focusRequestID, "Valid Chromium focus results must route back to the matching pending focus request")
        expectEqual(focusResult?.ok, true, "Valid Chromium focus results must preserve success")
        expectTrue(focusResultController.pendingFocusRequests.isEmpty, "Valid Chromium focus results must clear the pending focus slot")

        print("verify_chromium_extension_transport_semantics=ok")
    }

    private static func chromiumTarget(
        id: String,
        title: String,
        supportedCommands: [MediaRemoteTransportCommand]? = [.play, .pause, .playPause, .next, .previous],
        browserFamily: String = "chromium",
        browserDisplayName: String = "Chromium",
        browserBundleIdentifier: String = "org.chromium.Chromium"
    ) -> MediaRemoteTarget {
        MediaRemoteTarget(
            id: id,
            bundleIdentifier: ChromiumBrowserExtensionTransport.nativeMessagingHostName,
            parentBundleIdentifier: "",
            displayName: ChromiumBrowserExtensionTransport.targetDisplayName(
                browser: browserDisplayName,
                pageTitle: title
            ),
            pid: 0,
            title: title,
            artist: "",
            album: "",
            playbackRate: "1",
            mediaType: ChromiumBrowserExtensionTransport.mediaType,
            artworkBase64: nil,
            duration: 100,
            elapsedTime: 10,
            elapsedTimestamp: 0,
            supportedCommands: supportedCommands,
            browserFamily: browserFamily,
            browserDisplayName: browserDisplayName,
            browserBundleIdentifier: browserBundleIdentifier
        )
    }

    private static func legacyTarget(
        bundleIdentifier: String,
        displayName: String,
        title: String = "Browser media"
    ) -> MediaRemoteTarget {
        MediaRemoteTarget(
            id: "\(bundleIdentifier):\(title):legacy",
            bundleIdentifier: bundleIdentifier,
            parentBundleIdentifier: "",
            displayName: displayName,
            pid: 123,
            title: title,
            artist: "",
            album: "",
            playbackRate: "1",
            mediaType: nil,
            artworkBase64: nil,
            duration: nil,
            elapsedTime: nil,
            elapsedTimestamp: nil,
            supportedCommands: nil,
            browserFamily: nil,
            browserDisplayName: nil,
            browserBundleIdentifier: nil
        )
    }

    private static func expectTrue(_ actual: Bool, _ message: String) {
        guard actual else {
            fail(message)
        }
    }

    private static func expectFalse(_ actual: Bool, _ message: String) {
        guard !actual else {
            fail(message)
        }
    }

    private static func expectEqual<T: Equatable>(_ actual: T, _ expected: T, _ message: String) {
        guard actual == expected else {
            fail("\(message): expected \(String(describing: expected)), got \(String(describing: actual))")
        }
    }

    private static func fail(_ message: String) -> Never {
        FileHandle.standardError.write(Data("verify_chromium_extension_transport_semantics: \(message)\n".utf8))
        exit(1)
    }
}
SWIFT

swiftc \
  -module-cache-path "$workdir/module-cache" \
  "$workdir/Stubs.swift" \
  "$workdir/ChromiumBrowserExtensionTransport.swift" \
  "$workdir/Semantics.swift" \
  -o "$workdir/verify_chromium_extension_transport_semantics"

"$workdir/verify_chromium_extension_transport_semantics"

python3 - "$repo_root" <<'PY'
import json
import pathlib
import re
import sys

repo_root = pathlib.Path(sys.argv[1])
transport = (repo_root / "SonosHandoffMenuBar/SonosHandoffMenuBar/App/ChromiumBrowserExtensionTransport.swift").read_text()
native_host = (repo_root / "packages/SonosHandoffCore/Sources/KeywayChromiumNativeHost/main.swift").read_text()
service_worker = (repo_root / "ChromiumExtension/service_worker.js").read_text()

def fail(message):
    raise SystemExit(f"verify_chromium_extension_transport_semantics: {message}")

def expect(text, needle, message):
    if needle not in text:
        fail(message)

for forbidden in (
    "browser" + "InstanceID",
    "instance" + "ID",
    "chromium-" + "extension:",
    "disconnectInterval",
    "snapshotSourcesByBrowser" + "InstanceID",
    "public" + "TargetID",
    "raw" + "TargetID",
):
    if forbidden in transport or forbidden in native_host:
        fail(f"old Chromium identity mechanism must be removed from Swift/native host sources: {forbidden}")

expect(service_worker, "const protocolVersion = 3", "service worker must speak Chromium extension protocol v3")
expect(service_worker, 'return ["chromium-tab", message.profileGuid, message.tabId].join(":")', "service worker source IDs must use profile GUID plus tab ID")
expect(service_worker, "chrome.storage.local.get([profileGuidStorageKey]", "service worker must load profile GUID from chrome.storage.local")
expect(service_worker, "chrome.storage.local.set({ [profileGuidStorageKey]: profileGuid }", "service worker must persist minted profile GUIDs")
expect(service_worker, 'type: "hello"', "service worker hello must include a hello type")
expect(service_worker, "profileGuid,", "service worker hello must include profile GUID")
expect(service_worker, "epoch: snapshotEpoch", "service worker hello must include the current snapshot epoch")
expect(service_worker, "resumed: resume.resumed", "service worker hello must include resume state")

expect(transport, "static let protocolVersion = 3", "Swift transport must hard-cut the browser extension protocol at v3")
expect(transport, 'static let targetIDPrefix = "chromium-tab:"', "Swift transport must recognize the stable Chromium tab target prefix")
expect(transport, "private var snapshotSourcesByProfileGuid: [String: SnapshotSource] = [:]", "Swift transport snapshots must be keyed by profile GUID")
expect(transport, "private var connectionIDByProfileGuid: [String: String] = [:]", "Swift transport must maintain a profile-to-connection route table")
expect(transport, "private var highestAcceptedEpochByProfileGuid: [String: Int] = [:]", "Swift transport must track highest accepted epoch per profile GUID")
expect(transport, "snapshotSourcesByProfileGuid[profileGuid] = SnapshotSource(", "Swift transport must atomically replace profile snapshots")
expect(transport, "connectionIDByProfileGuid[profileGuid] = connectionID", "Swift transport must update the route table with each snapshot")
expect(transport, "connectionID: connectionID", "Swift command/focus payloads must stamp the resolved connection ID")
expect(transport, "return connectionIDByProfileGuid[profileGuid]", "Swift route lookup must resolve connection ID from target profile GUID")

expect(transport, "private static let profileRetainVisibleDuration: TimeInterval = 10", "Swift transport must retain visible profile targets for a 10s reconnect grace")
expect(transport, "let lastSnapshotAt: Date", "Swift transport snapshots must record when they were last refreshed")
expect(transport, "private func hideSilentProfiles(now: Date) {", "Swift transport must hide silent profile targets without dropping retained route state")
expect(transport, "private func handleBrowserTermination(bundleIdentifier: String) {", "Swift transport must clear profiles immediately on confirmed browser quit")
expect(transport, "NSWorkspace.didTerminateApplicationNotification", "Swift transport must observe browser termination notifications")
expect(transport, "resumed != nil", "Swift transport must treat any hello-derived snapshot (resumed true or false) as authoritative and adopt its connection")
for forbidden in ("disconnectInterval", "markDisconnectedIfStale", "browserInstanceID", "staleEvictionTimer", "evictStaleProfiles", "staleProfileTimeout"):
    if forbidden in transport:
        fail(f"Swift transport must not retain the Phase 1 stale eviction mechanism: {forbidden}")

expect(native_host, "let connectionID = UUID().uuidString.lowercased()", "native host must mint one private connection ID per process")
expect(native_host, "struct NativeHelloMessage: Decodable", "native host must decode hello messages carrying profile GUID")
expect(native_host, "let epoch: Int", "native host hello decoding must include resume epoch")
expect(native_host, "let resumed: Bool", "native host hello decoding must include resumed state")
expect(native_host, "let snapshot: [NativeHelloSnapshotTarget]?", "native host hello decoding must include optional resume snapshot metadata")
expect(native_host, "hostConnectionState.record(profileGuid: hello.profileGuid)", "native host must record the profile GUID from hello")
expect(native_host, 'targets[index]["id"] = "\\(chromiumTargetIDPrefix)\\(profileGuid):\\(tabID)"', "native host must assemble stable Chromium tab target IDs")
expect(native_host, 'root["profileGuid"] = profileGuid', "native host snapshots must expose profile GUID at the root")
expect(native_host, 'root["connectionID"] = connectionID', "native host snapshots must expose the private route connection ID at the root")
expect(native_host, "func payloadByMatchingConnectionID(_ payload: String) -> Data?", "native host must route commands by connection ID")
expect(native_host, 'let payloadConnectionID = root["connectionID"] as? String', "native host command routing must require an explicit connection ID")
expect(native_host, "guard payloadConnectionID == connectionID else {\n        return nil\n    }", "native host must silently drop commands for other connections")
expect(native_host, 'root.removeValue(forKey: "connectionID")', "native host must not forward the private route token to the extension")

observer = native_host[native_host.index("let commandObserver = DistributedNotificationCenter.default().addObserver("):native_host.index("\n}\n\nfunc postNativeMessage")]
expect(observer, "guard let routedPayload = payloadByMatchingConnectionID(payload) else {\n        return\n    }", "native host observer must stop before forwarding mismatched connection IDs")
expect(observer, "writeNativeMessage(routedPayload)", "native host observer must forward only matched payloads")
if "postNotificationName" in observer:
    fail("native host command observer must not post replies for commands owned by another connection")

def routed(payload, expected_connection_id):
    root = json.loads(payload)
    if root.get("connectionID") != expected_connection_id:
        return None
    root.pop("connectionID", None)
    return root

payload = json.dumps({
    "type": "command",
    "protocolVersion": 3,
    "requestID": "request-a",
    "targetID": "chromium-tab:profile-a:22",
    "command": "playPause",
    "connectionID": "connection-a",
})
forwarded_by_a = routed(payload, "connection-a")
forwarded_by_b = routed(payload, "connection-b")
if forwarded_by_a is None:
    fail("demultiplexing proof expected profile A host to forward profile A command")
if forwarded_by_b is not None:
    fail("demultiplexing proof expected profile B host to drop profile A command")
if "connectionID" in forwarded_by_a:
    fail("demultiplexing proof expected forwarded command to omit private connection ID")
if forwarded_by_a["targetID"] != "chromium-tab:profile-a:22":
    fail("demultiplexing proof expected stable target ID to pass through unchanged")

print("verify_chromium_extension_transport_static_semantics=ok")
