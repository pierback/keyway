#!/usr/bin/env bash
set -euo pipefail

if [[ "${KEYWAY_MEDIAREMOTE_KILL_SMOKE:-0}" != "1" ]]; then
  echo "smoke_mediaremote_helper_kill=skipped gate=KEYWAY_MEDIAREMOTE_KILL_SMOKE"
  exit 0
fi

APP_DIR="${KEYWAY_APP:-$HOME/Applications/Keyway.app}"
APP_EXECUTABLE="$APP_DIR/Contents/MacOS/Keyway"
HELPER_SCRIPT="$APP_DIR/Contents/Resources/MediaRemoteHelper/keyway-mediaremote-helper.pl"
STATUS_FILE="$HOME/Library/Application Support/keyway/shortcut-runtime-status.json"

fail() {
  printf 'smoke_mediaremote_helper_kill: %s\n' "$1" >&2
  exit 1
}

[[ -x "$APP_EXECUTABLE" ]] || fail "Keyway app is not installed at $APP_DIR; run scripts/install_menubar_app first"
[[ -x "$HELPER_SCRIPT" ]] || fail "bundled MediaRemote helper script is missing"
pgrep -x Keyway >/dev/null || fail "Keyway must already be running"

helper_pids() {
  pgrep -f "$HELPER_SCRIPT" || true
}

read_trace_sequence() {
  python3 - "$STATUS_FILE" <<'PY'
import json
import pathlib
import sys

path = pathlib.Path(sys.argv[1])
if not path.exists():
    print(0)
else:
    print(json.loads(path.read_text()).get("mediaTransportTraceSequence", 0))
PY
}

trace_has_success_after() {
  local start_sequence="$1"
  local target_id="$2"
  local command="$3"
  python3 - "$STATUS_FILE" "$start_sequence" "$target_id" "$command" <<'PY'
import json
import pathlib
import sys

path = pathlib.Path(sys.argv[1])
start_sequence = int(sys.argv[2])
target_id = sys.argv[3]
command = sys.argv[4]
if not path.exists():
    raise SystemExit(1)
events = json.loads(path.read_text()).get("mediaTransportTrace", [])
for event in events:
    if event.get("sequence", 0) <= start_sequence:
        continue
    if (
        event.get("event") == "helper_command_result"
        and event.get("targetID") == target_id
        and event.get("command") == command
        and event.get("ok") is True
    ):
        raise SystemExit(0)
raise SystemExit(1)
PY
}

open_menu_text() {
  osascript <<'APPLESCRIPT'
tell application "System Events"
  if not (exists process "Keyway") then return ""
  tell process "Keyway"
    try
      if not (exists pop over 1 of menu bar 2) then click menu bar item 1 of menu bar 2
    end try
    delay 0.15
    if not (exists pop over 1 of menu bar 2) then return ""
    set output to ""
    set labels to value of static texts of scroll area 1 of group 1 of pop over 1 of menu bar 2
    repeat with label in labels
      set output to output & (label as text) & linefeed
    end repeat
    return output
  end tell
end tell
APPLESCRIPT
}

mediaremote_source_transport_button() {
  local action="$1"
  local selected_identifier="${2:-}"
  osascript - "$action" "$selected_identifier" <<'APPLESCRIPT'
on run argv
  set actionName to item 1 of argv
  set selectedIdentifier to item 2 of argv
  tell application "System Events"
    if not (exists process "Keyway") then return ""
    tell process "Keyway"
    try
      if not (exists pop over 1 of menu bar 2) then click menu bar item 1 of menu bar 2
    end try
    delay 0.15
    if not (exists pop over 1 of menu bar 2) then return ""
      repeat with buttonRef in buttons of scroll area 1 of group 1 of pop over 1 of menu bar 2
        set identifier to value of attribute "AXIdentifier" of buttonRef as text
        set buttonHelp to help of buttonRef as text
        if identifier starts with "source-row-" and identifier does not contain "chromium-tab:" and identifier does not contain "com.spotify.client:" and buttonHelp is "Pause" and (selectedIdentifier is "" or identifier is selectedIdentifier) then
          if actionName is "click" then perform action "AXPress" of buttonRef
          return identifier & ":" & buttonHelp
        end if
      end repeat
      return ""
    end tell
  end tell
end run
APPLESCRIPT
}

for _ in {1..50}; do
  [[ -n "$(helper_pids)" ]] && break
  sleep 0.1
done
[[ -n "$(helper_pids)" ]] || fail "MediaRemote helper process is not running"

initial_text="$(open_menu_text)"
[[ -n "$initial_text" ]] || fail "could not read Keyway menu through Accessibility"
if grep -Fq "No media sources" <<<"$initial_text"; then
  fail "Keyway must have at least one visible media source before helper-kill smoke"
fi
selected_source="$(mediaremote_source_transport_button find)"
[[ -n "$selected_source" ]] || fail "start a currently playing non-Spotify MediaRemote source, such as a muted looping QuickTime document, before helper-kill smoke"
selected_identifier="${selected_source%:Pause}"
selected_target_id="${selected_identifier#source-row-}"

start_sequence="$(read_trace_sequence)"
deadline=$((SECONDS + 10))

while read -r pid; do
  [[ -n "$pid" ]] || continue
  kill "$pid"
done < <(helper_pids)

while (( SECONDS < deadline )); do
  text="$(open_menu_text)"
  if [[ -z "$text" ]]; then
    sleep 0.1
    continue
  fi
  if grep -Fq "No media sources" <<<"$text"; then
    fail "source list collapsed to empty during MediaRemote helper recovery grace"
  fi
  [[ -n "$(helper_pids)" ]] || {
    sleep 0.1
    continue
  }
  if grep -Fq "not responding" <<<"$text"; then
    sleep 0.1
    continue
  fi
  pressed_identifier="$(mediaremote_source_transport_button click "$selected_identifier")"
  if [[ -n "$pressed_identifier" ]]; then
    command_deadline=$((SECONDS + 2))
    while (( SECONDS < command_deadline )); do
      if trace_has_success_after "$start_sequence" "$selected_target_id" pause; then
        echo "smoke_mediaremote_helper_kill=ok pressed=$pressed_identifier"
        exit 0
      fi
      sleep 0.05
    done
    fail "MediaRemote command did not succeed after helper recovery"
  fi
  sleep 0.1
done

fail "routing did not recover within 10s of MediaRemote helper death"
