#!/usr/bin/env bash
set -euo pipefail

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
workdir="$(mktemp -d)"
trap 'rm -rf "$workdir"' EXIT

cp "$repo_root/SonosHandoffMenuBar/SonosHandoffMenuBar/App/MediaTransportRouteSource.swift" "$workdir/MediaTransportRouteSource.swift"

cat >"$workdir/RouteSourceSemantics.swift" <<'SWIFT'
import Foundation

@main
struct RouteSourceSemantics {
    static func main() {
        let physical = metadata(
            sourceUnixProcessID: 0,
            sourceStateID: 1,
            sourceUserData: 0,
            targetUnixProcessID: 0,
            eventTimestamp: 100
        )
        expectTrue(physical.isPhysicalHIDSystemSource, "untargeted HID event must be recognized as HID-system sourced")
        expectTrue(physical.isUntargetedPhysicalHIDSystemSource, "untargeted HID event must be accepted as physical user input")

        let hidStateWithProcessPID = metadata(
            sourceUnixProcessID: 123,
            sourceStateID: 1,
            sourceUserData: 0,
            targetUnixProcessID: 0,
            eventTimestamp: 100
        )
        expectTrue(hidStateWithProcessPID.isPhysicalHIDSystemSource, "HID-state media keys must survive macOS source-pid rewriting")
        expectTrue(hidStateWithProcessPID.isUntargetedPhysicalHIDSystemSource, "untargeted HID-state media keys must stay routable after source-pid rewriting")

        let generatedProcessEvent = metadata(
            sourceUnixProcessID: 123,
            sourceStateID: 0,
            sourceUserData: 0,
            targetUnixProcessID: 0,
            eventTimestamp: 100
        )
        expectFalse(generatedProcessEvent.isPhysicalHIDSystemSource, "ordinary process-generated callbacks must not be treated as physical HID")
        expectFalse(generatedProcessEvent.isUntargetedPhysicalHIDSystemSource, "ordinary process-generated callbacks must not be accepted as physical input")

        let targetedHIDShape = metadata(
            sourceUnixProcessID: 0,
            sourceStateID: 1,
            sourceUserData: 0,
            targetUnixProcessID: 456,
            eventTimestamp: 100
        )
        expectTrue(targetedHIDShape.isPhysicalHIDSystemSource, "targeted HID events must still be accepted as physical user input")
        expectFalse(targetedHIDShape.isUntargetedPhysicalHIDSystemSource, "targeted HID events should remain diagnosable as already app-targeted")
        expectTrue(
            physical.matchesSameGeneratedMediaKey(as: targetedHIDShape),
            "same-event generated media-key matching must survive target pid changes caused by chooser focus"
        )

        let nextPress = metadata(
            sourceUnixProcessID: 0,
            sourceStateID: 1,
            sourceUserData: 0,
            targetUnixProcessID: 0,
            eventTimestamp: 10_000_100
        )
        expectFalse(
            physical.matchesSameGeneratedMediaKey(as: nextPress),
            "fresh physical key presses must not match old generated-event identity"
        )
        expectTrue(
            physical.matchesSameHIDSystemSource(as: nextPress),
            "chooser rebound suppression must recognize regenerated HID-system callbacks from the same source"
        )
        let rewrittenSourceHID = metadata(
            sourceUnixProcessID: 999,
            sourceStateID: 1,
            sourceUserData: 0,
            targetUnixProcessID: 456,
            eventTimestamp: 10_000_200
        )
        expectFalse(
            physical.matchesSameHIDSystemSource(as: rewrittenSourceHID),
            "strict HID source matching must remain source-pid aware for diagnostics"
        )
        expectFalse(
            physical.matchesSameHIDSystemSource(as: generatedProcessEvent),
            "chooser rebound suppression must not treat ordinary process-generated callbacks as HID-system rebounds"
        )

        print("verify_media_transport_route_source_semantics=ok")
    }

    private static func metadata(
        sourceUnixProcessID: Int64,
        sourceStateID: Int64,
        sourceUserData: Int64,
        targetUnixProcessID: Int64,
        eventTimestamp: UInt64
    ) -> MediaTransportInputMetadata {
        MediaTransportInputMetadata(
            sourceUnixProcessID: sourceUnixProcessID,
            sourceStateID: sourceStateID,
            sourceUserData: sourceUserData,
            targetUnixProcessID: targetUnixProcessID,
            eventTimestamp: eventTimestamp
        )
    }

    private static func expectTrue(_ value: Bool, _ message: String) {
        guard value else { fail(message) }
    }

    private static func expectFalse(_ value: Bool, _ message: String) {
        guard !value else { fail(message) }
    }

    private static func fail(_ message: String) -> Never {
        FileHandle.standardError.write(Data("verify_media_transport_route_source_semantics: \(message)\n".utf8))
        exit(1)
    }
}
SWIFT

swiftc \
  -module-cache-path "$workdir/module-cache" \
  "$workdir/MediaTransportRouteSource.swift" \
  "$workdir/RouteSourceSemantics.swift" \
  -o "$workdir/verify_media_transport_route_source_semantics"

"$workdir/verify_media_transport_route_source_semantics"
