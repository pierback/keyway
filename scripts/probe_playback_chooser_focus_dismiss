#!/usr/bin/env bash
set -euo pipefail

status_file="${KEYWAY_STATUS_FILE:-$HOME/Library/Application Support/keyway/shortcut-runtime-status.json}"
timeout_seconds="${KEYWAY_PROBE_TIMEOUT_SECONDS:-10}"

fail() {
  printf 'probe_playback_chooser_focus_dismiss: %s\n' "$1" >&2
  exit 1
}

read_trace_sequence() {
  python3 - "$status_file" <<'PY'
import json
import pathlib
import sys

payload = json.loads(pathlib.Path(sys.argv[1]).read_text())
print(int(payload.get("mediaTransportTraceSequence", 0)))
PY
}

read_trace_json() {
  python3 - "$status_file" <<'PY'
import json
import pathlib
import sys

payload = json.loads(pathlib.Path(sys.argv[1]).read_text())
print(json.dumps(payload.get("mediaTransportTrace", []), separators=(",", ":")))
PY
}

post_physical_play_pause() {
  swift - <<'SWIFT'
import AppKit
import ApplicationServices

let playPauseKeyCode = 16
let keyDownState = 0x0A
let keyUpState = 0x0B
let mediaKeySubtype: Int16 = 8

func postMediaKey(state: Int) {
    let data1 = (playPauseKeyCode << 16) | (state << 8)
    guard let event = NSEvent.otherEvent(
        with: .systemDefined,
        location: .zero,
        modifierFlags: [],
        timestamp: ProcessInfo.processInfo.systemUptime,
        windowNumber: 0,
        context: nil,
        subtype: mediaKeySubtype,
        data1: data1,
        data2: -1
    ), let cgEvent = event.cgEvent else {
        fatalError("failed to create media key event")
    }
    cgEvent.setIntegerValueField(.eventSourceUnixProcessID, value: 0)
    cgEvent.setIntegerValueField(.eventSourceStateID, value: 1)
    cgEvent.setIntegerValueField(.eventSourceUserData, value: 0)
    cgEvent.setIntegerValueField(.eventTargetUnixProcessID, value: 0)
    cgEvent.post(tap: .cghidEventTap)
}

postMediaKey(state: keyDownState)
usleep(35_000)
postMediaKey(state: keyUpState)
SWIFT
}

wait_for_event() {
  local start_sequence="$1"
  local event_name="$2"
  local deadline=$((SECONDS + timeout_seconds))
  while (( SECONDS < deadline )); do
    trace_json="$(read_trace_json)"
    if python3 - "$start_sequence" "$event_name" "$trace_json" <<'PY'
import json
import sys

start_sequence = int(sys.argv[1])
event_name = sys.argv[2]
events = [
    event for event in json.loads(sys.argv[3])
    if int(event.get("sequence", 0)) > start_sequence
]
raise SystemExit(0 if any(event.get("event") == event_name for event in events) else 1)
PY
    then
      return 0
    fi
    sleep 0.05
  done
  return 1
}

activate_finder() {
  osascript -e 'tell application "Finder" to activate' >/dev/null
}

close_chooser() {
  osascript -e 'tell application id "com.fpieringer.Keyway" to activate' -e 'tell application "System Events" to key code 53' >/dev/null 2>&1 || true
}

analyze_trace() {
  local start_sequence="$1"
  local trace_json
  trace_json="$(read_trace_json)"
  python3 - "$start_sequence" "$trace_json" <<'PY'
import json
import sys

start_sequence = int(sys.argv[1])
events = [
    event for event in json.loads(sys.argv[2])
    if int(event.get("sequence", 0)) > start_sequence
]

def fail(message):
    print(json.dumps(events, indent=2, sort_keys=True))
    print(f"probe_playback_chooser_focus_dismiss: {message}", file=sys.stderr)
    raise SystemExit(1)

def first(name):
    return next((event for event in events if event.get("event") == name), None)

show = first("chooser_show")
dismiss = first("chooser_dismissed")
if show is None:
    fail("chooser was not shown")
if dismiss is None:
    fail("chooser did not dismiss after another app was focused")
if events.index(dismiss) < events.index(show):
    fail("chooser dismissed before it was shown")
if any(event.get("event") == "chooser_dispatch" for event in events[events.index(show) + 1:]):
    fail("focus-loss dismissal dispatched to a row")
if any(event.get("event") == "helper_command_result" for event in events[events.index(show) + 1:]):
    fail("focus-loss dismissal sent a backend command")
print(json.dumps({
    "event": "probe_chooser_focus_dismiss_stable",
    "showSequence": show.get("sequence"),
    "dismissSequence": dismiss.get("sequence"),
}, sort_keys=True))
PY
}

trap close_chooser EXIT

start_sequence="$(read_trace_sequence)"
printf 'probe_playback_chooser_focus_dismiss: starting after trace sequence %s\n' "$start_sequence"
post_physical_play_pause
wait_for_event "$start_sequence" "chooser_show" || fail "timed out waiting for chooser_show"
activate_finder
wait_for_event "$start_sequence" "chooser_dismissed" || fail "timed out waiting for chooser_dismissed"
analyze_trace "$start_sequence"
printf 'probe_playback_chooser_focus_dismiss=ok\n'
