#!/usr/bin/env bash
set -euo pipefail

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
runtime="$repo_root/SonosHandoffMenuBar/SonosHandoffMenuBar/App/SonosHandoffApp.swift"
background="$repo_root/SonosHandoffMenuBar/SonosHandoffMenuBar/App/PlaybackBackgroundSync.swift"
controller="$repo_root/SonosHandoffMenuBar/SonosHandoffMenuBar/App/PlaybackSyncController.swift"
gate="$repo_root/SonosHandoffMenuBar/SonosHandoffMenuBar/App/PlaybackOperationGate.swift"
environment="$repo_root/SonosHandoffMenuBar/SonosHandoffMenuBar/Support/AppEnvironment.swift"
authority="$repo_root/packages/SonosHandoffCore/Sources/SonosHandoffCore/Handoff/PlaybackOperationAuthority.swift"

python3 - "$runtime" "$background" "$controller" "$gate" "$environment" "$authority" <<'PY'
import pathlib
import sys

runtime = pathlib.Path(sys.argv[1]).read_text()
background = pathlib.Path(sys.argv[2]).read_text()
controller = pathlib.Path(sys.argv[3]).read_text()
gate = pathlib.Path(sys.argv[4]).read_text()
environment = pathlib.Path(sys.argv[5]).read_text()
authority = pathlib.Path(sys.argv[6]).read_text()

app_runtime = runtime[runtime.index("final class AppRuntime"):runtime.index("private func prepareNotifications")]
for forbidden in (
    "volumeMonitorSeed",
    "seedVolumeMonitor",
    "preferredStartupRoomName",
    "activePlaybackObserver",
    "outputSelection",
    "outputDirectory",
):
    if forbidden in app_runtime:
        raise SystemExit(
            f"verify_sonos_observation_authority_semantics: AppRuntime must not own Sonos observation policy: {forbidden}"
        )
enable = app_runtime[app_runtime.index("    func enableSonos()"):app_runtime.index("    func stop()")]
for required in (
    "volumeHotkeys.setSonosVolumeInputEnabled(true)",
    "SonosVolumeMonitor.shared.start(volumeService: volumeService)",
    "playbackBackgroundSync.start()",
):
    if required not in enable:
        raise SystemExit(
            f"verify_sonos_observation_authority_semantics: AppRuntime must compose the Sonos owner through {required}"
        )

for required in (
    "private let operationGate: PlaybackOperationGate",
    "private var pollTask: Task<Void, Never>?",
    "private var observationTask: Task<Void, Never>?",
    "operationGate.startRuntime",
    "operationGate.stopRuntime()",
    "let observation = self?.requestSync()",
    "guard let ticket = operationGate.beginObservation()",
    "observationTask?.cancel()",
    "private func syncOnce(ticket: PlaybackAuthorityTicket) async",
    "guard isCurrentObservation(ticket) else",
    "operationGate.isCurrentObservation(ticket)",
):
    if required not in background:
        raise SystemExit(
            f"verify_sonos_observation_authority_semantics: background observation must use the shared runtime authority: {required}"
        )
for forbidden in (
    "private var observationGeneration",
    "private var observationSuspensionCount",
    "await sync.syncOnce()",
    "await self?.syncOnce()",
):
    if forbidden in background:
        raise SystemExit(
            f"verify_sonos_observation_authority_semantics: no caller may launch an independent observation: {forbidden}"
        )

for function_name in (
    "acceptGroupSuggestion",
    "acceptTransferSuggestion",
    "acceptHeadphoneTransferSuggestion",
):
    start = background.index(f"    private func {function_name}")
    next_function = background.find("\n    private func ", start + 1)
    body = background[start:next_function if next_function >= 0 else len(background)]
    if "operationGate.beginTransaction(" not in body or "operationGate.endTransaction(ticket)" not in body:
        raise SystemExit(
            f"verify_sonos_observation_authority_semantics: {function_name} must commit through the shared transaction authority"
        )

for required in (
    "let playbackOperationGate = PlaybackOperationGate()",
    "operationGate: playbackOperationGate",
):
    if required not in environment:
        raise SystemExit(
            f"verify_sonos_observation_authority_semantics: composition must inject one shared operation gate: {required}"
        )
if environment.count("operationGate: playbackOperationGate") != 2:
    raise SystemExit(
        "verify_sonos_observation_authority_semantics: background and foreground must receive the same operation gate"
    )

for required in (
    "private let operationGate: PlaybackOperationGate",
    "operationGate: PlaybackOperationGate",
    "guard let ticket = operationGate.beginObservation()",
    "operationGate.runTransaction(",
    "operationGate.isCurrentTransaction(ticket",
):
    if required not in controller:
        raise SystemExit(
            f"verify_sonos_observation_authority_semantics: foreground controller must use the shared authority: {required}"
        )
if "private let operationGate = PlaybackOperationGate()" in controller:
    raise SystemExit(
        "verify_sonos_observation_authority_semantics: foreground controller must not create a private authority"
    )

toggle_start = controller.index("    func toggleGroupMembership(")
toggle_end = controller.index("\n    private func clearGroupSuggestions", toggle_start)
toggle = controller[toggle_start:toggle_end]
outcome = "let outcome = try await applyGroupMembershipChange(change)"
commit_guard = "guard operationGate.isCurrentTransaction(ticket"
transaction_apply = "if let playbackTransactionRoomName = outcome.playbackTransactionRoomName"
if toggle.index(outcome) > toggle.index(commit_guard, toggle.index(outcome)):
    raise SystemExit(
        "verify_sonos_observation_authority_semantics: group mutation must check transaction authority after its mechanism result"
    )
if toggle.index(commit_guard, toggle.index(outcome)) > toggle.index(transaction_apply):
    raise SystemExit(
        "verify_sonos_observation_authority_semantics: group mutation must not apply playback selection before authority is checked"
    )

for required in (
    "private var authority = PlaybackOperationAuthority()",
    "func startRuntime(",
    "func stopRuntime()",
    "func beginObservation() -> PlaybackAuthorityTicket?",
    "func runTransaction(",
    "func beginTransaction(roomName: String)",
    "func endTransaction(_ ticket: PlaybackTransactionTicket)",
):
    if required not in gate:
        raise SystemExit(
            f"verify_sonos_observation_authority_semantics: application gate is missing shared authority behavior: {required}"
        )

for required in (
    "public mutating func start()",
    "public mutating func stop()",
    "public mutating func beginObservation()",
    "public func canCommitObservation(",
    "public mutating func beginTransaction()",
    "public func canCommitTransaction(",
    "public mutating func endTransaction(",
    "guard isRunning, !transactionInProgress",
):
    if required not in authority:
        raise SystemExit(
            f"verify_sonos_observation_authority_semantics: core authority is missing a runtime invariant: {required}"
        )

apply_start = controller.index("    private func applyGroupMembershipChange(")
apply_end = controller.index("\n    private func refreshAfterGroupMutation", apply_start)
apply = controller[apply_start:apply_end]
for forbidden in (
    "activeSpotifyRoomName =",
    "selectRoomName(",
    "clearSpotifyAuthRequired()",
    "requireSpotifyAuth(",
):
    if forbidden in apply:
        raise SystemExit(
            f"verify_sonos_observation_authority_semantics: nested group mechanism must return immutable state instead of mutating UI: {forbidden}"
        )
for required in (
    "playbackTransactionRoomName: replacement.roomName",
    "authRequiredMessage: transferOutcome.failureMessage",
):
    if required not in apply:
        raise SystemExit(
            f"verify_sonos_observation_authority_semantics: group mechanism outcome is missing {required}"
        )
PY

printf 'verify_sonos_observation_authority_semantics=ok\n'
