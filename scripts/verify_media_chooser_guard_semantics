#!/usr/bin/env bash
set -euo pipefail

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
workdir="$(mktemp -d)"
trap 'rm -rf "$workdir"' EXIT
transport_controller="$repo_root/SonosHandoffMenuBar/SonosHandoffMenuBar/App/MediaTransportActionController.swift"

cp "$repo_root/SonosHandoffMenuBar/SonosHandoffMenuBar/App/MediaChooserSessionGuard.swift" "$workdir/MediaChooserSessionGuard.swift"

cat >"$workdir/MediaRemoteTransportCommand.swift" <<'SWIFT'
enum MediaRemoteTransportCommand: String, Equatable {
    case play
    case playPause
    case next
    case previous
    case pause
}
SWIFT

cat >"$workdir/ChooserGuardSemantics.swift" <<'SWIFT'
import Foundation

@main
struct ChooserGuardSemantics {
    @MainActor
    static func main() {
        let guardStore = MediaChooserSessionGuard()
        let staleID = UUID()

        expectFalse(guardStore.isActive, "fresh guard must not start active")
        expectEqual(guardStore.stateName, "inactive", "inactive guard must report inactive")

        let noCommandID = guardStore.begin(command: nil)
        expectFalse(guardStore.isActive, "chooser without pending command must not create routing guard state")
        expectFalse(guardStore.finish(id: noCommandID), "finishing a no-command chooser must not clear unrelated state")

        let chooserID = guardStore.begin(command: .playPause)
        expectTrue(guardStore.isActive, "pending chooser command must create active guard state")
        expectEqual(guardStore.stateName, "visible", "new chooser must start visible")
        expectEqual(guardStore.activeCommandRawValue(for: chooserID), "playPause", "active command must be visible for dismiss logging")
        expectEqual(guardStore.activeCommand(for: chooserID), .playPause, "active command must be accessible before selection")
        expectFalse(guardStore.finish(id: staleID), "stale finish must not clear visible chooser")
        expectTrue(guardStore.isActive, "stale finish must leave visible chooser active")
        expectTrue(guardStore.finish(id: chooserID), "dismiss finish must clear chooser guard immediately")
        expectFalse(guardStore.isActive, "dismiss finish must not leave delayed dispatch state")
        expectEqual(guardStore.stateName, "inactive", "finished chooser must report inactive")

        let selectedID = guardStore.begin(command: .pause)
        expectTrue(guardStore.finish(id: selectedID, selected: true), "selected finish must clear chooser guard immediately")
        expectFalse(guardStore.isActive, "selected finish must not leave post-selection routing state")
        expectNil(guardStore.activeCommandRawValue(for: selectedID), "selected finish must clear active command lookup")
        expectNil(guardStore.activeCommand(for: selectedID), "selected finish must clear active command")

        let newerID = guardStore.begin(command: .next)
        expectFalse(guardStore.finish(id: selectedID), "stale selected id must not clear newer chooser")
        expectTrue(guardStore.isActive, "stale selected id must leave newer chooser active")
        expectEqual(guardStore.activeCommand(for: newerID), .next, "newer chooser must keep its command")
        expectTrue(guardStore.finish(id: newerID), "matching finish must clear newer chooser")
        expectFalse(guardStore.isActive, "matching finish must clear active state")

        print("verify_media_chooser_guard_semantics=ok")
    }

    private static func expectTrue(_ value: Bool, _ message: String) {
        guard value else { fail(message) }
    }

    private static func expectFalse(_ value: Bool, _ message: String) {
        guard !value else { fail(message) }
    }

    private static func expectNil<T>(_ value: T?, _ message: String) {
        guard value == nil else { fail(message) }
    }

    private static func expectEqual<T: Equatable>(_ actual: T, _ expected: T, _ message: String) {
        guard actual == expected else {
            fail("\(message): expected \(expected), got \(actual)")
        }
    }

    private static func fail(_ message: String) -> Never {
        FileHandle.standardError.write(Data("verify_media_chooser_guard_semantics: \(message)\n".utf8))
        exit(1)
    }
}
SWIFT

swiftc \
  -module-cache-path "$workdir/module-cache" \
  "$workdir/MediaRemoteTransportCommand.swift" \
  "$workdir/MediaChooserSessionGuard.swift" \
  "$workdir/ChooserGuardSemantics.swift" \
  -o "$workdir/verify_media_chooser_guard_semantics"

"$workdir/verify_media_chooser_guard_semantics"

overlay_controller="$repo_root/SonosHandoffMenuBar/SonosHandoffMenuBar/App/MediaTargetOverlayController.swift"

python3 - "$transport_controller" "$overlay_controller" <<'PY'
import pathlib
import sys

text = pathlib.Path(sys.argv[1]).read_text()
overlay_text = pathlib.Path(sys.argv[2]).read_text()

def fail(message):
    raise SystemExit(f"verify_media_chooser_guard_semantics: {message}")

if "try!" in overlay_text:
    fail("MediaTargetOverlayController must not use try! (crashes on task cancellation; use try?)")

route_start = text.index("    private func routeFromCache(")
route_end = text.index("\n    private func route(", route_start)
route_body = text[route_start:route_end]
required = [
    "let routeStatus = currentRouteStatus(command: command)",
    "guard routeStatus.kind != .unavailable else",
    "mediaRemoteController.refreshSnapshot()",
    "showChooserOverlay(",
]
for needle in required:
    if needle not in route_body:
        fail(f"empty route path must contain {needle!r}")
if "StatusHUD.shared.finish" in route_body:
    fail("zero-target routed input must open the chooser instead of ending in a HUD")
if "No Media Target" in route_body:
    fail("zero-target routed input must not use the old no-target HUD copy")

show_start = text.index("    private func showChooserOverlay(")
show_end = text.index("\n    private func sortedTargets", show_start)
show_body = text[show_start:show_end]
for needle in [
    "rowUpdates: overlayRowUpdates()",
    "emptyDiagnostics:",
    "chooserReentryBlocked(",
    "self.relaxRouteShield?(\"selected_row_dispatch\")",
    "self.relaxRouteShield?(\"chooser_focus\")",
    "self.relaxRouteShield?(\"chooser_dismissed\")",
]:
    if needle not in show_body:
        fail(f"chooser overlay path must preserve re-entry/deferred semantics and contain {needle!r}")

if "private func emptyDiscoveryDiagnostics()" not in text:
    fail("empty discovery must expose transport diagnostics for the confirmed-empty chooser state")

updates_start = text.index("    private func overlayRowUpdates()")
updates_end = text.index("\n    }", updates_start)
updates_code = "\n".join(
    line for line in text[updates_start:updates_end].splitlines()
    if not line.lstrip().startswith("//")
)
if "sourceRows(for:" in updates_code or "mediaSourceStore.rows" in updates_code:
    fail(
        "overlayRowUpdates must order and forward the EMITTED rows only: @Published emits from "
        "willSet, so mediaSourceStore.rows is still the previous array during the emission -- "
        "re-deriving rows from it hands the open chooser one-emission-stale reachability"
    )
PY
