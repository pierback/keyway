#!/usr/bin/env bash
set -euo pipefail

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
environment="$repo_root/SonosHandoffMenuBar/SonosHandoffMenuBar/Support/AppEnvironment.swift"
sonos_app="$repo_root/SonosHandoffMenuBar/SonosHandoffMenuBar/App/SonosHandoffApp.swift"
transport="$repo_root/SonosHandoffMenuBar/SonosHandoffMenuBar/App/ChromiumBrowserExtensionTransport.swift"
settings="$repo_root/SonosHandoffMenuBar/SonosHandoffMenuBar/Features/SettingsFeature.swift"

python3 - "$environment" "$sonos_app" "$transport" "$settings" <<'PY'
import pathlib
import sys

environment = pathlib.Path(sys.argv[1]).read_text()
sonos_app = pathlib.Path(sys.argv[2]).read_text()
transport = pathlib.Path(sys.argv[3]).read_text()
settings = pathlib.Path(sys.argv[4]).read_text()

def fail(message):
    raise SystemExit(f"verify_app_environment_external_input_semantics: {message}")

def section(source, start_needle, end_needle):
    start = source.find(start_needle)
    if start < 0:
        fail(f"missing {start_needle!r}")
    end = source.find(end_needle, start)
    if end < 0:
        fail(f"missing {end_needle!r}")
    return source[start:end]

live = section(
    environment,
    "    static func live() -> AppEnvironment {",
    "\n}\n\n@MainActor",
)
if "@MainActor\nstruct AppEnvironment {" not in environment:
    fail("AppEnvironment must be main-actor isolated")
if "@unchecked Sendable" in environment:
    fail("AppEnvironment must not bypass Swift concurrency checks")
for required in (
    "let playbackBackgroundSync = PlaybackBackgroundSync(",
    "let playbackSyncController = PlaybackSyncController(",
    "let volumeHotkeys = VolumeHotkeyController(",
):
    if required not in live:
        fail(f"AppEnvironment.live() must remain the explicit composition root: missing {required}")
for forbidden in (
    "chromiumNativeMessagingHostInstaller.install()",
    "groupSuggestionNotifier.prepare()",
    ".start()",
):
    if forbidden in live:
        fail(f"AppEnvironment.live() must be side-effect free: found {forbidden}")

runtime_start = section(
    sonos_app,
    "    func start() {",
    "\n    func stop()",
)
for required in (
    "prepareNotifications()",
    "installChromiumNativeMessagingHost()",
    "chromiumBrowserExtensionController.start()",
    "mediaRemoteController.start()",
):
    if required not in runtime_start:
        fail(f"AppRuntime.start() must own launch side effects: missing {required}")
if runtime_start.index("prepareNotifications()") > runtime_start.index("chromiumBrowserExtensionController.start()"):
    fail("notification registration must finish before operational controllers start")
if runtime_start.index("installChromiumNativeMessagingHost()") > runtime_start.index("chromiumBrowserExtensionController.start()"):
    fail("Chromium native host installation must precede bridge observation")

runtime_install = section(
    sonos_app,
    "    private func installChromiumNativeMessagingHost() {",
    "\n    }\n}",
)
for required in (
    "let state = try chromiumNativeMessagingHostInstaller.install()",
    'logger.info("Chromium native bridge installed',
    'logger.error("Chromium native bridge install failed',
):
    if required not in runtime_install:
        fail(f"AppRuntime must explicitly report optional bridge installation failure: missing {required}")

install = section(
    transport,
    "    func install() throws -> ChromiumNativeMessagingHostInstallState {",
    "\n    private var nativeHostDirectories",
)
if "precondition(" in install:
    fail("ChromiumNativeMessagingHostInstaller.install() must throw instead of preconditioning on filesystem state")
for required in (
    "enum ChromiumNativeMessagingHostInstallError: LocalizedError, Equatable",
    "guard fileManager.isExecutableFile(atPath: nativeHostExecutableURL.path) else {",
    "throw ChromiumNativeMessagingHostInstallError.missingExecutable(path: nativeHostExecutableURL.path)",
):
    if required not in transport:
        fail(f"Chromium native bridge installer must expose typed install failures: missing {required}")

for required in (
    "initialChromiumBridgeMessage: String? = nil",
    "_chromiumBridgeMessage = State(initialValue: initialChromiumBridgeMessage)",
    'settingsDiagnosticRow(title: "chromium bridge", detail: chromiumBridgeMessage)',
    "do {",
    "let state = try chromiumNativeMessagingHostInstaller.install()",
    "Chromium bridge install failed: \\(error.localizedDescription)",
):
    if required not in settings:
        fail(f"Settings must surface launch and repair bridge install failures: missing {required}")

if "try! chromiumNativeMessagingHostInstaller.install()" in settings:
    fail("Settings Repair Bridge action must not crash when Chromium native bridge install throws")

reveal = section(
    settings,
    "    private func revealChromiumExtension() {",
    "\n    }\n\n    private func openChromiumExtensionsPage",
)
if "Bundle.main.resourceURL!" in reveal or "precondition(" in reveal:
    fail("Settings Reveal Extension action must not crash on a missing app bundle or extension folder")
for required in (
    "guard let resourceURL = Bundle.main.resourceURL else {",
    "guard FileManager.default.fileExists(atPath: extensionURL.appendingPathComponent(\"manifest.json\").path) else {",
):
    if required not in reveal:
        fail(f"Settings Reveal Extension action must degrade gracefully: missing {required}")

probe = section(
    environment,
    "final class MediaRoutingProbeController {",
    "\n}\n\nprivate enum MediaRoutingProbeAction",
)
for forbidden in (
    "userInfo!",
    "as! String",
    "try! decoder.decode",
    "request.targetID!",
    "request.command!",
    "try! encoder.encode",
    "String(data: data, encoding: .utf8)!",
):
    if forbidden in probe:
        fail(f"MediaRoutingProbeController must not force untrusted probe input: found {forbidden}")
for required in (
    'guard let payload = notification.userInfo?["payload"] as? String else {',
    'logger.error("Ignoring media routing probe request without string payload")',
    "request = try decoder.decode(",
    'logger.error("Ignoring media routing probe decode failure',
    'message: "missing_target_id"',
    'message: "missing_command"',
    "data = try encoder.encode(response)",
    'logger.error("Dropping media routing probe response encode failure',
    "guard let json = String(data: data, encoding: .utf8) else {",
):
    if required not in probe:
        fail(f"MediaRoutingProbeController must log, ignore, or publish typed probe failures: missing {required}")

print("verify_app_environment_external_input_semantics=ok")
PY
