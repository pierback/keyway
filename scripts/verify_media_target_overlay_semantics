#!/usr/bin/env bash
set -euo pipefail

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
overlay="$repo_root/SonosHandoffMenuBar/SonosHandoffMenuBar/App/MediaTargetOverlayView.swift"
model="$repo_root/SonosHandoffMenuBar/SonosHandoffMenuBar/App/MediaTargetOverlayModel.swift"
controller="$repo_root/SonosHandoffMenuBar/SonosHandoffMenuBar/App/MediaTargetOverlayController.swift"
transport="$repo_root/SonosHandoffMenuBar/SonosHandoffMenuBar/App/MediaTransportActionController.swift"

python3 - "$overlay" "$model" "$controller" "$transport" <<'PY'
from pathlib import Path
import re
import sys

view = Path(sys.argv[1]).read_text()
model = Path(sys.argv[2]).read_text()
controller = Path(sys.argv[3]).read_text()
transport = Path(sys.argv[4]).read_text()
row_start = view.index("    private func targetRow(")
row_end = view.index("\n    private var volumePanel", row_start)
row = view[row_start:row_end]
for required in (
    'let routeConfirmation = model.routeConfirmationSequence != nil',
    'let confirming = routeConfirmation && selected',
    'routeConfirmationLabel(target: target)',
    'playbackState(target: target, suspect: suspect)',
    'mediaTargetOverlay.playbackState.',
    'mediaTargetOverlay.playbackTransition.',
    'case .play: ("Playing", "play.fill")',
    'case .pause: ("Paused", "pause.fill")',
    '.symbolEffect(.variableColor.iterative, isActive: !accessibilityReduceMotion)',
    'Text("Not responding")',
    'actionVerb(for: target)',
    '.disabled(routeConfirmation)',
    '.allowsHitTesting(!routeConfirmation)',
    '.id(target.id)',
):
    if required not in row:
        raise SystemExit(
            f"verify_media_target_overlay_semantics: target rows must expose playback state and route feedback: {required!r}"
        )
for forbidden in (
    'was \\(transition.fromTitle)',
    '.blendMode(.screen)',
    '.rotationEffect(',
    '.shadow(color: Color.accentColor',
    'animatedRouteConfirmationSequence',
):
    if forbidden in view:
        raise SystemExit(
            f"verify_media_target_overlay_semantics: route confirmation must stay a single quiet state change: {forbidden!r}"
        )
if 'accessibilityReduceMotion ? nil : .snappy(duration: 0.28), value: model.routeConfirmationSequence' not in view:
    raise SystemExit(
        "verify_media_target_overlay_semantics: route confirmation animation must be keyed to the route sequence and honor Reduce Motion"
    )
if "asyncAfter" in view:
    raise SystemExit(
        "verify_media_target_overlay_semantics: playback transition lifetime must not use an independent timer"
    )

header_start = view.index("    private var commandHeader: some View {")
header_end = view.index("\n    private var targetList", header_start)
header = view[header_start:header_end]
for required in (
    'model.command?.symbolName ?? "music.note.list"',
    'model.command?.displayName ?? "Media Sources"',
    '"Choose where it goes · \\(count)"',
):
    if required not in view:
        raise SystemExit(
            f"verify_media_target_overlay_semantics: command header must name the pending action: {required!r}"
        )
if 'proxy.scrollTo(targetID)' not in view:
    raise SystemExit("verify_media_target_overlay_semantics: selection must scroll into view")

visible_literals = re.findall(r'\b(?:Text|Label)\("([^"]*)"', view)
if any("automatic" in literal.casefold() for literal in visible_literals):
    raise SystemExit(
        "verify_media_target_overlay_semantics: automatic routing must not add alternate visible wording"
    )

footer_start = view.index("    private var footer: some View {")
footer_end = view.index("\n    private func footerHint(", footer_start)
footer = view[footer_start:footer_end]
for required in (
    'footerHint("↑↓", "Select")',
    'footerHint("⌘↵", "Open app")',
    'footerHint("⇥", "Volume")',
    'footerHint("←→", "Adjust")',
    'footerHint("M", "Mute")',
    'footerHint("esc", "Close")',
):
    if required not in footer:
        raise SystemExit(
            f"verify_media_target_overlay_semantics: footer must advertise overlay keys: {required!r}"
        )
if "model.routeConfirmationSequence" in footer:
    raise SystemExit(
        "verify_media_target_overlay_semantics: the footer must not branch for automatic routing"
    )

confirmation_update_start = model.index("    func updateRouteConfirmation(")
confirmation_update_end = model.index("\n    func updateRowsPreservingSelection(", confirmation_update_start)
confirmation_update = model[confirmation_update_start:confirmation_update_end]
for required in (
    '@Published private(set) var routeConfirmationSequence: Int?',
    'func updateRouteConfirmation(',
    'rows: [SourceRow]',
    'self.rows = rows',
    'rows.firstIndex(where: { $0.id == target.id })!',
):
    if required not in model:
        raise SystemExit(
            f"verify_media_target_overlay_semantics: existing overlay model must own route confirmation state: {required!r}"
        )
if "routeConfirmationSequence = (routeConfirmationSequence ?? 0) + 1" not in confirmation_update:
    raise SystemExit(
        "verify_media_target_overlay_semantics: every route confirmation must advance its sequence"
    )

for required in (
    'private static let routeConfirmationDismissInterval: TimeInterval = 0.8',
    'var isAwaitingSelection: Bool',
    'func showAutomaticRoute(',
    'panel.hidesOnDeactivate = false',
    'panel.ignoresMouseEvents = true',
    'panel.orderFrontRegardless()',
):
    if required not in controller:
        raise SystemExit(
            f"verify_media_target_overlay_semantics: passive overlay controller path is missing {required!r}"
        )

automatic_route_start = controller.index("    func showAutomaticRoute(")
automatic_route_end = controller.index("\n    func close()", automatic_route_start)
automatic_route = controller[automatic_route_start:automatic_route_end]
for required in (
    'rows: [SourceRow]',
    'presentRouteConfirmation(command: command, target: target, rows: rows)',
    "NSAccessibility.post(",
    "element: NSApplication.shared",
    "notification: .announcementRequested",
    '.announcement: "\\(target.appName) selected automatically for \\(command.displayName)"',
):
    if required not in automatic_route:
        raise SystemExit(
            f"verify_media_target_overlay_semantics: automatic route announcement is missing {required!r}"
        )

confirmation_start = controller.index("    private func presentRouteConfirmation(")
confirmation_end = controller.index("\n    func close()", confirmation_start)
confirmation = controller[confirmation_start:confirmation_end]
for required in (
    'model.updateRouteConfirmation(command: command, target: target, rows: rows)',
    'panel.hidesOnDeactivate = false',
    'panel.ignoresMouseEvents = true',
    'deadline: .now() + Self.routeConfirmationDismissInterval',
):
    if required not in confirmation:
        raise SystemExit(
            f"verify_media_target_overlay_semantics: shared route confirmation lifecycle is missing {required!r}"
        )

choose_start = controller.index("    private func choose(")
choose_end = controller.index("\n    private func focus(", choose_start)
choose = controller[choose_start:choose_end]
for required in (
    'guard let confirmationCommand = choose?(target, command) else',
    'let application = applicationToRestoreAfterSelection',
    'let keyWindow = keyWindowToRestoreAfterSelection',
    'NSApp.yieldActivation(to: application)',
    '_ = application.activate(options: [])',
    'keyWindow.makeKey()',
    'NSApp.deactivate()',
    'let rows = model.rows',
    'presentRouteConfirmation(command: confirmationCommand, target: target, rows: rows)',
):
    if required not in choose:
        raise SystemExit(
            f"verify_media_target_overlay_semantics: manual routing must reuse row confirmation: {required!r}"
        )
if "panel.resignKey()" in controller:
    raise SystemExit(
        "verify_media_target_overlay_semantics: AppKit must relinquish focus through public activation APIs"
    )

chooser_show_start = transport.index("        let chooserID = chooserSession.begin(command: command)")
chooser_show_end = transport.index("\n    private func sortedTargets(", chooser_show_start)
chooser_show = transport[chooser_show_start:chooser_show_end]
for required in (
    "let previousRouteConfirmation = routeConfirmationPresentation.flatMap",
    "after: previousRouteConfirmation?.targetID == target.id",
    "self.routeConfirmationPresentation = (target.id, confirmationCommand)",
    "return confirmationCommand",
):
    if required not in chooser_show:
        raise SystemExit(
            f"verify_media_target_overlay_semantics: manual confirmation must preserve rapid Play/Pause direction: {required!r}"
        )

focus_loss_start = controller.index("    private func closeFromFocusLoss()")
focus_loss_end = controller.index("\n    private func close(notifyDismiss:", focus_loss_start)
if "guard isAwaitingSelection else" not in controller[focus_loss_start:focus_loss_end]:
    raise SystemExit(
        "verify_media_target_overlay_semantics: focus loss must close only the interactive chooser"
    )

guard_start = transport.index("    private func chooserReentryBlocked(")
guard_end = transport.index("\n    private func showChooserImmediately(", guard_start)
guard_body = transport[guard_start:guard_end]
if "overlayController.isAwaitingSelection" not in guard_body:
    raise SystemExit(
        "verify_media_target_overlay_semantics: automatic confirmation must not block a subsequent media command"
    )
if "overlayController.isVisible || chooserSession.isActive" in guard_body:
    raise SystemExit(
        "verify_media_target_overlay_semantics: generic overlay visibility must not be treated as an active chooser"
    )

send_start = transport.index("    private func send(\n")
send_end = transport.index("\n    private func dispatchFromChooser(", send_start)
send_body = transport[send_start:send_end]
if "private var routeConfirmationPresentation: (targetID: String, command: MediaRemoteTransportCommand)?" not in transport:
    raise SystemExit(
        "verify_media_target_overlay_semantics: route confirmation must retain pending Play/Pause state"
    )
if "automaticRoutePresentation" in transport:
    raise SystemExit(
        "verify_media_target_overlay_semantics: route presentation state must use the generic hard-cutover name"
    )
for required in (
    "after: previousConfirmationCommand",
    "routeConfirmationPresentation = (target.id, spotlightCommand)",
    "overlayController.showAutomaticRoute(command: spotlightCommand, target: target, rows: rows)",
):
    if required not in send_body:
        raise SystemExit(
            f"verify_media_target_overlay_semantics: automatic route action presentation is missing {required!r}"
        )
if transport.count("rows: sourceRows(for: targets)") < 2:
    raise SystemExit(
        "verify_media_target_overlay_semantics: automatic spotlight must receive the normal chooser rows"
    )
spotlight = send_body.find("overlayController.showAutomaticRoute(command: spotlightCommand, target: target, rows: rows)")
dispatch = send_body.find("let dispatchID = beginBoundedProgrammaticDispatch(command: spotlightCommand)")
if spotlight == -1 or dispatch == -1 or spotlight > dispatch:
    raise SystemExit(
        "verify_media_target_overlay_semantics: automatic target must be shown before dispatch starts"
    )
if "send(command: spotlightCommand, to: target, dispatchID: dispatchID" not in send_body:
    raise SystemExit(
        "verify_media_target_overlay_semantics: automatic target must dispatch the same explicit command that the confirmation presents"
    )

chooser_start = transport.index("onChoose: {")
chooser_end = transport.index("onFocus:", chooser_start)
chooser_body = transport[chooser_start:chooser_end]
if "command: confirmationCommand" not in chooser_body:
    raise SystemExit(
        "verify_media_target_overlay_semantics: manually selected target must dispatch the same explicit command that the confirmation presents"
    )

if 'message: "Routed automatically"' in transport:
    raise SystemExit(
        "verify_media_target_overlay_semantics: automatic routing must not also emit the old success notification"
    )

print("verify_media_target_overlay_semantics=ok")
PY
