#!/usr/bin/env bash
set -euo pipefail

ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
PACKAGE_DIR="$ROOT_DIR/packages/SonosHandoffCore"

run() {
  echo "+ $*"
  "$@"
}

run swift test --package-path "$PACKAGE_DIR"
run "$ROOT_DIR/scripts/verify_shortcut_event_parser_semantics"
run "$ROOT_DIR/scripts/verify_menubar_output_section_semantics"
run "$ROOT_DIR/scripts/verify_settings_feature_semantics"
run "$ROOT_DIR/scripts/verify_desktop_transport_semantics"
run "$ROOT_DIR/scripts/verify_chromium_extension_transport_semantics"
run "$ROOT_DIR/scripts/verify_chromium_extension_semantics"
run "$ROOT_DIR/scripts/verify_mixed_media_routing_semantics"
run "$ROOT_DIR/scripts/verify_media_routing_probe_semantics"
run git -C "$ROOT_DIR" diff --check
run "$ROOT_DIR/scripts/install_menubar_app"

if [[ "${SONOS_HANDOFF_REAL_DEVICE_SMOKE:-0}" == "1" ]]; then
  ROOM="${SONOS_HANDOFF_ROOM:-Port}"
  run "$ROOT_DIR/scripts/smoke_port_handoff" "$ROOM"
  run "$ROOT_DIR/scripts/smoke_menubar_handoff" "$ROOM"
  run "$ROOT_DIR/scripts/smoke_menubar_slider" "$ROOM"
fi

if [[ "${KEYWAY_OVERLAY_UI_SMOKE:-0}" == "1" ]]; then
  run "$ROOT_DIR/scripts/smoke_overlay_browser_controls"
fi

if [[ "${KEYWAY_TRANSPORT_UI_SMOKE:-0}" == "1" ]]; then
  run "$ROOT_DIR/scripts/smoke_transport_routing_confirmation"
fi

if [[ "${KEYWAY_SPOTIFY_APPLEEVENT_SMOKE:-0}" == "1" ]]; then
  run "$ROOT_DIR/scripts/smoke_spotify_appleevent_transport"
fi

if [[ "${KEYWAY_HELIUM_JAVASCRIPT_SMOKE:-0}" == "1" ]]; then
  run "$ROOT_DIR/scripts/smoke_helium_javascript_transport"
fi

if [[ "${KEYWAY_CHROMIUM_EXTENSION_SMOKE:-0}" == "1" ]]; then
  run "$ROOT_DIR/scripts/smoke_chromium_extension_transport"
fi

if [[ "${KEYWAY_MIXED_MEDIA_ROUTING_SMOKE:-0}" == "1" ]]; then
  run "$ROOT_DIR/scripts/smoke_mixed_media_routing"
fi

echo "regression_gate=ok"
