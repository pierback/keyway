#!/usr/bin/env bash
set -euo pipefail

ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
PACKAGE_DIR="$ROOT_DIR/packages/SonosHandoffCore"
export CLANG_MODULE_CACHE_PATH="${CLANG_MODULE_CACHE_PATH:-$ROOT_DIR/.build/clang-module-cache}"
mkdir -p "$CLANG_MODULE_CACHE_PATH"

run() {
  echo "+ $*"
  "$@"
}

run swift test --disable-sandbox --package-path "$PACKAGE_DIR"
APP_DERIVED_DATA="$(mktemp -d /tmp/keyway-regression.XXXXXX)"
trap 'rm -rf "$APP_DERIVED_DATA"' EXIT
run xcodebuild \
  -quiet \
  -workspace "$ROOT_DIR/Keyway.xcworkspace" \
  -scheme Keyway \
  -destination platform=macOS \
  -derivedDataPath "$APP_DERIVED_DATA" \
  CODE_SIGNING_ALLOWED=NO \
  EXPANDED_CODE_SIGN_IDENTITY=- \
  build
for verifier in "$ROOT_DIR"/scripts/verify_*; do
  run "$verifier"
done
scripts=()
for script in "$ROOT_DIR"/scripts/*; do
  [[ -f "$script" ]] || continue
  [[ "$script" == "$ROOT_DIR"/scripts/verify_* ]] && continue
  IFS= read -r shebang < "$script"
  [[ "$shebang" == "#!/usr/bin/env bash" ]] && scripts+=("$script")
done
run bash -n "${scripts[@]}"
run git -C "$ROOT_DIR" diff --check

if [[ "${SONOS_HANDOFF_REAL_DEVICE_SMOKE:-0}" == "1" ]]; then
  ROOM="${SONOS_HANDOFF_ROOM:?Set SONOS_HANDOFF_ROOM to the Sonos room to verify}"
  run "$ROOT_DIR/scripts/smoke_port_handoff" "$ROOM"
  run "$ROOT_DIR/scripts/smoke_menubar_handoff" "$ROOM"
  run "$ROOT_DIR/scripts/smoke_menubar_slider" "$ROOM"
fi

if [[ "${KEYWAY_OVERLAY_UI_SMOKE:-0}" == "1" ]]; then
  run "$ROOT_DIR/scripts/smoke_overlay_browser_controls"
fi

if [[ "${KEYWAY_TRANSPORT_UI_SMOKE:-0}" == "1" ]]; then
  run "$ROOT_DIR/scripts/smoke_transport_routing_confirmation"
fi

if [[ "${KEYWAY_SPOTIFY_APPLEEVENT_SMOKE:-0}" == "1" ]]; then
  run "$ROOT_DIR/scripts/smoke_spotify_appleevent_transport"
fi

if [[ "${KEYWAY_SPOTIFY_CURRENT_TRACK_SMOKE:-0}" == "1" ]]; then
  run env \
    KEYWAY_SPOTIFY_APPLEEVENT_REQUIRE_CURRENT_TRACK=1 \
    KEYWAY_SPOTIFY_APPLEEVENT_PRIME_CURRENT_TRACK="${KEYWAY_SPOTIFY_CURRENT_TRACK_PRIME:-0}" \
    KEYWAY_SPOTIFY_APPLEEVENT_PRIME_URI="${KEYWAY_SPOTIFY_CURRENT_TRACK_PRIME_URI:-spotify:track:3n3Ppam7vgaVa1iaRUc9Lp}" \
    KEYWAY_SPOTIFY_APPLEEVENT_PRIME_DEVICE_NAME="${KEYWAY_SPOTIFY_CURRENT_TRACK_PRIME_DEVICE_NAME:-}" \
    KEYWAY_SPOTIFY_APPLEEVENT_PRIME_DEVICE_TYPE="${KEYWAY_SPOTIFY_CURRENT_TRACK_PRIME_DEVICE_TYPE:-Computer}" \
    KEYWAY_SPOTIFY_APPLEEVENT_REBOUND_CHECK=1 \
    KEYWAY_SPOTIFY_APPLEEVENT_BACKGROUND_CHECK=1 \
    KEYWAY_SPOTIFY_APPLEEVENT_ITERATIONS="${KEYWAY_SPOTIFY_CURRENT_TRACK_ITERATIONS:-6}" \
    KEYWAY_SPOTIFY_APPLEEVENT_REBOUND_ITERATIONS="${KEYWAY_SPOTIFY_CURRENT_TRACK_REBOUND_ITERATIONS:-10}" \
    "$ROOT_DIR/scripts/smoke_spotify_appleevent_transport"
fi

if [[ "${KEYWAY_SPOTIFY_WEBAPI_SMOKE:-0}" == "1" ]]; then
  run "$ROOT_DIR/scripts/smoke_spotify_webapi_transport"
fi

if [[ "${KEYWAY_HELIUM_CHROMIUM_EXTENSION_SMOKE:-0}" == "1" ]]; then
  run "$ROOT_DIR/scripts/smoke_helium_chromium_extension_transport"
fi

if [[ "${KEYWAY_CHROMIUM_EXTENSION_SMOKE:-0}" == "1" ]]; then
  run "$ROOT_DIR/scripts/smoke_chromium_extension_transport"
fi

if [[ "${KEYWAY_CHROMIUM_WORKER_SUSPENSION_SMOKE:-0}" == "1" ]]; then
  run "$ROOT_DIR/scripts/smoke_chromium_worker_suspension"
fi

if [[ "${KEYWAY_MEDIAREMOTE_KILL_SMOKE:-0}" == "1" ]]; then
  run "$ROOT_DIR/scripts/smoke_mediaremote_helper_kill"
fi

if [[ "${KEYWAY_MIXED_MEDIA_ROUTING_SMOKE:-0}" == "1" ]]; then
  run "$ROOT_DIR/scripts/smoke_mixed_media_routing"
fi

echo "regression_gate=ok"
