#!/usr/bin/env bash
set -euo pipefail

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
selection="$repo_root/SonosHandoffMenuBar/SonosHandoffMenuBar/App/PlaybackOutputSelection.swift"
policy="$repo_root/packages/SonosHandoffCore/Sources/SonosHandoffCore/Handoff/PlaybackOutputSelectionPolicy.swift"
controller="$repo_root/SonosHandoffMenuBar/SonosHandoffMenuBar/App/PlaybackSyncController.swift"
background_sync="$repo_root/SonosHandoffMenuBar/SonosHandoffMenuBar/App/PlaybackBackgroundSync.swift"
status_item="$repo_root/SonosHandoffMenuBar/SonosHandoffMenuBar/App/KeywayStatusItemController.swift"
app_dir="$repo_root/SonosHandoffMenuBar/SonosHandoffMenuBar"

python3 - "$selection" "$policy" "$controller" "$background_sync" "$status_item" "$app_dir" <<'PY'
import pathlib
import sys

selection_path = pathlib.Path(sys.argv[1])
policy_path = pathlib.Path(sys.argv[2])
controller_path = pathlib.Path(sys.argv[3])
background_path = pathlib.Path(sys.argv[4])
status_item_path = pathlib.Path(sys.argv[5])
app_dir = pathlib.Path(sys.argv[6])
selection = selection_path.read_text()
policy = policy_path.read_text()
controller = controller_path.read_text()
background = background_path.read_text()
status_item = status_item_path.read_text()
app_sources = "\n".join(path.read_text() for path in app_dir.rglob("*.swift"))

for source in (
    "activePlaybackObservation",
    "directoryRefresh",
    "userSelection",
    "playbackTransaction",
    "reset",
):
    if f"case {source}" not in policy:
        raise SystemExit(f"verify_playback_output_selection_semantics: missing selection source {source}")

observation_guard = (
    "guard !hasUserSelection || "
    "SonosRoomName.matches(self.roomName, roomName) else"
)
if observation_guard not in policy:
    raise SystemExit(
        "verify_playback_output_selection_semantics: background observations must not replace a user selection"
    )

if app_sources.count("SonosVolumeMonitor.shared.setTarget(") != 1:
    raise SystemExit(
        "verify_playback_output_selection_semantics: PlaybackOutputSelection must be the only volume-monitor target writer"
    )
if "SonosVolumeMonitor.shared.setTarget(" not in selection:
    raise SystemExit(
        "verify_playback_output_selection_semantics: selection and volume-monitor target must update atomically"
    )
if ".setSelection(" in app_sources:
    raise SystemExit(
        "verify_playback_output_selection_semantics: raw selection writers must use the shared authority policy"
    )

if "selectRoomName(roomName, source: .userSelection)" not in controller:
    raise SystemExit(
        "verify_playback_output_selection_semantics: menu speaker selection must establish user authority"
    )
if "selectRoomName(outcome.roomName, source: .playbackTransaction)" not in controller:
    raise SystemExit(
        "verify_playback_output_selection_semantics: confirmed menu transfer must release user authority"
    )
if "source: .activePlaybackObservation" not in background:
    raise SystemExit(
        "verify_playback_output_selection_semantics: background polling must be classified as an observation"
    )
if "source: .playbackTransaction" not in background:
    raise SystemExit(
        "verify_playback_output_selection_semantics: background transfer completion must be classified as a transaction"
    )

sync_start = controller.index("    private func syncActiveSpotifyOutput(generation: Int) async {")
sync_end = controller.index("\n    private func applyOutputRefresh(", sync_start)
sync_body = controller[sync_start:sync_end]
ticket_index = sync_body.index("guard let ticket = operationGate.beginObservation() else")
await_index = sync_body.index(
    "let status = try await activePlaybackObserver.activePlaybackDeviceStatus()"
)
generation_guard_index = sync_body.index("guard isCurrentAppearance(generation),")
authority_guard_index = sync_body.index("operationGate.isCurrentObservation(ticket)")
mutation_index = sync_body.index("activeSpotifyRoomName =")
if not ticket_index < await_index < generation_guard_index <= authority_guard_index < mutation_index:
    raise SystemExit(
        "verify_playback_output_selection_semantics: popover Spotify sync must reject late appearance and operation results before mutation"
    )

refresh_start = controller.index(
    "    private func applyOutputRefresh(_ refresh: PlaybackOutputRefresh, selectedRoomName resolvedSelectedRoomName: String?)"
)
refresh_end = controller.index("\n    private func preferredCurrentRoomName()", refresh_start)
refresh_body = controller[refresh_start:refresh_end]
for required in (
    "currentRoomName: selectedRoomName ?? outputSelection.roomName",
    "directoryRoomName: resolvedSelectedRoomName",
):
    if required not in refresh_body:
        raise SystemExit(
            f"verify_playback_output_selection_semantics: directory refresh must use the core authority policy: {required}"
        )
if "refresh.rows.first" in refresh_body:
    raise SystemExit(
        "verify_playback_output_selection_semantics: directory refresh must not synthesize the first speaker as selection"
    )

bind_start = background.index("    private func bindRuntimeEvents() {")
bind_end = background.index("\n    private func runEventTask(", bind_start)
bind_body = background[bind_start:bind_end]
if "Task { @MainActor" in bind_body:
    raise SystemExit(
        "verify_playback_output_selection_semantics: background event subscriptions must not create unowned tasks"
    )
if bind_body.count("runEventTask") < 2:
    raise SystemExit(
        "verify_playback_output_selection_semantics: background events must enter the shared task owner"
    )
for required in (
    "private var eventTasks: [UUID: Task<Void, Never>] = [:]",
    "eventTasks[id] = Task { @MainActor [weak self] in",
    "guard let self, !Task.isCancelled else",
    "for eventTask in eventTasks.values",
    "eventTask.cancel()",
    "eventTasks.removeAll()",
):
    if required not in background:
        raise SystemExit(
            f"verify_playback_output_selection_semantics: background task ownership is incomplete: {required}"
        )
if background.count("guard !Task.isCancelled else") < 3:
    raise SystemExit(
        "verify_playback_output_selection_semantics: notification transactions must reject work cancelled before they start"
    )
if background.count("guard isCurrentObservation(ticket) else") < 10:
    raise SystemExit(
        "verify_playback_output_selection_semantics: Sonos observations must reject stale authority after async boundaries"
    )
if background.count("guard operationGate.isCurrentTransaction(ticket) else") < 10:
    raise SystemExit(
        "verify_playback_output_selection_semantics: Sonos transactions must reject stale authority after async boundaries"
    )

controller_bind = controller[
    controller.index("        self.outputRefreshCancellable ="):
    controller.index("\n    var canControlVolume:")
]
if "Task { @MainActor" in controller_bind:
    raise SystemExit(
        "verify_playback_output_selection_semantics: playback notifications must not create unowned tasks"
    )
for required in (
    "private var notificationTasks: [UUID: Task<Void, Never>] = [:]",
    "self?.runAppearanceTask { controller in",
    "notificationTasks[id] = Task { @MainActor [weak self] in",
    "for notificationTask in notificationTasks.values",
    "notificationTask.cancel()",
    "notificationTasks.removeAll()",
    "operationGate.runTransaction(roomName:",
    "guard operationGate.isCurrentTransaction(ticket, roomName:",
):
    if required not in controller:
        raise SystemExit(
            f"verify_playback_output_selection_semantics: playback UI task ownership is incomplete: {required}"
        )

stop_start = controller.index("    func stop() {")
stop_end = controller.index("\n    private func runAppearanceTask(", stop_start)
stop_body = controller[stop_start:stop_end]
for required in (
    "sliderCommitter.cancel()",
    "operationGate.cancelVolume()",
    "operationGate.cancelTransaction()",
    "monitorCancellable?.cancel()",
    "outputSelectionCancellable?.cancel()",
    "outputRefreshCancellable?.cancel()",
    "cachedOutputRefreshCancellable?.cancel()",
):
    if required not in stop_body:
        raise SystemExit(
            f"verify_playback_output_selection_semantics: playback shutdown must cancel owned work: {required}"
        )

status_stop_start = status_item.index("    func stop() {")
status_stop_end = status_item.index(
    "\n    @objc private func handleStatusItemClick(", status_stop_start
)
if "playback.stop()" not in status_item[status_stop_start:status_stop_end]:
    raise SystemExit(
        "verify_playback_output_selection_semantics: status item shutdown must stop playback-owned work"
    )
PY

echo "verify_playback_output_selection_semantics=ok"
