#!/usr/bin/env bash
set -euo pipefail

ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
PACKAGE_DIR="$ROOT_DIR/packages/SonosHandoffCore"
ROOM="${1:-${SONOS_HANDOFF_ROOM:-Port}}"
OUTPUT_FILE="$(mktemp -t sonos-handoff-port-handoff.XXXXXX)"

cleanup() {
  rm -f "$OUTPUT_FILE"
}
trap cleanup EXIT

swift run --package-path "$PACKAGE_DIR" sonos-handoff-port handoff "$ROOM" | tee "$OUTPUT_FILE"

if ! grep -q '^handoff=ok$' "$OUTPUT_FILE"; then
  echo "smoke_port_handoff: missing handoff=ok" >&2
  exit 1
fi

if ! grep -q '^sonos_transport=playing$' "$OUTPUT_FILE"; then
  echo "smoke_port_handoff: Sonos did not report local playback" >&2
  exit 1
fi

echo "smoke_port_handoff=ok"
