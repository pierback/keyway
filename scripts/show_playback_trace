#!/usr/bin/env bash
set -euo pipefail

status_file="${1:-$HOME/Library/Application Support/keyway/shortcut-runtime-status.json}"

if [[ ! -f "$status_file" ]]; then
  printf 'show_playback_trace: missing status file: %s\n' "$status_file" >&2
  exit 1
fi

if ! /usr/bin/plutil -extract mediaTransportTrace raw "$status_file" >/dev/null 2>&1; then
  printf 'show_playback_trace: no mediaTransportTrace entries in %s\n' "$status_file"
  exit 0
fi

/usr/bin/plutil -extract mediaTransportTrace json -o - "$status_file"
