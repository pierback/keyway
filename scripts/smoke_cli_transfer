#!/usr/bin/env bash
set -euo pipefail

ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
DERIVED_DATA_DIR="$ROOT_DIR/.build/xcode-derived-data"
CLI_BINARY="$DERIVED_DATA_DIR/Build/Products/Debug/sonos-handoff"
PACKAGE_DIR="$ROOT_DIR/packages/SonosHandoffCore"
ALIAS="${1:-${SONOS_HANDOFF_ALIAS:-port}}"
ROOM="${SONOS_HANDOFF_ROOM:-Port}"
TRANSFER_OUTPUT="$(mktemp -t sonos-handoff-cli-transfer.XXXXXX)"
STATUS_OUTPUT="$(mktemp -t sonos-handoff-cli-transfer-status.XXXXXX)"

cleanup() {
  rm -f "$TRANSFER_OUTPUT" "$STATUS_OUTPUT"
}
trap cleanup EXIT

xcodebuild \
  -workspace "$ROOT_DIR/SonosHandoff.xcworkspace" \
  -scheme SonosHandoffCLI \
  -configuration Debug \
  -destination 'platform=macOS' \
  -derivedDataPath "$DERIVED_DATA_DIR" \
  build >/dev/null

"$CLI_BINARY" transfer "$ALIAS" | tee "$TRANSFER_OUTPUT"

if ! grep -q '^Transferred via Spotify Connect[.]$' "$TRANSFER_OUTPUT"; then
  echo "smoke_cli_transfer: transfer command did not report success" >&2
  exit 1
fi

swift run --package-path "$PACKAGE_DIR" sonos-handoff-port sonos-status "$ROOM" >"$STATUS_OUTPUT"
cat "$STATUS_OUTPUT"

if ! grep -q '^current_uri=x-sonos-vli:.*spotify:' "$STATUS_OUTPUT"; then
  echo "smoke_cli_transfer: Sonos was not in Spotify Connect mode" >&2
  exit 1
fi

if ! grep -Eq '^transport_state=(PLAYING|TRANSITIONING)$' "$STATUS_OUTPUT"; then
  echo "smoke_cli_transfer: Sonos did not report playback" >&2
  exit 1
fi

echo "smoke_cli_transfer=ok"
