#!/usr/bin/env bash
set -euo pipefail

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
workdir="$(mktemp -d)"
server_pid=""
browser_pid=""
monitor_pid=""

stop_process() {
  local pid="$1"
  [[ -n "$pid" ]] || return
  kill -TERM "$pid" >/dev/null 2>&1 || true
  for _ in {1..50}; do
    if ! kill -0 "$pid" >/dev/null 2>&1; then
      wait "$pid" >/dev/null 2>&1 || true
      return
    fi
    sleep 0.1
  done
  pkill -TERM -P "$pid" >/dev/null 2>&1 || true
  kill -KILL "$pid" >/dev/null 2>&1 || true
  wait "$pid" >/dev/null 2>&1 || true
}

cleanup() {
  stop_process "$monitor_pid"
  stop_process "$browser_pid"
  stop_process "$server_pid"
  for _ in {1..20}; do
    if rm -rf "$workdir" >/dev/null 2>&1; then
      return
    fi
    sleep 0.1
  done
  rm -rf "$workdir" >/dev/null 2>&1 || true
}
trap cleanup EXIT

fail() {
  printf 'smoke_chromium_worker_suspension: %s\n' "$1" >&2
  exit 1
}

contract_path="$repo_root/ChromiumBridgeProtocol/contract.json"
extension_id="$(python3 -c 'import json,sys; print(json.load(open(sys.argv[1]))["extensionID"])' "$contract_path")"
app_identifier="$(python3 -c 'import json,sys; print(json.load(open(sys.argv[1]))["appBundleIdentifier"])' "$contract_path")"
team_identifier="$(python3 -c 'import json,sys; print(json.load(open(sys.argv[1]))["teamIdentifier"])' "$contract_path")"
bridge_endpoint="$workdir/chromium-bridge.sock"

browser_path="${KEYWAY_CHROMIUM_SMOKE_BROWSER_PATH:-}"
if [[ -z "$browser_path" ]]; then
  if [[ -x "/Applications/Brave Browser.app/Contents/MacOS/Brave Browser" ]]; then
    browser_path="/Applications/Brave Browser.app/Contents/MacOS/Brave Browser"
  elif [[ -x "/Applications/Google Chrome.app/Contents/MacOS/Google Chrome" ]]; then
    browser_path="/Applications/Google Chrome.app/Contents/MacOS/Google Chrome"
  else
    fail "Google Chrome or Brave Browser must be installed, or set KEYWAY_CHROMIUM_SMOKE_BROWSER_PATH"
  fi
fi

playwright_module="$(
  node --input-type=module -e "console.log(await import.meta.resolve('playwright'))" \
    || fail "Playwright must be available to launch Chromium with extension support"
)"

"$repo_root/scripts/install_chromium_native_host" >/dev/null

cat >"$workdir/server.py" <<'PY'
import http.server
import math
import pathlib
import socketserver
import struct
import sys
import wave

root = pathlib.Path(sys.argv[1])
port_file = pathlib.Path(sys.argv[2])

sample_rate = 44100
with wave.open(str(root / "tone.wav"), "w") as wav:
    wav.setnchannels(1)
    wav.setsampwidth(2)
    wav.setframerate(sample_rate)
    for index in range(sample_rate):
        value = int(1200 * math.sin(2 * math.pi * 440 * index / sample_rate))
        wav.writeframesraw(struct.pack("<h", value))

(root / "index.html").write_text("""<!doctype html>
<html>
<head><meta charset="utf-8"><title>Keyway Chromium Suspension Smoke</title></head>
<body>
<audio id="media" controls preload="auto" autoplay loop src="/tone.wav"></audio>
<script>
media.volume = 0.4;
navigator.mediaSession.metadata = new MediaMetadata({
  title: "Keyway Chromium Suspension Track",
  artist: "Keyway",
  album: "Worker Suspension",
});
media.play();
</script>
</body>
</html>
""", encoding="utf-8")

class QuietHandler(http.server.SimpleHTTPRequestHandler):
    def log_message(self, format, *args):
        return

socketserver.TCPServer.allow_reuse_address = True
with socketserver.TCPServer(("127.0.0.1", 0), QuietHandler) as httpd:
    pathlib.os.chdir(root)
    port_file.write_text(str(httpd.server_address[1]), encoding="utf-8")
    httpd.serve_forever()
PY

port_file="$workdir/port"
python3 "$workdir/server.py" "$workdir" "$port_file" &
server_pid="$!"

for _ in {1..100}; do
  if [[ -s "$port_file" ]]; then
    break
  fi
  sleep 0.05
done
[[ -s "$port_file" ]] || fail "local smoke server did not start"

port="$(cat "$port_file")"
profile_dir="$workdir/profile"
mkdir -p "$profile_dir"

cat >"$workdir/launch-browser.mjs" <<'JS'
import fs from "node:fs/promises";

const [playwrightModule, browserPath, userDataDir, extensionPath, readyFile, targetURL] = process.argv.slice(2);
const { chromium } = await import(playwrightModule);
const context = await chromium.launchPersistentContext(userDataDir, {
  headless: false,
  executablePath: browserPath,
  ignoreDefaultArgs: ["--disable-extensions"],
  args: [
    `--load-extension=${extensionPath}`,
    "--autoplay-policy=no-user-gesture-required",
    "--no-first-run",
    "--no-default-browser-check",
    "--remote-debugging-port=0",
  ],
});

const page = await context.newPage();
await page.goto(targetURL);
await fs.writeFile(readyFile, "ready", "utf8");

let closing = false;
const close = async () => {
  if (closing) return;
  closing = true;
  await Promise.race([
    context.close(),
    new Promise(resolve => setTimeout(resolve, 4000)),
  ]);
  process.exit(0);
};

process.on("SIGTERM", close);
process.on("SIGINT", close);
await new Promise(() => {});
JS

browser_ready_file="$workdir/browser-ready"
browser_log_file="$workdir/browser.log"
KEYWAY_CHROMIUM_BRIDGE_ENDPOINT="$bridge_endpoint" node "$workdir/launch-browser.mjs" \
  "$playwright_module" \
  "$browser_path" \
  "$profile_dir" \
  "$repo_root/ChromiumExtension" \
  "$browser_ready_file" \
  "http://127.0.0.1:$port/index.html" \
  >"$browser_log_file" 2>&1 &
browser_pid="$!"

for _ in {1..600}; do
  if [[ -s "$browser_ready_file" ]]; then
    break
  fi
  sleep 0.05
done

if [[ ! -s "$browser_ready_file" ]]; then
  if [[ -s "$browser_log_file" ]]; then
    sed 's/^/chromium-worker-suspension-browser: /' "$browser_log_file" >&2
  fi
  fail "Chromium smoke browser did not load the test page"
fi

devtools_active_port="$profile_dir/DevToolsActivePort"
for _ in {1..100}; do
  if [[ -s "$devtools_active_port" ]]; then
    break
  fi
  sleep 0.05
done
[[ -s "$devtools_active_port" ]] || fail "Chromium did not expose DevToolsActivePort"

cat >"$workdir/main.swift" <<'SWIFT'
import Foundation

let readyPath = CommandLine.arguments[1]
let donePath = CommandLine.arguments[2]
let failPath = CommandLine.arguments[3]
let bridgeEndpoint = URL(fileURLWithPath: CommandLine.arguments[4])
let smokePageTitle = "Keyway Chromium Suspension Smoke"

struct Snapshot: Decodable {
    let protocolVersion: Int
    let profileGuid: String
    let connectionID: String
    let epoch: Int?
    let resumed: Bool?
    let targets: [Target]
}

struct Target: Decodable {
    let id: String
    let pageTitle: String
    let title: String
}

final class Monitor: @unchecked Sendable {
    private let decoder = JSONDecoder()
    private let lock = NSLock()
    private var initialIDs: Set<String>?
    private var initialConnectionID: String?
    private var initialProfileGuid: String?
    private var resumedAt: TimeInterval?
    private(set) var failed = false

    func handleSnapshot(_ payload: String) {
        lock.lock()
        defer { lock.unlock() }
        let snapshot = try! decoder.decode(Snapshot.self, from: Data(payload.utf8))
        precondition(
            snapshot.protocolVersion == KeywayChromiumBridgeContract.protocolVersion,
            "Chromium extension snapshot protocol must match the canonical bridge contract."
        )
        let smokeTargets = snapshot.targets.filter { $0.pageTitle == smokePageTitle }
        if initialIDs == nil {
            guard !smokeTargets.isEmpty else {
                return
            }
            initialIDs = Set(smokeTargets.map(\.id))
            initialConnectionID = snapshot.connectionID
            initialProfileGuid = snapshot.profileGuid
            try! "ready".write(toFile: readyPath, atomically: true, encoding: .utf8)
            return
        }
        guard snapshot.profileGuid == initialProfileGuid else {
            return
        }

        if smokeTargets.isEmpty {
            failed = true
            try! "target set went empty after initial discovery\n".write(toFile: failPath, atomically: true, encoding: .utf8)
            return
        }

        let ids = Set(smokeTargets.map(\.id))
        if ids == initialIDs && snapshot.connectionID != initialConnectionID {
            resumedAt = resumedAt ?? ProcessInfo.processInfo.systemUptime
        }
        if ids != initialIDs {
            failed = true
            try! "target IDs changed after worker suspension: \(Array(ids).sorted())\n".write(toFile: failPath, atomically: true, encoding: .utf8)
        }
    }

    var done: Bool {
        lock.lock()
        defer { lock.unlock() }
        guard let resumedAt else {
            return false
        }
        return ProcessInfo.processInfo.systemUptime - resumedAt >= 2
    }

    var hasFailed: Bool {
        lock.lock()
        defer { lock.unlock() }
        return failed
    }
}

let monitor = Monitor()
let bridgeServer = KeywayChromiumBridgeServer(
    endpointURL: bridgeEndpoint,
    onEvent: { event, payload in
        if event == .snapshot {
            monitor.handleSnapshot(payload)
        }
    }
)
do {
    try bridgeServer.start()
} catch {
    try! "bridge server failed: \(error)\n".write(toFile: failPath, atomically: true, encoding: .utf8)
    exit(1)
}
defer {
    bridgeServer.stop()
}

let deadline = Date(timeIntervalSinceNow: 30)
while Date() < deadline {
    RunLoop.current.run(mode: .default, before: Date(timeIntervalSinceNow: 0.025))
    if monitor.hasFailed {
        exit(1)
    }
    if monitor.done {
        try! "done".write(toFile: donePath, atomically: true, encoding: .utf8)
        exit(0)
    }
}

try! "timed out waiting for resumed worker snapshot\n".write(toFile: failPath, atomically: true, encoding: .utf8)
exit(1)
SWIFT

ipc_sources=("$repo_root"/packages/SonosHandoffCore/Sources/KeywayChromiumBridgeIPC/*.swift)
swiftc \
  -framework Security \
  "${ipc_sources[@]}" \
  "$workdir/main.swift" \
  -o "$workdir/worker-suspension-monitor"
signing_identity="${KEYWAY_SIGNING_IDENTITY:-}"
if [[ -z "$signing_identity" ]]; then
  signing_identity="$(security find-identity -v -p codesigning \
    | awk '$0 ~ /Apple Development/ && $0 !~ /CSSMERR_/ { print $2; exit }')"
fi
if [[ -z "$signing_identity" ]]; then
  fail "no Apple Development signing identity for team $team_identifier"
fi
codesign \
  --force \
  --options runtime \
  --timestamp=none \
  --identifier "$app_identifier" \
  --sign "$signing_identity" \
  "$workdir/worker-suspension-monitor"
signed_team_identifier="$(codesign -dvv "$workdir/worker-suspension-monitor" 2>&1 \
  | awk -F= '$1 == "TeamIdentifier" { print $2; exit }')"
if [[ "$signed_team_identifier" != "$team_identifier" ]]; then
  fail "smoke peer signed by unexpected team ${signed_team_identifier:-none}; expected $team_identifier"
fi
monitor_ready_file="$workdir/monitor-ready"
monitor_done_file="$workdir/monitor-done"
monitor_fail_file="$workdir/monitor-fail"
"$workdir/worker-suspension-monitor" "$monitor_ready_file" "$monitor_done_file" "$monitor_fail_file" "$bridge_endpoint" &
monitor_pid="$!"

for _ in {1..200}; do
  if [[ -s "$monitor_ready_file" || -s "$monitor_fail_file" ]]; then
    break
  fi
  sleep 0.05
done

if [[ -s "$monitor_fail_file" ]]; then
  fail "$(cat "$monitor_fail_file")"
fi
[[ -s "$monitor_ready_file" ]] || fail "Chromium worker suspension monitor did not discover the initial target"

cat >"$workdir/stop-worker.mjs" <<'JS'
import fs from "node:fs/promises";

const [devtoolsActivePortPath, extensionID] = process.argv.slice(2);
const [port, wsPath] = (await fs.readFile(devtoolsActivePortPath, "utf8")).trim().split(/\r?\n/);
const targetScriptURL = `chrome-extension://${extensionID}/service_worker.js`;
const socket = new WebSocket(`ws://127.0.0.1:${port}${wsPath}`);
const pending = new Map();
let nextID = 1;

socket.addEventListener("message", event => {
  const message = JSON.parse(event.data);
  if (message.id && pending.has(message.id)) {
    const { resolve, reject } = pending.get(message.id);
    pending.delete(message.id);
    if (message.error) {
      reject(new Error(message.error.message || JSON.stringify(message.error)));
    } else {
      resolve(message.result || {});
    }
    return;
  }
});

await new Promise(resolve => socket.addEventListener("open", resolve, { once: true }));

function send(method, params = {}) {
  const id = nextID;
  nextID += 1;
  socket.send(JSON.stringify({ id, method, params }));
  return new Promise((resolve, reject) => {
    pending.set(id, { resolve, reject });
  });
}

const { targetInfos } = await send("Target.getTargets");
const worker = targetInfos.find(target => target.type === "service_worker" && target.url === targetScriptURL);
if (!worker) throw new Error(`did not find extension service worker for ${targetScriptURL}`);
await send("Target.closeTarget", { targetId: worker.targetId });
socket.close();
console.log(`chromium_worker_suspension_stopped_target=${worker.targetId}`);
JS

node "$workdir/stop-worker.mjs" "$devtools_active_port" "$extension_id"

for _ in {1..500}; do
  if [[ -s "$monitor_done_file" || -s "$monitor_fail_file" ]]; then
    break
  fi
  sleep 0.05
done

if [[ -s "$monitor_fail_file" ]]; then
  fail "$(cat "$monitor_fail_file")"
fi
[[ -s "$monitor_done_file" ]] || fail "worker suspension monitor timed out"

printf 'smoke_chromium_worker_suspension=ok\n'
