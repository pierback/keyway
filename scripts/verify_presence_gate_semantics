#!/usr/bin/env bash
set -euo pipefail

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
app_dir="$repo_root/SonosHandoffMenuBar/SonosHandoffMenuBar"
settings="$app_dir/Features/SettingsFeature.swift"
controller="$app_dir/App/MediaTransportActionController.swift"
gate_settings="$app_dir/App/MediaPresenceGateSettings.swift"
probe="$app_dir/App/MediaPresenceProbe.swift"
environment="$app_dir/Support/AppEnvironment.swift"
app="$app_dir/App/SonosHandoffApp.swift"
plist="$app_dir/Resources/Info.plist"
project="$repo_root/SonosHandoffMenuBar/SonosHandoffMenuBar.xcodeproj/project.pbxproj"

fail() {
  printf 'verify_presence_gate_semantics: %s\n' "$*" >&2
  exit 1
}

for path in "$settings" "$controller" "$gate_settings" "$probe" "$environment" "$app" "$plist" "$project"; do
  [[ -f "$path" ]] || fail "missing required file: $path"
done

grep -q 'playPauseGateEnabledKey = "mediaPresenceGate.playPauseEnabled"' "$gate_settings" \
  || fail "presence gate setting must persist behind a stable UserDefaults key"
grep -q '@Published private(set) var playPauseGateEnabled' "$gate_settings" \
  || fail "presence gate setting must be observable but mutated through its setter"
grep -q 'func setPlayPauseGateEnabled(_ enabled: Bool)' "$gate_settings" \
  || fail "presence gate setting must have an explicit setter"

grep -q 'AVCaptureDevice.requestAccess(for: .video)' "$probe" \
  || fail "presence probe must request camera permission through AVFoundation"
grep -q 'VNDetectFaceRectanglesRequest' "$probe" \
  || fail "presence probe must use Vision face detection"
grep -q 'capturePresence(timeoutNanoseconds:' "$probe" \
  || fail "presence probe must capture a single bounded frame"
grep -q 'private func classify(sampleBuffer: CMSampleBuffer)' "$probe" \
  || fail "presence probe must classify the camera frame before crossing async boundaries"
grep -q 'session.sessionPreset = .vga640x480' "$probe" \
  || fail "presence probe should use a small camera frame"
grep -q 'timeoutNanoseconds: UInt64 = 3_000_000_000' "$probe" \
  || fail "presence probe must have a bounded timeout"

grep -q 'presenceGateDuplicateWindow' "$controller" \
  || fail "media routing must coalesce duplicate media-key events"
grep -q 'private func shouldGatePlayPauseByPresence' "$controller" \
  || fail "media routing must centralize the presence-gate predicate"
grep -q 'command == .playPause' "$controller" \
  || fail "presence gate must only apply to play/pause"
grep -q 'source == .eventTap || source == .commandCenter' "$controller" \
  || fail "presence gate must only apply to media-key/command-center sources"
grep -q 'mediaPresenceSettings.playPauseGateEnabled' "$controller" \
  || fail "presence gate must be opt-in from settings"
grep -q 'case .human:' "$controller" \
  || fail "human detection must be explicit"
grep -q 'showChooserImmediately' "$controller" \
  || fail "human detection must open the chooser"
grep -q 'case .noHuman, .unavailable:' "$controller" \
  || fail "no-human and unavailable results must be explicit"
grep -q 'routePlayFamilyWithoutChooser' "$controller" \
  || fail "no-human/unavailable results must route the original command directly"
python3 - "$controller" <<'PY'
import pathlib
import re
import sys

controller = pathlib.Path(sys.argv[1]).read_text()
match = re.search(
    r"switch result \{(?P<body>.*?)\n\s*\}\n\s*\}\n\s*\}",
    controller,
    re.S,
)
if match is None:
    print("verify_presence_gate_semantics: missing presence result switch", file=sys.stderr)
    raise SystemExit(1)
body = match.group("body")
human = re.search(r"case \.human:(?P<body>.*?)(?=\n\s*case )", body, re.S)
no_human = re.search(r"case \.noHuman, \.unavailable:(?P<body>.*)", body, re.S)
if human is None or no_human is None:
    print("verify_presence_gate_semantics: presence result cases are incomplete", file=sys.stderr)
    raise SystemExit(1)
if "showChooserImmediately" not in human.group("body"):
    print("verify_presence_gate_semantics: human detection must open the chooser", file=sys.stderr)
    raise SystemExit(1)
if "routePlayFamilyWithoutChooser" in human.group("body"):
    print("verify_presence_gate_semantics: human detection must not route directly", file=sys.stderr)
    raise SystemExit(1)
if "routePlayFamilyWithoutChooser" not in no_human.group("body"):
    print("verify_presence_gate_semantics: no-human/unavailable must route directly", file=sys.stderr)
    raise SystemExit(1)
if "showChooserImmediately" in no_human.group("body"):
    print("verify_presence_gate_semantics: no-human/unavailable must not open the chooser", file=sys.stderr)
    raise SystemExit(1)
PY

grep -q 'Presence-gated Play/Pause' "$settings" \
  || fail "settings UI must expose the presence gate"
grep -q 'a detected face opens the Media Target Chooser' "$settings" \
  || fail "settings UI must describe the presence-gated chooser rule"
! grep -q 'no detected face opens the Media Target Chooser' "$settings" \
  || fail "settings UI must not describe the old inverted chooser rule"
grep -q 'mediaPresenceSettings.setPlayPauseGateEnabled' "$settings" \
  || fail "settings UI must toggle the persisted setting"
grep -q 'AVCaptureDevice.authorizationStatus(for: .video)' "$settings" \
  || fail "settings UI must report camera permission state"
grep -q 'AVCaptureDevice.requestAccess(for: .video)' "$settings" \
  || fail "settings UI must be able to request camera permission"

grep -q 'mediaPresenceSettings: mediaPresenceSettings' "$environment" \
  || fail "app environment must share one presence setting instance"
grep -q 'mediaPresenceProbe: mediaPresenceProbe' "$environment" \
  || fail "app environment must own the app-layer probe"
grep -q 'mediaPresenceSettings: environment.mediaPresenceSettings' "$app" \
  || fail "settings window must receive the shared presence setting instance"

grep -q 'NSCameraUsageDescription' "$plist" \
  || fail "Info.plist must declare camera usage"
grep -q 'MediaPresenceGateSettings.swift' "$project" \
  || fail "Xcode project must include MediaPresenceGateSettings.swift"
grep -q 'MediaPresenceProbe.swift' "$project" \
  || fail "Xcode project must include MediaPresenceProbe.swift"

printf 'verify_presence_gate_semantics=ok\n'
