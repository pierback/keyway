#!/usr/bin/env ruby

require 'base64'
require 'digest'
require 'json'

root = File.expand_path('..', __dir__)
contract_path = File.join(root, 'ChromiumBridgeProtocol', 'contract.json')
contract = JSON.parse(File.read(contract_path))

required_keys = %w[
  protocolVersion
  nativeMessagingHostName
  extensionID
  appBundleIdentifier
  nativeHostCodeIdentifier
  teamIdentifier
]
missing_keys = required_keys.reject { |key| contract.key?(key) }
abort "missing Chromium bridge contract keys: #{missing_keys.join(', ')}" unless missing_keys.empty?

manifest = JSON.parse(File.read(File.join(root, 'ChromiumExtension', 'manifest.json')))
extension_digest = Digest::SHA256.digest(Base64.strict_decode64(manifest.fetch('key'))).bytes.first(16)
derived_extension_id = extension_digest.map do |byte|
  [byte >> 4, byte & 15].map { |nibble| (97 + nibble).chr }.join
end.join
abort 'Chromium bridge contract extensionID does not match manifest key' unless derived_extension_id == contract.fetch('extensionID')

swift = <<~SWIFT
  // Generated by scripts/generate_chromium_bridge_contract. Do not edit.

  public enum KeywayChromiumBridgeContract {
      public static let protocolVersion = #{Integer(contract.fetch('protocolVersion'))}
      public static let nativeMessagingHostName = #{contract.fetch('nativeMessagingHostName').dump}
      public static let extensionID = #{contract.fetch('extensionID').dump}
      public static let appBundleIdentifier = #{contract.fetch('appBundleIdentifier').dump}
      public static let nativeHostCodeIdentifier = #{contract.fetch('nativeHostCodeIdentifier').dump}
      public static let teamIdentifier = #{contract.fetch('teamIdentifier').dump}
  }
SWIFT

javascript = <<~JAVASCRIPT
  // Generated by scripts/generate_chromium_bridge_contract. Do not edit.

  export const keywayChromiumBridgeProtocolVersion = #{Integer(contract.fetch('protocolVersion'))};
  export const keywayChromiumNativeMessagingHostName = #{contract.fetch('nativeMessagingHostName').dump};
  export const keywayChromiumExtensionID = #{contract.fetch('extensionID').dump};
JAVASCRIPT

native_host_manifest = JSON.pretty_generate(
  'name' => contract.fetch('nativeMessagingHostName'),
  'description' => 'Keyway Chromium media bridge',
  'path' => '__KEYWAY_CHROMIUM_NATIVE_HOST_PATH__',
  'type' => 'stdio',
  'allowed_origins' => ["chrome-extension://#{contract.fetch('extensionID')}/"]
) + "\n"

outputs = {
  File.join(root, 'packages', 'SonosHandoffCore', 'Sources', 'KeywayChromiumBridgeIPC', 'KeywayChromiumBridgeContract.generated.swift') => swift,
  File.join(root, 'ChromiumExtension', 'chromium_bridge_contract.generated.js') => javascript,
  File.join(root, 'ChromiumExtension', 'native-host-manifest.json') => native_host_manifest,
}

if ARGV == ['--check']
  stale_paths = outputs.each_with_object([]) do |(path, contents), paths|
    paths << path unless File.exist?(path) && File.binread(path) == contents
  end
  abort "stale generated Chromium bridge contract: #{stale_paths.join(', ')}" unless stale_paths.empty?
elsif ARGV.empty?
  outputs.each { |path, contents| File.binwrite(path, contents) }
else
  abort "usage: #{File.basename($PROGRAM_NAME)} [--check]"
end
