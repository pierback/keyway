#!/usr/bin/env bash
set -euo pipefail

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
settings="$repo_root/SonosHandoffMenuBar/SonosHandoffMenuBar/Features/SettingsFeature.swift"
controller="$repo_root/SonosHandoffMenuBar/SonosHandoffMenuBar/App/MediaRemoteController.swift"

fail() {
  printf 'verify_settings_feature_semantics: %s\n' "$*" >&2
  exit 1
}

grep -q 'private func saveSpotifyClientID(showMessage: Bool) -> Bool' "$settings" \
  || fail "Spotify Client ID saving must report validation/persistence failure to callers"

grep -q 'return false' "$settings" \
  || fail "Spotify Client ID validation and persistence failures must stop dependent flows"

python3 - "$settings" "$controller" <<'PY'
import pathlib
import sys

text = pathlib.Path(sys.argv[1]).read_text()
controller = pathlib.Path(sys.argv[2]).read_text()
start = text.index("    private func startSpotifySignIn()")
end = text.index("    private func signOutSpotify()", start)
body = text[start:end]
required = """guard saveSpotifyClientID(showMessage: false) else {
            return
        }"""
if required not in body:
    raise SystemExit("verify_settings_feature_semantics: Spotify sign-in must stop when Client ID validation fails")
if body.index(required) > body.index("authCoordinator.login()"):
    raise SystemExit("verify_settings_feature_semantics: Spotify sign-in must validate the Client ID before login")

if "available: configImportBadgeAvailable" not in text:
    raise SystemExit("verify_settings_feature_semantics: config import badge must route through explicit pending/imported/failure status")

start = text.index("    private var configImportBadgeAvailable: Bool")
end = text.index("    private var configImportSummary: String", start)
body = text[start:end]
required = """guard let configImportReport else {
            return false
        }"""
if required not in body:
    raise SystemExit("verify_settings_feature_semantics: config import badge must stay unavailable until import runs")
if "!configImportReport.hasFailures && !configImportReport.hasConflicts" not in body:
    raise SystemExit("verify_settings_feature_semantics: config import badge must only show healthy after a conflict-free report")

if 'return "Config import has not run yet. Keyway will copy old Sonos Handoff config and token files into its own support directory."' not in text:
    raise SystemExit("verify_settings_feature_semantics: config import summary must describe the pending state before import runs")

start = text.index("    private func runConfigImport()")
end = text.index("\n    private func installChromiumNativeBridge()", start)
body = text[start:end]
if "await reloadState()" not in body:
    raise SystemExit("verify_settings_feature_semantics: config import must reload the bound settings state after copying legacy config")
if "await reloadSpotifyAuthState()" in body:
    raise SystemExit("verify_settings_feature_semantics: config import must not leave the Spotify Client ID field on stale auth-only refresh")

if 'private let heliumBundleIdentifier = "net.imput.helium"' not in text:
    raise SystemExit("verify_settings_feature_semantics: Chromium extension setup must know Helium's bundle identifier")

if 'chromiumBridgeMessage = "Installed native host manifests in \\(state.manifestPaths.count) supported Chromium-family locations."' not in text:
    raise SystemExit("verify_settings_feature_semantics: Chromium bridge repair status must describe supported manifest locations, not detected browser installs")

start = text.index("    private func openChromiumExtensionsPage()")
end = text.index("\n    private func reloadSpotifyAuthState()", start)
body = text[start:end]
for required in (
    "NSWorkspace.shared.urlForApplication(withBundleIdentifier: heliumBundleIdentifier)",
    "withApplicationAt: heliumURL",
    'chromiumBridgeMessage = "Opened Helium extension settings."',
    "NSWorkspace.shared.open(chromiumExtensionsURL)",
):
    if required not in body:
        raise SystemExit(f"verify_settings_feature_semantics: Chromium extension setup must prefer opening Helium extensions: {required}")

mark_failed = controller[controller.index("    private func markFailed"):controller.index("    private func beginHelperRecovery")]
if "pid: nil" not in mark_failed:
    raise SystemExit("verify_settings_feature_semantics: helper failure status must clear the dead MediaRemote pid before Settings renders it")

begin_recovery = controller[controller.index("    private func beginHelperRecovery"):controller.index("    private func scheduleRelaunch")]
if "pid: nil" not in begin_recovery:
    raise SystemExit("verify_settings_feature_semantics: helper recovery status must not preserve a dead MediaRemote pid in Settings")
schedule_relaunch = controller[controller.index("    private func scheduleRelaunch"):controller.index("    private func cancelRecoveryTask")]
if "relaunchDelayNanoseconds" not in schedule_relaunch:
    raise SystemExit("verify_settings_feature_semantics: helper recovery must use the capped relaunch schedule")

if 'Text("Up/Down, Enter, Command+Enter, Escape, Tab, 1-9")' not in text:
    raise SystemExit("verify_settings_feature_semantics: overlay shortcut legend must advertise Command+Enter focus and remove nonexistent shortcuts")
if 'Text("Up/Down, Enter, Escape, Tab, 1-9, P")' in text:
    raise SystemExit("verify_settings_feature_semantics: overlay shortcut legend must not advertise the removed P shortcut")
PY

printf 'verify_settings_feature_semantics=ok\n'
