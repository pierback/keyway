#!/usr/bin/env bash
set -euo pipefail

status_file="${KEYWAY_STATUS_FILE:-$HOME/Library/Application Support/keyway/shortcut-runtime-status.json}"
timeout_seconds="${KEYWAY_PROBE_TIMEOUT_SECONDS:-4}"

fail() {
  printf 'probe_display_brightness_passthrough: %s\n' "$1" >&2
  exit 1
}

read_trace_sequence() {
  python3 - "$status_file" <<'PY'
import json
import pathlib
import sys

payload = json.loads(pathlib.Path(sys.argv[1]).read_text())
print(int(payload.get("mediaTransportTraceSequence", 0)))
PY
}

read_trace_json() {
  python3 - "$status_file" <<'PY'
import json
import pathlib
import sys

payload = json.loads(pathlib.Path(sys.argv[1]).read_text())
print(json.dumps(payload.get("mediaTransportTrace", []), separators=(",", ":")))
PY
}

post_brightness_burst() {
  swift - <<'SWIFT'
import AppKit
import ApplicationServices

let brightnessUpKeyCode = 2
let brightnessDownKeyCode = 3
let keyDownState = 0x0A
let keyUpState = 0x0B
let systemDefinedMediaKeySubtype: Int16 = 8

func postSystemKey(keyCode: Int, state: Int) {
    let data1 = (keyCode << 16) | (state << 8)
    guard let event = NSEvent.otherEvent(
        with: .systemDefined,
        location: .zero,
        modifierFlags: [],
        timestamp: ProcessInfo.processInfo.systemUptime,
        windowNumber: 0,
        context: nil,
        subtype: systemDefinedMediaKeySubtype,
        data1: data1,
        data2: -1
    ), let cgEvent = event.cgEvent else {
        fatalError("failed to create brightness key event")
    }
    cgEvent.setIntegerValueField(.eventSourceUnixProcessID, value: 0)
    cgEvent.setIntegerValueField(.eventSourceStateID, value: 1)
    cgEvent.setIntegerValueField(.eventSourceUserData, value: 0)
    cgEvent.setIntegerValueField(.eventTargetUnixProcessID, value: 0)
    cgEvent.post(tap: .cghidEventTap)
}

postSystemKey(keyCode: brightnessUpKeyCode, state: keyDownState)
usleep(35_000)
postSystemKey(keyCode: brightnessUpKeyCode, state: keyUpState)
usleep(35_000)
postSystemKey(keyCode: brightnessDownKeyCode, state: keyDownState)
usleep(35_000)
postSystemKey(keyCode: brightnessDownKeyCode, state: keyUpState)
SWIFT
}

close_chooser() {
  osascript -e 'tell application "System Events" to key code 53' >/dev/null 2>&1 || true
}

analyze_trace() {
  local start_sequence="$1"
  local trace_json
  trace_json="$(read_trace_json)"
  python3 - "$start_sequence" "$trace_json" <<'PY'
import json
import sys

start_sequence = int(sys.argv[1])
events = [
    event for event in json.loads(sys.argv[2])
    if int(event.get("sequence", 0)) > start_sequence
]

def fail(message):
    print(json.dumps(events, indent=2, sort_keys=True))
    print(f"probe_display_brightness_passthrough: {message}", file=sys.stderr)
    raise SystemExit(1)

forbidden = {
    "transport_key_down",
    "decision_chooser",
    "chooser_show",
    "chooser_select",
    "chooser_dispatch",
}
seen_forbidden = [event for event in events if event.get("event") in forbidden]
if seen_forbidden:
    fail("display brightness key routed into media transport")

brightness_diagnostics = [
    event for event in events
    if event.get("event") == "event_tap_unhandled_system_defined"
    and event.get("mediaKeyCode") in {2, 3}
]
if not brightness_diagnostics:
    fail("brightness system-defined events were not observed as pass-through diagnostics")

print(json.dumps({
    "event": "probe_display_brightness_passthrough_stable",
    "diagnosticCount": len(brightness_diagnostics),
}, sort_keys=True))
PY
}

trap close_chooser EXIT

start_sequence="$(read_trace_sequence)"
printf 'probe_display_brightness_passthrough: starting after trace sequence %s\n' "$start_sequence"
post_brightness_burst
sleep "$timeout_seconds"
analyze_trace "$start_sequence"
printf 'probe_display_brightness_passthrough=ok\n'
