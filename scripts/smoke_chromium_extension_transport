#!/usr/bin/env bash
set -euo pipefail

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
iterations="${KEYWAY_CHROMIUM_EXTENSION_ITERATIONS:-100}"
dry_run="${KEYWAY_CHROMIUM_EXTENSION_DRY_RUN:-0}"
workdir="$(mktemp -d)"
server_pid=""
browser_pid=""

stop_process() {
  local pid="$1"
  [[ -n "$pid" ]] || return
  kill -TERM "$pid" >/dev/null 2>&1 || true
  for _ in {1..50}; do
    if ! kill -0 "$pid" >/dev/null 2>&1; then
      wait "$pid" >/dev/null 2>&1 || true
      return
    fi
    sleep 0.1
  done
  pkill -TERM -P "$pid" >/dev/null 2>&1 || true
  kill -KILL "$pid" >/dev/null 2>&1 || true
  wait "$pid" >/dev/null 2>&1 || true
}

cleanup() {
  stop_process "$browser_pid"
  stop_process "$server_pid"
  for _ in {1..20}; do
    if rm -rf "$workdir" >/dev/null 2>&1; then
      return
    fi
    sleep 0.1
  done
  rm -rf "$workdir" >/dev/null 2>&1 || true
}
trap cleanup EXIT

fail() {
  printf 'smoke_chromium_extension_transport: %s\n' "$1" >&2
  exit 1
}

case "$iterations" in
  ''|*[!0-9]*)
    fail "KEYWAY_CHROMIUM_EXTENSION_ITERATIONS must be a positive integer"
    ;;
esac

if (( iterations < 1 )); then
  fail "KEYWAY_CHROMIUM_EXTENSION_ITERATIONS must be at least 1"
fi

contract_path="$repo_root/ChromiumBridgeProtocol/contract.json"
extension_id="$(python3 -c 'import json,sys; print(json.load(open(sys.argv[1]))["extensionID"])' "$contract_path")"
app_identifier="$(python3 -c 'import json,sys; print(json.load(open(sys.argv[1]))["appBundleIdentifier"])' "$contract_path")"
team_identifier="$(python3 -c 'import json,sys; print(json.load(open(sys.argv[1]))["teamIdentifier"])' "$contract_path")"

if [[ "$dry_run" == "1" ]]; then
  printf 'chromium_extension_id=%s\n' "$extension_id"
  printf 'smoke_chromium_extension_transport_dry_run=ok\n'
  exit 0
fi

browser_path="${KEYWAY_CHROMIUM_SMOKE_BROWSER_PATH:-}"
if [[ -z "$browser_path" ]]; then
  if [[ -x "/Applications/Brave Browser.app/Contents/MacOS/Brave Browser" ]]; then
    browser_path="/Applications/Brave Browser.app/Contents/MacOS/Brave Browser"
  elif [[ -x "/Applications/Google Chrome.app/Contents/MacOS/Google Chrome" ]]; then
    browser_path="/Applications/Google Chrome.app/Contents/MacOS/Google Chrome"
  else
    fail "Google Chrome or Brave Browser must be installed, or set KEYWAY_CHROMIUM_SMOKE_BROWSER_PATH"
  fi
fi

playwright_module="$(
  node --input-type=module -e "console.log(await import.meta.resolve('playwright'))" \
    || fail "Playwright must be available to launch Chromium with extension support"
)"

active_page_file="$workdir/active-page-title"
bridge_endpoint="$workdir/chromium-bridge.sock"

"$repo_root/scripts/install_chromium_native_host" >/dev/null

cat >"$workdir/server.py" <<'PY'
import http.server
import math
import pathlib
import socketserver
import struct
import sys
import urllib.parse
import wave

root = pathlib.Path(sys.argv[1])
port_file = pathlib.Path(sys.argv[2])
active_title_file = pathlib.Path(sys.argv[3])

def write_tone(path, frequency):
    sample_rate = 44100
    sample_count = sample_rate
    with wave.open(str(path), "w") as wav:
        wav.setnchannels(1)
        wav.setsampwidth(2)
        wav.setframerate(sample_rate)
        for index in range(sample_count):
            value = int(1200 * math.sin(2 * math.pi * frequency * index / sample_rate))
            wav.writeframesraw(struct.pack("<h", value))

write_tone(root / "tone-a.wav", 440)
write_tone(root / "tone-b.wav", 660)

(root / "a.html").write_text("""<!doctype html>
<html>
<head><meta charset="utf-8"><title>Keyway Chromium Smoke A</title></head>
<body>
<button id="previous" aria-label="Previous track">Previous</button>
<button id="next" aria-label="Next track">Next</button>
<audio id="media" controls preload="auto" autoplay loop src="/tone-a.wav"></audio>
<script>
const tracks = [
  { title: "Keyway Chromium Smoke A Track 1", src: "/tone-a.wav" },
  { title: "Keyway Chromium Smoke A Track 2", src: "/tone-b.wav" },
];
let trackIndex = 0;
function setTrack(index) {
  trackIndex = (index + tracks.length) % tracks.length;
  media.src = tracks[trackIndex].src;
  media.currentTime = 0;
  navigator.mediaSession.metadata = new MediaMetadata({ title: tracks[trackIndex].title, artist: "Keyway" });
  media.play();
}
media.volume = 0.4;
next.addEventListener("click", () => setTrack(trackIndex + 1));
previous.addEventListener("click", () => setTrack(trackIndex - 1));
function reportVisibility() {
  if (document.visibilityState === "visible") {
    void fetch(`/keyway-active-title?title=${encodeURIComponent(document.title)}`, { cache: "no-store" });
  }
}
document.addEventListener("visibilitychange", reportVisibility);
window.addEventListener("focus", reportVisibility);
setInterval(reportVisibility, 100);
setTrack(0);
reportVisibility();
</script>
</body>
</html>
""", encoding="utf-8")

(root / "b.html").write_text("""<!doctype html>
<html>
<head><meta charset="utf-8"><title>Keyway Chromium Smoke B</title></head>
<body>
<button id="previous" aria-label="Previous track">Previous</button>
<button id="next" aria-label="Next track">Next</button>
<audio id="media" controls preload="auto" autoplay loop src="/tone-b.wav"></audio>
<script>
const tracks = [
  { title: "Keyway Chromium Smoke B Track 1", src: "/tone-b.wav" },
  { title: "Keyway Chromium Smoke B Track 2", src: "/tone-a.wav" },
];
let trackIndex = 0;
function setTrack(index) {
  trackIndex = (index + tracks.length) % tracks.length;
  media.src = tracks[trackIndex].src;
  media.currentTime = 0;
  navigator.mediaSession.metadata = new MediaMetadata({ title: tracks[trackIndex].title, artist: "Keyway" });
  media.play();
}
media.volume = 0.6;
next.addEventListener("click", () => setTrack(trackIndex + 1));
previous.addEventListener("click", () => setTrack(trackIndex - 1));
function reportVisibility() {
  if (document.visibilityState === "visible") {
    void fetch(`/keyway-active-title?title=${encodeURIComponent(document.title)}`, { cache: "no-store" });
  }
}
document.addEventListener("visibilitychange", reportVisibility);
window.addEventListener("focus", reportVisibility);
setInterval(reportVisibility, 100);
setTrack(0);
reportVisibility();
</script>
</body>
</html>
""", encoding="utf-8")

class QuietHandler(http.server.SimpleHTTPRequestHandler):
    def do_GET(self):
        url = urllib.parse.urlsplit(self.path)
        if url.path == "/keyway-active-title":
            title = urllib.parse.parse_qs(url.query).get("title", [""])[0]
            active_title_file.write_text(title, encoding="utf-8")
            self.send_response(204)
            self.end_headers()
            return
        super().do_GET()

    def log_message(self, format, *args):
        return

socketserver.TCPServer.allow_reuse_address = True
with socketserver.TCPServer(("127.0.0.1", 0), QuietHandler) as httpd:
    pathlib.os.chdir(root)
    port_file.write_text(str(httpd.server_address[1]), encoding="utf-8")
    httpd.serve_forever()
PY

port_file="$workdir/port"
python3 "$workdir/server.py" "$workdir" "$port_file" "$active_page_file" &
server_pid="$!"

for _ in {1..100}; do
  if [[ -s "$port_file" ]]; then
    break
  fi
  sleep 0.05
done

if [[ ! -s "$port_file" ]]; then
  fail "local smoke server did not start"
fi

port="$(cat "$port_file")"
profile_dir="$workdir/profile"
mkdir -p "$profile_dir"

cat >"$workdir/launch-browser.mjs" <<'JS'
import fs from "node:fs/promises";

const [playwrightModule, browserPath, userDataDir, extensionPath, readyFile, firstURL, secondURL] = process.argv.slice(2);
const { chromium } = await import(playwrightModule);
const context = await chromium.launchPersistentContext(userDataDir, {
  headless: false,
  executablePath: browserPath,
  ignoreDefaultArgs: ["--disable-extensions"],
  args: [
    `--load-extension=${extensionPath}`,
    "--autoplay-policy=no-user-gesture-required",
    "--no-first-run",
    "--no-default-browser-check",
  ],
});

const first = await context.newPage();
await first.goto(firstURL);
const second = await context.newPage();
await second.goto(secondURL);
await fs.writeFile(readyFile, "ready", "utf8");

let closing = false;
const close = async () => {
  if (closing) return;
  closing = true;
  await Promise.race([
    context.close(),
    new Promise(resolve => setTimeout(resolve, 4000)),
  ]);
  process.exit(0);
};

process.on("SIGTERM", close);
process.on("SIGINT", close);
await new Promise(() => {});
JS

browser_ready_file="$workdir/browser-ready"
browser_log_file="$workdir/browser.log"
KEYWAY_CHROMIUM_BRIDGE_ENDPOINT="$bridge_endpoint" node "$workdir/launch-browser.mjs" \
  "$playwright_module" \
  "$browser_path" \
  "$profile_dir" \
  "$repo_root/ChromiumExtension" \
  "$browser_ready_file" \
  "http://127.0.0.1:$port/a.html" \
  "http://127.0.0.1:$port/b.html" \
  >"$browser_log_file" 2>&1 &
browser_pid="$!"

for _ in {1..200}; do
  if [[ -s "$browser_ready_file" ]]; then
    break
  fi
  sleep 0.05
done

if [[ ! -s "$browser_ready_file" ]]; then
  if [[ -s "$browser_log_file" ]]; then
    sed 's/^/chromium-smoke-browser: /' "$browser_log_file" >&2
  fi
  fail "Chromium smoke browser did not load both test pages"
fi

cat >"$workdir/main.swift" <<'SWIFT'
import Foundation

let iterations = Int(CommandLine.arguments[1])!
let activePageTitlePath = CommandLine.arguments[2]
let bridgeEndpoint = URL(fileURLWithPath: CommandLine.arguments[3])

struct Snapshot: Decodable {
    let protocolVersion: Int
    let profileGuid: String
    let connectionID: String
    let targets: [Target]
}

struct Target: Decodable {
    let id: String
    let browser: String
    let browserFamily: String?
    let browserDisplayName: String?
    let browserBundleIdentifier: String?
    let pageTitle: String
    let title: String
    let playing: Bool
    let muted: Bool
    let volume: Double?
    let supportedCommands: [String]
}

struct CommandResult: Decodable {
    let requestID: String?
    let targetID: String
    let command: String
    let ok: Bool
    let unsupported: Bool?
    let message: String
}

struct FocusResult: Decodable {
    let requestID: String?
    let targetID: String
    let ok: Bool
    let message: String
}

struct CommandPayload: Encodable {
    let type: String
    let protocolVersion: Int
    let requestID: String
    let targetID: String
    let command: String
    let volumeDelta: Double?
    let connectionID: String
}

struct FocusPayload: Encodable {
    let type: String
    let protocolVersion: Int
    let requestID: String
    let targetID: String
    let connectionID: String
}

final class State: @unchecked Sendable {
    private let decoder = JSONDecoder()
    private let lock = NSLock()
    private(set) var targetsByTitle: [String: Target] = [:]
    private(set) var targetsByID: [String: Target] = [:]
    private var connectionIDByTargetID: [String: String] = [:]
    private var resultsByRequestID: [String: CommandResult] = [:]
    private var focusResultsByRequestID: [String: FocusResult] = [:]

    func handleSnapshot(_ payload: String) {
        let snapshot = try! decoder.decode(Snapshot.self, from: Data(payload.utf8))
        precondition(
            snapshot.protocolVersion == KeywayChromiumBridgeContract.protocolVersion,
            "Chromium extension snapshot protocol must match the canonical bridge contract."
        )
        lock.lock()
        for target in snapshot.targets where target.pageTitle.hasPrefix("Keyway Chromium Smoke ") {
            targetsByTitle[target.pageTitle] = target
            targetsByID[target.id] = target
            connectionIDByTargetID[target.id] = snapshot.connectionID
        }
        lock.unlock()
    }

    func handleCommandResult(_ payload: String) {
        let result = try! decoder.decode(CommandResult.self, from: Data(payload.utf8))
        guard let requestID = result.requestID else {
            preconditionFailure("Chromium command result must include requestID.")
        }
        lock.lock()
        resultsByRequestID[requestID] = result
        lock.unlock()
    }

    func handleFocusResult(_ payload: String) {
        let result = try! decoder.decode(FocusResult.self, from: Data(payload.utf8))
        guard let requestID = result.requestID else {
            preconditionFailure("Chromium focus result must include requestID.")
        }
        lock.lock()
        focusResultsByRequestID[requestID] = result
        lock.unlock()
    }

    func smokeTargets() -> (Target, Target)? {
        lock.lock()
        defer { lock.unlock() }
        guard let first = targetsByTitle["Keyway Chromium Smoke A"],
              let second = targetsByTitle["Keyway Chromium Smoke B"]
        else {
            return nil
        }
        return (first, second)
    }

    func target(id: String) -> Target? {
        lock.lock()
        defer { lock.unlock() }
        return targetsByID[id]
    }

    func result(requestID: String) -> CommandResult? {
        lock.lock()
        defer { lock.unlock() }
        return resultsByRequestID[requestID]
    }

    func focusResult(requestID: String) -> FocusResult? {
        lock.lock()
        defer { lock.unlock() }
        return focusResultsByRequestID[requestID]
    }

    func connectionID(targetID: String) -> String {
        lock.lock()
        defer { lock.unlock() }
        return connectionIDByTargetID[targetID]!
    }
}

func runLoop(until deadline: Date, condition: () -> Bool) -> Bool {
    while Date() < deadline {
        if condition() {
            return true
        }
        RunLoop.current.run(mode: .default, before: Date(timeIntervalSinceNow: 0.025))
    }
    return condition()
}

func percentile95(_ values: [Int]) -> Int {
    let sorted = values.sorted()
    let index = max(0, Int(ceil(Double(sorted.count) * 0.95)) - 1)
    return sorted[index]
}

func postCommand(state: State, target: Target, requestID: String, command: String, volumeDelta: Double? = nil) {
    let payload = CommandPayload(
        type: "command",
        protocolVersion: KeywayChromiumBridgeContract.protocolVersion,
        requestID: requestID,
        targetID: target.id,
        command: command,
        volumeDelta: volumeDelta,
        connectionID: state.connectionID(targetID: target.id)
    )
    let data = try! JSONEncoder().encode(payload)
    bridgeServer.sendCommand(String(data: data, encoding: .utf8)!)
}

func postFocus(state: State, target: Target, requestID: String) {
    let payload = FocusPayload(
        type: "focusTarget",
        protocolVersion: KeywayChromiumBridgeContract.protocolVersion,
        requestID: requestID,
        targetID: target.id,
        connectionID: state.connectionID(targetID: target.id)
    )
    let data = try! JSONEncoder().encode(payload)
    bridgeServer.sendCommand(String(data: data, encoding: .utf8)!)
}

func runCommand(
    state: State,
    target: Target,
    command: String,
    volumeDelta: Double? = nil,
    ackLatencies: inout [Int]
) -> CommandResult? {
    let requestID = UUID().uuidString
    let started = ProcessInfo.processInfo.systemUptime
    postCommand(state: state, target: target, requestID: requestID, command: command, volumeDelta: volumeDelta)
    guard runLoop(until: Date(timeIntervalSinceNow: 2), condition: { state.result(requestID: requestID) != nil }),
          let result = state.result(requestID: requestID)
    else {
        return nil
    }
    ackLatencies.append(Int(((ProcessInfo.processInfo.systemUptime - started) * 1000).rounded()))
    precondition(result.command == command, "Chromium command result must echo the requested command.")
    return result
}

func approximatelyEqual(_ lhs: Double?, _ rhs: Double, tolerance: Double = 0.02) -> Bool {
    guard let lhs else { return false }
    return abs(lhs - rhs) <= tolerance
}

func activePageTitle(path: String) -> String {
    guard let data = FileManager.default.contents(atPath: path),
          let title = String(data: data, encoding: .utf8)
    else {
        return ""
    }
    return title.trimmingCharacters(in: .whitespacesAndNewlines)
}

func runFocusCheck(
    state: State,
    target: Target,
    activePageTitlePath: String,
    ackLatencies: inout [Int]
) -> Bool {
    let requestID = UUID().uuidString
    let started = ProcessInfo.processInfo.systemUptime
    postFocus(state: state, target: target, requestID: requestID)
    guard runLoop(until: Date(timeIntervalSinceNow: 2), condition: { state.focusResult(requestID: requestID) != nil }),
          let result = state.focusResult(requestID: requestID)
    else {
        FileHandle.standardError.write(Data("smoke_chromium_extension_transport_failure focus_target=\(target.pageTitle) timeout\n".utf8))
        return false
    }
    ackLatencies.append(Int(((ProcessInfo.processInfo.systemUptime - started) * 1000).rounded()))
    guard result.ok, result.targetID == target.id else {
        FileHandle.standardError.write(Data("smoke_chromium_extension_transport_failure focus_target=\(target.pageTitle) result=\(result)\n".utf8))
        return false
    }
    let activated = runLoop(until: Date(timeIntervalSinceNow: 2)) {
        activePageTitle(path: activePageTitlePath) == target.pageTitle
    }
    if !activated {
        FileHandle.standardError.write(Data("smoke_chromium_extension_transport_failure focus_target=\(target.pageTitle) active_page=\(activePageTitle(path: activePageTitlePath))\n".utf8))
    }
    return activated
}

func currentSmokeTarget(state: State, pageTitle: String) -> Target? {
    let targets = state.smokeTargets()
    if pageTitle == "Keyway Chromium Smoke A" {
        return targets?.0
    }
    if pageTitle == "Keyway Chromium Smoke B" {
        return targets?.1
    }
    return nil
}

let state = State()
let bridgeServer = KeywayChromiumBridgeServer(
    endpointURL: bridgeEndpoint,
    onEvent: { event, payload in
        switch event {
        case .snapshot:
            state.handleSnapshot(payload)
        case .commandResult:
            state.handleCommandResult(payload)
        case .focusResult:
            state.handleFocusResult(payload)
        }
    }
)
do {
    try bridgeServer.start()
} catch {
    FileHandle.standardError.write(Data("smoke_chromium_extension_transport: bridge server failed: \(error)\n".utf8))
    exit(1)
}
defer {
    bridgeServer.stop()
}

let discoveryStarted = ProcessInfo.processInfo.systemUptime
guard runLoop(until: Date(timeIntervalSinceNow: 10), condition: { state.smokeTargets() != nil }),
      let initialTargets = state.smokeTargets()
else {
    FileHandle.standardError.write(Data("smoke_chromium_extension_transport: did not discover both Chromium smoke targets\n".utf8))
    exit(1)
}
let discoveryMs = Int(((ProcessInfo.processInfo.systemUptime - discoveryStarted) * 1000).rounded())

var ackLatencies: [Int] = []
var commandSurfaceSuccess = 0
var commandSurfaceFailure = 0
var focusSurfaceSuccess = 0
var focusSurfaceFailure = 0
var success = 0
var failure = 0
var wrongTarget = 0
var duplicate = 0

let initiallyPlaying = runLoop(until: Date(timeIntervalSinceNow: 2)) {
    guard let targets = state.smokeTargets() else { return false }
    return targets.0.playing && targets.1.playing
}

if !initiallyPlaying {
    commandSurfaceFailure += 1
    FileHandle.standardError.write(Data("smoke_chromium_extension_transport_failure command_surface=autoplay target_state=\(String(describing: state.smokeTargets()))\n".utf8))
}

if runFocusCheck(state: state, target: initialTargets.0, activePageTitlePath: activePageTitlePath, ackLatencies: &ackLatencies) {
    focusSurfaceSuccess += 1
} else {
    focusSurfaceFailure += 1
}
if runFocusCheck(state: state, target: initialTargets.1, activePageTitlePath: activePageTitlePath, ackLatencies: &ackLatencies) {
    focusSurfaceSuccess += 1
} else {
    focusSurfaceFailure += 1
}

if let commandTargets = state.smokeTargets(), commandSurfaceFailure == 0 {
    let target = commandTargets.0
    let other = commandTargets.1
    let otherVolume = other.volume
    let otherTitle = other.title
    let missingCommands = ["mute", "volumeDelta", "next", "previous"].filter {
        !target.supportedCommands.contains($0)
    }
    if !missingCommands.isEmpty {
        commandSurfaceFailure += 1
        FileHandle.standardError.write(Data("smoke_chromium_extension_transport_failure command_surface=required_commands missing=\(missingCommands) supported_commands=\(target.supportedCommands)\n".utf8))
    }

    for check in [
        ("pause", false, nil as Double?),
        ("play", true, nil),
        ("playPause", false, nil),
        ("playPause", true, nil),
    ] {
        guard let current = state.target(id: target.id),
              let result = runCommand(state: state, target: current, command: check.0, ackLatencies: &ackLatencies),
              result.ok,
              result.unsupported != true,
              result.targetID == target.id
        else {
            commandSurfaceFailure += 1
            FileHandle.standardError.write(Data("smoke_chromium_extension_transport_failure command_surface=\(check.0) result_missing_or_failed\n".utf8))
            continue
        }

        let observed = runLoop(until: Date(timeIntervalSinceNow: 2)) {
            state.target(id: target.id)?.playing == check.1
                && state.target(id: other.id)?.playing == true
        }
        if observed {
            commandSurfaceSuccess += 1
        } else {
            commandSurfaceFailure += 1
            if state.target(id: other.id)?.playing != true {
                wrongTarget += 1
            }
            FileHandle.standardError.write(Data("smoke_chromium_extension_transport_failure command_surface=\(check.0) target_state=\(String(describing: state.target(id: target.id))) other_state=\(String(describing: state.target(id: other.id)))\n".utf8))
        }
    }

    let initialTargetMuted = state.target(id: target.id)?.muted ?? target.muted
    let initialOtherMuted = state.target(id: other.id)?.muted ?? other.muted
    for expectedMuted in [!initialTargetMuted, initialTargetMuted] {
        guard let current = state.target(id: target.id),
              let result = runCommand(state: state, target: current, command: "mute", ackLatencies: &ackLatencies),
              result.ok,
              result.unsupported != true,
              result.targetID == target.id
        else {
            commandSurfaceFailure += 1
            FileHandle.standardError.write(Data("smoke_chromium_extension_transport_failure command_surface=mute result_missing_or_failed\n".utf8))
            continue
        }

        let observed = runLoop(until: Date(timeIntervalSinceNow: 2)) {
            state.target(id: target.id)?.muted == expectedMuted
                && state.target(id: other.id)?.muted == initialOtherMuted
        }
        if observed {
            commandSurfaceSuccess += 1
        } else {
            commandSurfaceFailure += 1
            if state.target(id: other.id)?.muted != initialOtherMuted {
                wrongTarget += 1
            }
            FileHandle.standardError.write(Data("smoke_chromium_extension_transport_failure command_surface=mute target_state=\(String(describing: state.target(id: target.id))) other_state=\(String(describing: state.target(id: other.id)))\n".utf8))
        }
    }

    if let current = state.target(id: target.id), let startingVolume = current.volume {
        let expectedVolume = min(1, startingVolume + 0.2)
        if let result = runCommand(state: state, target: current, command: "volumeDelta", volumeDelta: 0.2, ackLatencies: &ackLatencies),
           result.ok,
           result.unsupported != true,
           result.targetID == target.id {
            let observed = runLoop(until: Date(timeIntervalSinceNow: 2)) {
                approximatelyEqual(state.target(id: target.id)?.volume, expectedVolume)
                    && approximatelyEqual(state.target(id: other.id)?.volume, otherVolume ?? 0)
            }
            if observed {
                commandSurfaceSuccess += 1
            } else {
                commandSurfaceFailure += 1
                if !approximatelyEqual(state.target(id: other.id)?.volume, otherVolume ?? 0) {
                    wrongTarget += 1
                }
                FileHandle.standardError.write(Data("smoke_chromium_extension_transport_failure command_surface=volumeDelta target_state=\(String(describing: state.target(id: target.id))) other_state=\(String(describing: state.target(id: other.id)))\n".utf8))
            }
        } else {
            commandSurfaceFailure += 1
            FileHandle.standardError.write(Data("smoke_chromium_extension_transport_failure command_surface=volumeDelta result_missing_or_failed\n".utf8))
        }
    } else {
        commandSurfaceFailure += 1
        FileHandle.standardError.write(Data("smoke_chromium_extension_transport_failure command_surface=volumeDelta missing starting volume\n".utf8))
    }

    for check in [
        ("next", "Keyway Chromium Smoke A Track 2"),
        ("previous", "Keyway Chromium Smoke A Track 1"),
    ] {
        guard let current = currentSmokeTarget(state: state, pageTitle: target.pageTitle),
              let result = runCommand(state: state, target: current, command: check.0, ackLatencies: &ackLatencies),
              result.ok,
              result.unsupported != true,
              result.targetID == current.id
        else {
            commandSurfaceFailure += 1
            FileHandle.standardError.write(Data("smoke_chromium_extension_transport_failure command_surface=\(check.0) result_missing_or_failed\n".utf8))
            continue
        }

        let observed = runLoop(until: Date(timeIntervalSinceNow: 2)) {
            currentSmokeTarget(state: state, pageTitle: target.pageTitle)?.title == check.1
                && state.target(id: other.id)?.title == otherTitle
        }
        if observed {
            commandSurfaceSuccess += 1
        } else {
            commandSurfaceFailure += 1
            if state.target(id: other.id)?.title != otherTitle {
                wrongTarget += 1
            }
            FileHandle.standardError.write(Data("smoke_chromium_extension_transport_failure command_surface=\(check.0) target_state=\(String(describing: currentSmokeTarget(state: state, pageTitle: target.pageTitle))) other_state=\(String(describing: state.target(id: other.id)))\n".utf8))
        }
    }
}

guard let stressTargets = state.smokeTargets(),
      let firstVolume = stressTargets.0.volume,
      let secondVolume = stressTargets.1.volume
else {
    FileHandle.standardError.write(Data("smoke_chromium_extension_transport_failure missing volumes before stress loop\n".utf8))
    exit(1)
}

var expectedVolumes = [
    stressTargets.0.id: firstVolume,
    stressTargets.1.id: secondVolume,
]

for iteration in 0..<iterations {
    let currentTargets = state.smokeTargets()!
    let target = iteration.isMultiple(of: 2) ? currentTargets.0 : currentTargets.1
    let other = iteration.isMultiple(of: 2) ? currentTargets.1 : currentTargets.0
    let previousTargetVolume = expectedVolumes[target.id]!
    let volumeDelta = previousTargetVolume >= 0.8 ? -0.2 : 0.2
    expectedVolumes[target.id] = max(0, min(1, previousTargetVolume + volumeDelta))
    let expectedOtherVolume = expectedVolumes[other.id]!
    let requestID = UUID().uuidString
    let started = ProcessInfo.processInfo.systemUptime
    postCommand(state: state, target: target, requestID: requestID, command: "volumeDelta", volumeDelta: volumeDelta)

    guard runLoop(until: Date(timeIntervalSinceNow: 2), condition: { state.result(requestID: requestID) != nil }),
          let result = state.result(requestID: requestID)
    else {
        failure += 1
        FileHandle.standardError.write(Data("smoke_chromium_extension_transport_failure iteration=\(iteration + 1) timeout target=\(target.id)\n".utf8))
        continue
    }
    let ackMs = Int(((ProcessInfo.processInfo.systemUptime - started) * 1000).rounded())
    ackLatencies.append(ackMs)

    if !result.ok || result.unsupported == true || result.targetID != target.id || result.command != "volumeDelta" {
        failure += 1
        if result.targetID != target.id {
            wrongTarget += 1
        }
        FileHandle.standardError.write(Data("smoke_chromium_extension_transport_failure iteration=\(iteration + 1) result=\(result)\n".utf8))
        continue
    }

    let observedExpectedState = runLoop(until: Date(timeIntervalSinceNow: 2)) {
        approximatelyEqual(state.target(id: target.id)?.volume, expectedVolumes[target.id]!)
            && approximatelyEqual(state.target(id: other.id)?.volume, expectedOtherVolume)
    }

    if observedExpectedState {
        success += 1
    } else {
        failure += 1
        let targetVolume = state.target(id: target.id)?.volume
        let otherVolume = state.target(id: other.id)?.volume
        if !approximatelyEqual(otherVolume, expectedOtherVolume) {
            wrongTarget += 1
        }
        if approximatelyEqual(targetVolume, previousTargetVolume) && approximatelyEqual(otherVolume, expectedOtherVolume) {
            duplicate += 1
        }
        FileHandle.standardError.write(Data("smoke_chromium_extension_transport_failure iteration=\(iteration + 1) target_state=\(String(describing: state.target(id: target.id))) other_state=\(String(describing: state.target(id: other.id)))\n".utf8))
    }
}

print("chromium_extension_smoke_total=\(iterations)")
print("chromium_extension_command_surface_success=\(commandSurfaceSuccess)")
print("chromium_extension_command_surface_failure=\(commandSurfaceFailure)")
print("chromium_extension_focus_surface_success=\(focusSurfaceSuccess)")
print("chromium_extension_focus_surface_failure=\(focusSurfaceFailure)")
print("chromium_extension_smoke_success=\(success)")
print("chromium_extension_smoke_failure=\(failure)")
print("chromium_extension_smoke_wrong_target=\(wrongTarget)")
print("chromium_extension_smoke_duplicate=\(duplicate)")
print("chromium_extension_smoke_discovery_ms=\(discoveryMs)")
print("chromium_extension_smoke_p95_ack_ms=\(ackLatencies.isEmpty ? 0 : percentile95(ackLatencies))")

if commandSurfaceFailure > 0 || focusSurfaceFailure > 0 || failure > 0 {
    exit(1)
}
SWIFT

ipc_sources=("$repo_root"/packages/SonosHandoffCore/Sources/KeywayChromiumBridgeIPC/*.swift)
swiftc \
  -framework Security \
  "${ipc_sources[@]}" \
  "$workdir/main.swift" \
  -o "$workdir/chromium-extension-live-smoke"

signing_identity="${KEYWAY_SIGNING_IDENTITY:-}"
if [[ -z "$signing_identity" ]]; then
  signing_identity="$(security find-identity -v -p codesigning \
    | awk '$0 ~ /Apple Development/ && $0 !~ /CSSMERR_/ { print $2; exit }')"
fi
if [[ -z "$signing_identity" ]]; then
  fail "no Apple Development signing identity for team $team_identifier"
fi
codesign \
  --force \
  --options runtime \
  --timestamp=none \
  --identifier "$app_identifier" \
  --sign "$signing_identity" \
  "$workdir/chromium-extension-live-smoke"
signed_team_identifier="$(codesign -dvv "$workdir/chromium-extension-live-smoke" 2>&1 \
  | awk -F= '$1 == "TeamIdentifier" { print $2; exit }')"
if [[ "$signed_team_identifier" != "$team_identifier" ]]; then
  fail "smoke peer signed by unexpected team ${signed_team_identifier:-none}; expected $team_identifier"
fi
"$workdir/chromium-extension-live-smoke" "$iterations" "$active_page_file" "$bridge_endpoint"
