#!/usr/bin/env bash
set -euo pipefail

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
workdir="$(mktemp -d)"
trap 'rm -rf "$workdir"' EXIT

controller="$repo_root/SonosHandoffMenuBar/SonosHandoffMenuBar/App/MediaRemoteController.swift"
store="$repo_root/SonosHandoffMenuBar/SonosHandoffMenuBar/App/MediaSourceStore.swift"

python3 - "$controller" "$store" <<'PY'
import pathlib
import sys

controller = pathlib.Path(sys.argv[1]).read_text()
store = pathlib.Path(sys.argv[2]).read_text()

for forbidden in (
    "periodicRecoveryInterval",
    "maxImmediateRestartAttempts",
    "immediateRestartDelayNanoseconds",
    "Keyway will retry the helper every",
):
    if forbidden in controller:
        raise SystemExit(f"verify_media_remote_refresh_gate_semantics: removed helper recovery policy is still present: {forbidden}")

if "static let helperRecoveryGraceInterval: TimeInterval = 5" not in controller:
    raise SystemExit("verify_media_remote_refresh_gate_semantics: controller must own the shared 5s helper recovery grace")
if "MediaRemoteController.helperRecoveryGraceInterval" not in store:
    raise SystemExit("verify_media_remote_refresh_gate_semantics: store retention must use the controller's shared helper recovery grace")

snapshot_start = controller.index('            case "snapshot":')
snapshot_end = controller.index('            case "commandResult":', snapshot_start)
snapshot_body = controller[snapshot_start:snapshot_end]
targets_index = snapshot_body.index("targets = visibleTargets")
clear_index = snapshot_body.index("clearHelperDegraded()")
if clear_index < targets_index:
    raise SystemExit("verify_media_remote_refresh_gate_semantics: fresh snapshot must publish targets before clearing degraded retention")

print("verify_media_remote_refresh_gate_policy=ok")
PY

cat >"$workdir/RefreshGateSemantics.swift" <<'SWIFT'
import Foundation

@main
struct RefreshGateSemantics {
    static func main() {
        var gate = MediaRemoteSnapshotRefreshGate()
        expectFalse(gate.isRefreshing, "fresh gate must not be refreshing")

        let first = gate.begin(requestID: "first")
        expectEqual(first, "first", "first refresh must begin")
        expectTrue(gate.isRefreshing, "begun refresh must be visible")
        expectNil(gate.begin(requestID: "second"), "second refresh must coalesce while first is in flight")
        expectTrue(gate.isRefreshing, "coalesced refresh must leave first in flight")

        expectFalse(gate.finish(requestID: "stale"), "stale snapshot must not finish the active request")
        expectTrue(gate.isRefreshing, "stale snapshot must leave active request in flight")

        expectTrue(gate.finish(requestID: "first"), "matching snapshot must finish the active request")
        expectFalse(gate.isRefreshing, "matching snapshot must clear in-flight state")

        expectEqual(gate.begin(requestID: "third"), "third", "third refresh must begin after first finishes")
        expectFalse(gate.finish(requestID: nil), "nil request id must not finish a hard-cutover request")
        expectTrue(gate.isRefreshing, "nil completion must leave the active request in flight")
        expectTrue(gate.finish(requestID: "third"), "matching third snapshot must finish the active request")
        expectFalse(gate.isRefreshing, "matching third snapshot must clear in-flight state")

        _ = gate.begin(requestID: "fourth")
        gate.reset()
        expectFalse(gate.isRefreshing, "reset must clear in-flight state")

        print("verify_media_remote_refresh_gate_semantics=ok")
    }

    private static func expectTrue(_ value: Bool, _ message: String) {
        guard value else { fail(message) }
    }

    private static func expectFalse(_ value: Bool, _ message: String) {
        guard !value else { fail(message) }
    }

    private static func expectNil<T>(_ value: T?, _ message: String) {
        guard value == nil else {
            fail("\(message): got \(String(describing: value))")
        }
    }

    private static func expectEqual<T: Equatable>(_ actual: T?, _ expected: T, _ message: String) {
        guard actual == expected else {
            fail("\(message): expected \(expected), got \(String(describing: actual))")
        }
    }

    private static func fail(_ message: String) -> Never {
        FileHandle.standardError.write(Data("verify_media_remote_refresh_gate_semantics: \(message)\n".utf8))
        exit(1)
    }
}
SWIFT

swiftc \
  -module-cache-path "$workdir/module-cache" \
  "$repo_root/SonosHandoffMenuBar/SonosHandoffMenuBar/App/MediaRemoteSnapshotRefreshGate.swift" \
  "$workdir/RefreshGateSemantics.swift" \
  -o "$workdir/verify_media_remote_refresh_gate_semantics"

"$workdir/verify_media_remote_refresh_gate_semantics"
