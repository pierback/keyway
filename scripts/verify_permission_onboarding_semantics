#!/usr/bin/env bash
set -euo pipefail

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
app_delegate="$repo_root/SonosHandoffMenuBar/SonosHandoffMenuBar/App/AppDelegate.swift"
sonos_app="$repo_root/SonosHandoffMenuBar/SonosHandoffMenuBar/App/SonosHandoffApp.swift"
window_controller="$repo_root/SonosHandoffMenuBar/SonosHandoffMenuBar/App/PermissionOnboardingWindowController.swift"
onboarding="$repo_root/SonosHandoffMenuBar/SonosHandoffMenuBar/Features/PermissionOnboardingFeature.swift"
hotkeys="$repo_root/SonosHandoffMenuBar/SonosHandoffMenuBar/App/VolumeHotkeyController.swift"
settings="$repo_root/SonosHandoffMenuBar/SonosHandoffMenuBar/Features/SettingsFeature.swift"
status_hud="$repo_root/SonosHandoffMenuBar/SonosHandoffMenuBar/App/StatusHUD.swift"
status_item="$repo_root/SonosHandoffMenuBar/SonosHandoffMenuBar/App/KeywayStatusItemController.swift"
background_sync="$repo_root/SonosHandoffMenuBar/SonosHandoffMenuBar/App/PlaybackBackgroundSync.swift"

python3 - "$app_delegate" "$sonos_app" "$window_controller" "$onboarding" "$hotkeys" "$settings" "$status_hud" "$status_item" "$background_sync" <<'PY'
import pathlib
import sys

app_delegate = pathlib.Path(sys.argv[1]).read_text()
sonos_app = pathlib.Path(sys.argv[2]).read_text()
window_controller = pathlib.Path(sys.argv[3]).read_text()
onboarding = pathlib.Path(sys.argv[4]).read_text()
hotkeys = pathlib.Path(sys.argv[5]).read_text()
settings = pathlib.Path(sys.argv[6]).read_text()
status_hud = pathlib.Path(sys.argv[7]).read_text()
status_item = pathlib.Path(sys.argv[8]).read_text()
background_sync = pathlib.Path(sys.argv[9]).read_text()


def fail(message):
    raise SystemExit(f"verify_permission_onboarding_semantics: {message}")


def section(source, start_needle, end_needle):
    start = source.find(start_needle)
    if start < 0:
        fail(f"missing {start_needle!r}")
    end = source.find(end_needle, start)
    if end < 0:
        fail(f"missing {end_needle!r}")
    return source[start:end]


for required in (
    "private var permissionOnboardingController: PermissionOnboardingWindowController?",
    "permissionOnboardingController = PermissionOnboardingWindowController",
    "permissionOnboardingController!.presentIfNeeded()",
):
    if required not in app_delegate:
        fail(f"AppDelegate must own and present the first-run window: missing {required}")

launch = section(
    app_delegate,
    "    func applicationDidFinishLaunching",
    "\n    func applicationWillTerminate",
)
if "volumeHotkeys.start()" in launch:
    fail("AppDelegate must not start operational hotkeys before Local Network consent")
if launch.index("statusItemController?.start()") > launch.index("permissionOnboardingController!.presentIfNeeded()"):
    fail("the inert menu-bar shell must exist while permission onboarding is visible")
if launch.index("runtime.start()") > launch.index("permissionOnboardingController!.presentIfNeeded()"):
    fail("base media capabilities must start before onboarding is presented")
for required in (
    "PermissionOnboardingWindowController.localNetworkRequestedKey",
    "runtime.enableSonos()",
):
    if required not in launch:
        fail(f"launch must restore only the persisted Sonos capability: missing {required}")

runtime_start = section(
    sonos_app,
    "    func start() {",
    "\n    func enableSonos()",
)
for required in (
    "chromiumBrowserExtensionController.start()",
    "mediaRemoteController.start()",
    "mediaRoutingProbeController.start()",
    "refreshMediaPermissions()",
):
    if required not in runtime_start:
        fail(f"base startup must be owned by AppRuntime.start(): missing {required}")
if "guard !isStarted else" not in runtime_start or "isStarted = true" not in runtime_start:
    fail("AppRuntime.start() must be idempotent and publish activation before starting services")
for forbidden in (
    "SonosVolumeMonitor.shared.start(",
    "await outputDirectory.startBackgroundRefresh()",
    "playbackBackgroundSync.start()",
):
    if forbidden in runtime_start:
        fail(f"base startup must not activate Local Network work: found {forbidden}")

sonos_enable = section(
    sonos_app,
    "    func enableSonos() {",
    "\n    func stop()",
)
for required in (
    "guard isStarted, !isSonosEnabled else",
    "volumeHotkeys.setSonosVolumeInputEnabled(true)",
    "SonosVolumeMonitor.shared.start(",
    "playbackBackgroundSync.start()",
):
    if required not in sonos_enable:
        fail(f"Sonos activation must stay inside AppRuntime.enableSonos(): missing {required}")

runtime_stop = section(
    sonos_app,
    "    func stop() {",
    "\n    func refreshMediaPermissions",
)
for required in (
    "disableSonos()",
    "volumeHotkeys.stop()",
    "mediaRoutingProbeController.stop()",
    "mediaRemoteController.stop()",
    "chromiumBrowserExtensionController.stop()",
):
    if required not in runtime_stop:
        fail(f"operational shutdown must be owned by AppRuntime.stop(): missing {required}")

sonos_disable = section(
    sonos_app,
    "    private func disableSonos() {",
    "\n    private func prepareNotifications()",
)
for required in (
    "volumeHotkeys.setSonosVolumeInputEnabled(false)",
    "playbackBackgroundSync.stop()",
    "SonosVolumeMonitor.shared.stop()",
):
    if required not in sonos_disable:
        fail(f"Sonos shutdown must stay inside its capability owner: missing {required}")

termination = section(
    app_delegate,
    "    func applicationWillTerminate",
    "\n    nonisolated func userNotificationCenter",
)
for required in (
    "NotificationCenter.default.removeObserver(refreshHotkeysObserver)",
    "statusItemController?.stop()",
    "runtime?.stop()",
):
    if required not in termination:
        fail(f"AppDelegate termination must release app-owned resources: missing {required}")

for required in (
    "static let schemaVersion = 2",
    'static let completionKey = "permissionOnboardingCompletedVersion"',
    'static let localNetworkRequestedKey = "permissionOnboardingLocalNetworkRequested"',
    "UserDefaults.standard.integer(forKey: Self.completionKey) < Self.schemaVersion",
    "UserDefaults.standard.set(Self.schemaVersion, forKey: Self.completionKey)",
    "func presentIfNeeded() -> Bool",
    "_ = NSApp.setActivationPolicy(.regular)",
    "_ = NSApp.setActivationPolicy(.accessory)",
):
    if required not in window_controller:
        fail(f"window lifecycle must persist a version and restore menu-bar activation: missing {required}")

for required in (
    "private var permissionCompanionPanel: NSPanel?",
    "panel.level = .floating",
    "panel.hidesOnDeactivate = false",
    "panel.isFloatingPanel = true",
    "let appURL = Bundle.main.bundleURL",
    "NSDraggingItem(pasteboardWriter: appURL as NSURL)",
    "if operation.contains(.copy)",
):
    if required not in window_controller:
        fail(f"permission companion must float and drag the running app bundle: missing {required}")

for required in (
    "AccessibilityPermission.requestPrompt()",
    "CGRequestListenEventAccess()",
    "PlaybackSuggestionNotificationAuthorization.requestFromSettings(",
    "startLocalNetworkFeatures()",
    "localNetworkRequested = true",
    "NSApplication.didBecomeActiveNotification",
    '.disabled(!requiredSetupComplete)',
    '"Set Up Later"',
):
    if required not in onboarding:
        fail(f"wizard must guide and verify explicit user-driven requests: missing {required}")

for required in (
    "showPermissionCompanion(.accessibility)",
    "showPermissionCompanion(.inputMonitoring)",
    "showPermissionCompanion(.notifications)",
):
    if required not in onboarding:
        fail(f"every wizard permission must expose the shared companion: missing {required}")

for required in (
    "private var runtime: AppRuntime?",
    "runtime: AppRuntime",
    "runtime.start()",
    "self?.runtime?.enableSonos()",
):
    if required not in app_delegate:
        fail(f"AppDelegate must keep base and Sonos activation separate: missing {required}")
if "self?.runtime?.start()" in app_delegate:
    fail("Local Network onboarding must not restart the base runtime")

status_click = section(
    status_item,
    "    @objc private func handleStatusItemClick",
    "\n    private func togglePopover",
)
if "guard isRuntimeStarted() else" not in status_click:
    fail("the menu-bar shell must not expose operational controls before runtime activation")
if status_click.index("guard isRuntimeStarted() else") > status_click.index("togglePopover(relativeTo: sender)"):
    fail("blocked menu-bar interaction must reopen onboarding before the operational popover")
utility_menu = section(
    status_item,
    "    private func showUtilityMenu",
    "\n    private func menuItem",
)
if "if isRuntimeStarted()" not in utility_menu:
    fail("pre-activation utility menus must not expose MediaRemote restart")

background_init = section(
    background_sync,
    "    init(",
    "\n    private func bindRuntimeEvents",
)
if "AppEnvironment" in background_init:
    fail("background sync must receive explicit dependencies instead of the app composition root")
for forbidden in (
    "bindSuggestionAction(",
    "macAudioOutputMonitor.$output",
):
    if forbidden in background_init:
        fail(f"background sync init must be side-effect free before runtime activation: found {forbidden}")
background_start = section(
    background_sync,
    "    func start() {",
    "\n    private func syncOnce",
)
if "bindRuntimeEvents()" not in background_start:
    fail("background event subscriptions must be installed only at runtime activation")

refresh = section(
    hotkeys,
    "    func refreshMediaFallback() -> Bool {",
    "\n    private func ensureCommandCenterRoute",
)
for forbidden in (
    "AXIsProcessTrustedWithOptions",
    "CGRequestListenEventAccess",
    "promptIfMissing",
):
    if forbidden in hotkeys:
        fail(f"media-key runtime must detect permissions without prompting: found {forbidden}")
if "CGPreflightListenEventAccess()" not in refresh or "AXIsProcessTrusted()" not in refresh:
    fail("media-key runtime must continue to preflight both required permissions")

input_settings = section(
    settings,
    '                        Text("Input Monitoring")',
    '                        Text("Speaker suggestions")',
)
if "CGRequestListenEventAccess()" not in input_settings:
    fail("Settings Input Monitoring action must explicitly request access")
if "NSApplication.didBecomeActiveNotification" not in settings:
    fail("Settings must refresh permission badges after returning from System Settings")

not_determined = section(
    status_hud,
    "            case .notDetermined:",
    "            case .denied:",
)
if "requestAuthorization" in not_determined:
    fail("status notifications must not compete with onboarding for authorization")
if "authorization_not_requested" not in not_determined:
    fail("status notifications must record why undetermined authorization was skipped")

print("verify_permission_onboarding_semantics=ok")
PY
