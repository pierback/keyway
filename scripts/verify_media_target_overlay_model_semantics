#!/usr/bin/env bash
set -euo pipefail

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
workdir="$(mktemp -d)"
trap 'rm -rf "$workdir"' EXIT

cp "$repo_root/SonosHandoffMenuBar/SonosHandoffMenuBar/App/MediaTargetOverlayModel.swift" "$workdir/MediaTargetOverlayModel.swift"

if grep -q 'updateTargetsPreservingSelection' "$workdir/MediaTargetOverlayModel.swift"; then
  echo "verify_media_target_overlay_model_semantics: overlay rows must not update while the overlay is open" >&2
  exit 1
fi

cat >"$workdir/ModelStubs.swift" <<'SWIFT'
import Foundation

enum MediaRemoteTransportCommand: String {
    case playPause
}

struct MediaAudioControlPresentation {
    let title: String
    let detail: String
    let isEnabled: Bool

    static func disabled(title: String, detail: String) -> MediaAudioControlPresentation {
        MediaAudioControlPresentation(title: title, detail: detail, isEnabled: false)
    }
}

struct MediaAudioControlSnapshot {
    let sonos: MediaAudioControlPresentation
    let spotify: MediaAudioControlPresentation
    let browser: MediaAudioControlPresentation
}

struct MediaRemoteTarget: Equatable, Identifiable {
    let id: String
    let pid: Int
    let routingIdentity: String
    let appName: String
}

struct SourceRow: Equatable, Identifiable {
    let target: MediaRemoteTarget

    var id: String { target.id }
}
SWIFT

cat >"$workdir/OverlayModelSemantics.swift" <<'SWIFT'
import Foundation

@main
struct OverlayModelSemantics {
    @MainActor
    static func main() {
        newSessionResetsRowsAndSelection()
        movementStaysInsideTheVisibleSession()
        emptySessionClearsRows()
        print("verify_media_target_overlay_model_semantics=ok")
    }

    @MainActor
    private static func newSessionResetsRowsAndSelection() {
        let model = MediaTargetOverlayModel()
        model.update(command: .playPause, rows: [
            row(id: "helium:old", pid: 10, identity: "app.helium", appName: "Helium"),
            row(id: "spotify:old", pid: 20, identity: "com.spotify.client", appName: "Spotify"),
        ])
        model.select(index: 1)

        model.update(command: .playPause, rows: [
            row(id: "arc:new", pid: 30, identity: "company.thebrowser.Browser", appName: "Arc"),
        ])

        expectEqual(model.targets.map(\.id), ["arc:new"], "a new overlay session must use the rows passed at open time")
        expectEqual(model.selectedIndex, 0, "a new overlay session must reset selection")
        expectEqual(model.selectedTarget?.appName, "Arc", "a new overlay session must select the first visible row")
    }

    @MainActor
    private static func movementStaysInsideTheVisibleSession() {
        let model = MediaTargetOverlayModel()
        model.update(command: .playPause, rows: [
            row(id: "helium:open", pid: 10, identity: "app.helium", appName: "Helium"),
            row(id: "spotify:open", pid: 20, identity: "com.spotify.client", appName: "Spotify"),
        ])
        model.moveSelection(by: -1)

        expectEqual(model.targets.map(\.id), ["helium:open", "spotify:open"], "keyboard movement must not mutate visible rows")
        expectEqual(model.selectedIndex, 1, "keyboard movement must wrap within the open-session rows")
        expectEqual(model.selectedTarget?.id, "spotify:open", "keyboard movement must select only a visible-session row")
    }

    @MainActor
    private static func emptySessionClearsRows() {
        let model = MediaTargetOverlayModel()
        model.update(command: .playPause, rows: [
            row(id: "helium:old", pid: 10, identity: "app.helium", appName: "Helium"),
            row(id: "spotify:old", pid: 20, identity: "com.spotify.client", appName: "Spotify"),
        ])
        model.select(index: 0)

        model.update(command: .playPause, rows: [])

        expectEqual(model.targets.map(\.id), [], "an empty new session must clear visible rows")
        expectEqual(model.selectedIndex, 0, "an empty new session must reset selection")
        expectEqual(model.selectedTarget?.id, nil, "an empty new session must clear selected target")
    }

    private static func target(
        id: String,
        pid: Int,
        identity: String,
        appName: String
    ) -> MediaRemoteTarget {
        MediaRemoteTarget(id: id, pid: pid, routingIdentity: identity, appName: appName)
    }

    private static func row(
        id: String,
        pid: Int,
        identity: String,
        appName: String
    ) -> SourceRow {
        SourceRow(target: target(id: id, pid: pid, identity: identity, appName: appName))
    }

    private static func expectEqual<T: Equatable>(
        _ actual: T,
        _ expected: T,
        _ message: String
    ) {
        guard actual == expected else {
            fail("\(message): expected \(expected), got \(actual)")
        }
    }

    private static func fail(_ message: String) -> Never {
        FileHandle.standardError.write(Data("verify_media_target_overlay_model_semantics: \(message)\n".utf8))
        exit(1)
    }
}
SWIFT

swiftc \
  "$workdir/ModelStubs.swift" \
  "$workdir/MediaTargetOverlayModel.swift" \
  "$workdir/OverlayModelSemantics.swift" \
  -o "$workdir/verify_media_target_overlay_model_semantics"

"$workdir/verify_media_target_overlay_model_semantics"
