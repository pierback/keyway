#!/usr/bin/env bash
set -euo pipefail

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
workdir="$(mktemp -d)"
trap 'rm -rf "$workdir"' EXIT

cp \
  "$repo_root/SonosHandoffMenuBar/SonosHandoffMenuBar/App/MediaDesktopTransportAdapter.swift" \
  "$workdir/MediaDesktopTransportAdapter.swift"
sed -i '' '/^import AppKit$/d; /^import ApplicationServices$/d' "$workdir/MediaDesktopTransportAdapter.swift"

cat >"$workdir/Stubs.swift" <<'SWIFT'
import Foundation

enum AppleEventFixture {
    private static let fixtureLock = NSLock()
    private static var sendDelays: [TimeInterval] = []
    private static var sendStatuses: [OSStatus] = []
    private static var playbackStates: [OSType?] = []
    private static var eventIDs: [AEEventID] = []

    static func configure(
        sendDelays: [TimeInterval] = [],
        sendStatuses: [OSStatus] = [],
        playbackStates: [OSType?] = []
    ) {
        fixtureLock.lock()
        self.sendDelays = sendDelays
        self.sendStatuses = sendStatuses
        self.playbackStates = playbackStates
        eventIDs = []
        fixtureLock.unlock()
    }

    static func playbackState() -> OSType? {
        fixtureLock.lock()
        let state = playbackStates.isEmpty ? OSType(0x6B50_5350) : playbackStates.removeFirst()
        fixtureLock.unlock()
        return state
    }

    static func send(eventID: AEEventID) -> OSStatus {
        fixtureLock.lock()
        let delay = sendDelays.isEmpty ? 0 : sendDelays.removeFirst()
        let status = sendStatuses.isEmpty ? noErr : sendStatuses.removeFirst()
        fixtureLock.unlock()
        if delay > 0 {
            Thread.sleep(forTimeInterval: delay)
        }
        fixtureLock.lock()
        eventIDs.append(eventID)
        fixtureLock.unlock()
        return status
    }

    static func capturedEventIDs() -> [AEEventID] {
        fixtureLock.lock()
        let captured = eventIDs
        fixtureLock.unlock()
        return captured
    }
}

typealias OSStatus = Int32
typealias OSType = UInt32
typealias DescType = UInt32
typealias AEEventClass = UInt32
typealias AEEventID = UInt32
typealias AEKeyword = UInt32
typealias AEReturnID = Int16
typealias AETransactionID = Int32
typealias AESendMode = UInt32

struct AEAddressDesc {
    var eventID: AEEventID = 0
    var playbackState: OSType?
}
typealias AEDesc = AEAddressDesc
typealias AERecord = AEAddressDesc
typealias AppleEvent = AEAddressDesc

let noErr: OSStatus = 0
let typeApplicationBundleID: OSType = 0
let typeProperty: OSType = 1
let typeType: OSType = 2
let typeEnumerated: OSType = 3
let typeNull: OSType = 4
let typeObjectSpecifier: OSType = 5
let formPropertyID: OSType = 6
let keyAEDesiredClass: OSType = 7
let keyAEKeyForm: OSType = 8
let keyAEKeyData: OSType = 9
let keyAEContainer: OSType = 10
let keyDirectObject: OSType = 11
let kAECoreSuite: OSType = 12
let kAEGetData: OSType = 13
let kAutoGenerateReturnID: AEReturnID = 0
let kAnyTransactionID: AETransactionID = 0
let kAENoReply: UInt32 = 1
let kAEWaitReply: UInt32 = 2
let kAECanInteract: UInt32 = 4
let kAECanSwitchLayer: UInt32 = 8
let kAEDefaultTimeout: Int32 = 0

func AECreateList(
    _ factoringPtr: UnsafeRawPointer?,
    _ factoringSize: Int,
    _ isRecord: Bool,
    _ result: inout AERecord
) -> OSStatus { noErr }

func AEPutParamPtr(
    _ event: inout AppleEvent,
    _ keyword: OSType,
    _ type: DescType,
    _ dataPtr: UnsafeRawPointer?,
    _ dataSize: Int
) -> OSStatus { noErr }

func AECoerceDesc(
    _ source: inout AEDesc,
    _ type: DescType,
    _ result: inout AEDesc
) -> OSStatus { noErr }

func AEPutParamDesc(
    _ event: inout AppleEvent,
    _ keyword: OSType,
    _ descriptor: inout AEDesc
) -> OSStatus { noErr }

func AECreateDesc(
    _ descriptorType: DescType,
    _ dataPtr: UnsafeRawPointer?,
    _ dataSize: Int,
    _ result: inout AEAddressDesc
) -> OSStatus { noErr }

func AECreateAppleEvent(
    _ eventClass: AEEventClass,
    _ eventID: AEEventID,
    _ target: inout AEAddressDesc,
    _ returnID: AEReturnID,
    _ transactionID: AETransactionID,
    _ result: inout AppleEvent
) -> OSStatus {
    result.eventID = eventID
    return noErr
}

func AEDisposeDesc(_ descriptor: inout AEAddressDesc) -> OSStatus { noErr }

func AESendMessage(
    _ event: inout AppleEvent,
    _ reply: UnsafeMutablePointer<AppleEvent>?,
    _ sendMode: AESendMode,
    _ timeout: Int32
) -> OSStatus {
    if event.eventID == kAEGetData {
        reply?.pointee.playbackState = AppleEventFixture.playbackState()
        return noErr
    }
    return AppleEventFixture.send(eventID: event.eventID)
}

func AEGetParamPtr(
    _ event: inout AppleEvent,
    _ keyword: OSType,
    _ desiredType: DescType,
    _ actualType: UnsafeMutablePointer<DescType>?,
    _ dataPtr: UnsafeMutableRawPointer?,
    _ maximumSize: Int,
    _ actualSize: UnsafeMutablePointer<Int>?
) -> OSStatus {
    guard let playbackState = event.playbackState else {
        return -1700
    }
    actualType?.pointee = typeEnumerated
    dataPtr?.storeBytes(of: playbackState, as: OSType.self)
    actualSize?.pointee = MemoryLayout<OSType>.size
    return noErr
}

enum MediaRemoteTransportCommand: String, Equatable, Sendable {
    case play
    case pause
    case playPause
    case next
    case previous

    var displayName: String {
        switch self {
        case .play:
            return "Play"
        case .pause:
            return "Pause"
        case .playPause:
            return "Play/Pause"
        case .next:
            return "Next"
        case .previous:
            return "Previous"
        }
    }
}

struct MediaRemoteTarget: Equatable, Identifiable {
    let id: String
    let bundleIdentifier: String
    let parentBundleIdentifier: String
    let displayName: String
    let pid: Int
    let title: String
    let artist: String
    let album: String
    let playbackRate: String
    let mediaType: String?
    let artworkBase64: String?
    let duration: Double?
    let elapsedTime: Double?
    let elapsedTimestamp: Double?
    let supportedCommands: [MediaRemoteTransportCommand]?
    let browserFamily: String?
    let browserDisplayName: String?
    let browserBundleIdentifier: String?
}

struct MediaRemoteCommandResultEvent: Equatable, Sendable {
    let type: String
    let requestID: String?
    let targetID: String
    let command: String
    let ok: Bool
    let message: String
    let backend: String?
    let unsupported: Bool

    init(
        type: String,
        requestID: String?,
        targetID: String,
        command: String,
        ok: Bool,
        message: String,
        backend: String?,
        unsupported: Bool = false
    ) {
        self.type = type
        self.requestID = requestID
        self.targetID = targetID
        self.command = command
        self.ok = ok
        self.message = message
        self.backend = backend
        self.unsupported = unsupported
    }
}

enum ChromiumBrowserExtensionTransport {
    static let mediaType = "chromium_extension"
    static let targetIDPrefix = "chromium-tab:"

    static func isTarget(_ target: MediaRemoteTarget) -> Bool {
        target.mediaType == mediaType || target.id.hasPrefix(targetIDPrefix)
    }
}
SWIFT

cat >"$workdir/Semantics.swift" <<'SWIFT'
import Foundation

@main
struct Semantics {
    @MainActor
    static func main() async {
        let adapter = MediaDesktopTransportAdapter()
        let helium = target(
            id: "net.imput.helium:123:desktop",
            bundleIdentifier: "net.imput.helium",
            parentBundleIdentifier: ""
        )
        let heliumExtension = target(
            id: "chromium-tab:helium-profile:44",
            bundleIdentifier: "net.imput.helium",
            parentBundleIdentifier: "",
            mediaType: "chromium_extension"
        )
        let spotify = target(
            id: "com.spotify.client:123",
            bundleIdentifier: "com.spotify.client",
            parentBundleIdentifier: ""
        )
        let other = target(
            id: "com.example.other:123",
            bundleIdentifier: "com.example.other",
            parentBundleIdentifier: ""
        )

        expectEqual(
            adapter.backendName(for: helium),
            nil,
            "Helium desktop targets must not be owned by a fallback backend"
        )
        expectEqual(
            adapter.submit(command: .playPause, target: helium) { unexpectedResult($0) },
            nil,
            "Helium desktop targets must fail closed without fallback commands"
        )

        expectEqual(
            adapter.backendName(for: heliumExtension),
            nil,
            "Helium extension rows must not be claimed by the Helium desktop automation backend"
        )
        expectEqual(
            adapter.submit(command: .playPause, target: heliumExtension) { unexpectedResult($0) },
            nil,
            "Helium extension rows must route through the Chromium extension adapter"
        )

        expectEqual(
            adapter.backendName(for: spotify),
            "spotify_apple_event",
            "Spotify targets must be owned by Spotify AppleEvents"
        )
        expectEqual(adapter.backendName(for: other), nil, "Unknown targets must not claim a desktop backend")
        expectEqual(
            adapter.submit(command: .next, target: other) { unexpectedResult($0) },
            nil,
            "Unknown targets must remain unhandled by the desktop adapter"
        )

        AppleEventFixture.configure(playbackStates: [fourCharCode("kPSS")])
        let noTrackResult: MediaRemoteCommandResultEvent = await withCheckedContinuation { continuation in
            let submitted = adapter.submit(command: .play, target: spotify) { result in
                continuation.resume(returning: result)
            }
            expectEqual(submitted, "spotify_apple_event", "Spotify stopped state must remain owned by the desktop adapter")
        }
        expectEqual(noTrackResult.ok, false, "Spotify stopped state must not report a false command success")
        expectEqual(
            noTrackResult.message,
            "Spotify has no current desktop track.",
            "Spotify stopped state must explain why no command was sent"
        )
        expectEqual(
            AppleEventFixture.capturedEventIDs(),
            [],
            "Spotify stopped state must not enqueue a command that cannot execute"
        )

        AppleEventFixture.configure(sendDelays: [0.2])
        let delayedResult: MediaRemoteCommandResultEvent = await withCheckedContinuation { continuation in
            let startedAt = Date()
            let submitted = adapter.submit(command: .pause, target: spotify) { result in
                continuation.resume(returning: result)
            }
            expectEqual(submitted, "spotify_apple_event", "Spotify targets must be accepted by the desktop adapter")
            expectLessThan(
                Date().timeIntervalSince(startedAt),
                0.1,
                "Spotify AppleEvents must not block the main actor"
            )
        }
        expectEqual(delayedResult.ok, true, "Spotify delivery must report a successful AppleEvent send")
        expectEqual(delayedResult.backend, "spotify_apple_event", "Spotify results must retain backend provenance")
        expectEqual(
            AppleEventFixture.capturedEventIDs(),
            [fourCharCode("Paus")],
            "Spotify pause must use its native AppleEvent command"
        )

        AppleEventFixture.configure(sendDelays: [0.2, 0])
        var supersededResult: MediaRemoteCommandResultEvent?
        expectEqual(
            adapter.submit(command: .playPause, target: spotify) { result in
                supersededResult = result
            },
            "spotify_apple_event",
            "the first Spotify command must enter the serial AppleEvent transport"
        )
        let latestResult: MediaRemoteCommandResultEvent = await withCheckedContinuation { continuation in
            let submitted = adapter.submit(command: .playPause, target: spotify) { result in
                continuation.resume(returning: result)
            }
            expectEqual(submitted, "spotify_apple_event", "a newer Spotify command must supersede the pending result")
        }
        expectEqual(latestResult.ok, true, "the newest Spotify command must report successful delivery")
        try! await Task.sleep(nanoseconds: 50_000_000)
        expectEqual(supersededResult, nil, "superseded Spotify delivery must not report a stale result")
        expectEqual(
            AppleEventFixture.capturedEventIDs(),
            [
                fourCharCode("PlPs"),
                fourCharCode("PlPs"),
            ],
            "rapid Spotify toggles must remain ordered native toggle commands despite delayed delivery"
        )

        AppleEventFixture.configure(sendStatuses: [-600])
        let failedResult: MediaRemoteCommandResultEvent = await withCheckedContinuation { continuation in
            let submitted = adapter.submit(command: .play, target: spotify) { result in
                continuation.resume(returning: result)
            }
            expectEqual(submitted, "spotify_apple_event", "Spotify delivery failures must still be reported asynchronously")
        }
        expectEqual(failedResult.ok, false, "an AppleEvent delivery error must fail the Spotify result")
        expectEqual(
            failedResult.message,
            "Spotify AppleEvent failed status=-600",
            "Spotify delivery errors must retain their OSStatus"
        )

        print("verify_desktop_transport_semantics=ok")
    }

    @MainActor
    private static func unexpectedResult(_ result: MediaRemoteCommandResultEvent) {
        fail("unowned desktop target unexpectedly produced a result: \(result)")
    }

    private static func target(
        id: String,
        bundleIdentifier: String,
        parentBundleIdentifier: String,
        mediaType: String? = nil
    ) -> MediaRemoteTarget {
        MediaRemoteTarget(
            id: id,
            bundleIdentifier: bundleIdentifier,
            parentBundleIdentifier: parentBundleIdentifier,
            displayName: bundleIdentifier,
            pid: 123,
            title: "",
            artist: "",
            album: "",
            playbackRate: "1",
            mediaType: mediaType,
            artworkBase64: nil,
            duration: nil,
            elapsedTime: nil,
            elapsedTimestamp: nil,
            supportedCommands: nil,
            browserFamily: nil,
            browserDisplayName: nil,
            browserBundleIdentifier: nil
        )
    }

    private static func fourCharCode(_ value: String) -> OSType {
        value.utf8.reduce(0) { ($0 << 8) + UInt32($1) }
    }

    private static func expectEqual<T: Equatable>(_ actual: T, _ expected: T, _ message: String) {
        guard actual == expected else {
            fail("\(message): expected \(String(describing: expected)), got \(String(describing: actual))")
        }
    }

    private static func expectLessThan(_ actual: Double, _ expected: Double, _ message: String) {
        guard actual < expected else {
            fail("\(message): expected less than \(expected), got \(actual)")
        }
    }

    private static func fail(_ message: String) -> Never {
        FileHandle.standardError.write(Data("verify_desktop_transport_semantics: \(message)\n".utf8))
        exit(1)
    }
}
SWIFT

swiftc \
  "$workdir/Stubs.swift" \
  "$workdir/MediaDesktopTransportAdapter.swift" \
  "$workdir/Semantics.swift" \
  -o "$workdir/verify_desktop_transport_semantics"

"$workdir/verify_desktop_transport_semantics"

python3 - "$repo_root/SonosHandoffMenuBar/SonosHandoffMenuBar/App/MediaDesktopTransportAdapter.swift" <<'PY'
import sys

source = open(sys.argv[1], encoding="utf-8").read()

def fail(message):
    print(f"verify_desktop_transport_semantics: {message}", file=sys.stderr)
    sys.exit(1)

def index(needle):
    position = source.find(needle)
    if position < 0:
        fail(f"missing {needle!r}")
    return position

def assert_order(needles, message):
    positions = [index(needle) for needle in needles]
    if positions != sorted(positions):
        fail(message)

if "MediaDesktopTransportBackend" in source or "backend(for target:" in source:
    fail("single-backend desktop transport must not retain an enum or backend selector")

if 'nonisolated private static let spotifyAppleEventBackend = "spotify_apple_event"' not in source:
    fail("Spotify desktop transport must expose its backend name as a static constant")

if source.count("guard !ChromiumBrowserExtensionTransport.isTarget(target) else") != 1 \
        or source.count("guard Self.isSpotifyTarget(target) else") != 1:
    fail("desktop transport eligibility must have one canonical Spotify target guard")

if "guard let backend = backendName(for: target) else" not in source:
    fail("desktop command submission must reuse backend-name eligibility")

if "switch backend" in source:
    fail("single-backend desktop transport must dispatch directly without a switch")

assert_order(
    [
        "nonisolated private static let spotifyCommandQueue",
        "private var spotifySubmissionID: UUID?",
        "spotifySubmissionID = submissionID",
        "Self.spotifyCommandQueue.async",
        'let playbackStopped = Self.spotifyPlaybackState() == Self.fourCharCode("kPSS")',
        ": Self.sendAppleEvent(",
        "Task { @MainActor [weak self] in",
        "self.spotifySubmissionID = nil",
        "onResult(result)",
    ],
    "Spotify AppleEvents must use one ordered background transport and only publish the newest result on the main actor",
)

for forbidden in [
    "NSAppleScript",
    "spotifyPlaybackStatus",
    "Task.detached",
    "Thread.sleep",
    "unsupported: true",
]:
    if forbidden in source:
        fail("Spotify delivery must use background-safe AppleEvents without state polling or unsupported-result reclassification")

for needle in [
    "onResult: @escaping @MainActor @Sendable (MediaRemoteCommandResultEvent) -> Void",
    "guard let self, self.spotifySubmissionID == submissionID else",
    "nonisolated private static func spotifyPlaybackState() -> OSType?",
    "nonisolated private static func sendAppleEvent(",
    'var keyData = fourCharCode("pPlS")',
    "AECreateList(",
    "AEPutParamPtr(",
    "AECoerceDesc(",
    "AEPutParamDesc(",
    "AEGetParamPtr(",
    "AESendMode(kAEWaitReply | kAECanInteract | kAECanSwitchLayer)",
    'message: playbackStopped',
    '"Spotify has no current desktop track."',
    "AECreateDesc(",
    "AECreateAppleEvent(",
    "AESendMessage(",
    "AESendMode(kAENoReply | kAECanInteract | kAECanSwitchLayer)",
]:
    if needle not in source:
        fail("Spotify AppleEvents must report ordered delivery results without blocking the main actor")

for needle in [
    'case .play:\n            return "Play"',
    'case .pause:\n            return "Paus"',
    'case .playPause:\n            return "PlPs"',
    'case .next:\n            return "Next"',
    'case .previous:\n            return "Prev"',
]:
    if needle not in source:
        fail("Spotify AppleEvent transport must keep the explicit Spotify command mapping for every routed desktop command")
PY
