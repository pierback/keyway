#!/usr/bin/env bash
set -euo pipefail

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
monitor="$repo_root/SonosHandoffMenuBar/SonosHandoffMenuBar/App/MacAudioOutputMonitor.swift"
suggestion="$repo_root/SonosHandoffMenuBar/SonosHandoffMenuBar/App/HeadphoneTransferSuggestion.swift"
sync="$repo_root/SonosHandoffMenuBar/SonosHandoffMenuBar/App/PlaybackBackgroundSync.swift"
delegate="$repo_root/SonosHandoffMenuBar/SonosHandoffMenuBar/App/AppDelegate.swift"
notifications="$repo_root/SonosHandoffMenuBar/SonosHandoffMenuBar/App/ShortcutRuntimeStatus.swift"
registrar="$repo_root/SonosHandoffMenuBar/SonosHandoffMenuBar/App/PlaybackGroupSuggestion.swift"
environment="$repo_root/SonosHandoffMenuBar/SonosHandoffMenuBar/Support/AppEnvironment.swift"
project_file="$repo_root/SonosHandoffMenuBar/SonosHandoffMenuBar.xcodeproj/project.pbxproj"

fail() {
  printf 'verify_headphone_transfer_suggestion_semantics: %s\n' "$*" >&2
  exit 1
}

expect_contains() {
  local path="$1"
  local text="$2"
  grep -Fq "$text" "$path" || fail "$path missing expected text: $text"
}

expect_absent() {
  local path="$1"
  local text="$2"
  if grep -Fq "$text" "$path"; then
    fail "$path still contains forbidden text: $text"
  fi
}

ast-grep --lang swift -p '@MainActor
final class MacAudioOutputMonitor: ObservableObject { $$$ }' "$monitor" >/dev/null
expect_contains "$monitor" "import CoreAudio"
expect_contains "$monitor" "@Published private(set) var output: MacAudioOutputDevice?"
expect_contains "$monitor" "kAudioHardwarePropertyDefaultOutputDevice"
expect_contains "$monitor" "AudioObjectAddPropertyListenerBlock"
expect_contains "$monitor" "kAudioDevicePropertyTransportType"
expect_contains "$monitor" "isHeadphoneOutput(name: name)"
expect_absent "$monitor" "kAudioDeviceTransportTypeBluetooth?"
expect_absent "$monitor" "kAudioDeviceTransportTypeBluetoothLE?"
expect_contains "$monitor" "airpods"
expect_contains "$monitor" "headphone"

ast-grep --lang swift -p '@MainActor
final class HeadphoneTransferSuggestionPresenter { $$$ }' "$suggestion" >/dev/null
expect_contains "$suggestion" "struct HeadphoneTransferSuggestion"
expect_contains "$suggestion" 'static let categoryIdentifier = "sonos-handoff.headphone-transfer-suggestion"'
expect_contains "$suggestion" 'static let transferActionIdentifier = "sonos-handoff.headphone-transfer-suggestion.transfer"'
expect_contains "$suggestion" 'static let ignoreActionIdentifier = "sonos-handoff.headphone-transfer-suggestion.ignore"'
expect_contains "$suggestion" 'title: "Switch"'
expect_contains "$suggestion" 'title: "Ignore"'
expect_contains "$suggestion" 'content.title = "Headphones connected"'
expect_contains "$suggestion" 'content.categoryIdentifier = HeadphoneTransferSuggestionNotification.categoryIdentifier'
expect_contains "$suggestion" '"suggestionID": suggestion.id'
expect_contains "$suggestion" "suppressedOutputIDs.insert(suggestion.outputID)"

expect_contains "$registrar" "HeadphoneTransferSuggestionNotification.category"
expect_contains "$notifications" "sonosHandoffAcceptHeadphoneTransferSuggestion"
expect_contains "$notifications" "sonosHandoffIgnoreHeadphoneTransferSuggestion"
expect_contains "$delegate" "HeadphoneTransferSuggestionNotification.categoryIdentifier"
expect_contains "$delegate" ".sonosHandoffAcceptHeadphoneTransferSuggestion"
expect_contains "$delegate" ".sonosHandoffIgnoreHeadphoneTransferSuggestion"

expect_absent "$environment" "let headphoneTransferSuggestionStore: HeadphoneTransferSuggestionStore"
expect_absent "$environment" "let headphoneTransferSuggestionPresenter: HeadphoneTransferSuggestionPresenter"
expect_absent "$environment" "let macAudioOutputMonitor: MacAudioOutputMonitor"
expect_contains "$environment" "let macAudioOutputMonitor = MacAudioOutputMonitor()"
expect_contains "$environment" "headphoneTransferSuggestionStore: headphoneTransferSuggestionStore"
expect_contains "$environment" "headphoneTransferSuggestionPresenter: headphoneTransferSuggestionPresenter"
expect_contains "$environment" "macAudioOutputMonitor: macAudioOutputMonitor"

expect_contains "$sync" "private let headphoneTransferSuggestionPresenter: HeadphoneTransferSuggestionPresenter"
expect_contains "$sync" "private let macAudioOutputMonitor: MacAudioOutputMonitor"
expect_contains "$sync" "private var hasAudioOutputBaseline = false"
expect_contains "$sync" "private var pendingHeadphoneConnectionOutputID: UInt32?"
expect_contains "$sync" "macAudioOutputMonitor.start()"
expect_contains "$sync" "establishMacAudioOutputBaselineIfNeeded(macAudioOutputMonitor.output)"
expect_contains "$sync" 'macAudioOutputMonitor.$output'
expect_contains "$sync" "recordMacAudioOutputChange(output)"
expect_contains "$sync" "private func recordMacAudioOutputChange(_ output: MacAudioOutputDevice?)"
expect_contains "$sync" "pendingHeadphoneConnectionOutputID = output.id"
expect_contains "$sync" "try await updateHeadphoneTransferSuggestion("
expect_contains "$sync" "activeRoomName: selectedRoomName,"
expect_contains "$sync" "ticket: ticket"
expect_contains "$sync" "ticket: PlaybackAuthorityTicket"
expect_contains "$sync" "guard isCurrentObservation(ticket) else"
expect_contains "$sync" "guard output.isHeadphones else"
expect_contains "$sync" "guard pendingHeadphoneConnectionOutputID == output.id else"
expect_contains "$sync" "pendingHeadphoneConnectionOutputID = nil"
expect_contains "$sync" "activePlaybackObserver.availablePlaybackDevices()"
expect_contains "$sync" 'device.type.caseInsensitiveCompare("Computer") == .orderedSame'
expect_contains "$sync" "private func localSpotifyComputerPlaybackDeviceName() async throws -> String?"
expect_contains "$sync" "private static func localSpotifyComputerDeviceNames() -> [String]"
expect_contains "$sync" "Host.current()"
expect_contains "$sync" "ProcessInfo.processInfo.hostName"
expect_contains "$sync" "normalizedSpotifyDeviceName"
expect_contains "$sync" "HeadphoneTransferSuggestion("
expect_contains "$sync" "headphoneTransferSuggestionPresenter.presentIfNeeded(suggestion)"
expect_contains "$sync" "activePlaybackObserver.transferActivePlayback("
expect_contains "$sync" "guard let deviceName = try await localSpotifyComputerPlaybackDeviceName() else"
expect_contains "$sync" "deviceName: deviceName"
expect_contains "$sync" 'deviceType: "Computer"'
expect_contains "$sync" "play: true"
expect_contains "$sync" 'clearSelection(reason: "spotify_transferred_to_mac")'
expect_contains "$sync" "headphoneTransferSuggestionPresenter.suppress(id: suggestion.id)"
expect_contains "$sync" "guard let ticket = operationGate.beginTransaction(roomName: suggestion.outputName) else"
expect_contains "$sync" "guard operationGate.isCurrentTransaction(ticket) else"
expect_contains "$sync" "Could not move Spotify playback to this Mac."
expect_absent "$suggestion" "spotifyDeviceName"
expect_contains "$repo_root/packages/SonosHandoffCore/Sources/SonosHandoffCore/Handoff/SpotifyConnectBridge.swift" "https://api.spotify.com/v1/me/player"
expect_contains "$repo_root/packages/SonosHandoffCore/Sources/SonosHandoffCore/Handoff/SpotifyConnectBridge.swift" "SpotifyTransferPlaybackRequest"

python3 - "$sync" <<'PY'
import pathlib
import sys

text = pathlib.Path(sys.argv[1]).read_text()
start = text.index("    private func acceptHeadphoneTransferSuggestion(")
end = text.index("    private func ignoreHeadphoneTransferSuggestion", start)
body = text[start:end]
if "roomHandoffService.transfer" in body:
    raise SystemExit("verify_headphone_transfer_suggestion_semantics: headphone CTA must not use Sonos room transfer")
if "mediaTransportActionController.route" in body:
    raise SystemExit("verify_headphone_transfer_suggestion_semantics: headphone CTA must not route through media transport fallback")
if "startActivePlayback(" in body:
    raise SystemExit("verify_headphone_transfer_suggestion_semantics: headphone CTA must not use Spotify play/start endpoint")
if "transferActivePlayback(" not in body:
    raise SystemExit("verify_headphone_transfer_suggestion_semantics: headphone CTA must transfer active Spotify playback")
PY

expect_contains "$project_file" "HeadphoneTransferSuggestion.swift"
expect_contains "$project_file" "MacAudioOutputMonitor.swift"
expect_absent "$suggestion" "PlaybackTransferSuggestion"

printf 'verify_headphone_transfer_suggestion_semantics=ok\n'
