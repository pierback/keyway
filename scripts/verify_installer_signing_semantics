#!/usr/bin/env bash
set -euo pipefail

ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
INSTALLER="$(<"$ROOT_DIR/scripts/install_menubar_app")"
INSTALLER_BUILD="$(sed -n '/^xcodebuild \\/,/^  build$/p' "$ROOT_DIR/scripts/install_menubar_app")"
PROJECT_GENERATOR="$(<"$ROOT_DIR/scripts/generate_xcode_projects.rb")"
REGRESSION_GATE="$(<"$ROOT_DIR/scripts/regression_gate")"

if [[ "$INSTALLER_BUILD" == *'CODE_SIGN_STYLE='* ]] \
  || [[ "$INSTALLER_BUILD" == *'CODE_SIGN_IDENTITY='* ]]; then
  echo 'error: the installer must not override automatic Xcode signing' >&2
  exit 1
fi

if [[ "$INSTALLER" != *"EXPECTED_TEAM_ID='7Q44SDV7BM'"* ]] \
  || [[ "$INSTALLER" != *'TeamIdentifier=$EXPECTED_TEAM_ID'* ]]; then
  echo 'error: the installer must reject artifacts outside the paid Apple team' >&2
  exit 1
fi

if [[ "$PROJECT_GENERATOR" != *"settings['CODE_SIGN_STYLE'] = 'Automatic'"* ]] \
  || [[ "$PROJECT_GENERATOR" == *"settings['CODE_SIGN_STYLE'] = 'Manual'"* ]]; then
  echo 'error: generated Xcode projects must retain automatic signing' >&2
  exit 1
fi

if [[ "$REGRESSION_GATE" == *'CODE_SIGN_STYLE=Manual'* ]]; then
  echo 'error: ordinary regression builds must retain automatic signing' >&2
  exit 1
fi

echo 'installer_signing_semantics=ok'
