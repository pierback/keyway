#!/usr/bin/env bash
set -euo pipefail

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
controller="$repo_root/SonosHandoffMenuBar/SonosHandoffMenuBar/App/MediaTransportActionController.swift"
desktop_transport="$repo_root/SonosHandoffMenuBar/SonosHandoffMenuBar/App/MediaDesktopTransportAdapter.swift"

ast-grep --pattern 'private func automaticTarget($$$) -> $$$ { $$$ }' "$controller" >/dev/null
ast-grep --pattern 'private func showCommandFailureIfNeeded($$$) { $$$ }' "$controller" >/dev/null
ast-grep --pattern 'private func transportBackendName($$$) -> $$$ { $$$ }' "$controller" >/dev/null

python3 - "$controller" "$desktop_transport" <<'PY'
import sys

source_path = sys.argv[1]
source = open(source_path, encoding="utf-8").read()
desktop_transport_path = sys.argv[2]
desktop_transport = open(desktop_transport_path, encoding="utf-8").read()

def fail(message):
    print(f"verify_mixed_media_routing_semantics: {message}", file=sys.stderr)
    sys.exit(1)

def index(needle):
    position = source.find(needle)
    if position < 0:
        fail(f"missing {needle!r}")
    return position

def function_body(signature_suffix):
    signature = f"private func {signature_suffix}"
    start = index(signature)
    brace = source.find("{", start)
    if brace < 0:
        fail(f"missing body for {name}")
    depth = 0
    for offset in range(brace, len(source)):
        char = source[offset]
        if char == "{":
            depth += 1
        elif char == "}":
            depth -= 1
            if depth == 0:
                return source[brace + 1:offset]
    fail(f"unterminated body for {name}")

def assert_contains(haystack, needle, message):
    if needle not in haystack:
        fail(message)

def assert_order(haystack, needles, message):
    positions = []
    for needle in needles:
        position = haystack.find(needle)
        if position < 0:
            fail(f"{message}: missing {needle!r}")
        positions.append(position)
    if positions != sorted(positions):
        fail(message)

route_input = function_body("route(\n        command:")
assert_order(
    route_input,
    [
        "if MediaTransportCommandRules.isPlayFamily(command)",
        "showChooserImmediately(",
        "routeFromCache(",
    ],
    "play-family commands must open the chooser before cache routing can guess"
)

route_targets = function_body("route(\n        command: MediaRemoteTransportCommand,\n        targets:")
assert_order(
    route_targets,
    [
        "if let decision = automaticTarget(command: command, from: targets)",
        "send(command: command, to: decision.target, reason: decision.reason)",
        "showChooserOverlay(",
    ],
    "ambiguous multi-target routing must fall through to the chooser"
)

automatic_target = function_body("automaticTarget")
assert_order(
    automatic_target,
    [
        "preferredChromiumExtensionTarget(command: command, from: targets)",
        "targets.count == 1",
        "playingTargets.count == 1",
        "focusResolver.focusedTarget(in: targets)",
        "targetSelectionMemory.recentTargetID",
        "return nil",
    ],
    "automatic target selection must prefer a single playing target before focused/recent targets"
)

chromium_extension = function_body("preferredChromiumExtensionTarget")
assert_order(
    chromium_extension,
    [
        "ChromiumBrowserExtensionTransport.supports(command: command, target: $0)",
        "extensionTargets.filter(\\.isCurrentlyPlaying)",
        "playingExtensionTargets.count == 1",
    ],
    "automatic routing must prefer exactly one playing Chromium extension target for supported commands"
)

send = function_body("send(command:")
assert_order(
    send,
    [
        "desktopTransport.submit(command: command, target: target)",
        "shouldFallbackFromUnsupportedDesktopResult(target: target)",
        "sendProgrammaticSpotifyWebAPI(command: command, to: target, dispatchID: dispatchID, reason: reason)",
        '"desktop_transport_fallback"',
        "sendProgrammaticMediaRemote(command: command, to: target, dispatchID: dispatchID, reason: reason)",
        "chromiumBrowserExtensionController.submit(command: command, target: target",
        "sendProgrammaticLegacy(command: command, to: target, dispatchID: dispatchID, reason: reason)",
    ],
    "programmatic dispatch must prefer desktop adapters, gate unsupported desktop fallback, then use Chromium extension exactly before legacy"
)
if "legacyChromiumFallbackTarget" in send or '"chromium_extension_fallback"' in send:
    fail("Chromium extension command failures must not fall back to legacy browser rows")

programmatic_legacy = function_body("sendProgrammaticLegacy")
assert_order(
    programmatic_legacy,
    [
        "desktopTransport.submit(command: command, target: target)",
        "shouldFallbackFromUnsupportedDesktopResult(target: target)",
        "sendProgrammaticSpotifyWebAPI(command: command, to: target, dispatchID: dispatchID, reason: reason)",
        '"desktop_transport_fallback"',
        "sendProgrammaticMediaRemote(command: command, to: target, dispatchID: dispatchID, reason: reason)",
        "canUseMediaRemotePlayerPath(command: command, target: target)",
        "guard sendProgrammaticMediaRemote(command: command, to: target, dispatchID: dispatchID, reason: reason)",
    ],
    "programmatic legacy dispatch must gate unsupported desktop fallback before Spotify Web API and MediaRemote"
)

programmatic_spotify_webapi = function_body("sendProgrammaticSpotifyWebAPI")
assert_order(
    programmatic_spotify_webapi,
    [
        "spotifyPlaybackCommand(command: command, target: target)",
        "spotifyPlaybackController.sendActivePlaybackCommand(spotifyCommand)",
        "Self.spotifyWebAPIResult(",
        "Self.spotifyWebAPIBackend",
        "finishProgrammaticDispatch(",
        "sendProgrammaticMediaRemote(command: command, to: target, dispatchID: dispatchID, reason: reason)",
        '"spotify_webapi_fallback"',
        "showCommandFailureIfNeeded(result: result, target: target)",
    ],
    "programmatic Spotify Web API fallback must use the shared Spotify command service and fall through to MediaRemote on command failure"
)

programmatic_mediaremote = function_body("sendProgrammaticMediaRemote")
assert_order(
    programmatic_mediaremote,
    [
        "canUseMediaRemotePlayerPath(command: command, target: target)",
        "mediaRemoteController.submit(command: command, targetID: target.id)",
        "Self.mediaRemotePlayerPathBackend",
        "finishProgrammaticDispatch(",
        "showCommandFailureIfNeeded(result: result, target: target)",
    ],
    "programmatic MediaRemote fallback must use the player path and preserve async result handling"
)

chooser_send = function_body("sendFromChooser")
assert_order(
    chooser_send,
    [
        "desktopTransport.submit(command: command, target: target)",
        "shouldFallbackFromUnsupportedDesktopResult(target: target)",
        "sendChooserSpotifyWebAPI(command: command, to: target, dispatchID: dispatchID)",
        '"desktop_transport_fallback"',
        "sendChooserMediaRemote(command: command, to: target, dispatchID: dispatchID)",
        "chromiumBrowserExtensionController.submit(command: command, target: target",
        "sendChooserLegacy(command: command, to: target, dispatchID: dispatchID)",
    ],
    "chooser dispatch must prefer desktop adapters, gate unsupported desktop fallback, then use Chromium extension exactly before legacy"
)
if "legacyChromiumFallbackTarget" in chooser_send or '"chromium_extension_fallback"' in chooser_send:
    fail("Chooser Chromium extension command failures must not fall back to legacy browser rows")

chooser_legacy = function_body("sendChooserLegacy")
assert_order(
    chooser_legacy,
    [
        "desktopTransport.submit(command: command, target: target)",
        "shouldFallbackFromUnsupportedDesktopResult(target: target)",
        "sendChooserSpotifyWebAPI(command: command, to: target, dispatchID: dispatchID)",
        '"desktop_transport_fallback"',
        "sendChooserMediaRemote(command: command, to: target, dispatchID: dispatchID)",
        "canUseMediaRemotePlayerPath(command: command, target: target)",
        "guard sendChooserMediaRemote(command: command, to: target, dispatchID: dispatchID)",
    ],
    "chooser legacy dispatch must gate unsupported desktop fallback before Spotify Web API and MediaRemote"
)

chooser_spotify_webapi = function_body("sendChooserSpotifyWebAPI")
assert_order(
    chooser_spotify_webapi,
    [
        "spotifyPlaybackCommand(command: command, target: target)",
        "spotifyPlaybackController.sendActivePlaybackCommand(spotifyCommand)",
        "Self.spotifyWebAPIResult(",
        "Self.spotifyWebAPIBackend",
        "finishChooserDispatch(",
        "sendChooserMediaRemote(command: command, to: target, dispatchID: dispatchID)",
        '"spotify_webapi_fallback"',
        "showCommandFailureIfNeeded(result: result, target: target)",
    ],
    "chooser Spotify Web API fallback must use the shared Spotify command service and fall through to MediaRemote on command failure"
)

chooser_mediaremote = function_body("sendChooserMediaRemote")
assert_order(
    chooser_mediaremote,
    [
        "canUseMediaRemotePlayerPath(command: command, target: target)",
        "mediaRemoteController.submit(command: command, targetID: target.id)",
        "Self.mediaRemotePlayerPathBackend",
        "finishChooserDispatch(",
        "showCommandFailureIfNeeded(result: result, target: target)",
    ],
    "chooser MediaRemote fallback must use the player path and preserve async result handling"
)

mediaremote_gate = function_body("canUseMediaRemotePlayerPath")
assert_order(
    mediaremote_gate,
    [
        "ChromiumBrowserExtensionTransport.isTarget(target)",
        "desktopTransport.backendName(for: target) != nil",
        "target.isChromiumBrowserLike",
        '"browser_legacy_mediaremote_blocked"',
        '"requires_browser_extension"',
        '"Browser Extension Required"',
        "return false",
    ],
    "legacy Chromium browser rows must not use MediaRemote player-path routing because selected-row dispatch can affect a competing global media session"
)

desktop_fallback_gate = function_body("shouldFallbackFromUnsupportedDesktopResult")
assert_contains(
    desktop_fallback_gate,
    "!target.isChromiumBrowserLike",
    "Unsupported browser desktop automation commands must not fall through to MediaRemote or Spotify fallback"
)
assert_contains(
    desktop_transport,
    "const hasMediaSource = element => Boolean(element.currentSrc || element.src || element.querySelector('source')); const isReady = element => !element.ended && hasMediaSource(element);",
    "Helium desktop fallback must keep active-tab media targets stable through pause and source transitions"
)
if "legacyChromiumFallbackTarget" in source or '"chromium_extension_fallback"' in source:
    fail("Chromium extension routing must not retain legacy browser fallback hooks")

failure = function_body("showCommandFailureIfNeeded")
assert_order(
    failure,
    [
        "if result.unsupported",
        'title: "Command Unsupported"',
        'title: "Media Command Failed"',
    ],
    "unsupported command results must be shown as unsupported rather than generic failures"
)

backend = function_body("transportBackendName")
assert_order(
    backend,
    [
        "desktopTransport.backendName(command: command, target: target)",
        "chromiumBrowserExtensionController.backendName(command: command, target: target)",
        "Self.mediaRemotePlayerPathBackend",
    ],
    "backend names must follow the same desktop/Chromium/MediaRemote priority as dispatch"
)

chooser_scoped = function_body("chooserScopedCommand")
assert_contains(
    chooser_scoped,
    "desktopTransport.keepsPlayPauseToggle(for: target)",
    "chooser-scoped playPause must preserve desktop adapter toggles for Spotify and Helium"
)

spotify_command = function_body("spotifyPlaybackCommand")
assert_order(
    spotify_command,
    [
        "guard target.isSpotify",
        "case .play:",
        "return .play",
        "case .pause:",
        "return .pause",
        "case .playPause:",
        "return .playPause",
        "case .next:",
        "return .next",
        "case .previous:",
        "return .previous",
    ],
    "Spotify Web API fallback must map every media transport command to the shared Spotify playback command model"
)

assert_contains(
    source,
    "private let spotifyPlaybackController: any SpotifyActivePlaybackObserving",
    "media transport routing must receive the shared Spotify playback service"
)
assert_contains(
    source,
    'private static let spotifyWebAPIBackend = "spotify_web_api"',
    "Spotify Web API fallback must have a distinct trace backend"
)

print("verify_mixed_media_routing_semantics=ok")
PY
