#!/usr/bin/env bash
set -euo pipefail

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
controller="$repo_root/SonosHandoffMenuBar/SonosHandoffMenuBar/App/MediaTransportActionController.swift"
target_resolver="$repo_root/SonosHandoffMenuBar/SonosHandoffMenuBar/App/MediaTransportTargetResolver.swift"
desktop_transport="$repo_root/SonosHandoffMenuBar/SonosHandoffMenuBar/App/MediaDesktopTransportAdapter.swift"

ast-grep --pattern 'func automaticTarget($$$) -> $$$ { $$$ }' "$target_resolver" >/dev/null
ast-grep --pattern 'private func showCommandFailureIfNeeded($$$) { $$$ }' "$controller" >/dev/null
ast-grep --pattern 'private func transportBackendName($$$) -> $$$ { $$$ }' "$controller" >/dev/null

python3 - "$controller" "$target_resolver" "$desktop_transport" <<'PY'
import sys

source_path = sys.argv[1]
source = open(source_path, encoding="utf-8").read()
target_resolver_path = sys.argv[2]
target_resolver = open(target_resolver_path, encoding="utf-8").read()
desktop_transport_path = sys.argv[3]
desktop_transport = open(desktop_transport_path, encoding="utf-8").read()

def fail(message):
    print(f"verify_mixed_media_routing_semantics: {message}", file=sys.stderr)
    sys.exit(1)

def index(needle):
    position = source.find(needle)
    if position < 0:
        fail(f"missing {needle!r}")
    return position

def function_body(signature_suffix, text=None):
    text = source if text is None else text
    signature = f"private func {signature_suffix}"
    start = text.find(signature)
    if start < 0:
        signature = f"func {signature_suffix}"
        start = text.find(signature)
    if start < 0:
        fail(f"missing {signature!r}")
    brace = text.find("{", start)
    if brace < 0:
        fail(f"missing body for {name}")
    depth = 0
    for offset in range(brace, len(text)):
        char = text[offset]
        if char == "{":
            depth += 1
        elif char == "}":
            depth -= 1
            if depth == 0:
                return text[brace + 1:offset]
    fail(f"unterminated body for {name}")

def assert_contains(haystack, needle, message):
    if needle not in haystack:
        fail(message)

def assert_order(haystack, needles, message):
    positions = []
    for needle in needles:
        position = haystack.find(needle)
        if position < 0:
            fail(f"{message}: missing {needle!r}")
        positions.append(position)
    if positions != sorted(positions):
        fail(message)

route_input = function_body("route(\n        command:")
assert_order(
    route_input,
    [
        "case .commandCenter:",
        "commandCenterFilter.noteCommandCenterInput(command: command, metadata: commandCenterMetadata)",
        "case .userInterface:",
        '"decision_current_targets"',
        "routeFromCache(",
    ],
    "command-center input must enter the shared current-target gate after duplicate filtering"
)
command_center_branch = route_input[
    route_input.index("case .commandCenter:"):
    route_input.index("case .userInterface:")
]
if "routePlayFamilyWithoutChooser(" in command_center_branch:
    fail("command-center play-family input must not bypass the chooser through direct routing")
if "shouldRoutePlayFamilyWithoutChooser" in route_input or "routePlayFamilyWithoutChooser(" in route_input:
    fail("non-UI media input must not bypass the chooser through a targeted HID/PID route")
assert_order(
    route_input,
    [
        '"decision_current_targets"',
        "routeFromCache(",
    ],
    "media-key and command-center input must use the shared current-target ambiguity gate"
)

route_targets = function_body("route(\n        command: MediaRemoteTransportCommand,\n        targets:")
assert_order(
    route_targets,
    [
        "if targets.count == 1",
        "send(command: command, to: targets[0], reason: .single)",
    ],
    "non-row media input must still direct-route a single visible source"
)
assert_contains(
    route_targets,
    "if MediaTransportCommandRules.isPlayFamily(command)",
    "ambiguous play-family routing must stay chooser-first"
)
assert_contains(
    route_targets,
    "if let decision = targetResolver.automaticTarget(",
    "non-play-family routing must restore automatic target selection after the chooser regression"
)
assert_contains(
    route_targets,
    "send(command: command, to: decision.target, reason: decision.reason)",
    "automatic target selection must dispatch through the shared send path"
)
play_family_index = route_targets.index("if MediaTransportCommandRules.isPlayFamily(command)")
automatic_index = route_targets.index("if let decision = targetResolver.automaticTarget(")
final_chooser_index = route_targets.rfind("showChooserOverlay(")
if not play_family_index < automatic_index < final_chooser_index:
    fail("route ordering must be single-target first, chooser-first for play-family commands, automatic routing next, then chooser fallback")

chooser_immediate = function_body("showChooserImmediately")
if "helper_not_running" in chooser_immediate or "MediaRemote helper is not running" in chooser_immediate:
    fail("chooser presentation must not be blocked by a global MediaRemote-helper health gate")
assert_order(
    chooser_immediate,
    [
        "let cached = sortedTargets(mediaRemoteController.targets)",
        "let refreshQueued = mediaRemoteController.refreshSnapshot()",
        "showChooserOverlay(",
    ],
    "chooser presentation must take the cached rows first and refresh snapshots only in the background"
)

route_cache = function_body("routeFromCache")
if "mediaRemoteController.canRouteCommands" in route_cache:
    fail("cache routing must not use a blanket MediaRemote-helper health gate before adapter dispatch")
assert_order(
    route_cache,
    [
        "let targets = sortedTargets(mediaRemoteController.targets)",
        "guard !targets.isEmpty else",
        "mediaRemoteController.refreshSnapshot()",
        "route(",
    ],
    "cache routing must dispatch existing rows through their owning adapters"
)

automatic_target = function_body("automaticTarget", target_resolver)
assert_order(
    automatic_target,
    [
        "targets.count == 1",
        "playingTargets.count == 1",
        "playingTargets.count > 1",
        "focusedTarget(in: targets)",
        "recentTargetID",
    ],
    "automatic target selection must treat mixed playing state as ambiguous before focused/recent fallbacks"
)
assert_contains(
    automatic_target,
    "if playingTargets.count > 1 {\n            return nil\n        }",
    "automatic target selection must stop on mixed playing ambiguity before focused/recent fallback"
)
assert_contains(
    automatic_target,
    "ChromiumBrowserExtensionTransport.isTarget(playingTarget)",
    "automatic routing must identify Chromium extension targets on the single-playing path"
)
assert_contains(
    automatic_target,
    "!ChromiumBrowserExtensionTransport.supports(command: command, target: playingTarget)",
    "automatic routing must reject unsupported single Chromium targets instead of routing them directly"
)
if "preferredChromiumExtensionTarget(" in automatic_target or "private func preferredChromiumExtensionTarget" in target_resolver:
    fail("mixed media routing must not bypass global playing-target ambiguity through a Chromium-specific pre-check")

send = function_body("send(\n        command: MediaRemoteTransportCommand,\n        to target: MediaRemoteTarget,\n        dispatchID: UUID,")
assert_order(
    send,
    [
        "desktopTransport.submit(command: command, target: target)",
        "shouldFallbackFromUnsupportedDesktopResult(target: target)",
        "sendSpotifyWebAPI(command: command, to: target, dispatchID: dispatchID, context: context)",
        '"desktop_transport_fallback"',
        "sendMediaRemote(command: command, to: target, dispatchID: dispatchID, context: context)",
        "chromiumBrowserExtensionController.submit(command: command, target: target",
        "fallbackMediaRemote(command: command, to: target, dispatchID: dispatchID, context: context)",
    ],
    "shared dispatch must prefer desktop adapters, gate unsupported desktop fallback, then use Chromium extension exactly before MediaRemote fallback"
)
if "legacyChromiumFallbackTarget" in send or '"chromium_extension_fallback"' in send:
    fail("Chromium extension command failures must not fall back to legacy browser rows")

mediaremote_fallback = function_body("fallbackMediaRemote")
if "desktopTransport.submit(command: command, target: target)" in mediaremote_fallback:
    fail("MediaRemote fallback must not retry desktop dispatch after the primary chain already tried it")
assert_order(
    mediaremote_fallback,
    [
        "canUseMediaRemotePlayerPath(command: command, target: target)",
        "guard sendMediaRemote(command: command, to: target, dispatchID: dispatchID, context: context)",
    ],
    "MediaRemote fallback must gate the player path before dispatch"
)

spotify_webapi = function_body("sendSpotifyWebAPI")
assert_order(
    spotify_webapi,
    [
        "spotifyPlaybackCommand(command: command, target: target)",
        "spotifyPlaybackController.sendActivePlaybackCommand(spotifyCommand)",
        "Self.spotifyWebAPIResult(",
        "Self.spotifyWebAPIBackend",
        "finishDispatch(id: dispatchID, fallback: false)",
        "sendMediaRemote(command: command, to: target, dispatchID: dispatchID, context: context)",
        '"spotify_webapi_fallback"',
        "showCommandFailureIfNeeded(result: result, target: target)",
    ],
    "Spotify Web API fallback must use the shared Spotify command service and fall through to MediaRemote on command failure"
)

mediaremote = function_body("sendMediaRemote")
assert_order(
    mediaremote,
    [
        "canUseMediaRemotePlayerPath(command: command, target: target)",
        "mediaRemoteController.submit(command: command, targetID: target.id)",
        "Self.mediaRemotePlayerPathBackend",
        "finishDispatch(id: dispatchID, fallback: false)",
        "showCommandFailureIfNeeded(result: result, target: target)",
    ],
    "MediaRemote fallback must use the player path and preserve async result handling"
)

chooser_send = function_body("sendFromChooser")
assert_order(
    chooser_send,
    [
        "send(command: command, to: target, dispatchID: dispatchID, context: .chooser)",
    ],
    "chooser dispatch must use the shared adapter-aware selected-row path"
)
if "legacyChromiumFallbackTarget" in chooser_send or '"chromium_extension_fallback"' in chooser_send:
    fail("Chooser Chromium extension command failures must not fall back to legacy browser rows")

mediaremote_gate = function_body("canUseMediaRemotePlayerPath")
assert_order(
    mediaremote_gate,
    [
        "ChromiumBrowserExtensionTransport.isTarget(target)",
        "desktopTransport.backendName(for: target) != nil",
        "target.isChromiumBrowserLike",
        '"browser_legacy_mediaremote_blocked"',
        '"requires_browser_extension"',
        '"Browser Extension Required"',
        "return false",
    ],
    "legacy Chromium browser rows must not use MediaRemote player-path routing because selected-row dispatch can affect a competing global media session"
)

desktop_fallback_gate = function_body("shouldFallbackFromUnsupportedDesktopResult")
assert_contains(
    desktop_fallback_gate,
    "!target.isChromiumBrowserLike",
    "Unsupported browser desktop automation commands must not fall through to MediaRemote or Spotify fallback"
)
if "net.imput.helium" in desktop_transport or "execute active tab of front window javascript" in desktop_transport:
    fail("Helium must not retain desktop fallback probing or active-tab JavaScript dispatch")
if "legacyChromiumFallbackTarget" in source or '"chromium_extension_fallback"' in source:
    fail("Chromium extension routing must not retain legacy browser fallback hooks")

failure = function_body("showCommandFailureIfNeeded")
assert_order(
    failure,
    [
        "if result.unsupported",
        'title: "Command Unsupported"',
        'title: "Media Command Failed"',
    ],
    "unsupported command results must be shown as unsupported rather than generic failures"
)

backend = function_body("transportBackendName")
assert_order(
    backend,
    [
        "desktopTransport.backendName(command: command, target: target)",
        "chromiumBrowserExtensionController.backendName(command: command, target: target)",
        "Self.mediaRemotePlayerPathBackend",
    ],
    "backend names must follow the same desktop/Chromium/MediaRemote priority as dispatch"
)

chooser_scoped = function_body("chooserScopedCommand")
assert_contains(
    chooser_scoped,
    "desktopTransport.keepsPlayPauseToggle(for: target)",
    "chooser-scoped playPause must preserve desktop adapter toggles for Spotify"
)

spotify_command = function_body("spotifyPlaybackCommand")
assert_order(
    spotify_command,
    [
        "guard target.isSpotify",
        "case .play:",
        "return .play",
        "case .pause:",
        "return .pause",
        "case .playPause:",
        "return .playPause",
        "case .next:",
        "return .next",
        "case .previous:",
        "return .previous",
    ],
    "Spotify Web API fallback must map every media transport command to the shared Spotify playback command model"
)

assert_contains(
    source,
    "private let spotifyPlaybackController: any SpotifyActivePlaybackObserving",
    "media transport routing must receive the shared Spotify playback service"
)
assert_contains(
    source,
    'private static let spotifyWebAPIBackend = "spotify_web_api"',
    "Spotify Web API fallback must have a distinct trace backend"
)

print("verify_mixed_media_routing_semantics=ok")
PY
