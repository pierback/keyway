#!/usr/bin/env bash
set -euo pipefail

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
status_file="$repo_root/SonosHandoffMenuBar/SonosHandoffMenuBar/App/ShortcutRuntimeStatus.swift"
command_center_file="$repo_root/SonosHandoffMenuBar/SonosHandoffMenuBar/App/MediaCommandCenterInterceptor.swift"
hotkey_file="$repo_root/SonosHandoffMenuBar/SonosHandoffMenuBar/App/VolumeHotkeyController.swift"
event_tap_file="$repo_root/SonosHandoffMenuBar/SonosHandoffMenuBar/App/ShortcutEventTap.swift"
remote_controller_file="$repo_root/SonosHandoffMenuBar/SonosHandoffMenuBar/App/MediaRemoteController.swift"
runtime_file="$repo_root/SonosHandoffMenuBar/SonosHandoffMenuBar/App/SonosHandoffApp.swift"
remote_shim_file="$repo_root/MediaRemoteHelper/KeywayMediaRemoteShim.m"
remote_host_file="$repo_root/MediaRemoteHelper/keyway-mediaremote-helper.pl"

python3 - "$status_file" "$command_center_file" "$hotkey_file" "$event_tap_file" "$remote_controller_file" "$runtime_file" "$remote_shim_file" "$remote_host_file" <<'PY'
import pathlib
import sys

text = pathlib.Path(sys.argv[1]).read_text()
command_center = pathlib.Path(sys.argv[2]).read_text()
hotkeys = pathlib.Path(sys.argv[3]).read_text()
event_tap = pathlib.Path(sys.argv[4]).read_text()
remote_controller = pathlib.Path(sys.argv[5]).read_text()
runtime = pathlib.Path(sys.argv[6]).read_text()
remote_shim = pathlib.Path(sys.argv[7]).read_text()
remote_host = pathlib.Path(sys.argv[8]).read_text()
start = text.index("    private func persistSnapshot()")
end = text.index("\n}\n\nextension Notification.Name", start)
body = text[start:end]

required = (
    "try FileManager.default.createDirectory(",
    "let data = try JSONSerialization.data(withJSONObject: payload, options: [.prettyPrinted, .sortedKeys])",
    "try data.write(to: Self.persistenceURL, options: .atomic)",
    'fputs("ShortcutRuntimeStatus: could not persist snapshot:',
)
for needle in required:
    if needle not in body:
        raise SystemExit(f"verify_shortcut_runtime_status_semantics: persistSnapshot must log and skip failed runtime-status persistence: {needle}")

trace_start = text.index("    func recordMediaTransportEvent(")
trace_end = text.index("\n    private func scheduleTracePersistence()", trace_start)
trace_body = text[trace_start:trace_end]
for needle in (
    'fputs("ShortcutRuntimeStatus: dropping media transport trace notification:',
    "scheduleTracePersistence()",
    "return",
):
    if needle not in trace_body:
        raise SystemExit(f"verify_shortcut_runtime_status_semantics: trace notification encode failures must log and skip posting: {needle}")

route_start = command_center.index("    private func startRouteShieldAudio()")
route_end = command_center.index("\n    private func stopRouteShieldAudio()", route_start)
route_body = command_center[route_start:route_end]
for needle in (
    "private func startRouteShieldAudio() -> Bool",
    'logger.error("MediaCommandCenter routeShieldAudio=failed error=',
    "routeShieldEngine.stop()",
    "routeShieldEngine.detach(sourceNode)",
    "return false",
):
    if needle not in route_body:
        raise SystemExit(f"verify_shortcut_runtime_status_semantics: route shield audio start failures must degrade cleanly: {needle}")

for label, source in (
    ("ShortcutRuntimeStatus.swift", text),
    ("MediaCommandCenterInterceptor.swift", command_center),
):
    for forbidden in ("try!", "} catch {}", "preconditionFailure(", "fatalError("):
        if forbidden in source:
            raise SystemExit(f"verify_shortcut_runtime_status_semantics: {label} must not force-crash or silently catch diagnostics failures: {forbidden}")

snapshot_start = text.index("struct ShortcutRuntimeSnapshot")
snapshot_end = text.index("\n}\n\n@MainActor", snapshot_start)
snapshot_body = text[snapshot_start:snapshot_end]
for needle in (
    "mediaFallback == .enabled",
    "&& eventTapRunning",
    "&& commandCenterRouteRunning",
    "if isReady {",
):
    if needle not in snapshot_body:
        raise SystemExit(f"verify_shortcut_runtime_status_semantics: shortcut readiness must require every active interception layer: {needle}")

for forbidden in (
    "MediaRemotePrivateRouteShield",
    "dlopen(",
    "dlsym(",
    "MRMediaRemoteSetCanBeNowPlayingApplication",
    "MRMediaRemoteSetNowPlayingInfo",
    "MRMediaRemoteSetNowPlayingApplicationOverrideEnabled",
    "MRMediaRemoteSetOverriddenNowPlayingApplication",
):
    if forbidden in command_center:
        raise SystemExit(f"verify_shortcut_runtime_status_semantics: the app process must not load private MediaRemote route symbols: {forbidden}")

for needle in (
    "keyway_mediaremote_set_route_shield",
    "MRMediaRemoteSetCanBeNowPlayingApplication",
    "MRMediaRemoteSetNowPlayingInfo",
    "MRMediaRemoteSetNowPlayingApplicationOverrideEnabled",
    "MRMediaRemoteSetOverriddenNowPlayingApplication",
    '"type": @"routeShieldResult"',
):
    if needle not in remote_shim:
        raise SystemExit(f"verify_shortcut_runtime_status_semantics: the existing MediaRemote helper must own route-shield private API calls: {needle}")

for needle in (
    'DynaLoader::dl_find_symbol($handle, "keyway_mediaremote_set_route_shield")',
    '$type eq "setRouteShield"',
    "Keyway::MediaRemote::set_route_shield();",
):
    if needle not in remote_host:
        raise SystemExit(f"verify_shortcut_runtime_status_semantics: the helper protocol must expose route-shield control: {needle}")

for needle in (
    'case "routeShieldResult":',
    "routeShieldResultHandlers.removeValue(forKey: requestID)",
    "armRouteShieldResultTimeout(requestID: requestID)",
    "routeShieldResultHandlers.forEach { $0(false) }",
):
    if needle not in remote_controller:
        raise SystemExit(f"verify_shortcut_runtime_status_semantics: route-shield readiness must be acknowledged and fail closed with helper lifecycle: {needle}")

for needle in (
    "eventTap.map { CGEvent.tapIsEnabled(tap: $0) } ?? false",
    "if isRunning {",
    "if eventTap != nil {\n            stop()",
    "guard CGEvent.tapIsEnabled(tap: eventTap) else {",
    "let reenabled = isRunning",
    "if !reenabled {\n                stop()",
    "onInterrupted(type)",
    'logger.error("ShortcutEventTap reenable_failed',
):
    if needle not in event_tap:
        raise SystemExit(f"verify_shortcut_runtime_status_semantics: event-tap readiness must reflect the enabled Mach port: {needle}")

refresh_start = hotkeys.index("    func refreshMediaFallback() -> Bool")
refresh_end = hotkeys.index("\n    private func ensureCommandCenterRoute", refresh_start)
refresh_body = hotkeys[refresh_start:refresh_end]
for needle in (
    "guard ensureCommandCenterRoute(reason:",
    "failCommandCenterRoute()",
    "runtimeReporter.mediaFallbackWaitingForCommandCenter(",
    "if isTransportInputReady {",
    "return false",
):
    if needle not in refresh_body:
        raise SystemExit(f"verify_shortcut_runtime_status_semantics: media fallback must not report ready before command-center acknowledgement: {needle}")

for needle in (
    "private var isSonosVolumeInputEnabled = false",
    "private var isTransportInputReady = false",
    "&& (isSonosVolumeInputEnabled || isTransportInputReady)",
    "guard isTransportInputReady,",
    "guard isSonosVolumeInputEnabled else",
    "self.activeMediaRemoteGeneration == helperGeneration",
    "self.mediaRemoteController.helperGeneration == helperGeneration",
):
    if needle not in hotkeys:
        raise SystemExit(
            f"verify_shortcut_runtime_status_semantics: input capabilities must remain independently gated through dispatch: {needle}"
        )

handle_start = hotkeys.index("    func handle(type:")
handle_end = hotkeys.index("\n    func suspendCommandCenterRouteShield(", handle_start)
if "ensureCommandCenterRoute(" in hotkeys[handle_start:handle_end]:
    raise SystemExit(
        "verify_shortcut_runtime_status_semantics: accepted media keys must not supersede the acknowledged route-shield request"
    )

for needle in (
    "private var activeHelperGeneration: UInt?",
    "private var routeShieldRequestInFlight = false",
    "private var desiredRouteShieldPlayback = false",
    "func start(helperGeneration: UInt) -> Bool",
    "guard !routeShieldRequestInFlight else",
    "self.activeHelperGeneration == helperGeneration",
    "self.mediaRemoteController.helperGeneration == helperGeneration",
    "self.acknowledgedRouteShieldPlayback = isPlaying",
    "self.registerCommandsIfNeeded(helperGeneration: helperGeneration)",
):
    if needle not in command_center:
        raise SystemExit(
            f"verify_shortcut_runtime_status_semantics: route-shield acknowledgement must be single-flight and helper-generation bound: {needle}"
        )

register_index = command_center.index(
    "self.registerCommandsIfNeeded(helperGeneration: helperGeneration)"
)
success_index = command_center.rfind("guard succeeded else", 0, register_index)
if success_index < 0:
    raise SystemExit(
        "verify_shortcut_runtime_status_semantics: command targets must not register before route-shield acknowledgement"
    )

for needle in (
    "volumeHotkeys.setSonosVolumeInputEnabled(true)",
    "volumeHotkeys.setSonosVolumeInputEnabled(false)",
):
    if needle not in runtime:
        raise SystemExit(
            f"verify_shortcut_runtime_status_semantics: AppRuntime must own Sonos volume-input activation: {needle}"
        )

retry_start = hotkeys.index("    private func schedulePermissionRetry()")
retry_end = hotkeys.index("\n    private func stopPermissionRetry()", retry_start)
retry_body = hotkeys[retry_start:retry_end]
refresh_start = hotkeys.index("    func refreshMediaFallback() -> Bool")
refresh_guard = hotkeys.index("        guard accessibilityGranted, listenEventGranted else {", refresh_start)
refresh_prefix = hotkeys[refresh_start:refresh_guard]
if "lastReportedPermissionState = (accessibilityGranted, listenEventGranted)" not in refresh_prefix:
    raise SystemExit("verify_shortcut_runtime_status_semantics: every full permission refresh must synchronize retry deduplication state")
refresh_event_tap_start = hotkeys.index("    private func refreshEventTap() -> Bool")
refresh_event_tap_end = hotkeys.index("\n    private func reportEventTapFailure", refresh_event_tap_start)
refresh_event_tap_body = hotkeys[refresh_event_tap_start:refresh_event_tap_end]
if "guard shouldRun else {\n            eventTap.stop()" not in refresh_event_tap_body:
    raise SystemExit(
        "verify_shortcut_runtime_status_semantics: capability shutdown must retire disabled event-tap objects"
    )
denied_start = retry_body.index("            guard accessibilityGranted, listenEventGranted else {")
denied_end = retry_body.index("\n                return", denied_start)
denied_body = retry_body[denied_start:denied_end]
for needle in (
    "self.lastReportedPermissionState?.accessibilityGranted != accessibilityGranted",
    "self.lastReportedPermissionState?.listenEventGranted != listenEventGranted",
    "self.lastReportedPermissionState = (accessibilityGranted, listenEventGranted)",
    "self.runtimeReporter.mediaFallbackPermissionDenied(",
    "accessibilityGranted: accessibilityGranted",
    "listenEventGranted: listenEventGranted",
):
    if needle not in denied_body:
        raise SystemExit(f"verify_shortcut_runtime_status_semantics: permission retries must report changed partial permission state once: {needle}")
PY

printf 'verify_shortcut_runtime_status_semantics=ok\n'
