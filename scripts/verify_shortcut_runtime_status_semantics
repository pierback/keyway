#!/usr/bin/env bash
set -euo pipefail

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"

python3 - "$repo_root" <<'PY'
from pathlib import Path
import sys

root = Path(sys.argv[1])
app = root / "SonosHandoffMenuBar/SonosHandoffMenuBar/App"
status = (app / "ShortcutRuntimeStatus.swift").read_text()
reporter = (app / "ShortcutRuntimeReporter.swift").read_text()
hotkeys = (app / "VolumeHotkeyController.swift").read_text()
event_tap = (app / "ShortcutEventTap.swift").read_text()
remote = (app / "MediaRemoteController.swift").read_text()
transport = (app / "MediaTransportActionController.swift").read_text()
runtime = (app / "SonosHandoffApp.swift").read_text()
remote_shim = (root / "MediaRemoteHelper/KeywayMediaRemoteShim.m").read_text()
remote_host = (root / "MediaRemoteHelper/keyway-mediaremote-helper.pl").read_text()

persist_start = status.index("    private func persistSnapshot()")
persist_end = status.index("\n}\n\nextension Notification.Name", persist_start)
persist = status[persist_start:persist_end]
for required in (
    "try FileManager.default.createDirectory(",
    "let data = try JSONSerialization.data(withJSONObject: payload, options: [.prettyPrinted, .sortedKeys])",
    "try data.write(to: Self.persistenceURL, options: .atomic)",
    "[.posixPermissions: 0o600]",
    'fputs("ShortcutRuntimeStatus: could not persist snapshot:',
    '"processGeneration": processGeneration',
):
    if required not in persist:
        raise SystemExit(
            f"verify_shortcut_runtime_status_semantics: runtime status must persist atomically and privately: {required}"
        )

trace_start = status.index("    func recordMediaTransportEvent(")
trace_end = status.index("\n    private func scheduleTracePersistence()", trace_start)
trace = status[trace_start:trace_end]
for required in (
    'payload["processGeneration"] = processGeneration',
    "JSONSerialization.isValidJSONObject(payload)",
    'fputs("ShortcutRuntimeStatus: dropping invalid media transport trace',
    "if mediaTransportTrace.count > 240",
    "scheduleTracePersistence()",
):
    if required not in trace:
        raise SystemExit(
            f"verify_shortcut_runtime_status_semantics: traces must be validated, bounded, generation-bound, and persisted: {required}"
        )

if "DistributedNotificationCenter" in status:
    raise SystemExit(
        "verify_shortcut_runtime_status_semantics: runtime status must not publish unauthenticated distributed notifications"
    )

snapshot_start = status.index("struct ShortcutRuntimeSnapshot")
snapshot_end = status.index("\n}\n\n@MainActor", snapshot_start)
snapshot = status[snapshot_start:snapshot_end]
for required in (
    "mediaFallback == .enabled",
    "&& eventTapRunning",
    "if isReady {",
):
    if required not in snapshot:
        raise SystemExit(
            f"verify_shortcut_runtime_status_semantics: shortcut readiness must reflect the enabled event tap: {required}"
        )

for forbidden in (
    "commandCenterRoute",
    "command_center_route",
    "routeShield",
    "Media key routing",
    "MPNowPlayingInfoCenter",
    "MPRemoteCommandCenter",
):
    for label, source in (
        ("runtime status", status),
        ("runtime reporter", reporter),
        ("hotkey controller", hotkeys),
        ("MediaRemote controller", remote),
    ):
        if forbidden in source:
            raise SystemExit(
                f"verify_shortcut_runtime_status_semantics: {label} must not depend on a placeholder media session: {forbidden}"
            )

for required in (
    "guard let hidEventTap, let sessionEventTap else",
    "CGEvent.tapIsEnabled(tap: hidEventTap)",
    "CGEvent.tapIsEnabled(tap: sessionEventTap)",
    "if isRunning {",
    "if hidEventTap != nil || sessionEventTap != nil",
    "guard isRunning else {",
    "let reenabled = isRunning",
    "if !reenabled {\n                stop()",
    "onInterrupted(type)",
    'logger.error("ShortcutEventTap reenable_failed',
):
    if required not in event_tap:
        raise SystemExit(
            f"verify_shortcut_runtime_status_semantics: event-tap readiness must reflect the enabled Mach port: {required}"
        )

refresh_start = hotkeys.index("    func refreshMediaFallback() -> Bool")
refresh_end = hotkeys.index("\n    private func mediaRemoteHealthChanged", refresh_start)
refresh = hotkeys[refresh_start:refresh_end]
for required in (
    "guard mediaRemoteController.isHelperPairReady else",
    "runtimeReporter.mediaFallbackWaitingForHelper(",
    "guard refreshEventTap() else {",
    "commandCenterInterceptor.start()",
    "isTransportInputReady = true",
    "runtimeReporter.mediaFallbackEnabled(",
):
    if required not in refresh:
        raise SystemExit(
            f"verify_shortcut_runtime_status_semantics: media fallback must gate the event tap on helper readiness: {required}"
        )
event_tap_index = refresh.index("guard refreshEventTap() else {")
command_center_index = refresh.index("commandCenterInterceptor.start()", event_tap_index)
ready_index = refresh.index("isTransportInputReady = true", command_center_index)
if not event_tap_index < command_center_index < ready_index < refresh.index("runtimeReporter.mediaFallbackEnabled("):
    raise SystemExit(
        "verify_shortcut_runtime_status_semantics: the event taps and hidden command receiver must start before transport routing reports ready"
    )

waiting_start = reporter.index("    func mediaFallbackWaitingForHelper(")
waiting_end = reporter.index("\n    func eventTapUnavailable(", waiting_start)
waiting = reporter[waiting_start:waiting_end]
if "clearActiveEventTap: !eventTapRunning" not in waiting:
    raise SystemExit(
        "verify_shortcut_runtime_status_semantics: helper waiting must clear stale active-tap diagnostics when the tap is stopped"
    )

for required in (
    "private var isSonosVolumeInputEnabled = false",
    "private var isTransportInputReady = false",
    "&& (isSonosVolumeInputEnabled || activeMediaRemoteGeneration != nil)",
    "guard isTransportInputReady,",
    "guard isSonosVolumeInputEnabled else",
    "self.activeMediaRemoteGeneration == helperGeneration",
    "self.mediaRemoteController.helperGeneration == helperGeneration",
):
    if required not in hotkeys:
        raise SystemExit(
            f"verify_shortcut_runtime_status_semantics: input capabilities must remain independently gated through dispatch: {required}"
        )

interruption_start = hotkeys.index("    private func resetInputStateAfterTapInterruption")
interruption_end = hotkeys.index("\n    private func traceTransportKey", interruption_start)
interruption = hotkeys[interruption_start:interruption_end]
for required in (
    "guard eventTap.isRunning else {",
    "isTransportInputReady = false",
    "runtimeReporter.eventTapUnavailable(",
    "schedulePermissionRetry()",
):
    if required not in interruption:
        raise SystemExit(
            f"verify_shortcut_runtime_status_semantics: a disabled event tap must revoke transport readiness and retry: {required}"
        )

for required in (
    "volumeHotkeys.setSonosVolumeInputEnabled(true)",
    "volumeHotkeys.setSonosVolumeInputEnabled(false)",
):
    if required not in runtime:
        raise SystemExit(
            f"verify_shortcut_runtime_status_semantics: AppRuntime must own Sonos volume-input activation: {required}"
        )

retry_start = hotkeys.index("    private func schedulePermissionRetry()")
retry_end = hotkeys.index("\n    private func stopPermissionRetry()", retry_start)
retry = hotkeys[retry_start:retry_end]
for required in (
    "self.lastReportedPermissionState?.accessibilityGranted != accessibilityGranted",
    "self.lastReportedPermissionState?.listenEventGranted != listenEventGranted",
    "self.lastReportedPermissionState = (accessibilityGranted, listenEventGranted)",
    "self.runtimeReporter.mediaFallbackPermissionDenied(",
    "_ = self.refreshMediaFallback()",
):
    if required not in retry:
        raise SystemExit(
            f"verify_shortcut_runtime_status_semantics: permission retries must deduplicate failures and retry readiness: {required}"
        )

for required in (
    'DynaLoader::dl_find_symbol($handle, "keyway_mediaremote_snapshot")',
    'DynaLoader::dl_find_symbol($handle, "keyway_mediaremote_send_command")',
    'DynaLoader::dl_find_symbol($handle, "keyway_mediaremote_refresh_client_cache")',
):
    if required not in remote_host:
        raise SystemExit(
            f"verify_shortcut_runtime_status_semantics: the invisible Perl helper must retain media read/control support: {required}"
        )

for forbidden in (
    "keyway_mediaremote_set_route_shield",
    "MRMediaRemoteSetCanBeNowPlayingApplication",
    "MRMediaRemoteSetNowPlayingInfo",
    "MRMediaRemoteSetNowPlayingApplicationOverrideEnabled",
    "MRMediaRemoteSetOverriddenNowPlayingApplication",
    "routeShieldResult",
):
    if forbidden in remote_shim or forbidden in remote_host:
        raise SystemExit(
            f"verify_shortcut_runtime_status_semantics: helper processes must not register as media players: {forbidden}"
        )

if "mediaRemoteController.submit(command: command, targetID: target.id)" not in transport:
    raise SystemExit(
        "verify_shortcut_runtime_status_semantics: selected MediaRemote targets must retain direct command submission"
    )
PY

printf 'verify_shortcut_runtime_status_semantics=ok\n'
