const fs = require("fs");
const vm = require("vm");

const serviceWorkerPath = process.env.SERVICE_WORKER_PATH;
const code = fs.readFileSync(serviceWorkerPath, "utf8");
const ports = [];
const timeouts = [];
const sessionGetCallbacks = [];
const sessionStorageSets = [];

const context = {
  console,
  crypto: {
    randomUUID() {
      return "unused-new-profile-guid";
    },
  },
  navigator: {
    userAgent: "Mozilla/5.0 Chrome/126.0.0.0 Safari/537.36",
  },
  setInterval() {
    return "interval";
  },
  clearInterval() {},
  setTimeout(callback, delay) {
    timeouts.push({ callback, delay });
    return `timeout-${timeouts.length}`;
  },
  chrome: {
    storage: {
      local: {
        get(keys, callback) {
          callback({ profileGuid: "profile-guid-a" });
        },
        set() {
          throw new Error("stale-port test must not mint a new profile GUID");
        },
      },
      session: {
        get(keys, callback) {
          sessionGetCallbacks.push(callback);
        },
        set(items) {
          sessionStorageSets.push(items);
        },
      },
    },
    alarms: {
      create() {},
      onAlarm: {
        addListener() {},
      },
    },
    runtime: {
      id: "extensionid",
      lastError: null,
      connectNative() {
        const port = {
          messages: [],
          postMessage(message) {
            port.messages.push(message);
          },
          onMessage: {
            addListener() {},
          },
          onDisconnect: {
            addListener(listener) {
              port.disconnect = listener;
            },
          },
        };
        ports.push(port);
        return port;
      },
      onMessage: {
        addListener() {},
      },
    },
    tabs: {
      onRemoved: {
        addListener() {},
      },
      onUpdated: {
        addListener() {},
      },
      query(queryInfo, callback) {
        callback([]);
      },
      sendMessage() {},
    },
    scripting: {
      executeScript() {},
    },
    windows: {
      update() {},
    },
  },
};

vm.runInNewContext(code, context, { filename: serviceWorkerPath });

assertEqual(ports.length, 1, "worker must create the first native port");
assertEqual(sessionGetCallbacks.length, 1, "first native port must start resume loading");
ports[0].disconnect();
assertEqual(timeouts[0].delay, 1000, "worker must schedule a reconnect after port disconnect");
timeouts[0].callback();
assertEqual(ports.length, 2, "worker must create the replacement native port");
assertEqual(sessionGetCallbacks.length, 2, "replacement port must start its own resume loading");

sessionGetCallbacks[0]({});
assertEqual(ports[1].messages.length, 0, "stale resume callback from disconnected port must not post on the replacement port");
sessionGetCallbacks[1]({});
assertEqual(ports[1].messages.filter(message => message.type === "hello").length, 1, "replacement port must publish exactly one hello");
assertEqual(ports[1].messages.filter(message => message.type === "snapshot").length, 1, "replacement port must publish exactly one initial snapshot");
assertEqual(sessionStorageSets.at(-1).snapshotEpoch, 1, "replacement port must own the resumed epoch sequence");

console.log("verify_chromium_extension_stale_port_resume_semantics=ok");

function assert(condition, message) {
  if (!condition) {
    console.error(`verify_chromium_extension_semantics: ${message}`);
    process.exit(1);
  }
}

function assertEqual(actual, expected, message) {
  assert(actual === expected, `${message}: expected ${expected}, got ${actual}`);
}
