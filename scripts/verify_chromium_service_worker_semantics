SERVICE_WORKER_PATH="$repo_root/ChromiumExtension/service_worker.js" bun - <<'NODE'
const fs = require("fs");
const vm = require("vm");

const serviceWorkerPath = process.env.SERVICE_WORKER_PATH;
const code = fs.readFileSync(serviceWorkerPath, "utf8");
const postedMessages = [];
const intervals = [];
const scriptExecutions = [];
const tabMessages = [];
const queryRequests = [];
const sessionStorageSets = [];
const localStorage = { profileGuid: "profile-guid-a" };
const sessionStorage = {
  snapshotEpoch: 41,
  lastPublishedSnapshotTargets: [
    resumeTarget(22, "Live resume tab"),
    resumeTarget(99, "Closed resume tab"),
  ],
};

const context = {
  console,
  crypto: {
    randomUUID() {
      return "unused-new-profile-guid";
    },
  },
  navigator: {
    userAgent: "Mozilla/5.0 Chrome/126.0.0.0 Safari/537.36",
  },
  setInterval(callback, delay) {
    intervals.push({ callback, delay });
    return `interval-${intervals.length}`;
  },
  clearInterval() {},
  setTimeout() {
    return "timeout";
  },
  chrome: {
    storage: {
      local: {
        get(keys, callback) {
          callback(Object.fromEntries(keys.filter(key => key in localStorage).map(key => [key, localStorage[key]])));
        },
        set() {
          throw new Error("resume wake must not mint a new profile GUID");
        },
      },
      session: {
        get(keys, callback) {
          callback(Object.fromEntries(keys.filter(key => key in sessionStorage).map(key => [key, sessionStorage[key]])));
        },
        set(items) {
          Object.assign(sessionStorage, items);
          sessionStorageSets.push(items);
        },
      },
    },
    alarms: {
      create() {},
      onAlarm: {
        addListener() {},
      },
    },
    runtime: {
      id: "extensionid",
      lastError: null,
      connectNative() {
        return {
          postMessage(message) {
            postedMessages.push(message);
          },
          onMessage: {
            addListener() {},
          },
          onDisconnect: {
            addListener() {},
          },
        };
      },
      onMessage: {
        addListener() {},
      },
    },
    tabs: {
      onRemoved: {
        addListener() {},
      },
      onUpdated: {
        addListener() {},
      },
      query(queryInfo, callback) {
        queryRequests.push(queryInfo);
        callback([{ id: 22, url: "https://example.test/live", title: "Live resume tab" }]);
      },
      sendMessage(tabId, message, callback) {
        tabMessages.push({ tabId, message });
        callback({ ok: true });
      },
    },
    scripting: {
      executeScript(request, callback) {
        scriptExecutions.push(request);
        callback([]);
      },
    },
    windows: {
      update() {},
    },
  },
};

vm.runInNewContext(code, context, { filename: serviceWorkerPath });

const hello = postedMessages.find(message => message.type === "hello");
assert(hello, "resume wake must post hello");
assertEqual(hello.resumed, true, "resume wake hello must report resumed=true");
assertEqual(hello.epoch, 41, "resume wake hello must continue the stored epoch");
assertEqual(hello.snapshot.length, 1, "resume wake hello must prune closed tabs before publishing");
assertEqual(hello.snapshot[0].tabId, 22, "resume wake hello must keep live tabs");
assert(!hello.snapshot.some(target => target.tabId === 99), "resume wake hello must drop closed tabs");

const firstSnapshot = postedMessages.find(message => message.type === "snapshot");
assert(firstSnapshot, "resume wake must publish a bridge snapshot immediately after hello");
assertEqual(firstSnapshot.epoch, 42, "resume wake first snapshot must increment from the stored epoch");
assertEqual(firstSnapshot.targets.length, 1, "resume wake first snapshot must preserve the pruned bridge target");
assertEqual(firstSnapshot.targets[0].tabId, 22, "resume wake bridge snapshot must preserve live tab identity");
assertEqual(sessionStorageSets.at(-1).snapshotEpoch, 42, "resume wake snapshot persistence must store the incremented epoch");
assertEqual(intervals[0].delay, 1000, "resume wake with bridge targets must use the active snapshot heartbeat");
intervals[0].callback();
const bridgeHeartbeatSnapshot = postedMessages.filter(message => message.type === "snapshot").at(-1);
assertEqual(bridgeHeartbeatSnapshot.epoch, 43, "resume bridge heartbeat must keep advancing the stored epoch");
assertEqual(bridgeHeartbeatSnapshot.targets.length, 1, "resume bridge heartbeat must retain targets until a real probe response or expiry");
assertEqual(bridgeHeartbeatSnapshot.targets[0].tabId, 22, "resume bridge heartbeat must not reintroduce the pruned closed tab");
assertEqual(queryRequests.length, 2, "resume wake must query tabs once to prune and once to probe");
assertEqual(scriptExecutions.length, 1, "resume wake probe must reinject only live tabs");
assertEqual(tabMessages.length, 1, "resume wake probe must ask live tabs to republish");

console.log("verify_chromium_extension_resume_semantics=ok");

function resumeTarget(tabId, title) {
  return {
    type: "target",
    id: `chromium-tab:profile-guid-a:${tabId}`,
    browser: "Chrome",
    browserFamily: "chrome",
    browserRuntimeID: "extensionid",
    profileGuid: "profile-guid-a",
    tabId,
    url: `https://example.test/${tabId}`,
    pageTitle: title,
    title,
    artist: "Artist",
    album: "Album",
    playing: true,
    muted: false,
    volume: 0.5,
    duration: 100,
    elapsedTime: 10,
    hasMediaSessionMetadata: true,
    hasPlaybackActivity: true,
    supportedCommands: ["play", "pause", "playPause"],
    updatedAt: 1000,
    lastActiveAt: 1000,
  };
}

function assert(condition, message) {
  if (!condition) {
    console.error(`verify_chromium_extension_semantics: ${message}`);
    process.exit(1);
  }
}

function assertEqual(actual, expected, message) {
  assert(actual === expected, `${message}: expected ${expected}, got ${actual}`);
}
