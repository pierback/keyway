#!/usr/bin/env bash
set -euo pipefail

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
workdir="$(mktemp -d)"
trap 'rm -rf "$workdir"' EXIT

grep -v '^import SonosHandoffCore$' \
  "$repo_root/SonosHandoffMenuBar/SonosHandoffMenuBar/App/MediaTransportCommandRules.swift" \
  >"$workdir/MediaTransportCommandRules.swift"

cat >"$workdir/CommandRuleStubs.swift" <<'SWIFT'
import Foundation

enum MediaRemoteTransportCommand: String, Equatable {
    case play
    case playPause
    case next
    case previous
    case pause
}

enum MediaTransportRoutingReason {
    case single
    case focused
    case current
    case recent
    case chooser
}

enum MediaRouteStatusKind {
    case auto
    case focused
    case chooser
}

struct MediaRemoteTarget: Equatable, Identifiable {
    let id: String
    let appName: String
    let title: String
    let isCurrentlyPlaying: Bool
    let playbackFreshness: Double

    func matchesRoutingIdentity(_ identity: String?) -> Bool {
        id == identity
    }
}
SWIFT

cat >"$workdir/CommandRuleSemantics.swift" <<'SWIFT'
import Foundation

@main
struct CommandRuleSemantics {
    static func main() {
        expectEqual(
            MediaTransportCommandRules.rowScopedCommand(.playPause, for: target(id: "playing", playing: true)),
            .pause,
            "Play/Pause row dispatch must pause a playing row"
        )
        expectEqual(
            MediaTransportCommandRules.rowScopedCommand(.playPause, for: target(id: "paused", playing: false)),
            .play,
            "Play/Pause row dispatch must play a paused row"
        )
        expectEqual(
            MediaTransportCommandRules.rowScopedCommand(.next, for: target(id: "playing", playing: true)),
            .next,
            "Non-Play/Pause row dispatch must keep the requested command"
        )
        expectEqual(
            MediaTransportCommandRules.statusKind(for: .recent),
            .auto,
            "Remembered-target automatic routing must remain an automatic status"
        )

        let newerSpotify = target(id: "spotify", name: "Spotify", playing: true, freshness: 300)
        let olderArc = target(id: "arc", name: "Arc", playing: true, freshness: 100)
        let stoppedNewerHelium = target(id: "helium", name: "Helium", playing: false, freshness: 500)
        expectEqual(
            MediaTransportCommandRules.sortedTargets(
                [newerSpotify, stoppedNewerHelium, olderArc],
                preferredTargetID: newerSpotify.id
            ).map(\.id),
            ["spotify", "arc", "helium"],
            "Chooser ordering must be stable: playing targets first, then recent selected target, then app name, ignoring freshness churn"
        )

        let beta = target(id: "beta", name: "Arc", title: "Beta", playing: true, freshness: 300)
        let alpha = target(id: "alpha", name: "Arc", title: "Alpha", playing: true, freshness: 300)
        expectEqual(
            MediaTransportCommandRules.sortedTargets(
                [beta, alpha],
                preferredTargetID: nil
            ).map(\.id),
            ["alpha", "beta"],
            "Rows with the same app name must use title and id tie-breakers so order cannot depend on helper array order"
        )

        expectEqual(
            MediaTransportCommandRules.sortedTargets(
                [newerSpotify, stoppedNewerHelium, olderArc],
                preferredTargetID: stoppedNewerHelium.id
            ).map(\.id),
            ["arc", "spotify", "helium"],
            "Playing targets must stay above the recent selected target"
        )

        print("verify_media_transport_command_rules_semantics=ok")
    }

    private static func target(
        id: String,
        name: String = "App",
        title: String = "Title",
        playing: Bool,
        freshness: Double = 0
    ) -> MediaRemoteTarget {
        MediaRemoteTarget(
            id: id,
            appName: name,
            title: title,
            isCurrentlyPlaying: playing,
            playbackFreshness: freshness
        )
    }

    private static func expectEqual<T: Equatable>(
        _ actual: T,
        _ expected: T,
        _ message: String
    ) {
        guard actual == expected else {
            fail("\(message): expected \(expected), got \(actual)")
        }
    }

    private static func fail(_ message: String) -> Never {
        FileHandle.standardError.write(Data("verify_media_transport_command_rules_semantics: \(message)\n".utf8))
        exit(1)
    }
}
SWIFT

swiftc \
  "$workdir/CommandRuleStubs.swift" \
  "$workdir/MediaTransportCommandRules.swift" \
  "$workdir/CommandRuleSemantics.swift" \
  -o "$workdir/verify_media_transport_command_rules_semantics"

"$workdir/verify_media_transport_command_rules_semantics"
