#!/usr/bin/env bash
set -euo pipefail

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
workdir="$(mktemp -d)"
trap 'rm -rf "$workdir"' EXIT

grep -v '^import SonosHandoffCore$' \
  "$repo_root/SonosHandoffMenuBar/SonosHandoffMenuBar/App/MediaTransportCommandRules.swift" \
  >"$workdir/MediaTransportCommandRules.swift"

cat >"$workdir/CommandRuleStubs.swift" <<'SWIFT'
import Foundation

enum MediaRemoteTransportCommand: String, Equatable {
    case play
    case playPause
    case next
    case previous
    case pause
}

enum MediaSourceReachability: Equatable {
    case live
    case suspect(reason: String, since: Date)

    var isSuspect: Bool {
        self != .live
    }
}

struct SourceRow {
    let target: MediaRemoteTarget
    var reachability: MediaSourceReachability = .live
    var playbackStartedAt: Date?
    var playbackStoppedAt: Date?

    var id: String { target.id }
}

struct MediaRemoteTarget: Equatable, Identifiable {
    let id: String
    let appName: String
    let title: String
    let isCurrentlyPlaying: Bool
    let playbackFreshness: Double
    var isBrowserLike = false

    var isSpotify: Bool {
        appName == "Spotify"
    }

    func matchesRoutingIdentity(_ identity: String?) -> Bool {
        id == identity
    }
}
SWIFT

cat >"$workdir/CommandRuleSemantics.swift" <<'SWIFT'
import Foundation

@main
struct CommandRuleSemantics {
    static func main() {
        expectEqual(
            MediaTransportCommandRules.rowScopedCommand(.playPause, for: target(id: "playing", playing: true), after: nil),
            .pause,
            "Play/Pause row dispatch must pause a playing row"
        )
        expectEqual(
            MediaTransportCommandRules.rowScopedCommand(.playPause, for: target(id: "paused", playing: false), after: nil),
            .play,
            "Play/Pause row dispatch must play a paused row"
        )
        expectEqual(
            MediaTransportCommandRules.rowScopedCommand(.next, for: target(id: "playing", playing: true), after: .pause),
            .next,
            "Non-Play/Pause row dispatch must keep the requested command"
        )
        expectEqual(
            MediaTransportCommandRules.rowScopedCommand(.playPause, for: target(id: "stale-playing", playing: true), after: .pause),
            .play,
            "A rapid repeat must follow a pending Pause with Play even before playback metadata refreshes"
        )
        expectEqual(
            MediaTransportCommandRules.rowScopedCommand(.playPause, for: target(id: "stale-paused", playing: false), after: .play),
            .pause,
            "A rapid repeat must follow a pending Play with Pause even before playback metadata refreshes"
        )
        expectFalse(
            MediaTransportCommandRules.shouldOpenChooserForAutomaticRoute(reachability: .live),
            "Live automatic route candidates may dispatch without chooser confirmation"
        )
        expectTrue(
            MediaTransportCommandRules.shouldOpenChooserForAutomaticRoute(reachability: .suspect(reason: "command_failed", since: Date())),
            "Suspect automatic route candidates must divert to the chooser"
        )
        expectTrue(
            MediaTransportCommandRules.shouldOpenChooserForAutomaticRoute(reachability: nil),
            "Absent rows must defensively divert automatic routing to the chooser"
        )
        expectEqual(
            MediaTransportCommandRules.rowScopedCommand(.playPause, for: target(id: "suspect", playing: false), after: nil),
            .play,
            "Explicit suspect-row dispatch remains allowed and row scoped"
        )

        let now = Date(timeIntervalSince1970: 10_000)
        func ranked(_ rows: [SourceRow], picked: String? = nil, pickedAt: Date? = nil) -> [String] {
            MediaTransportCommandRules.sortedTargets(rows, recentTargetID: picked, recentPickedAt: pickedAt, now: now).map(\.id)
        }

        let spotifyStartedEarly = SourceRow(target: target(id: "spotify", name: "Spotify", playing: true), playbackStartedAt: now - 600)
        let heliumStartedLate = SourceRow(target: target(id: "helium", name: "Helium", playing: true, browser: true), playbackStartedAt: now - 30)
        expectEqual(
            ranked([heliumStartedLate, spotifyStartedEarly], picked: "helium", pickedAt: now - 1),
            ["spotify", "helium"],
            "Playing Spotify always leads, even against a newer start or pick"
        )
        let arcStartedEarly = SourceRow(target: target(id: "arc", name: "Arc", playing: true, browser: true), playbackStartedAt: now - 600)
        expectEqual(
            ranked([arcStartedEarly, heliumStartedLate]),
            ["helium", "arc"],
            "Among other playing sources the most recently started ranks first"
        )
        expectEqual(
            ranked([arcStartedEarly, heliumStartedLate], picked: "arc", pickedAt: now - 5),
            ["arc", "helium"],
            "A pick in Keyway newer than the other source's start wins"
        )
        expectEqual(
            ranked([arcStartedEarly, heliumStartedLate], picked: "arc", pickedAt: now - 900),
            ["helium", "arc"],
            "An older pick must not beat a newer playback start"
        )

        let pausedRecently = SourceRow(target: target(id: "music", name: "Music", playing: false), playbackStoppedAt: now - 120)
        let pausedLongAgo = SourceRow(target: target(id: "quicktime", name: "QuickTime", playing: false), playbackStoppedAt: now - 3_600)
        let idleTab = SourceRow(target: target(id: "x-tab", name: "Arc", playing: false, browser: true))
        let idleApp = SourceRow(target: target(id: "vlc", name: "VLC", playing: false))
        expectEqual(
            ranked([idleTab, pausedLongAgo, idleApp, pausedRecently, spotifyStartedEarly]),
            ["spotify", "music", "quicktime", "vlc", "x-tab"],
            "Tiers: playing, recently paused, idle; idle ordered by last activity, then apps above tabs"
        )

        let suspectPlaying = SourceRow(
            target: target(id: "suspect", name: "Brave", playing: true),
            reachability: .suspect(reason: "command_failed", since: now),
            playbackStartedAt: now - 1
        )
        expectEqual(
            ranked([suspectPlaying, spotifyStartedEarly, pausedRecently]),
            ["spotify", "suspect", "music"],
            "Unresponsive sources sink to the bottom of their tier but stay above lower tiers"
        )

        let beta = SourceRow(target: target(id: "beta", name: "Arc", title: "Beta", playing: true))
        let alpha = SourceRow(target: target(id: "alpha", name: "Arc", title: "Alpha", playing: true))
        expectEqual(
            ranked([beta, alpha]),
            ["alpha", "beta"],
            "Ties must use app name, title and id so order cannot depend on helper array order"
        )

        print("verify_media_transport_command_rules_semantics=ok")
    }

    private static func target(
        id: String,
        name: String = "App",
        title: String = "Title",
        playing: Bool,
        freshness: Double = 0,
        browser: Bool = false
    ) -> MediaRemoteTarget {
        MediaRemoteTarget(
            id: id,
            appName: name,
            title: title,
            isCurrentlyPlaying: playing,
            playbackFreshness: freshness,
            isBrowserLike: browser
        )
    }

    private static func expectEqual<T: Equatable>(
        _ actual: T,
        _ expected: T,
        _ message: String
    ) {
        guard actual == expected else {
            fail("\(message): expected \(expected), got \(actual)")
        }
    }

    private static func expectTrue(_ actual: Bool, _ message: String) {
        guard actual else {
            fail(message)
        }
    }

    private static func expectFalse(_ actual: Bool, _ message: String) {
        guard !actual else {
            fail(message)
        }
    }

    private static func fail(_ message: String) -> Never {
        FileHandle.standardError.write(Data("verify_media_transport_command_rules_semantics: \(message)\n".utf8))
        exit(1)
    }
}
SWIFT

swiftc \
  -module-cache-path "$workdir/module-cache" \
  "$workdir/CommandRuleStubs.swift" \
  "$workdir/MediaTransportCommandRules.swift" \
  "$workdir/CommandRuleSemantics.swift" \
  -o "$workdir/verify_media_transport_command_rules_semantics"

"$workdir/verify_media_transport_command_rules_semantics"
