#!/usr/bin/env bash
set -euo pipefail

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
source_section="$repo_root/SonosHandoffMenuBar/SonosHandoffMenuBar/App/MenuBarMediaSourceSection.swift"
status_controller="$repo_root/SonosHandoffMenuBar/SonosHandoffMenuBar/App/KeywayStatusItemController.swift"
output_section="$repo_root/SonosHandoffMenuBar/SonosHandoffMenuBar/App/MenuBarOutputSection.swift"
playback_controller="$repo_root/SonosHandoffMenuBar/SonosHandoffMenuBar/App/PlaybackSyncController.swift"
transport_controller="$repo_root/SonosHandoffMenuBar/SonosHandoffMenuBar/App/MediaTransportActionController.swift"
project_file="$repo_root/SonosHandoffMenuBar/SonosHandoffMenuBar.xcodeproj/project.pbxproj"

fail() {
  printf 'verify_menubar_source_first_semantics: %s\n' "$*" >&2
  exit 1
}

expect_contains() {
  local path="$1"
  local text="$2"
  grep -Fq "$text" "$path" || fail "$path missing expected text: $text"
}

expect_absent() {
  local path="$1"
  local text="$2"
  if grep -Fq "$text" "$path"; then
    fail "$path still contains forbidden text: $text"
  fi
}

ast-grep --lang swift -p '@MainActor
struct MenuBarMediaSourceSection: View { $$$ }' "$source_section" >/dev/null
ast-grep --lang swift -p 'func transferSpotifyPlayback(source: MediaRemoteTarget, to row: PlaybackOutputRow) { $$$ }' "$playback_controller" >/dev/null
ast-grep --lang swift -p 'func connectSpotify(to row: PlaybackOutputRow) { $$$ }' "$playback_controller" >/dev/null
ast-grep --lang swift -p 'func focus(target: MediaRemoteTarget) { $$$ }' "$transport_controller" >/dev/null

expect_contains "$status_controller" "MenuBarMediaSourceSection("
expect_contains "$status_controller" "sonosTile"
source_line="$(grep -n 'MenuBarMediaSourceSection(' "$status_controller" | head -1 | cut -d: -f1)"
sonos_line="$(grep -n 'sonosTile' "$status_controller" | head -1 | cut -d: -f1)"
[[ -n "$source_line" && -n "$sonos_line" && "$source_line" -lt "$sonos_line" ]] \
  || fail "$status_controller must render media sources before the speakers tile"
expect_contains "$status_controller" 'Text("Speakers")'
expect_contains "$status_controller" 'MenuBarVolumeControl(playback: playback)'
expect_contains "$status_controller" "if hasOutput {"
expect_contains "$status_controller" 'return "Looking on this network"'
expect_contains "$status_controller" 'return "Unavailable on this network"'
expect_contains "$status_controller" "Text(headerStatusTitle)"
expect_contains "$status_controller" "private var headerStatusTitle: String"
expect_contains "$status_controller" "private var isBrowserOnlyRoutingAvailable: Bool"
expect_contains "$status_controller" "private var postPopoverCloseAction: (@MainActor () -> Void)?"
expect_contains "$status_controller" "postPopoverCloseAction = { [weak self] in"
expect_contains "$status_controller" "self?.showCenteredChooser()"
expect_contains "$status_controller" "let action = postPopoverCloseAction"
expect_contains "$status_controller" "postPopoverCloseAction = nil"
expect_contains "$status_controller" "action?()"
expect_contains "$status_controller" "case .failed, .stopped:"
expect_contains "$status_controller" 'return "Browser only"'
expect_contains "$status_controller" "chromiumBrowserExtensionController.hasRoutableTargets"
expect_absent "$status_controller" "nowPlayingCard"
expect_absent "$status_controller" '"Fallback room"'
expect_absent "$status_controller" "mediaTransportActions.route(command: command)"
expect_absent "$status_controller" "Text(mediaRemoteController.health.badgeTitle)"

python3 - "$status_controller" <<'PY'
import pathlib
import sys

text = pathlib.Path(sys.argv[1]).read_text()

def fail(message):
    raise SystemExit(f"verify_menubar_source_first_semantics: {message}")

chooser_start = text.index("    private func openChooserFromPopover() {")
chooser_end = text.index("\n    @objc private func openSettingsFromMenu(", chooser_start)
chooser_body = text[chooser_start:chooser_end]
required_order = [
    "if popover.isShown {",
    "postPopoverCloseAction = { [weak self] in",
    "closePopover()",
    "return",
]
positions = []
for needle in required_order:
    position = chooser_body.find(needle)
    if position < 0:
        fail(f"openChooserFromPopover must contain {needle!r}")
    positions.append(position)
if positions != sorted(positions):
    fail("openChooserFromPopover must defer chooser presentation until after the popover closes")
if "self?.showCenteredChooser()" not in chooser_body:
    fail("openChooserFromPopover must reopen the chooser from the deferred popover-close action")
fallback_position = chooser_body.rfind("showCenteredChooser()")
if fallback_position < positions[-1]:
    fail("openChooserFromPopover must keep the direct chooser fallback only after the deferred popover-close branch")

popover_close_start = text.index("    func popoverDidClose(_ notification: Notification) {")
popover_close_end = text.index("\n}", popover_close_start)
popover_close_body = text[popover_close_start:popover_close_end]
required_close_order = [
    "stopPopoverDismissMonitors()",
    "let action = postPopoverCloseAction",
    "postPopoverCloseAction = nil",
    "action?()",
]
close_positions = []
for needle in required_close_order:
    position = popover_close_body.find(needle)
    if position < 0:
        fail(f"popoverDidClose must contain {needle!r}")
    close_positions.append(position)
if close_positions != sorted(close_positions):
    fail("popoverDidClose must clear and run the deferred chooser action after the popover closes")
PY

expect_contains "$source_section" 'Text("Active Sources")'
expect_contains "$source_section" "@ObservedObject var mediaSourceStore: MediaSourceStore"
expect_contains "$source_section" "mediaSourceStore.rows.map(\\.target)"
expect_contains "$source_section" "private var targetIDs: [String]"
expect_contains "$source_section" "displayTargets.map(\\.id)"
expect_absent "$source_section" "cachedTargets"
expect_absent "$source_section" "cachedTargetsGraceInterval"
expect_absent "$source_section" "cachedTargetsUpdatedAt"
expect_contains "$source_section" "sessionTargets"
expect_contains "$source_section" "sessionHasOpened"
expect_contains "$source_section" "let latestTargets = freshTargets"
expect_contains "$source_section" "let latestTargetsByID = Dictionary(uniqueKeysWithValues: latestTargets.map { (\$0.id, \$0) })"
expect_contains "$source_section" "var usedTargetIDs: Set<String> = []"
expect_contains "$source_section" "let resolvedTargets = sessionTargets.compactMap { sessionTarget in"
expect_contains "$source_section" "if ChromiumBrowserExtensionTransport.isTarget(sessionTarget), !latestTargets.isEmpty {"
expect_contains "$source_section" "return resolvedTargets + latestTargets.filter { !usedTargetIDs.contains(\$0.id) }"
expect_contains "$source_section" "private func liveSessionTarget("
expect_contains "$source_section" "displayName: sessionTarget.displayName"
expect_contains "$source_section" "title: sessionTarget.title"
expect_contains "$source_section" "playbackRate: latestTarget.playbackRate"
expect_contains "$source_section" "duration: latestTarget.duration ?? sessionTarget.duration"
expect_contains "$source_section" "elapsedTime: latestTarget.elapsedTime ?? sessionTarget.elapsedTime"
expect_contains "$source_section" "private var openingTargets: [MediaRemoteTarget]"
expect_contains "$source_section" "private func openTargetSession()"
expect_contains "$source_section" "sessionTargets = openingTargets"
expect_contains "$source_section" "sessionHasOpened = true"
expect_contains "$source_section" "private func hydrateEmptySessionIfNeeded(with targets: [MediaRemoteTarget])"
expect_contains "$source_section" "guard sessionHasOpened, sessionTargets.isEmpty, !targets.isEmpty else"
expect_contains "$source_section" "hydrateEmptySessionIfNeeded(with: sortedTargets)"
expect_contains "$source_section" "sessionTargets = []"
expect_contains "$source_section" "sessionHasOpened = false"
expect_contains "$source_section" "if mediaRemoteController.isRefreshingSnapshot"
expect_absent "$source_section" "canShowCachedTargets"
expect_contains "$source_section" ".animation(MenuBarMotion.rowUpdate, value: targetIDs)"
expect_absent "$source_section" ".animation(MenuBarMotion.rowUpdate, value: targets)"
expect_absent "$source_section" ".animation(MenuBarMotion.rowUpdate, value: playback.outputRows)"
expect_absent "$source_section" ".animation(MenuBarMotion.rowUpdate, value: playback.selectedRoomName)"
expect_contains "$source_section" "ForEach(displayTargets)"
expect_contains "$source_section" 'Text("No media sources")'
expect_contains "$source_section" "idleSpotifyConnectButton(row)"
expect_contains "$source_section" "playback.connectSpotify(to: row)"
expect_contains "$source_section" 'Text(selected ? "\(row.displayName) connected" : "Connect to \(row.displayName)")'
expect_contains "$source_section" 'accessibilityIdentifier("source-empty-connect-spotify-to-\(row.coordinator.roomName)")'
expect_absent "$source_section" "if displayTargets.isEmpty, mediaRemoteController.isRefreshingSnapshot"
expect_absent "$source_section" 'Text(mediaRemoteController.isRefreshingSnapshot ? "Refreshing..." : "No active media sources")'
expect_absent "$source_section" "return sessionTargets.map { liveSessionTarget(\$0, latestTarget: latestTargetsByID[\$0.id]) }"
expect_absent "$source_section" "replacementTarget("
expect_absent "$source_section" "latestTarget.browserBundleIdentifier == sessionTarget.browserBundleIdentifier"
expect_absent "$source_section" "latestTarget.browserDisplayName == sessionTarget.browserDisplayName"
expect_contains "$source_section" "let enabled = supports(command, target: target)"
expect_contains "$source_section" "mediaTransportActions.route(command: command, to: target)"
expect_absent "$source_section" "mediaTransportActions.route(command: command)"
expect_contains "$source_section" ".disabled(!enabled)"
expect_contains "$source_section" "mediaTransportActions.focus(target: target)"
expect_contains "$source_section" "private func sourceIdentityButton("
expect_contains "$source_section" '.help("Open \(target.appName)")'
expect_contains "$source_section" '.accessibilityIdentifier("source-\(target.id)-open")'
expect_contains "$source_section" '.accessibilityHint("Opens the app or browser tab")'
expect_contains "$source_section" "Text(target.detailText)"
expect_absent "$source_section" "private func sourceDetail("
expect_absent "$source_section" 'arrow.up.backward.and.arrow.down.forward'
expect_contains "$source_section" "if target.isSpotify"
expect_contains "$source_section" "playback.transferSpotifyPlayback(source: source, to: row)"
expect_contains "$source_section" "playback.hasActiveSpotifyConnection(to: row)"
expect_contains "$source_section" "ChromiumBrowserExtensionTransport.supports(command: command, target: target)"
expect_contains "$source_section" "if target.isChromiumBrowserLike"
expect_contains "$source_section" "return false"
expect_absent "$source_section" 'target.mediaType == "desktop_automation"'
expect_absent "$source_section" "Office unavailable"
expect_absent "$source_section" "Sonos routing not supported"

expect_contains "$playback_controller" "func transferSpotifyPlayback(source: MediaRemoteTarget, to row: PlaybackOutputRow)"
expect_contains "$playback_controller" "guard source.isSpotify, groupLoadingRoomName == nil else"
expect_contains "$playback_controller" "func connectSpotify(to row: PlaybackOutputRow)"
expect_contains "$playback_controller" "transfer(to: row.coordinator, verification: .connectOnly)"
expect_contains "$playback_controller" "func hasActiveSpotifyConnection(to row: PlaybackOutputRow) -> Bool"
expect_contains "$playback_controller" "func selectSpeaker(row: PlaybackOutputRow)"

expect_contains "$output_section" "playback.selectSpeaker(row: row)"
expect_contains "$output_section" 'Text(groupEditingActive ? "Group" : "Speakers")'
expect_absent "$output_section" "playback.transfer(to: row)"
expect_absent "$output_section" 'accessibilityIdentifier("transfer-to-'
expect_absent "$output_section" "Hands off Spotify playback"

expect_contains "$transport_controller" "func focus(target: MediaRemoteTarget)"
expect_contains "$transport_controller" "sourceFocusActionController.focus(target: target)"

python3 - "$transport_controller" <<'PY'
import pathlib
import sys

text = pathlib.Path(sys.argv[1]).read_text()

def fail(message):
    raise SystemExit(f"verify_menubar_source_first_semantics: {message}")

focus_start = text.index("    func focus(target: MediaRemoteTarget) {")
focus_end = text.index("\n    private func showChooserFromCache(", focus_start)
focus_body = text[focus_start:focus_end]
remember = "rememberTarget(target)"
delegate = "sourceFocusActionController.focus(target: target)"
if remember not in focus_body:
    fail("focus(target:) must remember the focused target")
if focus_body.index(remember) > focus_body.index(delegate):
    fail("focus(target:) must remember the target before delegating focus")

closure_start = text.index("            onFocus: { [weak self] target in")
closure_end = text.index("\n            onDismiss:", closure_start)
closure_body = text[closure_start:closure_end]
closure_remember = "self.rememberTarget(target)"
closure_delegate = "self.sourceFocusActionController.focus(target: target)"
if closure_remember not in closure_body:
    fail("chooser onFocus must remember the focused target")
if closure_body.index(closure_remember) > closure_body.index(closure_delegate):
    fail("chooser onFocus must remember the target before delegating focus")
PY

python3 - "$source_section" <<'PY'
import pathlib
import sys

text = pathlib.Path(sys.argv[1]).read_text()

def fail(message):
    raise SystemExit(f"verify_menubar_source_first_semantics: {message}")

display_start = text.index("    private var displayTargets: [MediaRemoteTarget] {")
display_end = text.index("\n    private var openingTargets: [MediaRemoteTarget] {", display_start)
display_body = text[display_start:display_end]
required_order = [
    "let latestTargets = freshTargets",
    "let latestTargetsByID = Dictionary(uniqueKeysWithValues: latestTargets.map { ($0.id, $0) })",
    "var usedTargetIDs: Set<String> = []",
    "let resolvedTargets = sessionTargets.compactMap { sessionTarget in",
    "if let latestTarget = latestTargetsByID[sessionTarget.id] {",
    "if ChromiumBrowserExtensionTransport.isTarget(sessionTarget), !latestTargets.isEmpty {",
    "return resolvedTargets + latestTargets.filter { !usedTargetIDs.contains($0.id) }",
]
positions = []
for needle in required_order:
    position = display_body.find(needle)
    if position < 0:
        fail(f"displayTargets must contain {needle!r}")
    positions.append(position)
if positions != sorted(positions):
    fail("displayTargets must reconcile exact stable-ID matches before dropping stale Chromium rows")
PY

expect_contains "$project_file" "MenuBarMediaSourceSection.swift"
expect_contains "$project_file" "MediaSourceStore.swift"

printf 'verify_menubar_source_first_semantics=ok\n'
