#!/usr/bin/env bash
set -euo pipefail

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
workdir="$(mktemp -d)"
trap 'rm -rf "$workdir"' EXIT

cp "$repo_root/SonosHandoffMenuBar/SonosHandoffMenuBar/App/MediaSourceStore.swift" "$workdir/MediaSourceStore.swift"

if grep -q 'try!' "$workdir/MediaSourceStore.swift"; then
  echo "verify_source_store_semantics: MediaSourceStore.swift must not use try! (crashes on task cancellation; use try?)" >&2
  exit 1
fi

cat >"$workdir/SourceStoreStubs.swift" <<'SWIFT'
import Combine
import Foundation

enum MediaRemoteTransportCommand: String, Equatable, Sendable {
    case play
    case pause
    case playPause
}

struct MediaRemoteTarget: Equatable, Identifiable, Sendable {
    let id: String
    let title: String
    let playbackRate: String
    let duration: Double?
    let elapsedTime: Double?
    let elapsedTimestamp: Double?
    let supportedCommands: [MediaRemoteTransportCommand]?
    var muted: Bool? = nil
}

enum ChromiumBrowserExtensionTransport {
    static func isTarget(_ target: MediaRemoteTarget) -> Bool {
        target.id.hasPrefix("chromium-tab:")
    }
}

struct MediaRemoteCommandResultEvent: Equatable, Sendable {
    let targetID: String
    let ok: Bool
    let unsupported: Bool
}

@MainActor
final class ChromiumBrowserExtensionController: ObservableObject {
    @Published private(set) var suspectTargetIDs: Set<String>

    init(suspectTargetIDs: Set<String> = []) {
        self.suspectTargetIDs = suspectTargetIDs
    }

    func replaceSuspectTargetIDs(_ suspectTargetIDs: Set<String>) {
        self.suspectTargetIDs = suspectTargetIDs
    }
}

@MainActor
final class MediaRemoteController: ObservableObject {
    static let helperRecoveryGraceInterval: TimeInterval = 5

    @Published private(set) var targets: [MediaRemoteTarget]
    @Published private(set) var helperDegradedSince: Date?

    init(targets: [MediaRemoteTarget] = []) {
        self.targets = targets
        self.helperDegradedSince = nil
    }

    func replaceTargets(_ targets: [MediaRemoteTarget]) {
        self.targets = targets
    }

    func replaceHelperDegradedSince(_ helperDegradedSince: Date?) {
        self.helperDegradedSince = helperDegradedSince
    }
}
SWIFT

cat >"$workdir/SourceStoreSemantics.swift" <<'SWIFT'
import Foundation

@main
struct SourceStoreSemantics {
    @MainActor
    static func main() {
        var currentDate = Date()
        let spotify = target(
            id: "spotify:desktop",
            title: "Old Song",
            playbackRate: "1",
            supportedCommands: [.playPause]
        )
        let chromium = target(
            id: "chromium-tab:profile-a:22",
            title: "Video",
            playbackRate: "0",
            supportedCommands: [.play, .pause],
            muted: true
        )
        let controller = MediaRemoteController(targets: [spotify, chromium])
        let chromiumController = ChromiumBrowserExtensionController()
        let store = MediaSourceStore(
            mediaRemoteController: controller,
            chromiumBrowserExtensionController: chromiumController,
            now: { currentDate }
        )

        expectEqual(store.targets, controller.targets, "store targets must mirror initial MediaRemoteController targets")
        expectEqual(store.rows.map(\.id), controller.targets.map(\.id), "source row IDs must match target IDs")
        assertAllLive(store.rows, "initial rows")

        let updatedSpotify = target(
            id: "spotify:desktop",
            title: "Updated Song",
            playbackRate: "0",
            supportedCommands: [.pause]
        )
        let stableIDsBefore = store.rows.map(\.id)
        controller.replaceTargets([updatedSpotify, chromium])
        drainMainQueue()

        expectEqual(store.rows.map(\.id), stableIDsBefore, "same target IDs must update in the same row identity slots")
        expectEqual(store.targets.map(\.title), ["Updated Song", "Video"], "same-ID updates must refresh target fields")
        expectEqual(store.rows[0].capabilities.supportedCommands, [.pause], "capabilities must refresh from updated targets")
        expectEqual(store.rows[0].audioState.playbackRate, "0", "audio state must refresh from updated targets")
        expectEqual(store.rows.first { $0.id == chromium.id }?.audioState.muted, true, "browser audio state must preserve tab-level muted state")
        assertAllLive(store.rows, "updated rows")

        chromiumController.replaceSuspectTargetIDs([chromium.id])
        drainMainQueue()
        assertSuspect(store.rows.first { $0.id == chromium.id }, reason: "no_recent_snapshot", "chromium silence must overlay reachability")

        let updatedSilentChromium = target(
            id: chromium.id,
            title: "Updated Video",
            playbackRate: "1",
            supportedCommands: [.play, .pause]
        )
        controller.replaceTargets([updatedSpotify, updatedSilentChromium])
        drainMainQueue()
        assertSuspect(store.rows.first { $0.id == chromium.id }, reason: "no_recent_snapshot", "updated(target:) must carry reachability forward before overlay recompute")

        store.recordCommandResult(MediaRemoteCommandResultEvent(targetID: chromium.id, ok: false, unsupported: false))
        assertSuspect(store.rows.first { $0.id == chromium.id }, reason: "command_failed", "command failures must override snapshot silence")

        chromiumController.replaceSuspectTargetIDs([])
        drainMainQueue()
        assertSuspect(store.rows.first { $0.id == chromium.id }, reason: "command_failed", "snapshot/silence clearing must not clear command_failed")

        store.recordCommandResult(MediaRemoteCommandResultEvent(targetID: chromium.id, ok: true, unsupported: false))
        assertLive(store.rows.first { $0.id == chromium.id }, "successful command result must clear command_failed")

        store.recordCommandResult(MediaRemoteCommandResultEvent(targetID: chromium.id, ok: false, unsupported: false))
        // Poll instead of a single fixed-margin sleep: the 10s cooldown task resumes on
        // the main executor whenever the run loop gets around to it, so a tight margin
        // (10.25s) flakes under load. Exit as soon as the row clears, fail past 13s.
        let cooldownDeadline = Date().addingTimeInterval(13)
        while Date() < cooldownDeadline,
              store.rows.first(where: { $0.id == chromium.id })?.reachability.isSuspect == true {
            RunLoop.main.run(until: Date().addingTimeInterval(0.1))
        }
        assertLive(store.rows.first { $0.id == chromium.id }, "command_failed cooldown must clear after ten seconds")

        store.recordCommandResult(MediaRemoteCommandResultEvent(targetID: chromium.id, ok: false, unsupported: true))
        assertLive(store.rows.first { $0.id == chromium.id }, "unsupported commands must not mark reachability suspect")

        controller.replaceTargets([chromium, updatedSpotify])
        drainMainQueue()

        expectEqual(store.targets, controller.targets, "store targets must mirror later MediaRemoteController targets")
        expectEqual(store.rows.map(\.id), ["chromium-tab:profile-a:22", "spotify:desktop"], "store row ordering must follow controller target ordering")
        assertAllLive(store.rows, "reordered rows")

        let degradedSince = currentDate
        controller.replaceHelperDegradedSince(degradedSince)
        drainMainQueue()
        controller.replaceTargets([chromium])
        drainMainQueue()

        expectEqual(store.rows.map(\.id), ["chromium-tab:profile-a:22", "spotify:desktop"], "store must retain MediaRemote rows during helper recovery")
        assertLive(store.rows.first { $0.id == chromium.id }, "helper recovery must not make Chromium rows suspect")
        assertSuspect(store.rows.first { $0.id == updatedSpotify.id }, reason: "helper_restarting", "helper recovery must mark retained MediaRemote rows suspect")

        let recoveredSpotify = target(
            id: "spotify:desktop",
            title: "Recovered Song",
            playbackRate: "1",
            supportedCommands: [.playPause]
        )
        let retainedIDsBeforeRecovery = store.rows.map(\.id)
        controller.replaceTargets([chromium, recoveredSpotify])
        drainMainQueue()
        controller.replaceHelperDegradedSince(nil)
        drainMainQueue()

        expectEqual(store.rows.map(\.id), retainedIDsBeforeRecovery, "fresh MediaRemote snapshot must update retained rows in place")
        expectEqual(store.rows.first { $0.id == recoveredSpotify.id }?.target.title, "Recovered Song", "fresh MediaRemote snapshot must refresh retained target fields")
        assertAllLive(store.rows, "recovered rows")

        controller.replaceHelperDegradedSince(currentDate)
        drainMainQueue()
        controller.replaceTargets([chromium])
        drainMainQueue()
        assertSuspect(store.rows.first { $0.id == recoveredSpotify.id }, reason: "helper_restarting", "second helper recovery must retain last-known MediaRemote rows")
        currentDate = currentDate.addingTimeInterval(MediaRemoteController.helperRecoveryGraceInterval + 0.1)
        controller.replaceHelperDegradedSince(currentDate.addingTimeInterval(-MediaRemoteController.helperRecoveryGraceInterval - 0.1))
        drainMainQueue()
        let retentionDeadline = Date().addingTimeInterval(2)
        while Date() < retentionDeadline,
              store.rows.contains(where: { $0.id == recoveredSpotify.id }) {
            RunLoop.main.run(until: Date().addingTimeInterval(0.05))
        }
        expectEqual(store.rows.map(\.id), [chromium.id], "retained MediaRemote rows must drop after helper recovery grace expires")
        assertLive(store.rows.first { $0.id == chromium.id }, "Chromium rows must stay live after MediaRemote retention expiry")

        print("verify_source_store_semantics=ok")
    }

    private static func target(
        id: String,
        title: String,
        playbackRate: String,
        supportedCommands: [MediaRemoteTransportCommand]?,
        muted: Bool? = nil
    ) -> MediaRemoteTarget {
        var target = MediaRemoteTarget(
            id: id,
            title: title,
            playbackRate: playbackRate,
            duration: 180,
            elapsedTime: 42,
            elapsedTimestamp: 1_700_000_000,
            supportedCommands: supportedCommands
        )
        target.muted = muted
        return target
    }

    @MainActor
    private static func drainMainQueue() {
        RunLoop.main.run(until: Date().addingTimeInterval(0.05))
    }

    private static func assertAllLive(_ rows: [SourceRow], _ context: String) {
        for row in rows {
            assertLive(row, "\(context): row \(row.id) must report live reachability")
        }
    }

    private static func assertLive(_ row: SourceRow?, _ message: String) {
        guard let row else {
            fail("\(message): missing row")
        }
        switch row.reachability {
        case .live:
            break
        case .suspect, .gone:
            fail(message)
        }
    }

    private static func assertSuspect(_ row: SourceRow?, reason: String, _ message: String) {
        guard let row else {
            fail("\(message): missing row")
        }
        switch row.reachability {
        case .suspect(let actualReason, _):
            expectEqual(actualReason, reason, message)
        case .live, .gone:
            fail(message)
        }
    }

    private static func expectEqual<T: Equatable>(
        _ actual: T,
        _ expected: T,
        _ message: String
    ) {
        guard actual == expected else {
            fail("\(message): expected \(expected), got \(actual)")
        }
    }

    private static func fail(_ message: String) -> Never {
        FileHandle.standardError.write(Data("verify_source_store_semantics: \(message)\n".utf8))
        exit(1)
    }
}
SWIFT

swiftc \
  -module-cache-path "$workdir/module-cache" \
  "$workdir/SourceStoreStubs.swift" \
  "$workdir/MediaSourceStore.swift" \
  "$workdir/SourceStoreSemantics.swift" \
  -o "$workdir/verify_source_store_semantics"

"$workdir/verify_source_store_semantics"
