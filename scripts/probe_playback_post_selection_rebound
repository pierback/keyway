#!/usr/bin/env bash
set -euo pipefail

status_file="${KEYWAY_STATUS_FILE:-$HOME/Library/Application Support/keyway/shortcut-runtime-status.json}"
timeout_seconds="${KEYWAY_PROBE_TIMEOUT_SECONDS:-5}"
rebound_delay_seconds="${KEYWAY_PROBE_POST_SELECTION_REBOUND_DELAY_SECONDS:-0.35}"
settle_seconds="${KEYWAY_PROBE_POST_SELECTION_REBOUND_SETTLE_SECONDS:-0.35}"
routeable_delay_seconds="${KEYWAY_PROBE_POST_SELECTION_ROUTEABLE_DELAY_SECONDS:-1.1}"
targeted_echo_pid=""

fail() {
  printf 'probe_playback_post_selection_rebound: %s\n' "$1" >&2
  exit 1
}

read_trace_sequence() {
  python3 - "$status_file" <<'PY'
import json
import pathlib
import sys

payload = json.loads(pathlib.Path(sys.argv[1]).read_text())
print(int(payload.get("mediaTransportTraceSequence", 0)))
PY
}

read_trace_json() {
  python3 - "$status_file" <<'PY'
import json
import pathlib
import sys

payload = json.loads(pathlib.Path(sys.argv[1]).read_text())
print(json.dumps(payload.get("mediaTransportTrace", []), separators=(",", ":")))
PY
}

post_physical_play_pause() {
  swift - <<'SWIFT'
import AppKit
import ApplicationServices

let playPauseKeyCode = 16
let keyDownState = 0x0A
let keyUpState = 0x0B
let mediaKeySubtype: Int16 = 8

func postMediaKey(state: Int) {
    let data1 = (playPauseKeyCode << 16) | (state << 8)
    guard let event = NSEvent.otherEvent(
        with: .systemDefined,
        location: .zero,
        modifierFlags: [],
        timestamp: ProcessInfo.processInfo.systemUptime,
        windowNumber: 0,
        context: nil,
        subtype: mediaKeySubtype,
        data1: data1,
        data2: -1
    ), let cgEvent = event.cgEvent else {
        fatalError("failed to create media key event")
    }
    cgEvent.setIntegerValueField(.eventSourceUnixProcessID, value: 0)
    cgEvent.setIntegerValueField(.eventSourceStateID, value: 1)
    cgEvent.setIntegerValueField(.eventSourceUserData, value: 0)
    cgEvent.setIntegerValueField(.eventTargetUnixProcessID, value: 0)
    cgEvent.post(tap: .cghidEventTap)
}

postMediaKey(state: keyDownState)
usleep(35_000)
postMediaKey(state: keyUpState)
SWIFT
}

post_targeted_physical_play_pause() {
  swift - <<'SWIFT'
import AppKit
import ApplicationServices

let playPauseKeyCode = 16
let keyDownState = 0x0A
let keyUpState = 0x0B
let mediaKeySubtype: Int16 = 8
let targetProcessID = Int64(ProcessInfo.processInfo.environment["KEYWAY_PROBE_TARGETED_ECHO_PID"]!)!

func postMediaKey(state: Int) {
    let data1 = (playPauseKeyCode << 16) | (state << 8)
    guard let event = NSEvent.otherEvent(
        with: .systemDefined,
        location: .zero,
        modifierFlags: [],
        timestamp: ProcessInfo.processInfo.systemUptime,
        windowNumber: 0,
        context: nil,
        subtype: mediaKeySubtype,
        data1: data1,
        data2: -1
    ), let cgEvent = event.cgEvent else {
        fatalError("failed to create media key event")
    }
    cgEvent.setIntegerValueField(.eventSourceUnixProcessID, value: 0)
    cgEvent.setIntegerValueField(.eventSourceStateID, value: 1)
    cgEvent.setIntegerValueField(.eventSourceUserData, value: 0)
    cgEvent.setIntegerValueField(.eventTargetUnixProcessID, value: targetProcessID)
    cgEvent.post(tap: .cghidEventTap)
}

postMediaKey(state: keyDownState)
usleep(35_000)
postMediaKey(state: keyUpState)
SWIFT
}

selected_target_pid() {
  local start_sequence="$1"
  local trace_json
  trace_json="$(read_trace_json)"
  python3 - "$start_sequence" "$trace_json" <<'PY'
import json
import sys

start_sequence = int(sys.argv[1])
events = [
    event for event in json.loads(sys.argv[2])
    if int(event.get("sequence", 0)) > start_sequence
]
show = next(event for event in events if event.get("event") == "chooser_show")
print(int(show["targets"][0]["pid"]))
PY
}

keyway_process_pid() {
  pgrep -x Keyway | head -n 1
}

select_chooser_row() {
  osascript -e 'tell application "System Events" to key code 36' >/dev/null
}

close_chooser() {
  osascript -e 'tell application "System Events" to key code 53' >/dev/null || true
}

wait_for_event() {
  local start_sequence="$1"
  local event_name="$2"
  local deadline=$((SECONDS + timeout_seconds))
  while (( SECONDS < deadline )); do
    trace_json="$(read_trace_json)"
    if python3 - "$start_sequence" "$event_name" "$trace_json" <<'PY'
import json
import sys

start_sequence = int(sys.argv[1])
event_name = sys.argv[2]
events = [
    event for event in json.loads(sys.argv[3])
    if int(event.get("sequence", 0)) > start_sequence
]
raise SystemExit(0 if any(event.get("event") == event_name for event in events) else 1)
PY
    then
      return 0
    fi
    sleep 0.05
  done
  return 1
}

analyze_trace() {
  local start_sequence="$1"
  local application_echo_pid="$2"
  local trace_json
  trace_json="$(read_trace_json)"
  python3 - "$start_sequence" "$application_echo_pid" "$trace_json" <<'PY'
import json
import sys

start_sequence = int(sys.argv[1])
application_echo_pid = int(sys.argv[2])
events = [
    event for event in json.loads(sys.argv[3])
    if int(event.get("sequence", 0)) > start_sequence
]

def fail(message):
    print(json.dumps(events, indent=2, sort_keys=True))
    print(f"probe_playback_post_selection_rebound: {message}", file=sys.stderr)
    raise SystemExit(1)

def first_after(index, name):
    return next((event for event in events[index + 1:] if event.get("event") == name), None)

def index_of(name):
    for index, event in enumerate(events):
        if event.get("event") == name:
            return index
    fail(f"missing {name}")

show_index = index_of("chooser_show")
dispatch_index = index_of("chooser_dispatch")
if dispatch_index <= show_index:
    fail("chooser_dispatch must happen after chooser_show")

helper = first_after(dispatch_index, "helper_command_result")
if helper is None:
    fail("missing helper_command_result after chooser_dispatch")
if helper.get("ok") is False:
    fail(f"helper reported failure: {helper.get('message')}")

rebound_key_index = None
for index, event in enumerate(events[dispatch_index + 1:], start=dispatch_index + 1):
    if event.get("event") == "transport_key_down":
        rebound_key_index = index
        break
if rebound_key_index is None:
    fail("missing forced post-selection targeted transport_key_down rebound")

dispatch = events[dispatch_index]
dispatch_target_id = dispatch.get("targetID")
show = events[show_index]
selected_target = next(
    (
        target for target in show.get("targets", [])
        if target.get("id") == dispatch_target_id
    ),
    None,
)
expected_echo_target_pid = selected_target.get("pid") if selected_target else None
actual_rebound_target_pid = events[rebound_key_index].get("eventTargetUnixProcessID")
if (
    expected_echo_target_pid is not None
    and actual_rebound_target_pid != expected_echo_target_pid
    and actual_rebound_target_pid != application_echo_pid
):
    routeable_show = next(
        (
            event for event in events[rebound_key_index + 1:]
            if event.get("event") == "chooser_show"
        ),
        None,
    )
    if routeable_show is None:
        fail(
            "retargeted post-selection media key was neither selected-target echo nor routeable "
            f"(expected target pid {expected_echo_target_pid}, got {actual_rebound_target_pid})"
        )
    print(json.dumps({
        "event": "probe_post_selection_retargeted_key_routeable",
        "actualTargetPID": actual_rebound_target_pid,
        "expectedEchoTargetPID": expected_echo_target_pid,
        "routeableChooserShowSequence": int(routeable_show.get("sequence", 0)),
    }, sort_keys=True))
    raise SystemExit(0)

suppressed = [
    event for event in events[rebound_key_index + 1:]
    if event.get("event") == "input_ignored"
    and event.get("reason") in {
        "chooser_targeted_media_key_echo_ignored",
        "media_key_rebound_ignored",
        "post_selection_echo",
    }
]
if not suppressed:
    fail("targeted post-selection rebound was not suppressed")

suppressed_sequence = int(suppressed[0].get("sequence", 0))
early_shows = [
    event for event in events[rebound_key_index + 1:]
    if int(event.get("sequence", 0)) < suppressed_sequence
    and event.get("event") == "chooser_show"
]
if early_shows:
    fail("targeted post-selection rebound reopened chooser before suppression")

routeable_key_index = None
for index, event in enumerate(events[rebound_key_index + 1:], start=rebound_key_index + 1):
    if event.get("event") == "transport_key_down" and index > events.index(suppressed[0]):
        routeable_key_index = index
        break
if routeable_key_index is None:
    fail("missing delayed routeable transport_key_down")

routeable_show = next(
    (
        event for event in events[routeable_key_index + 1:]
        if event.get("event") == "chooser_show"
    ),
    None,
)
if routeable_show is None:
    fail("delayed fresh media key did not reopen the chooser")

print(json.dumps({
    "event": "probe_post_selection_rebound_suppressed",
    "suppressedSequence": suppressed_sequence,
    "routeableChooserShowSequence": int(routeable_show.get("sequence", 0)),
}, sort_keys=True))
PY
}

trap close_chooser EXIT

start_sequence="$(read_trace_sequence)"
printf 'probe_playback_post_selection_rebound: starting after trace sequence %s\n' "$start_sequence"
post_physical_play_pause

if ! wait_for_event "$start_sequence" "chooser_show"; then
  read_trace_json | python3 -m json.tool >&2
  fail "timed out waiting for chooser_show"
fi
targeted_echo_pid="$(keyway_process_pid)"
if [[ -z "$targeted_echo_pid" ]]; then
  fail "could not find running Keyway pid"
fi

sleep 0.1
select_chooser_row

if ! wait_for_event "$start_sequence" "chooser_dispatch"; then
  read_trace_json | python3 -m json.tool >&2
  fail "timed out waiting for chooser_dispatch"
fi

sleep "$rebound_delay_seconds"
KEYWAY_PROBE_TARGETED_ECHO_PID="$targeted_echo_pid" post_targeted_physical_play_pause
sleep "$settle_seconds"
sleep "$routeable_delay_seconds"
post_physical_play_pause
sleep "$settle_seconds"
analyze_trace "$start_sequence" "$targeted_echo_pid"
printf 'probe_playback_post_selection_rebound=ok\n'
