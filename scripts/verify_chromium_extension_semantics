#!/usr/bin/env bash
set -euo pipefail

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"

bash -n "$repo_root/scripts/setup_chromium_extension" >/dev/null
bash -n "$repo_root/scripts/smoke_helium_chromium_extension_transport" >/dev/null

python3 - "$repo_root" <<'PY'
import json
import pathlib
import sys

repo_root = pathlib.Path(sys.argv[1])
manifest = json.loads((repo_root / "ChromiumExtension/manifest.json").read_text())
service_worker = (repo_root / "ChromiumExtension/service_worker.js").read_text()
content_script = (repo_root / "ChromiumExtension/content_script.js").read_text()
declared_permissions = set(manifest.get("permissions", []))
chrome_api_to_permission = {
    "chrome.storage.": "storage",
    "chrome.alarms.": "alarms",
}
for api_prefix, required_permission in chrome_api_to_permission.items():
    if api_prefix in service_worker and required_permission not in declared_permissions:
        raise SystemExit(
            f"verify_chromium_extension_semantics: service_worker.js calls {api_prefix}* but "
            f"manifest.json permissions is missing '{required_permission}' -- this API is undefined "
            "at runtime without it, silently breaking the extension outside this repo's static checks"
        )

transport = (repo_root / "SonosHandoffMenuBar/SonosHandoffMenuBar/App/ChromiumBrowserExtensionTransport.swift").read_text()
source_store = (repo_root / "SonosHandoffMenuBar/SonosHandoffMenuBar/App/MediaSourceStore.swift").read_text()
models = (repo_root / "SonosHandoffMenuBar/SonosHandoffMenuBar/App/MediaRemoteModels.swift").read_text()
action_controller = (repo_root / "SonosHandoffMenuBar/SonosHandoffMenuBar/App/MediaTransportActionController.swift").read_text()
target_resolver = (repo_root / "SonosHandoffMenuBar/SonosHandoffMenuBar/App/MediaTransportTargetResolver.swift").read_text()
environment = (repo_root / "SonosHandoffMenuBar/SonosHandoffMenuBar/Support/AppEnvironment.swift").read_text()
settings = (repo_root / "SonosHandoffMenuBar/SonosHandoffMenuBar/Features/SettingsFeature.swift").read_text()
project = (repo_root / "SonosHandoffMenuBar/SonosHandoffMenuBar.xcodeproj/project.pbxproj").read_text()
installer = (repo_root / "scripts/install_chromium_native_host").read_text()
readme = (repo_root / "ChromiumExtension/README.md").read_text()
generator = (repo_root / "scripts/generate_xcode_projects.rb").read_text()
setup = (repo_root / "scripts/setup_chromium_extension").read_text()
helium_smoke = (repo_root / "scripts/smoke_helium_chromium_extension_transport").read_text()
chromium_smoke = (repo_root / "scripts/smoke_chromium_extension_transport").read_text()
worker_suspension_smoke = (repo_root / "scripts/smoke_chromium_worker_suspension").read_text()
regression_gate = (repo_root / "scripts/regression_gate").read_text()
native_host = (repo_root / "packages/SonosHandoffCore/Sources/KeywayChromiumNativeHost/main.swift").read_text()

def expect(text, needle, message):
    if needle not in text:
        raise SystemExit(f"verify_chromium_extension_semantics: {message}")

expect(
    transport,
    "static let protocolVersion = 3",
    "Swift Chromium transport must hard-cut the browser extension protocol at v3",
)
expect(
    transport,
    'static let extensionID = "gmdpkggbaohimgacbclndlfjghgcbael"',
    "Swift app must register manifests for the stable unpacked extension ID",
)
expect(
    transport,
    'static let focusResultNotificationName = Notification.Name("com.fpieringer.keyway.chromium.focusResult")',
    "Swift Chromium transport must receive browser focus results separately from media command results",
)
expect(
    transport,
    'type: "focusTarget"',
    "Swift Chromium transport must send explicit browser focus requests",
)
expect(
    transport,
    "func focus(\n        target: MediaRemoteTarget,",
    "Swift Chromium transport must expose a dedicated focus operation",
)
expect(
    transport,
    "return target.browserFamily?.lowercased()",
    "Chromium extension targets must expose typed browser family metadata without parsing transport IDs",
)
expect(
    transport,
    "static func legacyBrowserFamily(target: MediaRemoteTarget) -> String?",
    "Chromium transport must classify legacy browser rows so exact extension targets can hide weaker same-family rows",
)
expect(
    source_store,
    "visibleMediaRemoteTargets",
    "canonical media source store must filter visible MediaRemote browser rows when exact extension targets exist",
)
expect(
    source_store,
    "ChromiumBrowserExtensionTransport.shadowsLegacyTarget(extensionTarget: $0, legacyTarget: target)",
    "canonical media source store must apply extension-to-legacy duplicate detection",
)
expect(
    transport,
    "static func shadowsLegacyTarget(extensionTarget: MediaRemoteTarget, legacyTarget: MediaRemoteTarget) -> Bool",
    "Chromium transport must centralize extension-to-legacy duplicate detection",
)
expect(
    transport,
    "extensionFamily == legacyFamily",
    "Chromium transport must shadow weaker legacy browser rows by exact browser family",
)
for forbidden in [
    "extensionTitle == normalizedMediaTitle(legacyTarget.title)",
    "private static func normalizedMediaTitle(",
]:
    if forbidden in transport:
        raise SystemExit(
            "verify_chromium_extension_semantics: Chromium transport must not shadow different browser families by title-only media metadata"
        )
expect(
    transport,
    'appendingPathComponent("Contents/Helpers/keyway-chromium-native-host")',
    "Swift installer must point browser manifests at the bundled native host",
)
expect(
    models,
    "var isChromiumBrowserLike: Bool",
    "media targets must identify Chromium-like legacy browser targets separately from Safari and Firefox",
)
expect(
    models,
    "var routeSourceLabel: String?",
    "media target model must expose route provenance for chooser display",
)
expect(
    target_resolver,
    "let playingTargets = targets.filter(\\.isCurrentlyPlaying)",
    "automatic routing must evaluate global playing targets before browser-specific fallback",
)
expect(
    target_resolver,
    "ChromiumBrowserExtensionTransport.isTarget(playingTarget)",
    "automatic routing must identify Chromium extension targets on the single-playing path",
)
expect(
    target_resolver,
    "!ChromiumBrowserExtensionTransport.supports(command: command, target: playingTarget)",
    "automatic routing must reject unsupported single Chromium targets instead of routing them directly",
)
expect(
    target_resolver,
    "if playingTargets.count > 1 {",
    "automatic routing must treat mixed playing targets as ambiguous",
)
if "preferredChromiumExtensionTarget(" in target_resolver:
    raise SystemExit("verify_chromium_extension_semantics: automatic routing must not bypass mixed playing ambiguity through a Chromium-specific pre-check")
send_body = action_controller[
    action_controller.index("    private func send(\n        command: MediaRemoteTransportCommand,"):
    action_controller.index("    private func fallbackMediaRemote(")
]
desktop_block = send_body[
    send_body.index("if let result = desktopTransport.submit(command: command, target: target) {"):
    send_body.index("if let sent = chromiumBrowserExtensionController.submit")
]
for forbidden in [
    "shouldFallbackFromUnsupportedDesktopResult(",
    "sendSpotifyWebAPI(",
    "sendMediaRemote(",
    "desktop_transport_fallback",
    "spotify_webapi_fallback",
]:
    if forbidden in desktop_block:
        raise SystemExit(
            f"verify_chromium_extension_semantics: desktop transport results must be terminal before Chromium routing: {forbidden}"
        )
for forbidden in [
    "shouldFallbackFromUnsupportedDesktopResult(",
    "sendSpotifyWebAPI(",
    "spotifyPlaybackCommand(",
    "spotifyWebAPIResult(",
    "spotifyWebAPIBackend",
    "spotify_webapi_fallback",
    "legacyChromiumFallbackTarget",
    '"chromium_extension_fallback"',
]:
    if forbidden in action_controller:
        raise SystemExit(
            f"verify_chromium_extension_semantics: Chromium and desktop routing must not retain obsolete fallback hooks: {forbidden}"
        )
overlay_view = repo_root.joinpath("SonosHandoffMenuBar/SonosHandoffMenuBar/App/MediaTargetOverlayView.swift").read_text()
expect(
    overlay_view,
    "target.routeSourceLabel",
    "chooser rows must display route provenance for browser targets",
)
expect(
    overlay_view,
    ".focusable(false)",
    "chooser row buttons must not draw the system blue focus ring; overlay selection is model-owned",
)
expect(
    service_worker,
    "const protocolVersion = 3",
    "Chromium extension service worker must speak protocol v3",
)
expect(
    service_worker,
    "chrome.storage.local.get([profileGuidStorageKey]",
    "Chromium extension service worker must load profile GUIDs from local browser-profile storage",
)
expect(
    service_worker,
    "chrome.storage.local.set({ [profileGuidStorageKey]: profileGuid }",
    "Chromium extension service worker must persist minted profile GUIDs",
)
expect(
    service_worker,
    'type: "hello"',
    "Chromium extension service worker must announce hello to the native host",
)
expect(
    service_worker,
    "profileGuid,",
    "Chromium extension service worker hello must include its stable profile GUID",
)
expect(
    service_worker,
    "epoch: snapshotEpoch",
    "Chromium extension service worker hello must include the current snapshot epoch",
)
expect(
    service_worker,
    "resumed: resume.resumed",
    "Chromium extension service worker hello must include resumed state",
)
expect(
    service_worker,
    "chrome.storage.session.get([snapshotStorageKey, snapshotEpochStorageKey]",
    "Chromium extension service worker must rehydrate snapshots from session storage",
)
expect(
    service_worker,
    "chrome.alarms.create(nativePortAlarmName, { periodInMinutes: 0.5 })",
    "Chromium extension service worker must register a 30s native-port dead-man alarm",
)
expect(
    service_worker,
    "rejectUnsupportedProtocol(message)",
    "Chromium extension service worker must reject unsupported native protocol versions",
)
expect(
    service_worker,
    "const targetStaleAfterMs = 15000",
    "Chromium extension service worker must expire stale media targets",
)
expect(
    service_worker,
    "return target.hasPlaybackActivity",
    "Chromium extension service worker must keep paused media with prior playback activity visible",
)
expect(
    content_script,
    "hasPlaybackActivity",
    "Chromium content script must report playback activity for paused media after restart probes",
)
expect(
    service_worker,
    "candidateID(documentID, frameId, mediaId)",
    "Chromium extension service worker must scope private routes to the content document",
)
expect(
    service_worker,
    "!selected.supportedCommands.includes(message.command)",
    "Chromium extension service worker must capability-gate commands against the selected route",
)
expect(
    service_worker,
    "browserFamily: source.browserFamily",
    "Chromium extension snapshots must expose browser family as typed metadata",
)
expect(
    service_worker,
    "removeStaleSources()",
    "Chromium extension service worker must remove stale sources before snapshots",
)
expect(
    service_worker,
    'const id = ["chromium-tab", profileGuid, tab.id].join(":")',
    "Chromium extension service worker must expose stable profile-and-tab source identities instead of media-element target identities",
)
expect(
    service_worker,
    "source.tabTitle || selected.frameTitle ||",
    "Chromium extension service worker must prefer tab titles over frame titles for browser source rows",
)
expect(
    content_script,
    "const documentID = crypto.getRandomValues(new Uint32Array(4))",
    "Chromium extension content script must stamp media routes on plain HTTP pages",
)
if "crypto.randomUUID" in content_script:
    raise SystemExit("verify_chromium_extension_semantics: Chromium content scripts must not require a secure context for document identity")
expect(
    content_script,
    "function runtimeAvailable()",
    "Chromium extension content script must check runtime health before messaging",
)
expect(
    content_script,
    "function retireBridge()",
    "Chromium extension content script must retire invalidated extension contexts",
)
expect(
    content_script,
    "function sendRuntimeMessage(message)",
    "Chromium extension content script must route runtime messages through the lifecycle guard",
)
expect(
    content_script,
    "message.documentID !== documentID",
    "Chromium extension content script must reject stale document commands",
)
expect(
    content_script,
    "element.shadowRoot",
    "Chromium extension content script must discover media and controls inside shadow DOM",
)
expect(
    content_script,
    "metadata?.album",
    "Chromium extension content script must report Media Session album metadata",
)
expect(
    content_script,
    'Boolean(element.currentSrc || element.src || element.querySelector("source"))',
    "Chromium extension content script must keep stable targets during readyState=0 source transitions",
)
expect(
    content_script,
    "}).catch(error => {",
    "Chromium extension content script must answer rejected media commands with an explicit failure",
)
expect(
    content_script,
    "retireIfExtensionContextInvalidated(error)",
    "Chromium extension content script must retire rejected commands caused by invalidated extension contexts",
)
expect(
    content_script,
    "Chromium media command failed.",
    "Chromium extension content script must return a deterministic failed-command message",
)
if "error instanceof Error ? error.message" in content_script:
    raise SystemExit("verify_chromium_extension_semantics: Chromium rejected-command errors must not expose browser-specific messages")
expect(
    service_worker,
    'if (message.type === "focusTarget")',
    "Chromium extension service worker must dispatch explicit focus requests",
)
expect(
    service_worker,
    "chrome.tabs.get(source.tabId",
    "Chromium extension service worker must resolve the live tab before focusing",
)
expect(
    service_worker,
    "chrome.windows.update(tab.windowId, { focused: true }",
    "Chromium extension service worker must focus the selected browser window",
)
expect(
    service_worker,
    "chrome.tabs.update(tab.id, { active: true }",
    "Chromium extension service worker must activate the selected browser tab by id",
)
expect(
    service_worker,
    "chrome.tabs.query({ active: true, windowId: tab.windowId }",
    "Chromium extension service worker must confirm the selected tab became active",
)
expect(
    native_host,
    'targets[index]["id"] = "\\(chromiumTargetIDPrefix)\\(profileGuid):\\(tabID)"',
    "Chromium native host must publish stable profile-and-tab target IDs to the app",
)
expect(
    native_host,
    "let connectionID = UUID().uuidString.lowercased()",
    "Chromium native host must mint one private connection ID per native-host process",
)
expect(
    native_host,
    "func payloadByMatchingConnectionID(_ payload: String) -> Data?",
    "Chromium native host must route commands by private connection ID",
)
expect(
    native_host,
    "func readNativeMessage() -> Data?",
    "Chromium native host must preserve raw browser payload bytes until envelope validation"
)
expect(
    native_host,
    "func writeNativeMessage(_ payload: Data)",
    "Chromium native host must write routed command payloads as exact JSON bytes"
)
expect(
    native_host,
    "func payloadByAddingHostBrowserIdentity(_ payload: Data) -> String?",
    "Chromium native host must validate snapshot payloads before adding browser identity metadata"
)
expect(
    native_host,
    "func payloadStringForResult(_ payload: Data) -> String?",
    "Chromium native host must validate result payloads before forwarding target IDs"
)
expect(
    native_host,
    "guard payloadConnectionID == connectionID else {\n        return nil\n    }",
    "Chromium native host must silently ignore commands owned by another browser host to avoid racing the owner result",
)
if "postUnroutableTargetResult" in native_host:
    raise SystemExit("verify_chromium_extension_semantics: Chromium native host must not post non-owner target failures")
expect(
    native_host,
    'targets[index]["browserFamily"]',
    "Chromium native host must add browser family metadata from the launching browser",
)
expect(
    native_host,
    'root["profileGuid"] = profileGuid',
    "Chromium native host must expose profile GUID metadata",
)
expect(
    native_host,
    'root["connectionID"] = connectionID',
    "Chromium native host must expose private routing connection metadata",
)
for forbidden in [
    'try! JSONSerialization.jsonObject(with: data) as! [String: Any]',
    'let raw' + 'TargetID = targets[index]["id"] as! String',
    'let public' + 'TargetID = root["targetID"] as! String',
    'let raw' + 'TargetID = root["targetID"] as! String',
    'let envelope = try! JSONDecoder().decode(NativeMessageEnvelope.self, from: data)',
    'preconditionFailure("Keyway command notifications must include a payload.")',
    'Unknown Chromium native message type:',
    "public" + "TargetID",
    "raw" + "TargetID",
    "instance" + "ID",
    "browser" + "InstanceID",
]:
    if forbidden in native_host:
        raise SystemExit(
            "verify_chromium_extension_semantics: Chromium native host must not crash on malformed extension or command payloads"
        )
expect(
    environment,
    "let state = try chromiumNativeMessagingHostInstaller.install()",
    "app startup must install or repair Chromium native messaging manifests",
)
start_method = transport[
    transport.index("    func start() {"):
    transport.index("\n    func stop() {")
]
reload_payload = 'let reloadPayload = "{\\"type\\":\\"reloadExtension\\",\\"protocolVersion\\":\\(ChromiumBrowserExtensionTransport.protocolVersion)}"'
expect(
    start_method,
    reload_payload,
    "app startup must reload connected extensions so browsers replace stale native hosts after an app update",
)
if start_method.count(reload_payload) != 1:
    raise SystemExit(
        "verify_chromium_extension_semantics: app startup must request exactly one extension reload"
    )
expect(
    start_method,
    "ChromiumBrowserExtensionTransport.commandNotificationName",
    "app startup must send extension reload through the native-host command channel",
)
expect(
    start_method,
    "object: ChromiumBrowserExtensionTransport.nativeMessagingHostName",
    "app startup extension reload must target the native messaging host",
)
expect(
    start_method,
    'userInfo: ["payload": reloadPayload]',
    "app startup extension reload must send the reload payload",
)
expect(
    start_method,
    "deliverImmediately: true",
    "app startup extension reload must not wait for distributed-notification coalescing",
)
if "connectionID" in start_method:
    raise SystemExit(
        "verify_chromium_extension_semantics: app startup reload must reach every connected browser profile without a connection ID"
    )
if start_method.index("snapshotObserver =") > start_method.index(reload_payload):
    raise SystemExit(
        "verify_chromium_extension_semantics: app startup must observe the replacement extension hello before requesting reload"
    )
if "_ = try! chromiumNativeMessagingHostInstaller.install()" in environment:
    raise SystemExit(
        "verify_chromium_extension_semantics: app startup must not crash when the Chromium bridge install fails"
    )
expect(
    settings,
