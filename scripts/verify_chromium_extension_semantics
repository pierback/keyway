    service_worker,
    "profileGuid,",
    "Chromium extension service worker hello must include its stable profile GUID",
)
expect(
    service_worker,
    "epoch: snapshotEpoch",
    "Chromium extension service worker hello must include the current snapshot epoch",
)
expect(
    service_worker,
    "resumed: resume.resumed",
    "Chromium extension service worker hello must include resumed state",
)
expect(
    service_worker,
    "chrome.storage.session.get([snapshotStorageKey, snapshotEpochStorageKey]",
    "Chromium extension service worker must rehydrate snapshots from session storage",
)
expect(
    service_worker,
    "chrome.alarms.create(nativePortAlarmName, { periodInMinutes: 0.5 })",
    "Chromium extension service worker must register a 30s native-port dead-man alarm",
)
disconnect_handler = service_worker[
    service_worker.index("  port.onDisconnect.addListener(() => {"):
    service_worker.index("  loadResumeState(resume => {", service_worker.index("  port.onDisconnect.addListener(() => {"))
]
expect(
    disconnect_handler,
    "void chrome.runtime.lastError;",
    "native-host disconnects must consume runtime.lastError so Helium does not record unchecked extension errors",
)
expect(
    disconnect_handler,
    "retireNativePort(port, generation)",
    "native-host disconnects must retire exactly their current port generation",
)
for needle in [
    "const reconnectMinimumDelayMs = 1000",
    "const reconnectMaximumDelayMs = 30000",
    "reconnectDelayMs = Math.min(reconnectDelayMs * 2, reconnectMaximumDelayMs)",
    "reconnectDelayMs = reconnectMinimumDelayMs",
]:
    expect(
        service_worker,
        needle,
        "native-host reconnects must use bounded backoff and reset it only after a stable connection",
    )
expect(
    service_worker,
    "rejectUnsupportedProtocol(message, port, generation)",
    "Chromium extension service worker must reject unsupported native protocol versions",
)
expect(
    service_worker,
    "const targetStaleAfterMs = 15000",
    "Chromium extension service worker must expire stale media targets",
)
expect(
    media_source_selection,
    "return target.hasPlaybackActivity",
    "Chromium media policy must keep paused media with prior playback activity visible",
)
expect(
    content_script,
    "hasPlaybackActivity",
    "Chromium content script must report playback activity for paused media after restart probes",
)
expect(
    service_worker,
    "candidateID(documentID, frameId, mediaId)",
    "Chromium extension service worker must scope private routes to the content document",
)
expect(
    service_worker,
    "!selected.supportedCommands.includes(message.command)",
    "Chromium extension service worker must capability-gate commands against the selected route",
)
expect(
    media_source_selection,
    "browserFamily: source.browserFamily",
    "Chromium extension snapshots must expose browser family as typed metadata",
)
expect(
    service_worker,
    "removeStaleSources()",
    "Chromium extension service worker must remove stale sources before snapshots",
)
expect(
    service_worker,
    'const id = ["chromium-tab", profileGuid, tab.id].join(":")',
    "Chromium extension service worker must expose stable profile-and-tab source identities instead of media-element target identities",
)
expect(
    media_source_selection,
    "source.tabTitle || selected.frameTitle ||",
    "Chromium media policy must prefer tab titles over frame titles for browser source rows",
)
expect(
    content_script,
    "const documentID = crypto.getRandomValues(new Uint32Array(4))",
    "Chromium extension content script must stamp media routes on plain HTTP pages",
)
if "crypto.randomUUID" in content_script:
    raise SystemExit("verify_chromium_extension_semantics: Chromium content scripts must not require a secure context for document identity")
expect(
    content_script,
    "function runtimeAvailable()",
    "Chromium extension content script must check runtime health before messaging",
)
expect(
    content_script,
    "function retireBridge()",
    "Chromium extension content script must retire invalidated extension contexts",
)
expect(
    content_script,
    "function sendRuntimeMessage(message)",
    "Chromium extension content script must route runtime messages through the lifecycle guard",
)
expect(
    content_script,
    "message.documentID !== documentID",
    "Chromium extension content script must reject stale document commands",
)
expect(
    content_script,
    "element.shadowRoot",
    "Chromium extension content script must discover media and controls inside shadow DOM",
)
expect(
    content_script,
    "metadata?.album",
    "Chromium extension content script must report Media Session album metadata",
)
expect(
    content_script,
    'Boolean(element.currentSrc || element.src || element.querySelector("source"))',
    "Chromium extension content script must keep stable targets during readyState=0 source transitions",
)
expect(
    content_script,
    "}).catch(error => {",
    "Chromium extension content script must answer rejected media commands with an explicit failure",
)
expect(
    content_script,
    "retireIfExtensionContextInvalidated(error)",
    "Chromium extension content script must retire rejected commands caused by invalidated extension contexts",
)
expect(
    content_script,
    "Chromium media command failed.",
    "Chromium extension content script must return a deterministic failed-command message",
)
if "error instanceof Error ? error.message" in content_script:
    raise SystemExit("verify_chromium_extension_semantics: Chromium rejected-command errors must not expose browser-specific messages")
expect(
    service_worker,
    'if (message.type === "focusTarget")',
    "Chromium extension service worker must dispatch explicit focus requests",
)
expect(
    service_worker,
    "chrome.tabs.get(source.tabId",
    "Chromium extension service worker must resolve the live tab before focusing",
)
expect(
    service_worker,
    "chrome.windows.update(tab.windowId, { focused: true }",
    "Chromium extension service worker must focus the selected browser window",
)
expect(
    service_worker,
    "chrome.tabs.update(tab.id, { active: true }",
    "Chromium extension service worker must activate the selected browser tab by id",
)
expect(
    service_worker,
    "chrome.tabs.query({ active: true, windowId: tab.windowId }",
    "Chromium extension service worker must confirm the selected tab became active",
)
expect(
    native_host,
    'targets[index]["id"] = "\\(chromiumTargetIDPrefix)\\(profileGuid):\\(tabID)"',
    "Chromium native host must publish stable profile-and-tab target IDs to the app",
)
