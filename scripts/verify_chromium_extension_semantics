#!/usr/bin/env bash
set -euo pipefail

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"

node --check "$repo_root/ChromiumExtension/service_worker.js" >/dev/null
node --check "$repo_root/ChromiumExtension/content_script.js" >/dev/null
bash -n "$repo_root/scripts/setup_chromium_extension" >/dev/null
bash -n "$repo_root/scripts/smoke_helium_chromium_extension_transport" >/dev/null

node - "$repo_root/ChromiumExtension/service_worker.js" <<'NODE'
const fs = require("fs");
const vm = require("vm");

const serviceWorkerPath = process.argv[2];
const code = fs.readFileSync(serviceWorkerPath, "utf8");
const postedMessages = [];
const intervals = [];
const timeouts = [];
const clearedIntervals = [];
const tabMessages = [];
let disconnectListener = null;
let nativeMessageListener = null;
let runtimeMessageListener = null;
let tabRemovedListener = null;
let tabUpdatedListener = null;
let mediaStateResponse = null;

const context = {
  console,
  navigator: {
    userAgent: "Mozilla/5.0 Chrome/126.0.0.0 Safari/537.36",
  },
  setInterval(callback, delay) {
    intervals.push({ callback, delay });
    return `interval-${intervals.length}`;
  },
  clearInterval(id) {
    clearedIntervals.push(id);
  },
  setTimeout(callback, delay) {
    timeouts.push({ callback, delay });
    return `timeout-${timeouts.length}`;
  },
  chrome: {
    runtime: {
      id: "extensionid",
      connectNative(name) {
        assertEqual(name, "com.fpieringer.keyway.chromium", "native host name");
        return {
          postMessage(message) {
            postedMessages.push(message);
          },
          onMessage: {
            addListener(listener) {
              nativeMessageListener = listener;
            },
          },
          onDisconnect: {
            addListener(listener) {
              disconnectListener = listener;
            },
          },
        };
      },
      onMessage: {
        addListener(listener) {
          runtimeMessageListener = listener;
        },
      },
    },
    tabs: {
      onRemoved: {
        addListener(listener) {
          tabRemovedListener = listener;
        },
      },
      onUpdated: {
        addListener(listener) {
          tabUpdatedListener = listener;
        },
      },
      sendMessage(tabId, message, options, callback) {
        tabMessages.push({ tabId, message, options });
        callback({ ok: true, message: "ack" });
      },
    },
  },
};

vm.runInNewContext(code, context, { filename: serviceWorkerPath });

assertEqual(context.browserInfoFromUserAgent("Mozilla/5.0 Arc/1.0 Chrome/126.0.0.0").key, "arc", "Arc user agent must preserve browser family");
assertEqual(context.browserInfoFromUserAgent("Mozilla/5.0 Edg/126.0.0.0 Chrome/126.0.0.0").key, "edge", "Edge user agent must preserve browser family");
assertEqual(context.browserInfoFromUserAgent("Mozilla/5.0 Vivaldi/6.8 Chrome/126.0.0.0").key, "vivaldi", "Vivaldi user agent must preserve browser family");
assertEqual(context.browserInfoFromUserAgent("Mozilla/5.0 Helium/1.0 Chrome/126.0.0.0").key, "helium", "Helium user agent must preserve browser family");

(async () => {
  assert(postedMessages.some(message => message.type === "hello"), "service worker must announce hello to native host");
  assert(postedMessages.some(message => message.type === "snapshot"), "service worker must publish a snapshot immediately");
  assertEqual(intervals.length, 1, "service worker must start one heartbeat interval");
  assertEqual(intervals[0].delay, 1000, "service worker heartbeat interval");

  intervals[0].callback();
  assert(
    postedMessages.filter(message => message.type === "snapshot").length >= 2,
    "heartbeat must publish recurring snapshots"
  );

  assert(typeof runtimeMessageListener === "function", "service worker must register runtime message listener");
  const keepsChannelOpen = runtimeMessageListener(
    {
      type: "keywayMediaState",
      mediaId: "media-1",
      title: "Song",
      artist: "Artist",
      playing: true,
      muted: false,
      volume: 0.5,
      duration: 120,
      elapsedTime: 10,
      supportedCommands: ["play", "pause", "playPause", "next"],
    },
    {
      tab: {
        id: 22,
        windowId: 11,
        url: "https://example.test/video",
        title: "Example Video",
      },
      frameId: 0,
    },
    response => {
      mediaStateResponse = response;
    }
  );
  assertEqual(keepsChannelOpen, true, "media state messages must keep the async response channel open");
  await Promise.resolve();
  assertEqual(mediaStateResponse?.ok, true, "media state response");
  const snapshot = postedMessages.filter(message => message.type === "snapshot").at(-1);
  assertEqual(snapshot.targets.length, 1, "media state must publish one browser target");
  assertEqual(
    snapshot.targets[0].id,
    "chromium-extension:chrome-extensionid:11:22:0:media-1",
    "target id must include browser and runtime identity"
  );
  assertEqual(snapshot.targets[0].browser, "Chrome", "target browser label");
  assertEqual(snapshot.targets[0].supportedCommands.join(","), "play,pause,playPause,next", "media state must preserve page-supported commands");

  runtimeMessageListener(
    {
      type: "keywayMediaState",
      mediaId: "media-2",
      title: "Second Song",
      artist: "Second Artist",
      playing: false,
      muted: false,
      volume: 0.75,
      duration: 180,
      elapsedTime: 20,
    },
    {
      tab: {
        id: 23,
        windowId: 11,
        url: "https://example.test/second-video",
        title: "Second Example Video",
      },
      frameId: 0,
    },
    () => {}
  );
  await Promise.resolve();
  const twoTargetSnapshot = postedMessages.filter(message => message.type === "snapshot").at(-1);
  assertEqual(twoTargetSnapshot.targets.length, 2, "two media tabs must publish two exact browser targets");
  assertEqual(
    twoTargetSnapshot.targets[1].id,
    "chromium-extension:chrome-extensionid:11:23:0:media-2",
    "second target id must preserve its own tab identity"
  );

  assert(typeof nativeMessageListener === "function", "service worker must register native command listener");
  nativeMessageListener({
    type: "command",
    requestID: "command-1",
    targetID: twoTargetSnapshot.targets[1].id,
    tabId: 23,
    frameId: 0,
    mediaId: "media-2",
    command: "playPause",
  });
  assertEqual(tabMessages.length, 1, "native command must dispatch to exactly one browser tab");
  assertEqual(tabMessages[0].tabId, 23, "native command must dispatch to the requested tab");
  assertEqual(tabMessages[0].options.frameId, 0, "native command must dispatch to the requested frame");
  assertEqual(tabMessages[0].message.mediaId, "media-2", "native command must dispatch to the requested media element");
  assertEqual(tabMessages[0].message.command, "playPause", "native command must preserve the command");
  const commandResult = postedMessages.filter(message => message.type === "commandResult").at(-1);
  assertEqual(commandResult.targetID, twoTargetSnapshot.targets[1].id, "command result must preserve exact target id");
  assertEqual(commandResult.ok, true, "command result must preserve content-script acknowledgement");

  assert(typeof tabUpdatedListener === "function", "service worker must register tab update listener");
  tabUpdatedListener(22, { status: "loading" });
  const afterNavigationSnapshot = postedMessages.filter(message => message.type === "snapshot").at(-1);
  assertEqual(afterNavigationSnapshot.targets.length, 1, "tab navigation must clear only the stale tab target");
  assertEqual(afterNavigationSnapshot.targets[0].tabId, 23, "tab navigation must keep other tab targets");

  runtimeMessageListener(
    {
      type: "keywayMediaState",
      mediaId: "media-2",
      title: "Second Song",
      artist: "Artist",
      playing: true,
      muted: false,
      volume: 0.5,
      duration: 120,
      elapsedTime: 10,
    },
    {
      tab: {
        id: 23,
        windowId: 11,
        url: "https://example.test/second-video",
        title: "Second Example Video",
      },
      frameId: 0,
    },
    () => {}
  );
  await Promise.resolve();
  assertEqual(postedMessages.filter(message => message.type === "snapshot").at(-1).targets.length, 1, "second media state fixture");
  assert(typeof tabRemovedListener === "function", "service worker must register tab removed listener");
  tabRemovedListener(23);
  const afterRemovalSnapshot = postedMessages.filter(message => message.type === "snapshot").at(-1);
  assertEqual(afterRemovalSnapshot.targets.length, 0, "tab removal must clear browser targets");

  assert(typeof disconnectListener === "function", "service worker must register native disconnect listener");
  disconnectListener();
  assertEqual(clearedIntervals[0], "interval-1", "service worker must clear heartbeat on disconnect");
  assertEqual(timeouts[0].delay, 1000, "service worker reconnect delay");

  console.log("verify_chromium_extension_semantics=ok");
})().catch(error => {
  console.error(error);
  process.exit(1);
});

function assert(condition, message) {
  if (!condition) {
    console.error(`verify_chromium_extension_semantics: ${message}`);
    process.exit(1);
  }
}

function assertEqual(actual, expected, message) {
  assert(actual === expected, `${message}: expected ${expected}, got ${actual}`);
}
NODE

python3 - "$repo_root" <<'PY'
import pathlib
import sys

repo_root = pathlib.Path(sys.argv[1])
transport = (repo_root / "SonosHandoffMenuBar/SonosHandoffMenuBar/App/ChromiumBrowserExtensionTransport.swift").read_text()
models = (repo_root / "SonosHandoffMenuBar/SonosHandoffMenuBar/App/MediaRemoteModels.swift").read_text()
action_controller = (repo_root / "SonosHandoffMenuBar/SonosHandoffMenuBar/App/MediaTransportActionController.swift").read_text()
environment = (repo_root / "SonosHandoffMenuBar/SonosHandoffMenuBar/Support/AppEnvironment.swift").read_text()
settings = (repo_root / "SonosHandoffMenuBar/SonosHandoffMenuBar/Features/SettingsFeature.swift").read_text()
project = (repo_root / "SonosHandoffMenuBar/SonosHandoffMenuBar.xcodeproj/project.pbxproj").read_text()
installer = (repo_root / "scripts/install_chromium_native_host").read_text()
readme = (repo_root / "ChromiumExtension/README.md").read_text()
generator = (repo_root / "scripts/generate_xcode_projects.rb").read_text()
setup = (repo_root / "scripts/setup_chromium_extension").read_text()
helium_smoke = (repo_root / "scripts/smoke_helium_chromium_extension_transport").read_text()
regression_gate = (repo_root / "scripts/regression_gate").read_text()

def expect(text, needle, message):
    if needle not in text:
        raise SystemExit(f"verify_chromium_extension_semantics: {message}")

expect(
    transport,
    'static let extensionID = "gmdpkggbaohimgacbclndlfjghgcbael"',
    "Swift app must register manifests for the stable unpacked extension ID",
)
expect(
    transport,
    "static func browserFamily(target: MediaRemoteTarget) -> String?",
    "Chromium extension targets must expose their browser family for safe legacy fallback",
)
expect(
    transport,
    'appendingPathComponent("Contents/Helpers/keyway-chromium-native-host")',
    "Swift installer must point browser manifests at the bundled native host",
)
expect(
    models,
    "var isChromiumBrowserLike: Bool",
    "media targets must identify Chromium-like legacy browser targets separately from Safari and Firefox",
)
expect(
    action_controller,
    "preferredChromiumExtensionTarget(command: command, from: targets)",
    "automatic routing must prefer a single playing Chromium extension target",
)
expect(
    action_controller,
    "automaticRoutingTargets(command: command, from: targets)",
    "automatic routing must drop unsupported Chromium extension targets when legacy Chromium fallback exists",
)
expect(
    action_controller,
    "legacyChromiumFallbackTarget(for: target)",
    "Chromium extension command failures must attempt a safe legacy Chromium fallback",
)
expect(
    action_controller,
    '"chromium_extension_fallback"',
    "Chromium extension fallback must be traced distinctly",
)
expect(
    environment,
    "_ = try! chromiumNativeMessagingHostInstaller.install()",
    "app startup must install or repair Chromium native messaging manifests",
)
expect(
    settings,
    'Button("Repair Bridge")',
    "Settings must expose a manual Chromium bridge repair action",
)
expect(
    settings,
    'Button("Reveal Extension")',
    "Settings must expose the bundled Chromium extension folder",
)
expect(
    settings,
    'Button("Open Extensions")',
    "Settings must expose the browser extension manager",
)
expect(
    settings,
    'URL(string: "chrome://extensions")!',
    "Settings must open the Chromium extension manager directly",
)
expect(
    settings,
    'activateFileViewerSelecting([extensionURL])',
    "Settings must reveal the exact bundled extension directory",
)
expect(
    settings,
    'appendingPathComponent("ChromiumExtension", isDirectory: true)',
    "Settings must reveal the bundled Chromium extension resource",
)
expect(
    project,
    "Build Chromium Native Host",
    "Xcode build must bundle the Chromium native host",
)
expect(
    project,
    "Copy Chromium Extension",
    "Xcode build must bundle the Chromium extension",
)
expect(
    project,
    "$(TARGET_BUILD_DIR)/$(UNLOCALIZED_RESOURCES_FOLDER_PATH)/ChromiumExtension/manifest.json",
    "Xcode build must copy the extension manifest into app resources",
)
expect(
    generator,
    "def add_chromium_native_host_build_phase(target)",
    "project generator must preserve the Chromium native host build phase",
)
expect(
    generator,
    "def add_chromium_extension_copy_phase(target)",
    "project generator must preserve the Chromium extension copy phase",
)
expect(
    installer,
    'bundled_host_path="$app_dir/Contents/Helpers/keyway-chromium-native-host"',
    "CLI installer must prefer the installed app helper",
)
expect(
    setup,
    'scripts/install_chromium_native_host',
    "extension setup script must install or repair native host manifests",
)
expect(
    setup,
    'open -R "$extension_manifest"',
    "extension setup script must reveal the extension manifest",
)
expect(
    setup,
    'extensions_url="chrome://extensions"',
    "extension setup script must open the Chromium extension manager",
)
expect(
    helium_smoke,
    "KEYWAY_CHROMIUM_SMOKE_BROWSER_PATH",
    "Helium extension smoke must reuse the Chromium extension transport smoke against Helium",
)
expect(
    helium_smoke,
    'restart_existing="${KEYWAY_HELIUM_SMOKE_RESTART:-0}"',
    "Helium extension smoke must require explicit opt-in before restarting a running Helium app",
)
expect(
    helium_smoke,
    "Helium is already running; set KEYWAY_HELIUM_SMOKE_RESTART=1",
    "Helium extension smoke must fail clearly instead of reusing a live Helium profile",
)
expect(
    helium_smoke,
    "trap restore_helium EXIT",
    "Helium extension smoke must restore Helium after an isolated restart smoke",
)
expect(
    helium_smoke,
    "/Applications/Helium.app/Contents/MacOS/Helium",
    "Helium extension smoke must target the default Helium executable",
)
expect(
    regression_gate,
    "KEYWAY_HELIUM_CHROMIUM_EXTENSION_SMOKE",
    "regression gate must expose the Helium Chromium extension smoke",
)
expect(
    transport,
    "Library/Application Support/net.imput.helium/NativeMessagingHosts",
    "Swift installer must register Helium's Chromium native messaging host directory",
)
expect(
    installer,
    "Library/Application Support/net.imput.helium/NativeMessagingHosts",
    "CLI installer must register Helium's Chromium native messaging host directory",
)
for browser_name, host_dir in [
    ("Arc", "Library/Application Support/Arc/User Data/NativeMessagingHosts"),
    ("Chrome Canary", "Library/Application Support/Google/Chrome Canary/NativeMessagingHosts"),
    ("Vivaldi", "Library/Application Support/Vivaldi/NativeMessagingHosts"),
    ("Opera", "Library/Application Support/com.operasoftware.Opera/NativeMessagingHosts"),
    ("Opera GX", "Library/Application Support/com.operasoftware.OperaGX/NativeMessagingHosts"),
]:
    expect(
        transport,
        host_dir,
        f"Swift installer must register {browser_name}'s Chromium native messaging host directory",
    )
    expect(
        installer,
        host_dir,
        f"CLI installer must register {browser_name}'s Chromium native messaging host directory",
    )
expect(
    readme,
    "Arc, Google Chrome, Chrome Canary, Chromium, Brave channels, Microsoft Edge channels, Vivaldi, Opera, Opera GX, and Helium",
    "extension README must document the common Chromium-family native host registration scope",
)
expect(
    readme,
    'scripts/setup_chromium_extension "/Applications/Helium.app"',
    "extension README must document the Helium setup script path",
)
expect(
    readme,
    "scripts/smoke_helium_chromium_extension_transport",
    "extension README must document the Helium extension smoke",
)
expect(
    readme,
    "Keyway.app/Contents/Resources/ChromiumExtension",
    "extension README must document the bundled extension resource path",
)
PY
