#!/usr/bin/env bash
set -euo pipefail

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"

bash -n "$repo_root/scripts/setup_chromium_extension" >/dev/null
bash -n "$repo_root/scripts/smoke_helium_chromium_extension_transport" >/dev/null

python3 - "$repo_root" <<'PY'
import json
import pathlib
import sys

repo_root = pathlib.Path(sys.argv[1])
manifest = json.loads((repo_root / "ChromiumExtension/manifest.json").read_text())
service_worker = (repo_root / "ChromiumExtension/service_worker.js").read_text()
content_script = (repo_root / "ChromiumExtension/content_script.js").read_text()
document_authority = (repo_root / "ChromiumExtension/document_authority.js").read_text()
media_source_selection = (repo_root / "ChromiumExtension/media_source_selection.js").read_text()
declared_permissions = set(manifest.get("permissions", []))
chrome_api_to_permission = {
    "chrome.storage.": "storage",
    "chrome.alarms.": "alarms",
}
for api_prefix, required_permission in chrome_api_to_permission.items():
    if api_prefix in service_worker and required_permission not in declared_permissions:
        raise SystemExit(
            f"verify_chromium_extension_semantics: service_worker.js calls {api_prefix}* but "
            f"manifest.json permissions is missing '{required_permission}' -- this API is undefined "
            "at runtime without it, silently breaking the extension outside this repo's static checks"
        )

app_chromium_sources = [
    repo_root / "SonosHandoffMenuBar/SonosHandoffMenuBar/App/ChromiumBrowserExtensionTransport.swift",
    repo_root / "SonosHandoffMenuBar/SonosHandoffMenuBar/App/ChromiumNativeMessagingHostInstaller.swift",
    repo_root / "SonosHandoffMenuBar/SonosHandoffMenuBar/App/ChromiumBrowserExtensionMessages.swift",
    repo_root / "SonosHandoffMenuBar/SonosHandoffMenuBar/App/ChromiumBrowserExtensionController.swift",
    repo_root / "SonosHandoffMenuBar/SonosHandoffMenuBar/App/ChromiumBrowserExtensionIPC.swift",
]
transport = "\n".join(source.read_text() for source in app_chromium_sources)
source_store = (repo_root / "SonosHandoffMenuBar/SonosHandoffMenuBar/App/MediaSourceStore.swift").read_text()
models = (repo_root / "SonosHandoffMenuBar/SonosHandoffMenuBar/App/MediaRemoteModels.swift").read_text()
action_controller = (repo_root / "SonosHandoffMenuBar/SonosHandoffMenuBar/App/MediaTransportActionController.swift").read_text()
target_resolver = (repo_root / "SonosHandoffMenuBar/SonosHandoffMenuBar/App/MediaTransportTargetResolver.swift").read_text()
environment = (repo_root / "SonosHandoffMenuBar/SonosHandoffMenuBar/Support/AppEnvironment.swift").read_text()
sonos_app = (repo_root / "SonosHandoffMenuBar/SonosHandoffMenuBar/App/SonosHandoffApp.swift").read_text()
settings = (repo_root / "SonosHandoffMenuBar/SonosHandoffMenuBar/Features/SettingsFeature.swift").read_text()
project = (repo_root / "SonosHandoffMenuBar/SonosHandoffMenuBar.xcodeproj/project.pbxproj").read_text()
installer = (repo_root / "scripts/install_chromium_native_host").read_text()
readme = (repo_root / "ChromiumExtension/README.md").read_text()
bridge_adr = (repo_root / "docs/adr/0006-authenticate-chromium-app-host-ipc.md").read_text()
generator = (repo_root / "scripts/generate_xcode_projects.rb").read_text()
setup = (repo_root / "scripts/setup_chromium_extension").read_text()
helium_smoke = (repo_root / "scripts/smoke_helium_chromium_extension_transport").read_text()
chromium_smoke = (repo_root / "scripts/smoke_chromium_extension_transport").read_text()
worker_suspension_smoke = (repo_root / "scripts/smoke_chromium_worker_suspension").read_text()
regression_gate = (repo_root / "scripts/regression_gate").read_text()
native_host_sources = sorted(
    (repo_root / "packages/SonosHandoffCore/Sources/KeywayChromiumNativeHost").glob("*.swift")
)
native_host = "\n".join(source.read_text() for source in native_host_sources)
release_builder = (repo_root / "scripts/build_notarized_app").read_text()
bridge_contract = json.loads((repo_root / "ChromiumBridgeProtocol/contract.json").read_text())
generated_bridge_javascript = (repo_root / "ChromiumExtension/chromium_bridge_contract.generated.js").read_text()
generated_bridge_swift = (repo_root / "packages/SonosHandoffCore/Sources/KeywayChromiumBridgeIPC/KeywayChromiumBridgeContract.generated.swift").read_text()

def expect(text, needle, message):
    if needle not in text:
        raise SystemExit(f"verify_chromium_extension_semantics: {message}")

for source in app_chromium_sources + native_host_sources:
    if not source.exists():
        raise SystemExit(f"verify_chromium_extension_semantics: missing split Chromium source {source}")
for module_name in ("document_authority.js", "media_source_selection.js"):
    expect(
        project,
        f"ChromiumExtension/{module_name}",
        f"Xcode project must copy Chromium worker module {module_name}",
    )
    expect(
        generator,
        f"ChromiumExtension/{module_name}",
        f"project generator must copy Chromium worker module {module_name}",
    )
    expect(
        release_builder,
        module_name,
        f"notarized release extension ZIP must include {module_name}",
    )
expect(
    service_worker,
    'from "./document_authority.js"',
    "service worker must import focused document authority policy",
)
expect(
    service_worker,
    'from "./media_source_selection.js"',
    "service worker must import focused media selection policy",
)
expect(
    document_authority,
    "export class DocumentAuthorityRegistry",
    "document authority must remain an independently testable module",
)
expect(
    media_source_selection,
    "export function materializeSource",
    "media source materialization must remain an independently testable module",
)

expect(
    transport,
    "static let protocolVersion = KeywayChromiumBridgeContract.protocolVersion",
    "Swift Chromium transport must consume the canonical browser extension protocol version",
)
expect(
    transport,
    "static let extensionID = KeywayChromiumBridgeContract.extensionID",
    "Swift app must consume the canonical unpacked extension ID",
)
expect(
    transport,
    "case .focusResult:",
    "Swift Chromium transport must route authenticated browser focus results separately from media command results",
)
expect(
    transport,
    'type: "focusTarget"',
    "Swift Chromium transport must send explicit browser focus requests",
)
expect(
    transport,
    "func focus(\n        target: MediaRemoteTarget,",
    "Swift Chromium transport must expose a dedicated focus operation",
)
expect(
    transport,
    "return target.browserFamily?.lowercased()",
    "Chromium extension targets must expose typed browser family metadata without parsing transport IDs",
)
expect(
    transport,
    "static func legacyBrowserFamily(target: MediaRemoteTarget) -> String?",
    "Chromium transport must classify legacy browser rows so exact extension targets can hide weaker same-family rows",
)
expect(
    source_store,
    "visibleMediaRemoteTargets",
    "canonical media source store must filter visible MediaRemote browser rows when exact extension targets exist",
)
expect(
    source_store,
    "ChromiumBrowserExtensionTransport.shadowsLegacyTarget(extensionTarget: $0, legacyTarget: target)",
    "canonical media source store must apply extension-to-legacy duplicate detection",
)
expect(
    transport,
    "static func shadowsLegacyTarget(extensionTarget: MediaRemoteTarget, legacyTarget: MediaRemoteTarget) -> Bool",
    "Chromium transport must centralize extension-to-legacy duplicate detection",
)
expect(
    transport,
    "extensionFamily == legacyFamily",
    "Chromium transport must shadow weaker legacy browser rows by exact browser family",
)
for forbidden in [
    "extensionTitle == normalizedMediaTitle(legacyTarget.title)",
    "private static func normalizedMediaTitle(",
]:
    if forbidden in transport:
        raise SystemExit(
            "verify_chromium_extension_semantics: Chromium transport must not shadow different browser families by title-only media metadata"
        )
expect(
    transport,
    'appendingPathComponent("Contents/Helpers/keyway-chromium-native-host")',
    "Swift installer must point browser manifests at the bundled native host",
)
expect(
    release_builder,
    'EXTENSION_ZIP_PATH="$OUTPUT_DIR/Keyway-Chromium-Extension-$VERSION.zip"',
    "notarized releases must emit a versioned Chrome Web Store upload",
)
expect(
    release_builder,
    'cd "$ROOT_DIR/ChromiumExtension"',
    "Chrome Web Store uploads must place manifest.json at the ZIP root",
)
expect(
    release_builder,
    "chrome_extension_zip=%s",
    "release output must report the Chrome Web Store upload path",
)
expect(
    action_controller,
    "if result.backend == ChromiumBrowserExtensionTransport.backendName {",
    "Chromium command failures must show the browser bridge's actual result instead of claiming the browser was unreachable",
)
expect(
    models,
    "var isChromiumBrowserLike: Bool",
    "media targets must identify Chromium-like legacy browser targets separately from Safari and Firefox",
)
expect(
    models,
    "var routeSourceLabel: String?",
    "media target model must expose route provenance for chooser display",
)
expect(
    target_resolver,
    "let playingTargets = targets.filter(\\.isCurrentlyPlaying)",
    "automatic routing must evaluate global playing targets before browser-specific fallback",
)
expect(
    target_resolver,
    "ChromiumBrowserExtensionTransport.isTarget(playingTarget)",
    "automatic routing must identify Chromium extension targets on the single-playing path",
)
expect(
    target_resolver,
    "!ChromiumBrowserExtensionTransport.supports(command: command, target: playingTarget)",
    "automatic routing must reject unsupported single Chromium targets instead of routing them directly",
)
expect(
    target_resolver,
    "if playingTargets.count > 1 {",
    "automatic routing must treat mixed playing targets as ambiguous",
)
if "preferredChromiumExtensionTarget(" in target_resolver:
    raise SystemExit("verify_chromium_extension_semantics: automatic routing must not bypass mixed playing ambiguity through a Chromium-specific pre-check")
send_body = action_controller[
    action_controller.index("    private func send(\n        command: MediaRemoteTransportCommand,"):
    action_controller.index("    private func fallbackMediaRemote(")
]
desktop_block = send_body[
    send_body.index("if let result = desktopTransport.submit(command: command, target: target) {"):
    send_body.index("if let sent = chromiumBrowserExtensionController.submit")
]
for forbidden in [
    "shouldFallbackFromUnsupportedDesktopResult(",
    "sendSpotifyWebAPI(",
    "sendMediaRemote(",
    "desktop_transport_fallback",
    "spotify_webapi_fallback",
]:
    if forbidden in desktop_block:
        raise SystemExit(
            f"verify_chromium_extension_semantics: desktop transport results must be terminal before Chromium routing: {forbidden}"
        )
for forbidden in [
    "shouldFallbackFromUnsupportedDesktopResult(",
    "sendSpotifyWebAPI(",
    "spotifyPlaybackCommand(",
    "spotifyWebAPIResult(",
    "spotifyWebAPIBackend",
    "spotify_webapi_fallback",
    "legacyChromiumFallbackTarget",
    '"chromium_extension_fallback"',
]:
    if forbidden in action_controller:
        raise SystemExit(
            f"verify_chromium_extension_semantics: Chromium and desktop routing must not retain obsolete fallback hooks: {forbidden}"
        )
overlay_view = repo_root.joinpath("SonosHandoffMenuBar/SonosHandoffMenuBar/App/MediaTargetOverlayView.swift").read_text()
expect(
    overlay_view,
    "target.routeSourceLabel",
    "chooser rows must display route provenance for browser targets",
)
expect(
    overlay_view,
    ".focusable(false)",
    "chooser row buttons must not draw the system blue focus ring; overlay selection is model-owned",
)
expect(
    service_worker,
    "const protocolVersion = keywayChromiumBridgeProtocolVersion",
    "Chromium extension service worker must consume the canonical protocol version",
)
expect(
    generated_bridge_javascript,
    f"keywayChromiumBridgeProtocolVersion = {bridge_contract['protocolVersion']}",
    "generated JavaScript contract must match the canonical protocol version",
)
expect(
    generated_bridge_swift,
    f"protocolVersion = {bridge_contract['protocolVersion']}",
    "generated Swift contract must match the canonical protocol version",
)
expect(
    service_worker,
    "chrome.storage.local.get([profileGuidStorageKey]",
    "Chromium extension service worker must load profile GUIDs from local browser-profile storage",
)
