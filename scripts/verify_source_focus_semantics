#!/usr/bin/env bash
set -euo pipefail

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
workdir="$(mktemp -d)"
trap 'rm -rf "$workdir"' EXIT

cp \
  "$repo_root/SonosHandoffMenuBar/SonosHandoffMenuBar/App/SourceFocusActionController.swift" \
  "$repo_root/SonosHandoffMenuBar/SonosHandoffMenuBar/App/MediaTargetOverlayKeyboardAction.swift" \
  "$workdir/"

cat >"$workdir/Stubs.swift" <<'SWIFT'
import AppKit
import Foundation

enum AppIdentity {
    static let loggerSubsystem = "com.fpieringer.Keyway.tests"
}

enum MediaAudioVolumeDirection: Equatable, Sendable {
    case down
    case up
}

struct MediaRemoteTarget: Equatable, Identifiable {
    let id: String
    let bundleIdentifier: String
    let parentBundleIdentifier: String
    let displayName: String
    let pid: Int
    let playbackRate: String
    let mediaType: String?

    var appName: String {
        displayName.isEmpty ? bundleIdentifier : displayName
    }

    var isCurrentlyPlaying: Bool {
        playbackRate != "0"
    }
}

enum ChromiumBrowserExtensionTransport {
    static let backendName = "chromium_extension"
    static let mediaType = "chromium_extension"
    static let targetIDPrefix = "chromium-extension:"

    static func isTarget(_ target: MediaRemoteTarget) -> Bool {
        target.mediaType == mediaType || target.id.hasPrefix(targetIDPrefix)
    }
}

struct ChromiumBrowserExtensionTargetAddress {
    let browserKey: String
    let windowID: Int
    let tabID: Int
    let frameID: Int
    let mediaID: String

    init(targetID: String) {
        let parts = targetID.split(separator: ":", omittingEmptySubsequences: false).map(String.init)
        precondition(parts.count >= 6 && parts[0] == "chromium-extension")
        browserKey = parts[1]
        windowID = Int(parts[2])!
        tabID = Int(parts[3])!
        frameID = Int(parts[4])!
        mediaID = parts[5...].joined(separator: ":")
    }
}

@MainActor
final class ChromiumBrowserExtensionController {
    var focusReturn: Bool?
    var nextFocusResult: SourceFocusResult?
    var focusCalls: [String] = []

    func focus(
        target: MediaRemoteTarget,
        onResult: @escaping (SourceFocusResult) -> Void
    ) -> Bool? {
        guard ChromiumBrowserExtensionTransport.isTarget(target) else {
            return nil
        }
        focusCalls.append(target.id)
        if let nextFocusResult {
            onResult(nextFocusResult)
        }
        return focusReturn
    }
}

@MainActor
final class MediaRemoteController {
    var refreshCount = 0

    func refreshSnapshot() {
        refreshCount += 1
    }
}

@MainActor
final class StatusHUD {
    static let shared = StatusHUD()
    var finishes: [(title: String, message: String)] = []

    func finish(title: String, message: String, dismissAfter: Double? = nil) {
        finishes.append((title, message))
    }
}

final class ShortcutRuntimeStatus {
    static let shared = ShortcutRuntimeStatus()
    var events: [(String, [String: Any])] = []

    func recordMediaTransportEvent(_ event: String, fields: [String: Any]) {
        events.append((event, fields))
    }
}
SWIFT

cat >"$workdir/Semantics.swift" <<'SWIFT'
import Foundation

@main
struct Semantics {
    @MainActor
    static func main() {
        expectEqual(
            MediaTargetOverlayKeyboardInterpreter.action(
                keyCode: 36,
                characters: "\r",
                commandDown: false,
                expanded: false,
                targetCount: 4
            ),
            .routeSelected,
            "Enter must route the selected target"
        )
        expectEqual(
            MediaTargetOverlayKeyboardInterpreter.action(
                keyCode: 36,
                characters: "\r",
                commandDown: true,
                expanded: false,
                targetCount: 4
            ),
            .focusSelected,
            "Command+Enter must focus the selected target"
        )
        expectEqual(
            MediaTargetOverlayKeyboardInterpreter.action(
                keyCode: 126,
                characters: "",
                commandDown: true,
                expanded: true,
                targetCount: 4
            ),
            .adjustExpandedVolume(.up),
            "Command+Up must remain expanded volume control while controls are visible"
        )
        expectEqual(
            MediaTargetOverlayKeyboardInterpreter.action(
                keyCode: 18,
                characters: "1",
                commandDown: false,
                expanded: false,
                targetCount: 0
            ),
            .none,
            "Quick route must not select a missing row"
        )

        let spotify = appTarget(
            id: "spotify-row",
            bundleIdentifier: "com.spotify.client",
            displayName: "Spotify",
            pid: 101
        )
        let heliumApp = appTarget(
            id: "helium-app-row",
            bundleIdentifier: "net.imput.helium",
            displayName: "Helium",
            pid: 202
        )
        let chromeTab = browserTarget(
            browserRuntime: "chrome-runtime",
            windowID: 11,
            tabID: 22,
            mediaID: "media-1",
            displayName: "Chrome - Song A"
        )
        let heliumTab = browserTarget(
            browserRuntime: "helium-runtime",
            windowID: 33,
            tabID: 44,
            mediaID: "media-2",
            displayName: "Helium - Song B"
        )

        expectEqual(
            SourceFocusDestination(target: spotify),
            .application(pid: 101, bundleIdentifiers: ["com.spotify.client"]),
            "Spotify app focus must preserve selected app pid and bundle identifier"
        )
        expectEqual(
            SourceFocusDestination(target: heliumApp),
            .application(pid: 202, bundleIdentifiers: ["net.imput.helium"]),
            "Helium app focus must preserve selected app pid and bundle identifier"
        )
        expectEqual(
            SourceFocusDestination(target: chromeTab),
            .chromiumExtension(targetID: chromeTab.id, windowID: 11, tabID: 22),
            "Chrome tab focus must preserve selected browser runtime window and tab"
        )
        expectEqual(
            SourceFocusDestination(target: heliumTab),
            .chromiumExtension(targetID: heliumTab.id, windowID: 33, tabID: 44),
            "Helium tab focus must preserve selected browser runtime window and tab"
        )

        let codableResult = SourceFocusResult(
            requestID: "focus-1",
            targetID: chromeTab.id,
            ok: false,
            message: "stale",
            backend: ChromiumBrowserExtensionTransport.backendName,
            failureReason: .browserTargetUnavailable
        )
        let decoded = try! JSONDecoder().decode(
            SourceFocusResult.self,
            from: JSONEncoder().encode(codableResult)
        )
        expectEqual(decoded, codableResult, "Source focus result must be a separate codable result model")

        let mediaRemote = MediaRemoteController()
        let chromium = ChromiumBrowserExtensionController()
        let memory = MediaTargetSelectionMemory()
        let controller = SourceFocusActionController(
            mediaRemoteController: mediaRemote,
            chromiumBrowserExtensionController: chromium,
            targetSelectionMemory: memory
        )

        ShortcutRuntimeStatus.shared.events = []
        StatusHUD.shared.finishes = []
        chromium.focusReturn = true
        chromium.nextFocusResult = SourceFocusResult(
            requestID: "focus-2",
            targetID: chromeTab.id,
            ok: true,
            message: "focused",
            backend: ChromiumBrowserExtensionTransport.backendName
        )
        controller.focus(target: chromeTab)
        expectEqual(chromium.focusCalls, [chromeTab.id], "Focus controller must delegate Chromium targets to Chromium focus")
        expectEqual(memory.recentTargetID, chromeTab.id, "Focus controller must remember the selected target")
        expectEqual(
            ShortcutRuntimeStatus.shared.events.map(\.0),
            ["source_focus_requested", "source_focus_succeeded"],
            "Successful focus must emit exactly one terminal success trace"
        )
        expectEqual(mediaRemote.refreshCount, 0, "Successful focus must not refresh stale targets")
        expectEqual(StatusHUD.shared.finishes.count, 0, "Successful focus must not show a failure HUD")

        ShortcutRuntimeStatus.shared.events = []
        chromium.focusCalls = []
        chromium.nextFocusResult = SourceFocusResult(
            requestID: "focus-3",
            targetID: heliumTab.id,
            ok: false,
            message: "tab unavailable",
            backend: ChromiumBrowserExtensionTransport.backendName,
            failureReason: .browserTargetUnavailable
        )
        controller.focus(target: heliumTab)
        expectEqual(chromium.focusCalls, [heliumTab.id], "Selected Chromium row must win over competing browser tabs")
        expectEqual(
            ShortcutRuntimeStatus.shared.events.map(\.0),
            ["source_focus_requested", "source_focus_failed"],
            "Failed browser focus must emit exactly one terminal failure trace"
        )
        expectEqual(mediaRemote.refreshCount, 1, "Failed browser focus must refresh stale targets")
        expectEqual(StatusHUD.shared.finishes.count, 1, "Failed browser focus must fail visibly")

        ShortcutRuntimeStatus.shared.events = []
        chromium.focusReturn = nil
        let missingApp = appTarget(
            id: "missing-app-row",
            bundleIdentifier: "com.fpieringer.keyway.missing-source-focus-test",
            displayName: "Missing App",
            pid: 0
        )
        controller.focus(target: missingApp)
        expectEqual(
            ShortcutRuntimeStatus.shared.events.map(\.0),
            ["source_focus_requested", "source_focus_failed"],
            "Missing app focus must emit exactly one terminal failure trace"
        )
        expectEqual(mediaRemote.refreshCount, 2, "Missing app focus must refresh stale targets")
        expectEqual(StatusHUD.shared.finishes.count, 2, "Missing app focus must fail visibly")

        print("activation_events_from_media_key=0")
        print("verify_source_focus_semantics=ok")
    }

    private static func appTarget(
        id: String,
        bundleIdentifier: String,
        displayName: String,
        pid: Int
    ) -> MediaRemoteTarget {
        MediaRemoteTarget(
            id: id,
            bundleIdentifier: bundleIdentifier,
            parentBundleIdentifier: "",
            displayName: displayName,
            pid: pid,
            playbackRate: "1",
            mediaType: nil
        )
    }

    private static func browserTarget(
        browserRuntime: String,
        windowID: Int,
        tabID: Int,
        mediaID: String,
        displayName: String
    ) -> MediaRemoteTarget {
        MediaRemoteTarget(
            id: "chromium-extension:\(browserRuntime):\(windowID):\(tabID):0:\(mediaID)",
            bundleIdentifier: "com.fpieringer.keyway.chromium",
            parentBundleIdentifier: "",
            displayName: displayName,
            pid: 0,
            playbackRate: "1",
            mediaType: ChromiumBrowserExtensionTransport.mediaType
        )
    }

    private static func expectEqual<T: Equatable>(_ actual: T, _ expected: T, _ message: String) {
        guard actual == expected else {
            fail("\(message): expected \(expected), got \(actual)")
        }
    }

    private static func fail(_ message: String) -> Never {
        FileHandle.standardError.write(Data("verify_source_focus_semantics: \(message)\n".utf8))
        exit(1)
    }
}
SWIFT

swiftc \
  "$workdir/Stubs.swift" \
  "$workdir/SourceFocusActionController.swift" \
  "$workdir/MediaTargetOverlayKeyboardAction.swift" \
  "$workdir/Semantics.swift" \
  -o "$workdir/verify_source_focus_semantics"

"$workdir/verify_source_focus_semantics"

python3 - "$repo_root" <<'PY'
import pathlib
import sys

repo_root = pathlib.Path(sys.argv[1])
source_focus = (repo_root / "SonosHandoffMenuBar/SonosHandoffMenuBar/App/SourceFocusActionController.swift").read_text()
keyboard = (repo_root / "SonosHandoffMenuBar/SonosHandoffMenuBar/App/MediaTargetOverlayKeyboardAction.swift").read_text()
overlay = (repo_root / "SonosHandoffMenuBar/SonosHandoffMenuBar/App/MediaTargetOverlayController.swift").read_text()
transport = (repo_root / "SonosHandoffMenuBar/SonosHandoffMenuBar/App/MediaTransportActionController.swift").read_text()
status_item = (repo_root / "SonosHandoffMenuBar/SonosHandoffMenuBar/App/KeywayStatusItemController.swift").read_text()

def fail(message):
    raise SystemExit(f"verify_source_focus_semantics: {message}")

def expect(text, needle, message):
    if needle not in text:
        fail(message)

def function_body(text, signature):
    start = text.find(signature)
    if start < 0:
        fail(f"missing {signature}")
    brace = text.find("{", start)
    if brace < 0:
        fail(f"missing body for {signature}")
    depth = 0
    for offset in range(brace, len(text)):
        char = text[offset]
        if char == "{":
            depth += 1
        elif char == "}":
            depth -= 1
            if depth == 0:
                return text[brace + 1:offset]
    fail(f"unterminated body for {signature}")

expect(source_focus, "struct SourceFocusResult: Codable, Equatable", "source focus must have a separate result model")
expect(source_focus, "enum SourceFocusFailureReason", "source focus must have focus-specific failure reasons")
for event in ("source_focus_requested", "source_focus_succeeded", "source_focus_failed"):
    expect(source_focus, event, f"source focus must trace {event}")
expect(source_focus, "NSRunningApplication(processIdentifier:", "app focus must prefer pid activation")
expect(source_focus, "NSRunningApplication.runningApplications(withBundleIdentifier:", "app focus must fall back to bundle identifier activation")
expect(source_focus, "SourceFocusDestination", "source focus must expose a testable destination model")

for forbidden in (
    "NSWorkspace.shared.open",
    "NSWorkspace.shared.openApplication",
    "openApplication(",
    "MediaRemoteCommandResultEvent",
    "mediaRemoteController.submit",
    "desktopTransport.submit",
):
    if forbidden in source_focus:
        fail(f"source focus module must not reopen targets or own media command dispatch: {forbidden}")

expect(keyboard, "case focusSelected", "chooser keyboard model must expose a focus action")
expect(keyboard, "return commandDown ? .focusSelected : .routeSelected", "Command+Enter must be separated from Enter")
expect(overlay, "MediaTargetOverlayKeyboardInterpreter.action(", "overlay must delegate keyboard semantics to the dedicated interpreter")
focus_case = overlay[overlay.index("case .focusSelected:"):overlay.index("case .close:", overlay.index("case .focusSelected:"))]
if "focus(target)" not in focus_case or "choose(" in focus_case:
    fail("Command+Enter must focus the selected target without routing a media command")
route_case = overlay[overlay.index("case .routeSelected:"):overlay.index("case .focusSelected:", overlay.index("case .routeSelected:"))]
if "choose(target)" not in route_case or "focus(" in route_case:
    fail("Enter must route the selected target without source activation")

route_from_media_key = function_body(transport, "func routeFromMediaKey(")
if "sourceFocus" in route_from_media_key or "focus(target:" in route_from_media_key:
    fail("media-key entry point must not activate apps or tabs")
route_body = function_body(transport, "private func route(\n        command: MediaRemoteTransportCommand,")
if "sourceFocus" in route_body or "focus(target:" in route_body:
    fail("media command routing must not own source activation")
show_chooser_overlay = function_body(transport, "private func showChooserOverlay(")
expect(show_chooser_overlay, "onFocus:", "source focus must only be reachable from the visible chooser")
expect(show_chooser_overlay, "sourceFocusActionController.focus(target: target)", "chooser focus must delegate to the source-focus module")

for forbidden in ("NSRunningApplication", "NSWorkspace.shared.open", "chrome.tabs.update", "chrome.windows.update"):
    if forbidden in transport:
        fail(f"media transport must not own activation: {forbidden}")

for relative_path in (
    "SonosHandoffMenuBar/SonosHandoffMenuBar/App/ShortcutEventParser.swift",
    "SonosHandoffMenuBar/SonosHandoffMenuBar/App/ShortcutEventTap.swift",
    "SonosHandoffMenuBar/SonosHandoffMenuBar/App/VolumeHotkeyController.swift",
    "SonosHandoffMenuBar/SonosHandoffMenuBar/App/MediaCommandCenterInterceptor.swift",
):
    text = (repo_root / relative_path).read_text()
    for forbidden in ("SourceFocusActionController", "sourceFocus", "focusSelected"):
        if forbidden in text:
            fail(f"media-key and command-center layers must not reference source focus: {relative_path}")

for forbidden in (
    "startStatusItemModifierMonitor",
    "handleModifierMonitorEvent",
    "showCenteredChooserFromModifierClick",
    "lastModifierChooserClickTime",
):
    if forbidden in status_item:
        fail("status item must not keep the hidden modifier-click chooser trigger")

swift_sources_with_keyboard_interpreter = [
    path
    for path in (repo_root / "SonosHandoffMenuBar/SonosHandoffMenuBar").rglob("*.swift")
    if "MediaTargetOverlayKeyboardInterpreter.action" in path.read_text()
]
if swift_sources_with_keyboard_interpreter != [
    repo_root / "SonosHandoffMenuBar/SonosHandoffMenuBar/App/MediaTargetOverlayController.swift"
]:
    fail("Command+Enter focus semantics must only be interpreted inside the visible chooser")

print("verify_source_focus_static_semantics=ok")
PY
