#!/usr/bin/env bash
set -euo pipefail

helium_path="${KEYWAY_HELIUM_BROWSER_PATH:-/Applications/Helium.app/Contents/MacOS/Helium}"
restart_existing="${KEYWAY_HELIUM_SMOKE_RESTART:-0}"
helium_was_running=0

restore_helium() {
  if [[ "$helium_was_running" == "1" ]]; then
    open -g -a Helium >/dev/null 2>&1
  fi
}

if [[ ! -x "$helium_path" ]]; then
  printf 'smoke_helium_chromium_extension_transport: Helium executable is missing at %s\n' "$helium_path" >&2
  exit 1
fi

if pgrep -x Helium >/dev/null; then
  if [[ "$restart_existing" != "1" ]]; then
    printf 'smoke_helium_chromium_extension_transport: Helium is already running; set KEYWAY_HELIUM_SMOKE_RESTART=1 to restart it for an isolated extension smoke\n' >&2
    exit 1
  fi
  helium_was_running=1
  trap restore_helium EXIT
  osascript -e 'tell application id "net.imput.helium" to quit' >/dev/null
  for _ in {1..100}; do
    pgrep -x Helium >/dev/null || break
    sleep 0.05
  done
  if pgrep -x Helium >/dev/null; then
    printf 'smoke_helium_chromium_extension_transport: Helium did not quit before isolated smoke\n' >&2
    exit 1
  fi
fi

KEYWAY_CHROMIUM_SMOKE_BROWSER_PATH="$helium_path" "$(dirname "${BASH_SOURCE[0]}")/smoke_chromium_extension_transport"
