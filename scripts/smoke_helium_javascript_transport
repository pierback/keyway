#!/usr/bin/env bash
set -euo pipefail

iterations="${KEYWAY_HELIUM_JAVASCRIPT_ITERATIONS:-50}"
settle_seconds="${KEYWAY_HELIUM_JAVASCRIPT_SETTLE_SECONDS:-0.35}"
dry_run="${KEYWAY_HELIUM_JAVASCRIPT_DRY_RUN:-0}"
workdir="$(mktemp -d)"
server_pid=""
smoke_window_id=""

cleanup() {
  if [[ -n "$smoke_window_id" ]]; then
    osascript - "$smoke_window_id" <<'APPLESCRIPT' >/dev/null 2>&1 || true
on run argv
    set smokeWindowID to item 1 of argv
    tell application id "net.imput.helium"
        close (first window whose id is smokeWindowID)
    end tell
end run
APPLESCRIPT
  fi
  if [[ -n "$server_pid" ]]; then
    kill "$server_pid" >/dev/null 2>&1 || true
  fi
  rm -rf "$workdir"
}
trap cleanup EXIT

fail() {
  printf 'smoke_helium_javascript_transport: %s\n' "$1" >&2
  exit 1
}

case "$iterations" in
  ''|*[!0-9]*)
    fail "KEYWAY_HELIUM_JAVASCRIPT_ITERATIONS must be a positive integer"
    ;;
esac

if (( iterations < 1 )); then
  fail "KEYWAY_HELIUM_JAVASCRIPT_ITERATIONS must be at least 1"
fi

if [[ "$dry_run" == "1" ]]; then
  printf 'smoke_helium_javascript_transport_dry_run=ok\n'
  exit 0
fi

if ! pgrep -x Helium >/dev/null; then
  open -g -a Helium
fi

for _ in {1..100}; do
  if pgrep -x Helium >/dev/null; then
    break
  fi
  sleep 0.05
done

if ! pgrep -x Helium >/dev/null; then
  fail "Helium must be running before JavaScript transport smoke"
fi

command -v ffmpeg >/dev/null || fail "ffmpeg must be installed for the deterministic Helium video smoke"

cat >"$workdir/server.py" <<'PY'
import http.server
import pathlib
import socketserver
import subprocess
import sys

root = pathlib.Path(sys.argv[1])
port_file = pathlib.Path(sys.argv[2])

subprocess.run(
    [
        "ffmpeg",
        "-y",
        "-f",
        "lavfi",
        "-i",
        "testsrc2=size=320x180:rate=30",
        "-t",
        "60",
        "-pix_fmt",
        "yuv420p",
        "-an",
        "-movflags",
        "+faststart",
        str(root / "smoke.mp4"),
    ],
    check=True,
    stdout=subprocess.DEVNULL,
    stderr=subprocess.DEVNULL,
)

(root / "media.html").write_text("""<!doctype html>
<html>
<head><meta charset="utf-8"><title>Keyway Helium Smoke Media</title></head>
<body>
<video id="media" controls autoplay loop muted playsinline preload="auto" src="/smoke.mp4"></video>
</body>
</html>
""", encoding="utf-8")

(root / "empty.html").write_text("""<!doctype html>
<html>
<head><meta charset="utf-8"><title>Keyway Helium Smoke Empty</title></head>
<body></body>
</html>
""", encoding="utf-8")

class QuietHandler(http.server.SimpleHTTPRequestHandler):
    def log_message(self, format, *args):
        return

socketserver.TCPServer.allow_reuse_address = True
with socketserver.TCPServer(("127.0.0.1", 0), QuietHandler) as httpd:
    pathlib.os.chdir(root)
    port_file.write_text(str(httpd.server_address[1]), encoding="utf-8")
    httpd.serve_forever()
PY

port_file="$workdir/port"
python3 "$workdir/server.py" "$workdir" "$port_file" &
server_pid="$!"

for _ in {1..100}; do
  if [[ -s "$port_file" ]]; then
    break
  fi
  sleep 0.05
done

if [[ ! -s "$port_file" ]]; then
  fail "local Helium smoke server did not start"
fi

port="$(cat "$port_file")"
media_url="http://127.0.0.1:$port/media.html"
empty_url="http://127.0.0.1:$port/empty.html"

smoke_window_id="$(
  osascript - "$media_url" <<'APPLESCRIPT'
on run argv
    set smokeURL to item 1 of argv
    tell application id "net.imput.helium"
        set smokeWindow to make new window
        set URL of active tab of smokeWindow to smokeURL
        return id of smokeWindow
    end tell
end run
APPLESCRIPT
)"

helium_state() {
  osascript - "$smoke_window_id" <<'APPLESCRIPT'
on run argv
    set smokeWindowID to item 1 of argv
    tell application id "net.imput.helium"
        set smokeWindow to first window whose id is smokeWindowID
        return execute active tab of smokeWindow javascript "(() => { const isReady = element => !element.ended && element.readyState > 0 && (Number.isFinite(element.duration) ? element.duration > 0 : true); const isPlaying = element => !element.paused && !element.ended; const collectDeepMedia = () => { const media = []; const seen = new Set(); const roots = [document]; for (let index = 0; index < roots.length; index += 1) { const root = roots[index]; root.querySelectorAll('video,audio').forEach(element => { if (!seen.has(element)) { seen.add(element); media.push(element); } }); root.querySelectorAll('*').forEach(element => { if (element.shadowRoot) roots.push(element.shadowRoot); }); root.querySelectorAll('iframe,frame').forEach(frame => { const source = frame.getAttribute('src') || ''; const sameOrigin = source === '' || source.startsWith('about:') || new URL(frame.src || source, location.href).origin === location.origin; const sandbox = frame.getAttribute('sandbox'); const sandboxAllowsSameOrigin = sandbox === null || sandbox.split(/\\s+/).includes('allow-same-origin'); if (sameOrigin && sandboxAllowsSameOrigin && frame.contentDocument) roots.push(frame.contentDocument); }); } return media; }; const media = collectDeepMedia().filter(isReady); const playing = media.filter(isPlaying); return JSON.stringify({ok: true, mediaCount: media.length, playingCount: playing.length, title: document.title, href: location.href}); })()"
    end tell
end run
APPLESCRIPT
}

helium_toggle() {
  osascript - "$smoke_window_id" <<'APPLESCRIPT'
on run argv
    set smokeWindowID to item 1 of argv
    tell application id "net.imput.helium"
        set smokeWindow to first window whose id is smokeWindowID
        return execute active tab of smokeWindow javascript "(() => { const isReady = element => !element.ended && element.readyState > 0 && (Number.isFinite(element.duration) ? element.duration > 0 : true); const isPlaying = element => !element.paused && !element.ended; const collectDeepMedia = () => { const media = []; const seen = new Set(); const roots = [document]; for (let index = 0; index < roots.length; index += 1) { const root = roots[index]; root.querySelectorAll('video,audio').forEach(element => { if (!seen.has(element)) { seen.add(element); media.push(element); } }); root.querySelectorAll('*').forEach(element => { if (element.shadowRoot) roots.push(element.shadowRoot); }); root.querySelectorAll('iframe,frame').forEach(frame => { const source = frame.getAttribute('src') || ''; const sameOrigin = source === '' || source.startsWith('about:') || new URL(frame.src || source, location.href).origin === location.origin; const sandbox = frame.getAttribute('sandbox'); const sandboxAllowsSameOrigin = sandbox === null || sandbox.split(/\\s+/).includes('allow-same-origin'); if (sameOrigin && sandboxAllowsSameOrigin && frame.contentDocument) roots.push(frame.contentDocument); }); } return media; }; const visibleArea = element => { const rect = element.getBoundingClientRect(); const view = element.ownerDocument.defaultView || window; const width = Math.max(0, Math.min(rect.right, view.innerWidth) - Math.max(rect.left, 0)); const height = Math.max(0, Math.min(rect.bottom, view.innerHeight) - Math.max(rect.top, 0)); return width * height; }; const media = collectDeepMedia().filter(isReady); const playing = media.filter(isPlaying); if (playing.length > 0) { playing.forEach(element => element.pause()); return JSON.stringify({ok: true, action: 'pause', affected: playing.length}); } media.sort((left, right) => visibleArea(right) - visibleArea(left) || ((right.videoWidth || 1) * (right.videoHeight || 1)) - ((left.videoWidth || 1) * (left.videoHeight || 1)) || right.duration - left.duration); const target = media[0]; if (!target) return JSON.stringify({ok: false, reason: 'no_media'}); target.play(); return JSON.stringify({ok: true, action: 'play', affected: 1}); })()"
    end tell
end run
APPLESCRIPT
}

navigate_smoke_window() {
  osascript - "$smoke_window_id" "$1" <<'APPLESCRIPT' >/dev/null
on run argv
    set smokeWindowID to item 1 of argv
    set smokeURL to item 2 of argv
    tell application id "net.imput.helium"
        set smokeWindow to first window whose id is smokeWindowID
        set URL of active tab of smokeWindow to smokeURL
    end tell
end run
APPLESCRIPT
}

json_field() {
  python3 - "$1" "$2" <<'PY'
import json
import sys

payload = json.loads(sys.argv[1])
value = payload.get(sys.argv[2])
print("" if value is None else value)
PY
}

wait_for_media_page() {
  for _ in {1..200}; do
    state="$(helium_state)"
    if [[ "$(json_field "$state" ok)" == "True" ]] \
      && [[ "$(json_field "$state" title)" == "Keyway Helium Smoke Media" ]] \
      && (( "$(json_field "$state" mediaCount)" == 1 )); then
      return 0
    fi
    sleep 0.05
  done
  fail "Helium smoke media page did not expose exactly one ready media element: $state"
}

wait_for_empty_page() {
  for _ in {1..200}; do
    state="$(helium_state)"
    if [[ "$(json_field "$state" ok)" == "True" ]] \
      && [[ "$(json_field "$state" title)" == "Keyway Helium Smoke Empty" ]] \
      && (( "$(json_field "$state" mediaCount)" == 0 )); then
      return 0
    fi
    sleep 0.05
  done
  fail "Helium smoke empty page still exposed media: $state"
}

wait_for_media_page

success=0
failure=0
elapsed_values=()

for iteration in $(seq 1 "$iterations"); do
  before="$(helium_state)"
  before_playing="$(json_field "$before" playingCount)"
  started_ms="$(python3 - <<'PY'
import time
print(int(time.monotonic() * 1000))
PY
)"
  result="$(helium_toggle)"
  finished_ms="$(python3 - <<'PY'
import time
print(int(time.monotonic() * 1000))
PY
)"
  elapsed_values+=("$((finished_ms - started_ms))")

  if [[ "$(json_field "$result" ok)" != "True" ]]; then
    printf 'smoke_helium_javascript_transport_failure iteration=%s result=%s\n' "$iteration" "$result" >&2
    failure=$((failure + 1))
    continue
  fi

  sleep "$settle_seconds"
  after="$(helium_state)"
  after_playing="$(json_field "$after" playingCount)"

  if (( before_playing > 0 )); then
    if (( after_playing == 0 )); then
      success=$((success + 1))
    else
      printf 'smoke_helium_javascript_transport_failure iteration=%s expected_pause before=%s after=%s result=%s\n' "$iteration" "$before" "$after" "$result" >&2
      failure=$((failure + 1))
    fi
  else
    if (( after_playing > 0 )); then
      success=$((success + 1))
    else
      printf 'smoke_helium_javascript_transport_failure iteration=%s expected_play before=%s after=%s result=%s\n' "$iteration" "$before" "$after" "$result" >&2
      failure=$((failure + 1))
    fi
  fi
done

navigate_smoke_window "$empty_url"
wait_for_empty_page

p95="$(
  printf '%s\n' "${elapsed_values[@]}" \
    | sort -n \
    | awk -v count="$iterations" '
      BEGIN {
        p95_index = int(count * 0.95)
        if (p95_index < count * 0.95) {
          p95_index += 1
        }
        if (p95_index < 1) {
          p95_index = 1
        }
      }
      { values[NR] = $1 }
      END { print values[p95_index] }
    '
)"

printf 'helium_javascript_smoke_total=%s\n' "$iterations"
printf 'helium_javascript_smoke_success=%s\n' "$success"
printf 'helium_javascript_smoke_failure=%s\n' "$failure"
printf 'helium_javascript_smoke_stale_targets_after_empty_page=0\n'
printf 'helium_javascript_smoke_p95_ms=%s\n' "$p95"

if (( failure > 0 )); then
  exit 1
fi
