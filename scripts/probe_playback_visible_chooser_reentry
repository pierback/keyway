#!/usr/bin/env bash
set -euo pipefail

status_file="${KEYWAY_STATUS_FILE:-$HOME/Library/Application Support/keyway/shortcut-runtime-status.json}"
timeout_seconds="${KEYWAY_PROBE_TIMEOUT_SECONDS:-5}"
settle_seconds="${KEYWAY_PROBE_VISIBLE_REENTRY_SETTLE_SECONDS:-0.45}"

fail() {
  printf 'probe_playback_visible_chooser_reentry: %s\n' "$1" >&2
  exit 1
}

read_trace_sequence() {
  python3 - "$status_file" <<'PY'
import json
import pathlib
import sys

payload = json.loads(pathlib.Path(sys.argv[1]).read_text())
print(int(payload.get("mediaTransportTraceSequence", 0)))
PY
}

read_trace_json() {
  python3 - "$status_file" <<'PY'
import json
import pathlib
import sys

payload = json.loads(pathlib.Path(sys.argv[1]).read_text())
print(json.dumps(payload.get("mediaTransportTrace", []), separators=(",", ":")))
PY
}

post_physical_play_pause() {
  swift - <<'SWIFT'
import AppKit
import ApplicationServices

let playPauseKeyCode = 16
let keyDownState = 0x0A
let keyUpState = 0x0B
let mediaKeySubtype: Int16 = 8

func postMediaKey(state: Int) {
    let data1 = (playPauseKeyCode << 16) | (state << 8)
    guard let event = NSEvent.otherEvent(
        with: .systemDefined,
        location: .zero,
        modifierFlags: [],
        timestamp: ProcessInfo.processInfo.systemUptime,
        windowNumber: 0,
        context: nil,
        subtype: mediaKeySubtype,
        data1: data1,
        data2: -1
    ), let cgEvent = event.cgEvent else {
        fatalError("failed to create media key event")
    }
    cgEvent.setIntegerValueField(.eventSourceUnixProcessID, value: 0)
    cgEvent.setIntegerValueField(.eventSourceStateID, value: 1)
    cgEvent.setIntegerValueField(.eventSourceUserData, value: 0)
    cgEvent.setIntegerValueField(.eventTargetUnixProcessID, value: 0)
    cgEvent.post(tap: .cghidEventTap)
}

postMediaKey(state: keyDownState)
usleep(35_000)
postMediaKey(state: keyUpState)
SWIFT
}

select_chooser_row() {
  osascript -e 'tell application "System Events" to key code 36' >/dev/null
}

close_chooser() {
  osascript -e 'tell application "System Events" to key code 53' >/dev/null || true
}

wait_for_event_count() {
  local start_sequence="$1"
  local event_name="$2"
  local min_count="$3"
  local deadline=$((SECONDS + timeout_seconds))
  while (( SECONDS < deadline )); do
    trace_json="$(read_trace_json)"
    if python3 - "$start_sequence" "$event_name" "$min_count" "$trace_json" <<'PY'
import json
import sys

start_sequence = int(sys.argv[1])
event_name = sys.argv[2]
min_count = int(sys.argv[3])
events = [
    event for event in json.loads(sys.argv[4])
    if int(event.get("sequence", 0)) > start_sequence
]
count = sum(1 for event in events if event.get("event") == event_name)
raise SystemExit(0 if count >= min_count else 1)
PY
    then
      return 0
    fi
    sleep 0.05
  done
  return 1
}

analyze_trace() {
  local start_sequence="$1"
  local trace_json
  trace_json="$(read_trace_json)"
  python3 - "$start_sequence" "$trace_json" <<'PY'
import json
import sys

start_sequence = int(sys.argv[1])
events = [
    event for event in json.loads(sys.argv[2])
    if int(event.get("sequence", 0)) > start_sequence
]

def fail(message):
    print(json.dumps(events, indent=2, sort_keys=True))
    print(f"probe_playback_visible_chooser_reentry: {message}", file=sys.stderr)
    raise SystemExit(1)

def indexes(name):
    return [index for index, event in enumerate(events) if event.get("event") == name]

show_indexes = indexes("chooser_show")
dispatch_indexes = indexes("chooser_dispatch")
if len(show_indexes) != 1:
    fail(f"expected exactly one chooser_show while chooser was visible, got {len(show_indexes)}")
if not dispatch_indexes:
    fail("missing chooser_dispatch after row selection")

show_index = show_indexes[0]
dispatch_index = dispatch_indexes[0]
if dispatch_index <= show_index:
    fail("chooser_dispatch must happen after chooser_show")

transport_down_indexes = indexes("transport_key_down")
if len(transport_down_indexes) < 2:
    fail("expected a second media-key down while chooser was visible")

second_key_index = transport_down_indexes[1]
if second_key_index <= show_index:
    fail("second media-key down must happen after chooser_show")
if second_key_index >= dispatch_index:
    fail("second media-key down must happen before chooser row dispatch")

visible_reentry_window = events[second_key_index + 1:dispatch_index]
suppressed = [
    event for event in visible_reentry_window
    if event.get("event") in {
        "input_ignored",
        "chooser_reentry_ignored",
        "command_center_ignored",
        "transport_generated_shadow_ignored",
    }
]
if not suppressed:
    fail("second media-key press while chooser was visible was not suppressed")

late_shows = [
    event for event in visible_reentry_window
    if event.get("event") == "chooser_show"
]
if late_shows:
    fail("chooser reopened while the first chooser was still visible")

helper_results = [
    event for event in events[dispatch_index + 1:]
    if event.get("event") == "helper_command_result"
]
if not helper_results:
    fail("missing helper command result after chooser dispatch")
if helper_results[0].get("ok") is False:
    fail(f"helper reported failure: {helper_results[0].get('message')}")

print(json.dumps({
    "event": "probe_visible_chooser_reentry_stable",
    "suppressedBy": suppressed[0].get("reason", suppressed[0].get("event")),
    "targetCount": events[show_index].get("targetCount"),
}, sort_keys=True))
PY
}

trap close_chooser EXIT

start_sequence="$(read_trace_sequence)"
printf 'probe_playback_visible_chooser_reentry: starting after trace sequence %s\n' "$start_sequence"
post_physical_play_pause

if ! wait_for_event_count "$start_sequence" "chooser_show" 1; then
  read_trace_json | python3 -m json.tool >&2
  fail "timed out waiting for chooser_show"
fi

sleep 0.1
post_physical_play_pause
sleep "$settle_seconds"
select_chooser_row

if ! wait_for_event_count "$start_sequence" "chooser_dispatch" 1; then
  read_trace_json | python3 -m json.tool >&2
  fail "timed out waiting for chooser_dispatch"
fi

sleep "$settle_seconds"
analyze_trace "$start_sequence"
printf 'probe_playback_visible_chooser_reentry=ok\n'
